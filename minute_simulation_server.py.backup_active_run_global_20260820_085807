"+")[0]\n                    : "--";\n\n            setText(\n                "proRunClock",\n                "REQ "\n                + req\n                + "  START "\n                + start\n            );\n\n        }\n\n\n        /*\n         * Do NOT touch the chart or minute table here.\n         * That is intentionally minute-based.\n         */\n    }\n\n\n    // ========================================================\n    // ONLY UPDATE MINUTE HISTORY WHEN MINUTE CHANGES\n    // ========================================================\n\n    function renderMinuteHistory(\n        state\n    ){\n\n        const tbody =\n            el(\n                "proHistoryTable"\n            );\n\n        if(!tbody){\n            return;\n        }\n\n        const history =\n            Array.isArray(\n                state.history\n            )\n                ? state.history\n                : [];\n\n        /*\n         * First completed minute for NOW:\n         * the history point should be at the END of the\n         * scheduled start minute, not the build timestamp.\n         *\n         * Example:\n         * START 14:27:00\n         * first minute point = 14:28:00\n         */\n        const filtered =\n            history.filter(\n                row => {\n\n                    if(\n                        state.run_id !== "NOW"\n                    ){\n                        return true;\n                    }\n\n                    if(\n                        !state.scheduled_start\n                    ){\n                        return true;\n                    }\n\n                    if(\n                        !row.timestamp\n                    ){\n                        return true;\n                    }\n\n                    return (\n                        row.timestamp\n                        >=\n                        state.scheduled_start\n                    );\n                }\n            );\n\n        if(!filtered.length){\n\n            tbody.innerHTML =\n                `\n                <tr>\n                    <td\n                        colspan="9"\n                        class="pro-empty"\n                    >\n                        No completed minute snapshot yet\n                    </td>\n                </tr>\n                `;\n\n            return;\n        }\n\n        tbody.innerHTML =\n            filtered\n                .slice()\n                .reverse()\n                .map(\n                    row => `\n                    <tr>\n\n                        <td>\n                            ${\n                                row.timestamp\n                                ?.split("T")[1]\n                                ?.split("+")[0]\n                                ||\n                                "--"\n                            }\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.synthetic_future\n                                ??\n                                row.spot,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.actual_future\n                                ??\n                                row.future,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.atm,\n                                0\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.current_ce\n                                ??\n                                row.ce,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.current_pe\n                                ??\n                                row.pe,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.straddle\n                                ??\n                                row.current_straddle,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.delta,\n                                5\n                            )}\n                        </td>\n\n                        <td class="${\n                            pnlClass(\n                                row.total_pnl\n                                ??\n                                row.total\n                            )\n                        }">\n                            ${\n                                signed(\n                                    row.total_pnl\n                                    ??\n                                    row.total,\n                                    2\n                                )\n                            }\n                        </td>\n\n                    </tr>\n                    `\n                )\n                .join("");\n    }\n\n\n    // ========================================================\n    // P&L CHART\n    // ========================================================\n\n    function renderPnlChart(\n        state\n    ){\n\n        if(!ensureChart()){\n            return;\n        }\n\n        const section =\n            el(\n                "minutePnlChartSection"\n            );\n\n        const canvas =\n            el(\n                "minutePnlChart"\n            );\n\n        const meta