 )\n                )\n                .filter(\n                    v => v !== null\n                );\n\n        const rect =\n            canvas.getBoundingClientRect();\n\n        const dpr =\n            window.devicePixelRatio || 1;\n\n        const w =\n            rect.width;\n\n        const h =\n            rect.height;\n\n        canvas.width =\n            Math.max(\n                1,\n                Math.floor(\n                    w * dpr\n                )\n            );\n\n        canvas.height =\n            Math.max(\n                1,\n                Math.floor(\n                    h * dpr\n                )\n            );\n\n        const ctx =\n            canvas.getContext(\n                "2d"\n            );\n\n        ctx.setTransform(\n            dpr,\n            0,\n            0,\n            dpr,\n            0,\n            0\n        );\n\n        ctx.clearRect(\n            0,\n            0,\n            w,\n            h\n        );\n\n        if(values.length < 2){\n\n            ctx.fillStyle =\n                "#8ea2b8";\n\n            ctx.font =\n                "10px system-ui";\n\n            ctx.fillText(\n                values.length === 1\n                    ? "Waiting for next minute..."\n                    : "Waiting for minute snapshots...",\n                10,\n                20\n            );\n\n            return;\n        }\n\n        const min =\n            Math.min(\n                ...values,\n                0\n            );\n\n        const max =\n            Math.max(\n                ...values,\n                0\n            );\n\n        const range =\n            Math.max(\n                max - min,\n                0.000001\n            );\n\n        const left = 40;\n        const right = 12;\n        const top = 12;\n        const bottom = 22;\n\n        // Grid / zero\n        ctx.strokeStyle =\n            "#1b2b3b";\n\n        ctx.lineWidth = 1;\n\n        const zeroY =\n            h\n            -\n            bottom\n            -\n            (\n                (0-min)\n                /\n                range\n            )\n            *\n            (\n                h-top-bottom\n            );\n\n        ctx.beginPath();\n        ctx.moveTo(left,zeroY);\n        ctx.lineTo(w-right,zeroY);\n        ctx.stroke();\n\n        // P&L line\n        ctx.strokeStyle =\n            "#35d07f";\n\n        ctx.lineWidth = 2;\n\n        ctx.beginPath();\n\n        values.forEach(\n            (value,index) => {\n\n                const x =\n                    left\n                    +\n                    (\n                        index\n                        /\n                        Math.max(\n                            values.length-1,\n                            1\n                        )\n                    )\n                    *\n                    (\n                        w-left-right\n                    );\n\n                const y =\n                    h\n                    -\n                    bottom\n                    -\n                    (\n                        (value-min)\n                        /\n                        range\n                    )\n                    *\n                    (\n                        h-top-bottom\n                    );\n\n                if(index === 0){\n                    ctx.moveTo(\n                        x,\n                        y\n                    );\n                }else{\n                    ctx.lineTo(\n                        x,\n                        y\n                    );\n                }\n\n            }\n        );\n\n        ctx.stroke();\n\n        // Points\n        ctx.fillStyle =\n            "#55aaff";\n\n        values.forEach(\n            (value,index) => {\n\n                const x =\n                    left\n                    +\n                    (\n                        index\n                        /\n                        Math.max(\n                            values.length-1,\n                            1\n                        )\n                    )\n                    *\n                    (\n                        w-left-right\n                    );\n\n                const y =\n                    h\n                    -\n                    bottom\n                    -\n                    (\n                        (value-min)\n                        /\n                        range\n                    )\n                    *\n                    (\n                        h-top-bottom\n                    );\n\n                ctx.beginPath();\n\n                ctx.arc(\n                    x,\n                    y,\n                    2.5,\n                    0,\n                    Math.PI*2\n                );\n\n                ctx.fill();\n            }\n        );\n\n        ctx.fillStyle =\n            "#8ea2b8";\n\n        ctx.font =\n            "9px system-ui";\n\n        ctx.fillText(\n            "Max "\n            +\n            max.toFixed(2),\n            left,\n            10\n        );\n\n        ctx.fillText(\n            "Min "\n            +\n            min.toFixed(2),\n            left,\n            h-3\n        );\n\n        ctx.textAlign =\n            "right";\n\n        ctx.fillText(\n            "Current "\n            +\n            values[\n                values.length-1\n            ].toFixed(2),\n            w-right,\n            10\n        );\n\n        ctx.textAlign =\n            "left";\n    }\n\n\n    // ========================================================\n    // FETCH SELECTED RUN FREQUENTLY\n    //\n    // This is the important real-time fix.\n    // ========================================================\n\n    async function fetchActiveRun(){\n\n        try{\n\n            const response =\n                await fetch(\n                    "/api/runs/"\n                    +\n                    activeRun\n                    +\n                    "?ts="\n                    +\n                    Date.now(),\n                    {\n                        cache:"no-store"\n                    }\n                );\n\n            if(!response.ok){\n                return;\n            }\n\n            const state =\n                await response.json();\n\n            cache[\n                activeRun\n            ] = state;\n\n            /*\n             * LIVE summary every 250 ms.\n             */\n            renderLiveSummary(\n                state\n            );\n\n            /*\n             * The minute/history/chart only update when\n             * their latest minute changes.\n             */\n            const history =\n                Array.isArray(\n                    state.history\n                )\n                    ? state.history\n                    : [];\n\n            const latest =\n                history.length\n                    ? history[\n                        history.length-1\n                    ]\n                    : null;\n\n            const minuteKey =\n                [\n                    state.run_id,\n                    latest?.timestamp || "",\n                    state.started\n                        ? "1"\n                        : "0",\n                    state.completed\n                        ? "1"\n                        : "0",\n                ].join("|");\n\n            if(\n                minuteKey !== chartMinuteKey\n            ){\n\n                chartMinuteKey =\n                    minuteKey;\n\n                renderMinuteHistory(\n                    state\n                );\n\n                renderPnlChart(\n                    state\n                );\n            }\n\n        }catch(error){\n\n            console.error(\n                "[LIVE ACTIVE RUN]",\n                error\n            );\n        }\n    }\n\n\n    // ========================================================\n    // FIND CLICKED TAB\n    // ========================================================\n\n    function installTabs(){\n\n        document\n            .querySelectorAll(\n                "#proSimRoot .pro-sim-tab"\n            )\n            .forEach(\n                button => {\n\n                    if(\n                        button.dataset\n                            .liveBound\n                    ){\n                        return;\n                    }\n\n                    button.dataset.liveBound =\n                        "1";\n\n                    button.addEventListener(\n                        "click",\n                        () => {\n\n                            const runId =\n                                button.dataset.run;\n\n                            if(\n                                !RUNS.includes(\n                                    runId\n                                )\n                            ){\n                                return;\n                            }\n\n                            activeRun =\n                                runId;\n\n                            chartMinuteKey =\n                                "";\n\n                            document\n                                .querySelectorAll(\n                                    "#proSimRoot .pro-sim-tab"\n                                )\n                                .forEach(\n                                    tab => {\n\n                                        tab.classList.toggle(\n                                            "active",\n                                            tab.dataset.run\n                                            ===\n                                            activeRun\n                                        );\n\n                                    }\n                                );\n\n                            ensureChart();\n\n                            fetchActiveRun();\n\n                        },\n                        true\n                    );\n                }\n            );\n    }\n\n\n    // ========================================================\n    // MAIN\n    // ========================================================\n\n    function boot(){\n\n        ensureChart();\n\n        installTabs();\n\n        /*\n         * Fast active-run refresh.\n         * Does NOT rebuild the DOM.\n         */\n        fetchActiveRun();\n\n        setInterval(\n            fetchActiveRun,\n            250\n        );\n\n        /*\n         * Reinstall tabs if the existing UI script\n         * recreates them.\n         */\n        setInterval(\n            () => {\n                installTabs();\n            },\n            1000\n        );\n    }\n\n\n    if(\n        document.readyState === "loading"\n    ){\n\n        document.addEventListener(\n            "DOMContentLoaded",\n            boot,\n            {once:true}\n        );\n\n    }else{\n\n        boot();\n\n    }\n\n})();\n</script>\n\n</body>\n</html>\n'


class HTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, *_args) -> None:
        return

    def send_json(self, payload: dict, status: int = 200) -> None:
        body = json.dumps(
            payload,
            default=str,
            allow_nan=False,
        ).encode("utf-8")

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8",
        )
        self.send_header(
            "Cache-Control",
            "no-store",
        )
        self.send_header(
            "Access-Control-Allow-Origin",
            "*",
        )
        self.send_header(
            "Content-Length",
            str(len(body)),
        )
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]

        if path == "/":
            body = DASHBOARD_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header(
                "Content-Type",
                "text/html; charset=utf-8",
            )
            self.send_header(
                "Cache-Control",
                "no-store",
            )
            self.send_header(
                "Content-Length",
                str(len(body)),
            )
            self.end_headers()
            self.wfile.write(body)
            return

        if path == "/api/runs":
            self.send_json({
                "status": "SUCCESS",
                "run_ids": list(RUN_IDS),
                "runs": CONTROLLER.state(),
            })
            return

        if path == "/api/runs/NOW/start":
            self.send_json(
                CONTROLLER.start_now()
            )
            return

        if path.startswith("/api/runs/"):
            run_id = path.rsplit("/", 1)[-1]
            state = CONTROLLER.state(run_id)
            if state is None:
                self.send_json(
                    {
                        "status": "ERROR",
                        "error": "Unknown simulation run",
                        "run_id": run_id,
                    },
                    404,
                )
                return
            self.send_json(state)
            return

        self.send_json(
            {
                "status": "ERROR",
                "error": "Not found",
            },
            404,
        )


async def server_websocket_loop() -> None:
    await ws_loop()


def main() -> None:
    print("=" * 72)
    print("NIFTY CLEAN MINUTE SIMULATION SERVER")
    print("=" * 72)
    print(f"Feed : {WS_URI}")
    print(f"HTTP : http://0.0.0.0:{HTTP_PORT}")
    print("Runs : 09:16 / 09:17 / 09:18 / 09:19 / NOW")
    print(
        f"Quote policy : "
        f"{'LTP fallback enabled' if USE_LTP_FALLBACK else 'strict bid/ask'}"
    )
    print("=" * 72)

    thread = threading.Thread(
        target=lambda: asyncio.run(
            server_websocket_loop()
        ),
        daemon=True,
        name="market-websocket",
    )
    thread.start()

    server = ThreadingHTTPServer(
        (HTTP_HOST, HTTP_PORT),
        HTTPHandler,
    )

    print(
        f"[HTTP] Listening on {HTTP_HOST}:{HTTP_PORT}"
    )

    try:
        server.serve_forever()
    finally:
        server.server_close()


if __name__ == "__main__":
    main()