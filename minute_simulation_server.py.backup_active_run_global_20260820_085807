\n\n#proSimRoot .pro-sim-top{\n    padding:6px 9px 5px !important;\n}\n\n#proSimRoot .pro-sim-title{\n    font-size:14px !important;\n    line-height:1.1;\n}\n\n#proSimRoot .pro-sim-sub{\n    display:none !important;\n}\n\n#proSimRoot .pro-sim-tabs{\n    display:grid !important;\n    grid-template-columns:\n        repeat(4,minmax(0,1fr))\n        minmax(130px,1.25fr);\n    gap:4px !important;\n    margin-top:5px !important;\n    width:100%;\n}\n\n#proSimRoot .pro-sim-tab{\n    min-width:0 !important;\n    padding:7px 9px !important;\n    min-height:28px !important;\n    font-size:10px !important;\n    border-radius:6px !important;\n}\n\n#proSimRoot .pro-sim-now{\n    margin-left:0 !important;\n}\n\n/* Compact live/request status */\n#proSimRoot .pro-sim-status{\n    display:flex !important;\n    margin-top:4px !important;\n    gap:4px !important;\n}\n\n#proSimRoot .pro-pill{\n    padding:3px 7px !important;\n    font-size:8px !important;\n}\n\n/* ------------------------------------------------------------\n   Market summary\n   ------------------------------------------------------------ */\n\n#proSimRoot .pro-grid{\n    display:grid !important;\n    grid-template-columns:\n        repeat(4,minmax(0,1fr));\n    gap:5px !important;\n    padding:6px !important;\n}\n\n#proSimRoot .pro-card{\n    padding:7px 8px !important;\n    min-width:0;\n    border-radius:7px !important;\n}\n\n#proSimRoot .pro-card-label{\n    font-size:7px !important;\n    letter-spacing:.35px;\n}\n\n#proSimRoot .pro-card-value{\n    font-size:16px !important;\n    line-height:1.1;\n    margin-top:3px !important;\n}\n\n#proSimRoot .pro-card-small{\n    font-size:8px !important;\n    margin-top:2px;\n}\n\n/* ------------------------------------------------------------\n   Main summary rows\n   ------------------------------------------------------------ */\n\n#proSimRoot .pro-two{\n    display:grid !important;\n    grid-template-columns:\n        minmax(0,1fr)\n        minmax(0,1fr);\n    gap:5px !important;\n    padding:0 6px 5px !important;\n}\n\n#proSimRoot .pro-section{\n    border-radius:7px !important;\n}\n\n#proSimRoot .pro-section-head{\n    padding:6px 8px !important;\n    font-size:8px !important;\n    letter-spacing:.45px;\n}\n\n#proSimRoot .pro-section-body{\n    padding:6px !important;\n}\n\n#proSimRoot .pro-leg-grid{\n    gap:4px !important;\n}\n\n#proSimRoot .pro-leg{\n    padding:5px 6px !important;\n    min-width:0;\n}\n\n#proSimRoot .pro-leg-name{\n    font-size:7px !important;\n}\n\n#proSimRoot .pro-leg-value{\n    font-size:11px !important;\n    overflow:hidden;\n    text-overflow:ellipsis;\n    white-space:nowrap;\n}\n\n#proSimRoot .pro-pnl-grid{\n    gap:4px !important;\n}\n\n#proSimRoot .pro-pnl{\n    padding:6px !important;\n}\n\n#proSimRoot .pro-pnl-value{\n    font-size:14px !important;\n}\n\n/* ------------------------------------------------------------\n   Greeks / Risk\n   ------------------------------------------------------------ */\n\n#proSimRoot .pro-greeks{\n    gap:4px !important;\n}\n\n#proSimRoot .pro-greek{\n    padding:5px 6px !important;\n}\n\n#proSimRoot .pro-greek-name{\n    font-size:7px !important;\n}\n\n#proSimRoot .pro-greek-value{\n    font-size:11px !important;\n}\n\n/* ------------------------------------------------------------\n   Tables\n   ------------------------------------------------------------ */\n\n#proSimRoot .pro-table-wrap{\n    width:auto;\n    padding:0 6px 5px !important;\n}\n\n#proSimRoot .pro-table{\n    width:100%;\n    font-size:8px !important;\n}\n\n#proSimRoot .pro-table th,\n#proSimRoot .pro-table td{\n    padding:4px 5px !important;\n    white-space:nowrap;\n}\n\n/* ------------------------------------------------------------\n   P&L HISTORY · 1-MINUTE SNAPSHOTS CHART\n   ------------------------------------------------------------ */\n\n#autoPnlChartSection{\n    margin:0 6px 5px;\n    border:1px solid #20344a;\n    border-radius:7px;\n    background:#0d1827;\n    overflow:hidden;\n}\n\n#autoPnlChartHeader{\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    padding:6px 8px;\n    border-bottom:1px solid #20344a;\n}\n\n#autoPnlChartTitle{\n    font-size:8px;\n    font-weight:750;\n    letter-spacing:.5px;\n}\n\n#autoPnlChartStatus{\n    font-size:8px;\n    color:#8ea2b8;\n}\n\n#autoPnlChartWrap{\n    height:185px;\n    padding:5px 7px 7px;\n}\n\n#autoPnlChart{\n    width:100%;\n    height:175px;\n    display:block;\n    background:#08111d;\n    border-radius:5px;\n}\n\n/* ------------------------------------------------------------\n   Blank historical runs\n   ------------------------------------------------------------ */\n\n#autoPnlChartSection.blank-history\n#autoPnlChart{\n    opacity:.55;\n}\n\n/* ------------------------------------------------------------\n   NOW button states\n   ------------------------------------------------------------ */\n\n#proSimRoot .pro-sim-now[data-now-state="scheduled"]{\n    background:#684f18 !important;\n    border-color:#9a7624 !important;\n}\n\n#proSimRoot .pro-sim-now[data-now-state="running"]{\n    background:#173f2c !important;\n    border-color:#35d07f !important;\n}\n\n#proSimRoot .pro-sim-now[data-now-state="completed"]{\n    background:#193052 !important;\n    border-color:#4c86c4 !important;\n}\n\n#proSimRoot .pro-sim-now:disabled{\n    cursor:not-allowed;\n    opacity:.92;\n}\n\n/* ------------------------------------------------------------\n   Responsive\n   ------------------------------------------------------------ */\n\n@media(max-width:850px){\n\n    #proSimRoot .pro-sim-tabs{\n        grid-template-columns:\n            repeat(4,minmax(75px,1fr))\n            minmax(110px,1fr);\n        overflow-x:auto;\n    }\n\n    #proSimRoot .pro-two{\n        grid-template-columns:1fr;\n    }\n\n    #proSimRoot .pro-grid{\n        grid-template-columns:\n            repeat(2,minmax(0,1fr));\n    }\n}\n\n</style>\n\n\n<style id="perRunChartCleanup">\n\n/* Previous chart implementations are disabled. */\n</style>\n\n\n<style id="finalNowTabLayout">\n\n#proSimRoot .pro-sim-tabs{\n    display:grid !important;\n    grid-template-columns:\n        repeat(5,minmax(0,1fr))\n        minmax(125px,1.1fr) !important;\n    gap:4px !important;\n    width:100% !important;\n}\n\n#proSimRoot .pro-sim-tab{\n    min-width:0 !important;\n    width:100% !important;\n}\n\n#proSimRoot .pro-sim-now-result{\n    background:#17243a !important;\n    border-color:#426489 !important;\n}\n\n#proStartNowButton{\n    min-width:0 !important;\n    width:100% !important;\n    min-height:28px !important;\n    padding:6px 10px !important;\n    border-radius:6px !important;\n\n    background:#167146 !important;\n    border:1px solid #2c9d69 !important;\n    color:#ecfff5 !important;\n\n    font-size:10px !important;\n    font-weight:750 !important;\n\n    cursor:pointer !important;\n}\n\n#proStartNowButton:hover{\n    background:#1d8856 !important;\n}\n\n#proStartNowButton:disabled{\n    background:#29343c !important;\n    border-color:#47525a !important;\n    color:#aeb8bf !important;\n    cursor:not-allowed !important;\n    opacity:1 !important;\n}\n\n@media(max-width:850px){\n\n    #proSimRoot .pro-sim-tabs{\n        grid-template-columns:\n            repeat(5,minmax(70px,1fr))\n            minmax(105px,1fr) !important;\n        overflow-x:auto;\n    }\n}\n\n</style>\n\n\n<style id="singleMinuteDataUI">\n\n/* ------------------------------------------------------------\n   ONE TIME-GRANULARITY ONLY\n   ------------------------------------------------------------ */\n\n/*\n * The P&L chart and 1-MINUTE HISTORY are the authoritative UI\n * time series.\n */\n#autoPnlChartSection{\n    margin-top:5px !important;\n}\n\n\n/* ------------------------------------------------------------\n   Label the single authoritative series.\n   ------------------------------------------------------------ */\n\n#autoPnlChartTitle{\n    font-size:9px !important;\n}\n\n#autoPnlChartStatus{\n    font-size:8px !important;\n    color:#8ea2b8;\n}\n\n</style>\n\n\n<style id="perRunPnlChartVisibility">\n\n/* The chart itself is allowed to exist. */\n#autoPnlChartSection{\n    display:none;\n    margin:5px 6px 5px;\n    background:#0d1827;\n    border:1px solid #20344a;\n    border-radius:7px;\n    overflow:hidden;\n}\n\n/* The selected run is started -> show chart. */\n#autoPnlChartSection.show-pnl-chart{\n    display:block !important;\n}\n\n/* Waiting runs: no chart area. */\n#autoPnlChartSection.hide-pnl-chart{\n    display:none !important;\n}\n\n</style>\n\n\n<style id="liveSummaryChartFix">\n\n/* ============================================================\n   AUTHORITATIVE P&L CHART\n   ============================================================ */\n\n#minutePnlChartSection{\n    display:none;\n    margin:5px 6px;\n    background:#0d1827;\n    border:1px solid #20344a;\n    border-radius:7px;\n    overflow:hidden;\n}\n\n#minutePnlChartSection.visible{\n    display:block !important;\n}\n\n#minutePnlChartHeader{\n    height:25px;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:0 8px;\n    border-bottom:1px solid #20344a;\n}\n\n#minutePnlChartTitle{\n    font-size:9px;\n    font-weight:750;\n    letter-spacing:.45px;\n}\n\n#minutePnlChartMeta{\n    font-size:8px;\n    color:#8ea2b8;\n}\n\n#minutePnlChartWrap{\n    height:170px;\n    padding:5px 7px 7px;\n}\n\n#minutePnlChart{\n    width:100%;\n    height:158px;\n    display:block;\n    background:#08111d;\n    border-radius:5px;\n}\n\n/* Current/live values */\n#proSimRoot .live-value{\n    transition:none !important;\n}\n\n/* Never animate cards / text. */\n#proSimRoot *,\n#minutePnlChartSection *{\n    animation:none !important;\n    transition:none !important;\n}\n\n</style>\n\n</head>\n<body>\n<header>\n    <h1>NIFTY Independent Minute Simulations</h1>\n    <div class="tabs">\n        <button data-run="0916">09:16</button>\n        <button data-run="0917">09:17</button>\n        <button data-run="0918">09:18</button>\n        <button data-run="0919">09:19</button>\n        <button id="nowButton" class="now">START NOW</button>\n    </div>\n</header>\n\n<main>\n    <div id="status" class="status">CONNECTING...</div>\n\n    <div class="cards">\n        <div class="card">\n            <div class="label">Spot</div>\n            <div id="spot" class="value">—</div>\n        </div>\n        <div class="card">\n            <div class="label">Future</div>\n            <div id="future" class="value">—</div>\n        </div>\n        <div class="card">\n            <div class="label">ATM</div>\n            <div id="atm" class="value">—</div>\n        </div>\n        <div class="card">\n            <div class="label">Total P&L</div>\n            <div id="totalPnl" class="value">0.0000</div>\n        </div>\n    </div>\n\n    <div class="panel">\n        <h3>Trade</h3>\n        <div class="cards">\n            <div>\n                <div class="label">Entry CE</div>\n                <div id="entryCe" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Entry PE</div>\n                <div id="entryPe" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Entry Straddle</div>\n                <div id="entryStraddle" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Trade Status</div>\n                <div id="tradeStatus" class="value">WAITING</div>\n            </div>\n        </div>\n        <div id="entryReason" class="reason"></div>\n    </div>\n\n    <div class="panel">\n        <h3>Greeks</h3>\n        <div class="grid4">\n            <div>\n                <div class="label">Delta</div>\n                <div id="delta" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Gamma</div>\n                <div id="gamma" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Theta</div>\n                <div id="theta" class="value">—</div>\n            </div>\n            <div>\n                <div class="label">Vega</div>\n                <div id="vega" class="value">—</div>\n            </div>\n        </div>\n    </div>\n\n    <div class="panel">\n        <h3>P&L History</h3>\n        <canvas id="pnlChart" width="1400" height="280"></canvas>\n    </div>\n\n    <div class="panel">\n        <h3>1-MINUTE HISTORY</h3>\n        <table>\n            <thead>\n                <tr>\n                    <th>Time</th>\n                    <th>Spot</th>\n                    <th>Future</th>\n                    <th>ATM</th>\n                    <th>Straddle</th>\n                    <th>Delta</th>\n                    <th>Gamma</th>\n                    <th>Hedge</th>\n                    <th>Total P&L</th>\n                </tr>\n            </thead>\n            <tbody id="history"></tbody>\n        </table>\n    </div>\n</main>\n\n<script>\nlet activeRun = "0916";\n\nfunction fmt(v, digits=2) {\n    const n = Number(v);\n    return Number.isFinite(n) ? n.toFixed(digits) : "—";\n}\n\nfunction setActive(runId) {\n    activeRun = runId;\n    document.querySelectorAll("[data-run]").forEach(btn => {\n        btn.classList.toggle(\n            "active",\n            btn.dataset.run === runId\n        );\n    });\n}\n\nfunction render(state) {\n    if (!state) return;\n\n    setActive(state.run_id);\n\n    const m = state.market || {};\n    const e = state.entry || {};\n    const p = state.position || {};\n    const g = state.greeks || {};\n    const h = state.history || [];\n\n    document.getElementById("spot").textContent =\n        fmt(m.spot);\n\n    document.getElementById("future").textContent =\n        fmt(m.future);\n\n    document.getElementById("atm").textContent =\n        fmt(m.atm);\n\n    document.getElementById("totalPnl").textContent =\n        fmt(\n            (state.pnl || {}).total,\n            4\n        );\n\n    document.getElementById("entryCe").textContent =\n        e.ce ? `${e.ce} @ ${fmt(e.ce_price, 2)}` : "—";\n\n    document.getElementById("entryPe").textContent =\n        e.pe ? `${e.pe} @ ${fmt(e.pe_price, 2)}` : "—";\n\n    document.getElementById("entryStraddle").textContent =\n        fmt(e.straddle, 2);\n\n    document.getElementById("tradeStatus").textContent =\n        p.active\n            ? "ACTIVE"\n            : state.completed\n                ? `EXITED: ${state.exit?.reason || "—"}`\n                : state.armed\n                    ? "ARMED"\n                    : "WAITING";\n\n    document.getElementById("entryReason").textContent =\n        state.entry_block_reason\n            ? `Entry block: ${state.entry_block_reason}`\n            : (\n                e.quote_source\n                    ? `Entry quote source: ${e.quote_source}`\n                    : ""\n            );\n\n    document.getElementById("delta").textContent =\n        fmt(g.delta, 6);\n\n    document.getElementById("gamma").textContent =\n        fmt(g.gamma, 6);\n\n    document.getElementById("theta").textContent =\n        fmt(g.theta, 6);\n\n    document.getElementById("vega").textContent =\n        fmt(g.vega, 6);\n\n    document.getElementById("status").textContent =\n        state.completed\n            ? `COMPLETED — ${state.exit?.reason || "EXIT"}`\n            : state.started\n                ? `LIVE — ${state.run_id}`\n                : state.armed\n                    ? `ARMED — ${state.run_id}`\n                    : `WAITING — ${state.run_id}`;\n\n    drawChart(h);\n    renderHistory(h);\n}\n\nfunction drawChart(history) {\n    const c = document.getElementById("pnlChart");\n    const ctx = c.getContext("2d");\n\n    ctx.clearRect(0, 0, c.width, c.height);\n\n    if (history.length < 2) return;\n\n    const values = history.map(\n        x => Number(x.total_pnl || 0)\n    );\n\n    const min = Math.min(...values);\n    const max = Math.max(...values);\n    const range = Math.max(max - min, 1);\n\n    ctx.beginPath();\n\n    values.forEach((v, i) => {\n        const x =\n            20 +\n            i / (values.length - 1) *\n            (c.width - 40);\n\n        const y =\n            c.height - 20 -\n            (v - min) / range *\n            (c.height - 40);\n\n        if (i === 0) ctx.moveTo(x, y);\n        else ctx.lineTo(x, y);\n    });\n\n    ctx.stroke();\n}\n\nfunction renderHistory(history) {\n    const body = document.getElementById("history");\n\n    body.innerHTML = history\n        .slice()\n        .reverse()\n        .map(x => `\n            <tr>\n                <td>${x.timestamp || "—"}</td>\n                <td>${fmt(x.spot)}</td>\n                <td>${fmt(x.future)}</td>\n                <td>${fmt(x.atm)}</td>\n                <td>${fmt(x.straddle)}</td>\n                <td>${fmt(x.delta, 6)}</td>\n                <td>${fmt(x.gamma, 6)}</td>\n                <td>${fmt(x.hedge, 4)}</td>\n                <td>${fmt(x.total_pnl, 4)}</td>\n            </tr>\n        `)\n        .join("");\n}\n\nasync function refresh() {\n    try {\n        const r = await fetch(\n            `/api/runs/${activeRun}`,\n            {cache: "no-store"}\n        );\n\n        render(await r.json());\n\n    } catch (err) {\n        console.error(err);\n        document.getElementById("status").textContent =\n            "SERVER ERROR";\n    }\n}\n\ndocument.querySelectorAll("[data-run]").forEach(btn => {\n    btn.addEventListener("click", () => {\n        setActive(btn.dataset.run);\n        refresh();\n    });\n});\n\ndocument.getElementById("nowButton").addEventListener(\n    "click",\n    async () => {\n        const btn = document.getElementById("nowButton");\n        btn.disabled = true;\n        btn.textContent = "STARTING NOW...";\n\n        try {\n            const r = await fetch(\n                "/api/runs/NOW/start",\n                {cache: "no-store"}\n            );\n\n            const state = await r.json();\n            render(state);\n\n        } catch (err) {\n            console.error(err);\n        } finally {\n            btn.disabled = false;\n            btn.textContent = "START NOW";\n        }\n    }\n);\n\nsetInterval(refresh, 1000);\nrefresh();\n</script>\n\n<div id="proSimRoot">\n  <div class="pro-sim-shell">\n\n    <div class="pro-sim-top">\n      <div class="pro-sim-title-row">\n        <div>\n          <div class="pro-sim-title">\n            NIFTY Minute Straddle Simulation\n          </div>\n          <div class="pro-sim-sub">\n            Independent live simulations · Synthetic future strategy model · 1-minute state history\n          </div>\n        </div>\n\n        <div class="pro-sim-live">\n          <span class="pro-sim-live-dot"></span>\n          <span id="proLiveStatus">LIVE</span>\n        </div>\n      </div>\n\n      <div class="pro-sim-tabs" id="proRunTabs">\n        <button class="pro-sim-tab active" data-run="0916">09:16</button>\n        <button class="pro-sim-tab" data-run="0917">09:17</button>\n        <button class="pro-sim-tab" data-run="0918">09:18</button>\n        <button class="pro-sim-tab" data-run="0919">09:19</button>\n        <button\n          class="pro-sim-tab pro-sim-now-result"\n          data-run="NOW"\n          title="View START NOW simulation"\n        >NOW</button>\n\n        <button\n          id="proStartNowButton"\n          class="pro-start-now-action"\n          type="button"\n          title="Schedule START NOW for the next full minute"\n        >START NOW</button>\n      </div>\n\n      <div class="pro-sim-status">\n        <div class="pro-pill" id="proRunState">WAITING</div>\n        <div class="pro-pill" id="proRunClock">--</div>\n        <div class="pro-pill" id="proEntryStatus">NO ENTRY</div>\n      </div>\n    </div>\n\n    <div class="pro-grid">\n\n      <div class="pro-card">\n        <div class="pro-card-label">Synthetic Spot</div>\n        <div class="pro-card-value" id="proSyntheticSpot">--</div>\n        <div class="pro-card-small">Strategy underlying</div>\n      </div>\n\n      <div class="pro-card">\n        <div class="pro-card-label">Actual Future</div>\n        <div class="pro-card-value" id="proActualFuture">--</div>\n        <div class="pro-card-small">NIFTY FUT market</div>\n      </div>\n\n      <div class="pro-card">\n        <div class="pro-card-label">ATM</div>\n        <div class="pro-card-value" id="proATM">--</div>\n        <div class="pro-card-small" id="proExpiry">Expiry --</div>\n      </div>\n\n      <div class="pro-card">\n        <div class="pro-card-label">Current Straddle</div>\n        <div class="pro-card-value" id="proCurrentStraddle">--</div>\n        <div class="pro-card-small" id="proEntryStraddle">Entry --</div>\n      </div>\n\n    </div>\n\n    <div class="pro-two">\n\n      <div class="pro-section">\n        <div class="pro-section-head">\n          Entry vs Current\n        </div>\n\n        <div class="pro-section-body">\n          <div class="pro-leg-grid">\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">CE Entry</div>\n              <div class="pro-leg-value" id="proEntryCE">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">PE Entry</div>\n              <div class="pro-leg-value" id="proEntryPE">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Entry Straddle</div>\n              <div class="pro-leg-value" id="proEntryStraddle2">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Current CE</div>\n              <div class="pro-leg-value" id="proCurrentCE">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Current PE</div>\n              <div class="pro-leg-value" id="proCurrentPE">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Quote Source</div>\n              <div class="pro-leg-value" id="proQuoteSource">--</div>\n            </div>\n\n          </div>\n        </div>\n      </div>\n\n      <div class="pro-section">\n        <div class="pro-section-head">\n          P&L\n        </div>\n\n        <div class="pro-section-body">\n          <div class="pro-pnl-grid">\n\n            <div class="pro-pnl">\n              <div class="pro-card-label">Option</div>\n              <div class="pro-pnl-value" id="proOptionPnl">--</div>\n            </div>\n\n            <div class="pro-pnl">\n              <div class="pro-card-label">Synthetic Hedge</div>\n              <div class="pro-pnl-value" id="proFuturePnl">--</div>\n            </div>\n\n            <div class="pro-pnl">\n              <div class="pro-card-label">Total</div>\n              <div class="pro-pnl-value" id="proTotalPnl">--</div>\n            </div>\n\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <div class="pro-two">\n\n      <div class="pro-section">\n        <div class="pro-section-head">\n          Greeks\n        </div>\n\n        <div class="pro-section-body">\n          <div class="pro-greeks">\n\n            <div class="pro-greek">\n              <div class="pro-greek-name">Delta</div>\n              <div class="pro-greek-value" id="proDelta">--</div>\n            </div>\n\n            <div class="pro-greek">\n              <div class="pro-greek-name">Gamma</div>\n              <div class="pro-greek-value" id="proGamma">--</div>\n            </div>\n\n            <div class="pro-greek">\n              <div class="pro-greek-name">Theta</div>\n              <div class="pro-greek-value" id="proTheta">--</div>\n            </div>\n\n            <div class="pro-greek">\n              <div class="pro-greek-name">Vega</div>\n              <div class="pro-greek-value" id="proVega">--</div>\n            </div>\n\n          </div>\n        </div>\n      </div>\n\n      <div class="pro-section">\n        <div class="pro-section-head">\n          Hedge / Risk\n        </div>\n\n        <div class="pro-section-body">\n          <div class="pro-leg-grid">\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Hedge</div>\n              <div class="pro-leg-value" id="proHedge">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Points Out</div>\n              <div class="pro-leg-value" id="proPointsOut">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Points Allowed</div>\n              <div class="pro-leg-value" id="proPointsAllowed">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Exit</div>\n              <div class="pro-leg-value" id="proExitReason">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Entry Time</div>\n              <div class="pro-leg-value" id="proEntryTime">--</div>\n            </div>\n\n            <div class="pro-leg">\n              <div class="pro-leg-name">Run</div>\n              <div class="pro-leg-value" id="proRunId">--</div>\n            </div>\n\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <div class="pro-chart-wrap">\n      <div class="pro-chart-card">\n        <div class="pro-section-head">\n          Synthetic Future / P&L Timeline\n        </div>\n        <canvas class="pro-chart" id="proChart"></canvas>\n      </div>\n    </div>\n\n    <div class="pro-table-wrap">\n      <div class="pro-section">\n        <div class="pro-section-head">\n          Hedge Events\n        </div>\n\n        <div style="overflow:auto;padding:0 8px 8px">\n          <table class="pro-table">\n            <thead>\n              <tr>\n                <th>Timestamp</th>\n                <th>Type</th>\n                <th>Hedge</th>\n                <th>Change</th>\n                <th>Delta</th>\n                <th>Points Out</th>\n                <th>Allowed</th>\n                <th>Synthetic</th>\n                <th>Actual FUT</th>\n              </tr>\n            </thead>\n            <tbody id="proHedgeTable">\n              <tr>\n                <td colspan="9" class="pro-empty">\n                  No hedge events\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <div class="pro-table-wrap">\n      <div class="pro-section">\n        <div class="pro-section-head">\n          1-MINUTE HISTORY\n        </div>\n\n        <div style="overflow:auto;padding:0 8px 8px">\n          <table class="pro-table">\n            <thead>\n              <tr>\n                <th>Time</th>\n                <th>Synthetic</th>\n                <th>Actual FUT</th>\n                <th>ATM</th>\n                <th>CE</th>\n                <th>PE</th>\n                <th>Straddle</th>\n                <th>Delta</th>\n                <th>Total P&L</th>\n              </tr>\n            </thead>\n            <tbody id="proHistoryTable">\n              <tr>\n                <td colspan="9" class="pro-empty">\n                  Waiting for minute history\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script id="professionalSimulationJS">\n(function(){\n\n  const RUNS = [\n    "0916",\n    "0917",\n    "0918",\n    "0919",\n    "NOW"\n  ];\n\n  const ACTIVE_RUN_KEY = "nifty_minute_active_run";\n\n\n  let activeRun = "0916";\n\n\n  try {\n\n\n    const savedRun =\n\n      localStorage.getItem(\n\n        ACTIVE_RUN_KEY\n\n      );\n\n\n    if (\n\n      savedRun &&\n\n      RUNS.includes(savedRun)\n\n    ) {\n\n\n      activeRun = savedRun;\n\n\n    }\n\n\n  } catch (error) {\n\n\n    console.warn(\n\n      "[RUN STATE] localStorage read failed",\n\n      error\n\n    );\n\n\n  }\n\n  let timer = null;\n\n  const $ = id =>\n    document.getElementById(id);\n\n  function persistActiveRun(runId){\n\n    if(!RUNS.includes(runId)){\n      return;\n    }\n\n    activeRun = runId;\n    try{\n\n      localStorage.setItem(\n        ACTIVE_RUN_KEY,\n        activeRun\n      );\n\n    }catch(error){\n\n      console.warn(\n        "[RUN STATE] localStorage write failed",\n        error\n      );\n\n    }\n\n  }\n\n\n\n    persistActiveRun(runId);\n    try{\n\n\n      localStorage.setItem(\n\n        ACTIVE_RUN_KEY,\n\n        activeRun\n\n      );\n\n\n    }catch(error){\n\n\n      console.warn(\n\n        "[RUN STATE] localStorage write failed",\n\n        error\n\n      );\n\n\n    }\n\n\n  }\n\n\n  function fmt(v, digits=2){\n    if(v === null || v === undefined || !Number.isFinite(Number(v))){\n      return "--";\n    }\n\n    return Number(v).toLocaleString(\n      undefined,\n      {\n        minimumFractionDigits: digits,\n        maximumFractionDigits: digits\n      }\n    );\n  }\n\n  function signed(v, digits=2){\n    if(v === null || v === undefined || !Number.isFinite(Number(v))){\n      return "--";\n    }\n\n    const n = Number(v);\n    return (n >= 0 ? "+" : "") + fmt(n, digits);\n  }\n\n  function esc(v){\n    return String(v ?? "")\n      .replaceAll("&","&amp;")\n      .replaceAll("<","&lt;")\n      .replaceAll(">","&gt;")\n      .replaceAll(\'"\',"&quot;")\n      .replaceAll("\'","&#039;");\n  }\n\n  function pnlClass(v){\n    const n = Number(v);\n\n    if(!Number.isFinite(n)){\n      return "pro-neutral";\n    }\n\n    if(n > 0){\n      return "pro-positive";\n    }\n\n    if(n < 0){\n      return "pro-negative";\n    }\n\n    return "pro-neutral";\n  }\n\n  function setPnl(id, value){\n    const node = $(id);\n\n    if(!node){\n      return;\n    }\n\n    node.textContent = signed(value,2);\n    node.className =\n      "pro-pnl-value "\n      +\n      pnlClass(value);\n  }\n\n  function setText(id, value){\n    const node = $(id);\n\n    if(node){\n      node.textContent =\n        value === null ||\n        value === undefined ||\n        value === ""\n          ? "--"\n          : value;\n    }\n  }\n\n  function resizeCanvas(){\n    const canvas = $("proChart");\n\n    if(!canvas){\n      return;\n    }\n\n    const rect =\n      canvas.getBoundingClientRect();\n\n    const dpr =\n      window.devicePixelRatio || 1;\n\n    canvas.width =\n      Math.max(\n        1,\n        Math.floor(rect.width * dpr)\n      );\n\n    canvas.height =\n      Math.max(\n        1,\n        Math.floor(rect.height * dpr)\n      );\n  }\n\n  function drawChart(state){\n\n    const canvas = $("proChart");\n\n    if(!canvas){\n      return;\n    }\n\n    resizeCanvas();\n\n    const ctx =\n      canvas.getContext("2d");\n\n    const dpr =\n      window.devicePixelRatio || 1;\n\n    const width =\n      canvas.width / dpr;\n\n    const height =\n      canvas.height / dpr;\n\n    ctx.setTransform(\n      dpr,\n      0,\n      0,\n      dpr,\n      0,\n      0\n    );\n\n    ctx.clearRect(\n      0,\n      0,\n      width,\n      height\n    );\n\n    const history =\n      Array.isArray(state.history)\n        ? state.history\n        : [];\n\n    if(history.length < 2){\n\n      ctx.fillStyle = "#8ea2b8";\n      ctx.font = "12px system-ui";\n\n      ctx.fillText(\n        "Waiting for minute history...",\n        20,\n        30\n      );\n\n      return;\n    }\n\n    const series = history.map(\n      row => ({\n        synthetic:\n          Number(\n            row.synthetic_future ??\n            row.spot ??\n            NaN\n          ),\n\n        pnl:\n          Number(\n            row.total_pnl ??\n            row.total ??\n            NaN\n          )\n      })\n    );\n\n    const validSynthetic =\n      series\n        .map(x => x.synthetic)\n        .filter(Number.isFinite);\n\n    const validPnl =\n      series\n        .map(x => x.pnl)\n        .filter(Number.isFinite);\n\n    if(\n      validSynthetic.length < 2\n      ||\n      validPnl.length < 2\n    ){\n      return;\n    }\n\n    function drawSeries(\n      values,\n      top,\n      bottom,\n      stroke\n    ){\n\n      const min =\n        Math.min(...values);\n\n      const max =\n        Math.max(...values);\n\n      const range =\n        Math.max(\n          max - min,\n          0.000001\n        );\n\n      ctx.strokeStyle =\n        stroke;\n\n      ctx.lineWidth = 2;\n\n      ctx.beginPath();\n\n      values.forEach(\n        (v,i) => {\n\n          const x =\n            12\n            +\n            (\n              i /\n              Math.max(\n                values.length - 1,\n                1\n              )\n            )\n            *\n            (\n              width - 24\n            );\n\n          const y =\n            bottom\n            -\n            (\n              (v - min)\n              / range\n            )\n            *\n            (\n              bottom - top\n            );\n\n          if(i === 0){\n            ctx.moveTo(x,y);\n          }else{\n            ctx.lineTo(x,y);\n          }\n\n        }\n      );\n\n      ctx.stroke();\n\n      ctx.fillStyle = "#8ea2b8";\n      ctx.font = "10px system-ui";\n\n      ctx.fillText(\n        fmt(min,2),\n        14,\n        bottom - 3\n      );\n\n      ctx.fillText(\n        fmt(max,2),\n        14,\n        top + 10\n      );\n    }\n\n    const middle =\n      Math.floor(\n        height * .52\n      );\n\n    drawSeries(\n      validSynthetic,\n      12,\n      middle - 8,\n      "#55aaff"\n    );\n\n    drawSeries(\n      validPnl,\n      middle + 8,\n      height - 12,\n      "#35d07f"\n    );\n\n    ctx.strokeStyle = "#20344a";\n    ctx.lineWidth = 1;\n\n    ctx.beginPath();\n    ctx.moveTo(12,middle);\n    ctx.lineTo(width - 12,middle);\n    ctx.stroke();\n\n    ctx.fillStyle = "#55aaff";\n    ctx.fillText(\n      "Synthetic Future",\n      width - 120,\n      20\n    );\n\n    ctx.fillStyle = "#35d07f";\n    ctx.fillText(\n      "Total P&L",\n      width - 75,\n      middle + 24\n    );\n  }\n\n  function renderHedgeEvents(state){\n\n    const tbody =\n      $("proHedgeTable");\n\n    if(!tbody){\n      return;\n    }\n\n    const events =\n      Array.isArray(state.hedge?.events)\n        ? state.hedge.events\n        : [];\n\n    if(!events.length){\n\n      tbody.innerHTML =\n        \'<tr><td colspan="9" class="pro-empty">No hedge events</td></tr>\';\n\n      return;\n    }\n\n    tbody.innerHTML =\n      events\n        .slice()\n        .reverse()\n        .slice(0,50)\n        .map(\n          e => `\n            <tr>\n              <td>${esc(e.timestamp)}</td>\n              <td>${esc(e.kind ?? e.type ?? "")}</td>\n              <td>${fmt(e.hedge_total ?? e.current,4)}</td>\n              <td>${signed(e.hedge_change ?? e.change,4)}</td>\n              <td>${fmt(e.delta,5)}</td>\n              <td>${fmt(e.points_out,3)}</td>\n              <td>${fmt(e.points_allowed,3)}</td>\n              <td>${fmt(e.synthetic_future ?? e.spot,2)}</td>\n              <td>${fmt(e.actual_future ?? e.future,2)}</td>\n            </tr>\n          `\n        )\n        .join("");\n  }\n\n  function renderHistory(state){\n\n    const tbody =\n      $("proHistoryTable");\n\n    if(!tbody){\n      return;\n    }\n\n    const rows =\n      Array.isArray(state.history)\n        ? state.history\n        : [];\n\n    if(!rows.length){\n\n      tbody.innerHTML =\n        \'<tr><td colspan="9" class="pro-empty">Waiting for minute history</td></tr>\';\n\n      return;\n    }\n\n    tbody.innerHTML =\n      rows\n        .slice()\n        .reverse()\n        .slice(0,60)\n        .map(\n          r => `\n            <tr>\n              <td>${esc(r.timestamp)}</td>\n              <td>${fmt(r.synthetic_future ?? r.spot,2)}</td>\n              <td>${fmt(r.actual_future ?? r.future,2)}</td>\n              <td>${fmt(r.atm,0)}</td>\n              <td>${fmt(r.current_ce ?? r.ce,2)}</td>\n              <td>${fmt(r.current_pe ?? r.pe,2)}</td>\n              <td>${fmt(r.straddle ?? r.current_straddle,2)}</td>\n              <td>${fmt(r.delta,5)}</td>\n              <td class="${pnlClass(r.total_pnl ?? r.total)}">\n                ${signed(r.total_pnl ?? r.total,2)}\n              </td>\n            </tr>\n          `\n        )\n        .join("");\n  }\n\n  function render(state){\n\n    if(!state){\n      return;\n    }\n\n    const market =\n      state.market || {};\n\n    const entry =\n      state.entry || {};\n\n    const position =\n      state.position || {};\n\n    const greeks =\n      state.greeks || {};\n\n    const hedge =\n      state.hedge || {};\n\n    const pnl =\n      state.pnl || {};\n\n    const exit =\n      state.exit || {};\n\n    setText(\n      "proRunId",\n      state.run_id\n    );\n\n    setText(\n      "proSyntheticSpot",\n      fmt(\n        market.synthetic_future ??\n        market.spot\n      )\n    );\n\n    setText(\n      "proActualFuture",\n      fmt(\n        market.actual_future ??\n        market.future\n      )\n    );\n\n    setText(\n      "proATM",\n      fmt(market.atm,0)\n    );\n\n    setText(\n      "proExpiry",\n      "Expiry " +\n      (entry.expiry ?? "--")\n    );\n\n    setText(\n      "proCurrentStraddle",\n      fmt(\n        position.current_straddle\n      )\n    );\n\n    setText(\n      "proEntryStraddle",\n      "Entry " +\n      fmt(entry.straddle)\n    );\n\n    setText(\n      "proEntryCE",\n      fmt(entry.ce_price)\n    );\n\n    setText(\n      "proEntryPE",\n      fmt(entry.pe_price)\n    );\n\n    setText(\n      "proEntryStraddle2",\n      fmt(entry.straddle)\n    );\n\n    setText(\n      "proCurrentCE",\n      fmt(position.current_ce)\n    );\n\n    setText(\n      "proCurrentPE",\n      fmt(position.current_pe)\n    );\n\n    setText(\n      "proQuoteSource",\n      entry.quote_source\n    );\n\n    setPnl(\n      "proOptionPnl",\n      pnl.option\n    );\n\n    setPnl(\n      "proFuturePnl",\n      pnl.future\n    );\n\n    setPnl(\n      "proTotalPnl",\n      pnl.total\n    );\n\n    setText(\n      "proDelta",\n      fmt(greeks.delta,6)\n    );\n\n    setText(\n      "proGamma",\n      fmt(greeks.gamma,7)\n    );\n\n    setText(\n      "proTheta",\n      fmt(greeks.theta,4)\n    );\n\n    setText(\n      "proVega",\n      fmt(greeks.vega,4)\n    );\n\n    setText(\n      "proHedge",\n      fmt(hedge.current,4)\n    );\n\n    setText(\n      "proPointsOut",\n      fmt(hedge.points_out,3)\n    );\n\n    setText(\n      "proPointsAllowed",\n      fmt(hedge.points_allowed,3)\n    );\n\n    setText(\n      "proExitReason",\n      exit.reason ??\n      (\n        state.completed\n          ? "COMPLETED"\n          : state.started\n            ? "RUNNING"\n            : "WAITING"\n      )\n    );\n\n    setText(\n      "proEntryTime",\n      entry.timestamp\n    );\n\n    const runState =\n      $("proRunState");\n\n    if(runState){\n\n      runState.textContent =\n        state.completed\n          ? "COMPLETED"\n          : state.started\n            ? "RUNNING"\n            : state.armed\n              ? "ARMED"\n              : "WAITING";\n    }\n\n    setText(\n      "proEntryStatus",\n      entry.timestamp\n        ? "ENTRY " + entry.timestamp\n        : "NO ENTRY"\n    );\n\n    setText(\n      "proRunClock",\n      state.start_timestamp\n        ? "START " + state.start_timestamp\n        : "--"\n    );\n\n    drawChart(state);\n    renderHedgeEvents(state);\n    renderHistory(state);\n  }\n\n  async function fetchState(){\n\n    try{\n\n      const response =\n        await fetch(\n          "/api/runs/"\n          +\n          activeRun\n          +\n          "?ts="\n          +\n          Date.now(),\n          {\n            cache:"no-store"\n          }\n        );\n\n      if(!response.ok){\n        throw new Error(\n          "HTTP " + response.status\n        );\n      }\n\n      const state =\n        await response.json();\n\n      render(state);\n\n      const live =\n        $("proLiveStatus");\n\n      if(live){\n        live.textContent =\n          state.completed\n            ? "COMPLETED"\n            : "LIVE";\n      }\n\n    }catch(error){\n\n      const live =\n        $("proLiveStatus");\n\n      if(live){\n        live.textContent = "RECONNECTING";\n      }\n\n      console.error(\n        "[PRO SIM UI]",\n        error\n      );\n    }\n  }\n\n  async function startNow(){\n\n    try{\n\n      const response =\n        await fetch(\n          "/api/runs/NOW/start?ts="\n          +\n          Date.now(),\n          {\n            cache:"no-store"\n          }\n        );\n\n      const data =\n        await response.json();\n\n      if(!response.ok){\n        throw new Error(\n          data.error ||\n          "Unable to arm NOW"\n        );\n      }\n\n      persistActiveRun("NOW");\n      updateTabState();\n\n      await fetchState();\n\n    }catch(error){\n\n      console.error(\n        "[START NOW]",\n        error\n      );\n\n      alert(\n        "Unable to start NOW simulation: "\n        +\n        error.message\n      );\n    }\n  }\n\n  function updateTabState(){\n\n    document\n      .querySelectorAll(\n        ".pro-sim-tab"\n      )\n      .forEach(\n        button => {\n\n          button.classList.toggle(\n            "active",\n            button.dataset.run === activeRun\n          );\n        }\n      );\n  }\n\n  function install(){\n\n    document\n      .querySelectorAll(\n        ".pro-sim-tab"\n      )\n      .forEach(\n        button => {\n\n          button.addEventListener(\n            "click",\n            () => {\n\n              const run =\n                button.dataset.run;\n\n              if(run === "NOW"){\n\n                startNow();\n                return;\n              }\n\n              persistActiveRun(run);\n              updateTabState();\n              fetchState();\n            }\n          );\n        }\n      );\n\n    window.addEventListener(\n      "resize",\n      () => drawChart(\n        window.__PRO_LAST_STATE ||\n        {}\n      )\n    );\n\n    // Keep a copy for resize redraws.\n    const originalRender = render;\n\n    window.__PRO_RENDER = function(state){\n\n      window.__PRO_LAST_STATE = state;\n      originalRender(state);\n\n    };\n\n    fetchState();\n\n    if(timer){\n      clearInterval(timer);\n    }\n\n    timer =\n      setInterval(\n        fetchState,\n        1000\n      );\n  }\n\n  /*\n   * Replace render with state-caching wrapper.\n   */\n  window.__PRO_LAST_STATE = null;\n\n  if(\n    document.readyState === "loading"\n  ){\n    document.addEventListener(\n      "DOMContentLoaded",\n      install,\n      {\n        once:true\n      }\n    );\n  }else{\n    install();\n  }\n\n})();\n</script>\n\n\n<script id="compactFinalLayout">\n(function(){\n\n  function arrange(){\n\n    const root =\n      document.getElementById("proSimRoot");\n\n    if(!root){\n      return;\n    }\n\n    const shell =\n      root.querySelector(".pro-sim-shell");\n\n    const sections =\n      [...root.querySelectorAll(".pro-table-wrap")];\n\n    let hedge = null;\n    let history = null;\n\n    sections.forEach(section => {\n\n      const head =\n        section.querySelector(".pro-section-head");\n\n      const text =\n        head\n          ? head.textContent.trim().toLowerCase()\n          : "";\n\n      if(text === "hedge events"){\n        hedge = section;\n      }\n\n      if(text === "minute history"){\n        history = section;\n      }\n\n    });\n\n    const firstTwo =\n      root.querySelector(".pro-two");\n\n    if(\n      hedge &&\n      firstTwo &&\n      shell\n    ){\n      shell.insertBefore(\n        hedge,\n        firstTwo\n      );\n\n      hedge.id =\n        "proHedgeEventsSection";\n    }\n\n    const chart =\n      root.querySelector(".pro-chart-wrap");\n\n    if(chart){\n      chart.remove();\n    }\n\n    /*\n     * Remove the old independent-run visual controls.\n     * The compact pro panel owns the tabs.\n     */\n    document\n      .querySelectorAll(\n        "#fiveSimulationRunTabs,#fiveRunLabel"\n      )\n      .forEach(node => {\n\n        const parent =\n          node.closest(\n            ".card,.panel,section"\n          ) ||\n          node.parentElement;\n\n        if(parent){\n          parent.style.display =\n            "none";\n        }\n\n      });\n  }\n\n  if(\n    document.readyState === "loading"\n  ){\n    document.addEventListener(\n      "DOMContentLoaded",\n      arrange,\n      {once:true}\n    );\n  }else{\n    arrange();\n  }\n\n})();\n</script>\n\n<script id="finalPnlChartJS">\n(function(){\n\n    function installPnlChart(){\n\n        const root =\n            document.getElementById("proSimRoot");\n\n        if(!root){\n            return;\n        }\n\n        if(\n            document.getElementById(\n                "proPnlHistoryChartSection"\n            )\n        ){\n            return;\n        }\n\n        /*\n         * Find the existing 1-MINUTE HISTORY section.\n         * The P&L chart goes directly before it.\n         */\n        const tableSections =\n            Array.from(\n                root.querySelectorAll(\n                    ".pro-table-wrap"\n                )\n            );\n\n        const minuteHistory =\n            tableSections.find(\n                section => {\n\n                    const head =\n                        section.querySelector(\n                            ".pro-section-head"\n                        );\n\n                    return (\n                        head &&\n                        head.textContent\n                            .trim()\n                            .toLowerCase()\n                            === "minute history"\n                    );\n                }\n            );\n\n        if(!minuteHistory){\n            return;\n        }\n\n        const chart =\n            document.createElement("div");\n\n        chart.id =\n            "proPnlHistoryChartSection";\n\n        chart.innerHTML = `\n            <div class="pro-chart-title">\n                P&L HISTORY · 1-MINUTE SNAPSHOTS\n            </div>\n\n            <div id="proPnlHistoryCanvasWrap">\n                <canvas\n                    id="proPnlHistoryCanvas"\n                ></canvas>\n            </div>\n        `;\n\n        minuteHistory.parentNode.insertBefore(\n            chart,\n            minuteHistory\n        );\n\n        console.log(\n            "[PRO UI] P&L chart installed"\n        );\n    }\n\n\n    function drawPnlChart(history){\n\n        const canvas =\n            document.getElementById(\n                "proPnlHistoryCanvas"\n            );\n\n        if(!canvas){\n            return;\n        }\n\n        const rect =\n            canvas.getBoundingClientRect();\n\n        const dpr =\n            window.devicePixelRatio || 1;\n\n        const width =\n            Math.max(\n                1,\n                Math.floor(\n                    rect.width * dpr\n                )\n            );\n\n        const height =\n            Math.max(\n                1,\n                Math.floor(\n                    rect.height * dpr\n                )\n            );\n\n        canvas.width = width;\n        canvas.height = height;\n\n        const ctx =\n            canvas.getContext("2d");\n\n        ctx.setTransform(\n            dpr,\n            0,\n            0,\n            dpr,\n            0,\n            0\n        );\n\n        const w =\n            rect.width;\n\n        const h =\n            rect.height;\n\n        ctx.clearRect(\n            0,\n            0,\n            w,\n            h\n        );\n\n        if(\n            !Array.isArray(history)\n            ||\n            history.length < 2\n        ){\n\n            ctx.fillStyle =\n                "#8ea2b8";\n\n            ctx.font =\n                "10px system-ui";\n\n            ctx.fillText(\n                "Waiting for P&L history...",\n                10,\n                20\n            );\n\n            return;\n        }\n\n        const values =\n            history\n                .map(\n                    row =>\n                        Number(\n                            row.total_pnl ??\n                            row.total ??\n                            0\n                        )\n                )\n                .filter(\n                    Number.isFinite\n                );\n\n        if(values.length < 2){\n            return;\n        }\n\n        const min =\n            Math.min(...values);\n\n        const max =\n            Math.max(...values);\n\n        /*\n         * Keep a visible zero line whenever the range\n         * crosses zero.\n         */\n        const low =\n            Math.min(\n                min,\n                0\n            );\n\n        const high =\n            Math.max(\n                max,\n                0\n            );\n\n        const range =\n            Math.max(\n                high - low,\n                0.000001\n            );\n\n        const padX = 10;\n        const padY = 12;\n\n        /*\n         * Grid / zero line.\n         */\n        const zeroY =\n            h -\n            padY -\n            (\n                (0 - low)\n                / range\n            )\n            *\n            (\n                h - 2 * padY\n            );\n\n        ctx.strokeStyle =\n            "#20344a";\n\n        ctx.lineWidth = 1;\n\n        ctx.beginPath();\n\n        ctx.moveTo(\n            padX,\n            zeroY\n        );\n\n        ctx.lineTo(\n            w - padX,\n            zeroY\n        );\n\n        ctx.stroke();\n\n        /*\n         * P&L line.\n         */\n        ctx.strokeStyle =\n            "#35d07f";\n\n        ctx.lineWidth = 2;\n\n        ctx.beginPath();\n\n        values.forEach(\n            (value, index) => {\n\n                const x =\n                    padX\n                    +\n                    (\n                        index\n                        /\n                        Math.max(\n                            values.length - 1,\n                            1\n                        )\n                    )\n                    *\n                    (\n                        w - 2 * padX\n                    );\n\n                const y =\n                    h -\n                    padY\n                    -\n                    (\n                        (value - low)\n                        /\n                        range\n                    )\n                    *\n                    (\n                        h - 2 * padY\n                    );\n\n                if(index === 0){\n                    ctx.moveTo(\n                        x,\n                        y\n                    );\n                }else{\n                    ctx.lineTo(\n                        x,\n                        y\n                    );\n                }\n\n            }\n        );\n\n        ctx.stroke();\n\n        /*\n         * Last-value marker.\n         */\n        const last =\n            values[values.length - 1];\n\n        const lastX =\n            w - padX;\n\n        const lastY =\n            h -\n            padY\n            -\n            (\n                (last - low)\n                /\n                range\n            )\n            *\n            (\n                h - 2 * padY\n            );\n\n        ctx.fillStyle =\n            "#35d07f";\n\n        ctx.beginPath();\n\n        ctx.arc(\n            lastX,\n            lastY,\n            3,\n            0,\n            Math.PI * 2\n        );\n\n        ctx.fill();\n\n        /*\n         * Labels.\n         */\n        ctx.fillStyle =\n            "#8ea2b8";\n\n        ctx.font =\n            "9px system-ui";\n\n        ctx.fillText(\n            "Max " + max.toFixed(2),\n            10,\n            10\n        );\n\n        ctx.fillText(\n            "Min " + min.toFixed(2),\n            10,\n            h - 2\n        );\n\n        ctx.textAlign = "right";\n\n        ctx.fillText(\n            "Current " + last.toFixed(2),\n            w - 10,\n            10\n        );\n\n        ctx.textAlign = "left";\n    }\n\n\n    window.__PRO_DRAW_PNL_CHART =\n        drawPnlChart;\n\n\n    /*\n     * We hook into the existing pro UI render.\n     * The existing render function already receives the\n     * complete Simulation state.\n     */\n    function hookRender(){\n\n        if(\n            typeof window.__PRO_RENDER\n            !== "function"\n        ){\n            return;\n        }\n\n        if(\n            window.__PRO_PNL_HOOKED\n        ){\n            return;\n        }\n\n        const original =\n            window.__PRO_RENDER;\n\n        window.__PRO_RENDER =\n            function(state){\n\n                original(state);\n\n                if(state){\n\n                    drawPnlChart(\n                        Array.isArray(\n                            state.history\n                        )\n                            ? state.history\n                            : []\n                    );\n                }\n\n            };\n\n        window.__PRO_PNL_HOOKED =\n            true;\n    }\n\n\n    function boot(){\n\n        installPnlChart();\n\n        /*\n         * Existing professional UI may already have\n         * created its render wrapper. Try repeatedly for\n         * a short period rather than changing the engine.\n         */\n        hookRender();\n\n        let attempts = 0;\n\n        const timer =\n            setInterval(\n                () => {\n\n                    installPnlChart();\n                    hookRender();\n\n                    attempts++;\n\n                    if(\n                        attempts > 30\n                    ){\n                        clearInterval(timer);\n                    }\n\n                },\n                200\n            );\n    }\n\n\n    if(\n        document.readyState\n        === "loading"\n    ){\n        document.addEventListener(\n            "DOMContentLoaded",\n            boot,\n            {once:true}\n        );\n    }else{\n        boot();\n    }\n\n\n    window.addEventListener(\n        "resize",\n        () => {\n\n            const last =\n                window.__PRO_LAST_STATE;\n\n            if(last){\n                drawPnlChart(\n                    Array.isArray(\n                        last.history\n                    )\n                        ? last.history\n                        : []\n                );\n            }\n\n        }\n    );\n\n})();\n</script>\n\n\n<script id="perRunAutomaticDashboardJS">\n(function(){\n\n    const RUNS = [\n        "0916",\n        "0917",\n        "0918",\n        "0919",\n        "NOW"\n    ];\n\n    let activeRun = "0916";\n\n    const cache = {};\n\n    let polling = false;\n\n    /*\n     * UI rendering is MINUTE SNAPSHOT based.\n     *\n     * The browser may poll every second, but it does NOT\n     * rebuild the dashboard every second.\n     */\n    const renderedKeys = {};\n\n    function renderKey(state){\n\n        if(!state){\n            return "";\n        }\n\n        const history =\n            Array.isArray(\n                state.history\n            )\n                ? state.history\n                : [];\n\n        const chartSection =\n            el(\n                "autoPnlChartSection"\n            );\n\n        /*\n         * Chart policy:\n         *\n         * 09:16/09:17/09:18/09:19:\n         *     show only after that run actually starts.\n         *\n         * NOW:\n         *     do not show before START NOW.\n         *     after the scheduled start, show the chart\n         *     and build it only from NOW\'s own minute history.\n         */\n        if(chartSection){\n\n            const shouldShowChart =\n                !!state.started\n                &&\n                (\n                    state.run_id !== "NOW"\n                    ||\n                    !!state.request_timestamp\n                );\n\n            if(shouldShowChart){\n\n                chartSection.classList.add(\n                    "show-pnl-chart"\n                );\n\n                chartSection.classList.remove(\n                    "hide-pnl-chart"\n                );\n\n            }else{\n\n                chartSection.classList.remove(\n                    "show-pnl-chart"\n                );\n\n                chartSection.classList.add(\n                    "hide-pnl-chart"\n                );\n            }\n        }\n\n        const latest =\n            history.length\n                ? history[\n                    history.length - 1\n                ]\n                : null;\n\n        const latestMinute =\n            latest\n            &&\n            latest.timestamp\n                ? latest.timestamp\n                : "";\n\n        return [\n            state.run_id || "",\n            state.request_timestamp || "",\n            state.started ? "1" : "0",\n            state.completed ? "1" : "0",\n            state.exit_reason || "",\n            latestMinute,\n        ].join("|");\n    }\n\n    function el(id){\n        return document.getElementById(id);\n    }\n\n    function num(value){\n        const n = Number(value);\n\n        return Number.isFinite(n)\n            ? n\n            : null;\n    }\n\n    function fmt(\n        value,\n        digits=2\n    ){\n        const n = num(value);\n\n        if(n === null){\n            return "--";\n        }\n\n        return n.toLocaleString(\n            undefined,\n            {\n                minimumFractionDigits:digits,\n                maximumFractionDigits:digits\n            }\n        );\n    }\n\n    function signed(\n        value,\n        digits=2\n    ){\n        const n = num(value);\n\n        if(n === null){\n            return "--";\n        }\n\n        return (\n            n >= 0\n                ? "+"\n                : ""\n        )\n        +\n        fmt(\n            n,\n            digits\n        );\n    }\n\n    function text(\n        id,\n        value\n    ){\n        const node = el(id);\n\n        if(node){\n            node.textContent =\n                value === null\n                ||\n                value === undefined\n                ||\n                value === ""\n                    ? "--"\n                    : value;\n        }\n    }\n\n    function pnlClass(value){\n\n        const n = num(value);\n\n        if(n === null){\n            return "pro-neutral";\n        }\n\n        if(n > 0){\n            return "pro-positive";\n        }\n\n        if(n < 0){\n            return "pro-negative";\n        }\n\n        return "pro-neutral";\n    }\n\n    function setPnl(\n        id,\n        value\n    ){\n\n        const node = el(id);\n\n        if(!node){\n            return;\n        }\n\n        node.textContent =\n            signed(\n                value,\n                2\n            );\n\n        node.className =\n            "pro-pnl-value "\n            +\n            pnlClass(\n                value\n            );\n    }\n\n\n    // ========================================================\n    // ENSURE P&L CHART EXISTS IN THE CORRECT POSITION\n    // ========================================================\n\n    function ensureChart(){\n\n        if(\n            el(\n                "autoPnlChartSection"\n            )\n        ){\n            return;\n        }\n\n        const root =\n            el("proSimRoot");\n\n        if(!root){\n            return;\n        }\n\n        const historySections =\n            Array.from(\n                root.querySelectorAll(\n                    ".pro-table-wrap"\n                )\n            );\n\n        const minuteHistory =\n            historySections.find(\n                section => {\n\n                    const head =\n                        section.querySelector(\n                            ".pro-section-head"\n                        );\n\n                    return (\n                        head\n                        &&\n                        head.textContent\n                            .trim()\n                            .toLowerCase()\n                            ===\n                            "minute history"\n                    );\n                }\n            );\n\n        if(!minuteHistory){\n            return;\n        }\n\n        const section =\n            document.createElement(\n                "div"\n            );\n\n        section.id =\n            "autoPnlChartSection";\n\n        section.innerHTML = `\n            <div id="autoPnlChartHeader">\n                <div id="autoPnlChartTitle">\n                    P&L HISTORY · 1-MINUTE SNAPSHOTS\n                </div>\n\n                <div id="autoPnlChartStatus">\n                    --\n                </div>\n            </div>\n\n            <div id="autoPnlChartWrap">\n                <canvas\n                    id="autoPnlChart"\n                ></canvas>\n            </div>\n        `;\n\n        /* P&L chart MUST sit directly above minute history. */\n        minuteHistory.parentNode.insertBefore(\n            section,\n            minuteHistory\n        );\n    }\n\n\n    // ========================================================\n    // ACTIVE TAB\n    // ========================================================\n\n    function activateTab(\n        runId\n    ){\n\n        activeRun =\n            RUNS.includes(runId)\n                ? runId\n                : "0916";\n\n        document\n            .querySelectorAll(\n                "#proSimRoot .pro-sim-tab"\n            )\n            .forEach(\n                button => {\n\n                    button.classList.toggle(\n                        "active",\n                        button.dataset.run\n                        ===\n                        activeRun\n                    );\n\n                }\n            );\n    }\n\n\n    // ========================================================\n    // NOW BUTTON\n    // ========================================================\n\n    function updateNowButton(\n        state\n    ){\n\n        const button =\n            document.getElementById(\n                "proStartNowButton"\n            );\n\n        if(!button){\n            return;\n        }\n\n        const requested =\n            !!state?.request_timestamp;\n\n        const scheduled =\n            !!state?.scheduled_start;\n\n        const running =\n            !!state?.started\n            &&\n            !state?.completed;\n\n        const completed =\n            !!state?.completed;\n\n        if(\n            requested\n            &&\n            !running\n            &&\n            !completed\n        ){\n\n            button.disabled =\n                true;\n\n            button.dataset.nowState =\n                "scheduled";\n\n            button.textContent =\n                state.scheduled_start\n                    ? (\n                        "NOW · START "\n                        +\n                        new Date(\n                            state.scheduled_start\n                        ).toLocaleTimeString(\n                            [],\n                            {\n                                hour:"2-digit",\n                                minute:"2-digit",\n                                second:"2-digit",\n                                hour12:false\n                            }\n                        )\n                    )\n                    : "NOW · SCHEDULED";\n\n            return;\n        }\n\n\n        if(running){\n\n            button.disabled =\n                true;\n\n            button.dataset.nowState =\n                "running";\n\n            button.textContent =\n                "NOW · LIVE";\n\n            return;\n        }\n\n\n        if(completed){\n\n            button.disabled =\n                false;\n\n            button.dataset.nowState =\n                "completed";\n\n            button.textContent =\n                "START NOW";\n\n            return;\n        }\n\n\n        button.disabled =\n            false;\n\n        button.dataset.nowState =\n            "";\n\n        button.textContent =\n            "START NOW";\n    }\n\n\n    // ========================================================\n    // RENDER ACTIVE RUN\n    // ========================================================\n\n    function renderRun(\n        state\n    ){\n\n        if(!state){\n            return;\n        }\n\n        ensureChart();\n\n        activateTab(\n            state.run_id\n        );\n\n        const market =\n            state.market || {};\n\n        const entry =\n            state.entry || {};\n\n        const position =\n            state.position || {};\n\n        const greeks =\n            state.greeks || {};\n\n        const hedge =\n            state.hedge || {};\n\n        const pnl =\n            state.pnl || {};\n\n        const exit =\n            state.exit || {};\n\n        const history =\n            Array.isArray(\n                state.history\n            )\n                ? state.history\n                : [];\n\n\n        // ----------------------------------------------------\n        // RUN STATUS\n        // ----------------------------------------------------\n\n        let statusText =\n            "WAITING — "\n            + state.run_id;\n\n        if(\n            state.completed\n        ){\n\n            statusText =\n                "COMPLETED — "\n                +\n                state.run_id;\n\n        }else if(\n            state.started\n        ){\n\n            statusText =\n                "LIVE — "\n                +\n                state.run_id;\n\n        }else if(\n            state.request_timestamp\n        ){\n\n            statusText =\n                "SCHEDULED — "\n                +\n                state.run_id;\n\n        }\n\n        text(\n            "proRunState",\n            statusText\n        );\n\n\n        // Keep requested/scheduled timestamps visible\n        // in the compact status row.\n\n        if(\n            state.run_id === "NOW"\n        ){\n\n            let clockText =\n                "";\n\n            if(\n                state.request_timestamp\n            ){\n\n                clockText =\n                    "REQ "\n                    +\n                    state.request_timestamp\n                        .split("T")[1]\n                        .split("+")[0];\n\n            }\n\n            if(\n                state.scheduled_start\n            ){\n\n                clockText +=\n                    "  START "\n                    +\n                    state.scheduled_start\n                        .split("T")[1]\n                        .split("+")[0];\n\n            }\n\n            text(\n                "proRunClock",\n                clockText || "--"\n            );\n\n        }else{\n\n            text(\n                "proRunClock",\n                state.start_timestamp\n                    ? (\n                        "START "\n                        +\n                        state.start_timestamp\n                            .split("T")[1]\n                            .split("+")[0]\n                    )\n                    : "--"\n            );\n\n        }\n\n\n        text(\n            "proEntryStatus",\n            entry.timestamp\n                ? (\n                    "ENTRY "\n                    +\n                    entry.timestamp\n                        .split("T")[1]\n                        .split("+")[0]\n                )\n                : "NO ENTRY"\n        );\n\n\n        // ----------------------------------------------------\n        // MARKET\n        // ----------------------------------------------------\n\n        text(\n            "proSyntheticSpot",\n            fmt(\n                market.synthetic_future\n                ??\n                market.spot\n            )\n        );\n\n        text(\n            "proActualFuture",\n            fmt(\n                market.actual_future\n                ??\n                market.future\n            )\n        );\n\n        text(\n            "proATM",\n            fmt(\n                market.atm,\n                0\n            )\n        );\n\n        text(\n            "proExpiry",\n            entry.expiry\n                ? "Expiry "\n                  + entry.expiry\n                : "Expiry --"\n        );\n\n        text(\n            "proCurrentStraddle",\n            fmt(\n                position.current_straddle\n            )\n        );\n\n        text(\n            "proEntryStraddle",\n            "Entry "\n            +\n            fmt(\n                entry.straddle\n            )\n        );\n\n\n        // ----------------------------------------------------\n        // TRADE\n        // ----------------------------------------------------\n\n        text(\n            "proEntryCE",\n            fmt(\n                entry.ce_price\n            )\n        );\n\n        text(\n            "proEntryPE",\n            fmt(\n                entry.pe_price\n            )\n        );\n\n        text(\n            "proEntryStraddle2",\n            fmt(\n                entry.straddle\n            )\n        );\n\n        text(\n            "proCurrentCE",\n            fmt(\n                position.current_ce\n            )\n        );\n\n        text(\n            "proCurrentPE",\n            fmt(\n                position.current_pe\n            )\n        );\n\n        text(\n            "proQuoteSource",\n            entry.quote_source\n        );\n\n\n        // ----------------------------------------------------\n        // P&L\n        // ----------------------------------------------------\n\n        setPnl(\n            "proOptionPnl",\n            pnl.option\n        );\n\n        setPnl(\n            "proFuturePnl",\n            pnl.future\n        );\n\n        setPnl(\n            "proTotalPnl",\n            pnl.total\n        );\n\n\n        // ----------------------------------------------------\n        // GREEKS\n        // ----------------------------------------------------\n\n        text(\n            "proDelta",\n            fmt(\n                greeks.delta,\n                6\n            )\n        );\n\n        text(\n            "proGamma",\n            fmt(\n                greeks.gamma,\n                7\n            )\n        );\n\n        text(\n            "proTheta",\n            fmt(\n                greeks.theta,\n                4\n            )\n        );\n\n        text(\n            "proVega",\n            fmt(\n                greeks.vega,\n                4\n            )\n        );\n\n\n        // ----------------------------------------------------\n        // HEDGE / RISK\n        // ----------------------------------------------------\n\n        text(\n            "proHedge",\n            fmt(\n                hedge.current,\n                4\n            )\n        );\n\n        text(\n            "proPointsOut",\n            fmt(\n                hedge.points_out,\n                3\n            )\n        );\n\n        text(\n            "proPointsAllowed",\n            fmt(\n                hedge.points_allowed,\n                3\n            )\n        );\n\n        text(\n            "proExitReason",\n            exit.reason\n            ||\n            (\n                state.completed\n                    ? "COMPLETED"\n                    : state.started\n                        ? "RUNNING"\n                        : "WAITING"\n            )\n        );\n\n        text(\n            "proEntryTime",\n            entry.timestamp\n                ? entry.timestamp\n                    .split("T")[1]\n                    .split("+")[0]\n                : "--"\n        );\n\n        text(\n            "proRunId",\n            state.run_id\n        );\n\n\n        // ----------------------------------------------------\n        // HEDGE EVENTS\n        // ----------------------------------------------------\n\n        renderHedgeEvents(\n            state\n        );\n\n\n        // ----------------------------------------------------\n        // MINUTE HISTORY\n        // ----------------------------------------------------\n\n        renderHistory(\n            state\n        );\n\n\n        // ----------------------------------------------------\n        // P&L CHART\n        // ----------------------------------------------------\n\n        drawPnlHistory(\n            history,\n            state\n        );\n\n\n        // ----------------------------------------------------\n        // NOW BUTTON\n        // ----------------------------------------------------\n\n        if(\n            state.run_id === "NOW"\n        ){\n\n            updateNowButton(\n                state\n            );\n\n        }\n\n    }\n\n\n    // ========================================================\n    // HEDGE EVENTS TABLE\n    // ========================================================\n\n\n    function renderHedgeEvents(state){\n        /*\n         * Deliberately disabled in the UI.\n         *\n         * Hedge events remain available inside the simulation\n         * engine, but the dashboard is minute-snapshot only.\n         */\n        return;\n    }\n\n\n    // ========================================================\n    // MINUTE HISTORY TABLE\n\n    // ========================================================\n\n    function renderHistory(\n        state\n    ){\n\n        const tbody =\n            el(\n                "proHistoryTable"\n            );\n\n        if(!tbody){\n            return;\n        }\n\n        const rows =\n            Array.isArray(\n                state.history\n            )\n                ? state.history\n                : [];\n\n        if(!rows.length){\n\n            tbody.innerHTML =\n                `\n                <tr>\n                    <td\n                        colspan="9"\n                        class="pro-empty"\n                    >\n                        No minute snapshot yet\n                    </td>\n                </tr>\n                `;\n\n            return;\n        }\n\n        tbody.innerHTML =\n            rows\n                .slice()\n                .reverse()\n                .map(\n                    row => `\n                    <tr>\n\n                        <td>\n                            ${(row.timestamp || "")\n                                .split("T")[1]\n                                ?.split("+")[0]\n                                || "--"}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.synthetic_future ??\n                                row.spot,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.actual_future ??\n                                row.future,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.atm,\n                                0\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.current_ce ??\n                                row.ce,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.current_pe ??\n                                row.pe,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.straddle ??\n                                row.current_straddle,\n                                2\n                            )}\n                        </td>\n\n                        <td>\n                            ${fmt(\n                                row.delta,\n                                5\n                            )}\n                        </td>\n\n                        <td class="${pnlClass(\n                            row.total_pnl ??\n                            row.total\n                        )}">\n                            ${signed(\n                                row.total_pnl ??\n                                row.total,\n                                2\n                            )}\n                        </td>\n\n                    </tr>\n                    `\n                )\n                .join("");\n    }\n\n\n    // ========================================================\n    // P&L HISTORY · 1-MINUTE SNAPSHOTS LINE CHART\n    //\n    // One point per history record.\n    // The existing simulator history is minute-based.\n    // ========================================================\n\n    function drawPnlHistory(\n        history,\n        state\n    ){\n\n        ensureChart();\n\n        const canvas =\n            el(\n                "autoPnlChart"\n            );\n\n        const section =\n            el(\n                "autoPnlChartSection"\n            );\n\n        const status =\n            el(\n                "autoPnlChartStatus"\n            );\n\n        if(\n            !canvas\n            ||\n            !section\n        ){\n            return;\n        }\n\n        if(status){\n\n            status.textContent =\n                state.run_id\n                +\n                " · "\n                +\n                history.length\n                +\n                " minute point"\n                +\n                (\n                    history.length === 1\n                        ? ""\n                        : "s"\n                );\n\n        }\n\n        const rect =\n            canvas.getBoundingClientRect();\n\n        const dpr =\n            window.devicePixelRatio || 1;\n\n        const width =\n            Math.max(\n                1,\n                Math.floor(\n                    rect.width * dpr\n                )\n            );\n\n        const height =\n            Math.max(\n                1,\n                Math.floor(\n                    rect.height * dpr\n                )\n            );\n\n        canvas.width =\n            width;\n\n        canvas.height =\n            height;\n\n        const ctx =\n            canvas.getContext(\n                "2d"\n            );\n\n        ctx.setTransform(\n            dpr,\n            0,\n            0,\n            dpr,\n            0,\n            0\n        );\n\n        const w =\n            rect.width;\n\n        const h =\n            rect.height;\n\n        ctx.clearRect(\n            0,\n            0,\n            w,\n            h\n        );\n\n        /*\n         * No data => genuinely blank chart.\n         */\n        if(\n            !Array.isArray(history)\n            ||\n            history.length === 0\n        ){\n\n            section.classList.add(\n                "blank-history"\n            );\n\n            return;\n        }\n\n        section.classList.remove(\n            "blank-history"\n        );\n\n        const points =\n            history\n                .map(\n                    row => ({\n                        value:\n                            num(\n                                row.total_pnl ??\n                                row.total\n                            ),\n\n                        time:\n                            row.timestamp\n                    })\n                )\n                .filter(\n                    point =>\n                        point.value !== null\n                );\n\n        if(!points.length){\n            return;\n        }\n\n        const values =\n            points.map(\n                point =>\n                    point.value\n            );\n\n        const min =\n            Math.min(\n                ...values,\n                0\n            );\n\n        const max =\n            Math.max(\n                ...values,\n                0\n            );\n\n        const range =\n            Math.max(\n                max - min,\n                0.000001\n            );\n\n        const left = 38;\n        const right = 12;\n        const top = 12;\n        const bottom = 22;\n\n        /*\n         * Horizontal zero line.\n         */\n        const zeroY =\n            h\n            -\n            bottom\n            -\n            (\n                (0 - min)\n                /\n                range\n            )\n            *\n            (\n                h\n                -\n                top\n                -\n                bottom\n            );\n\n        ctx.strokeStyle =\n            "#24384d";\n\n        ctx.lineWidth = 1;\n\n        ctx.beginPath();\n\n        ctx.moveTo(\n            left,\n            zeroY\n        );\n\n        ctx.lineTo(\n            w - right,\n            zeroY\n        );\n\n        ctx.stroke();\n\n\n        /*\n         * Grid lines.\n         */\n        ctx.strokeStyle =\n            "#122335";\n\n        for(\n            let i=1;\n            i<4;\n            i++\n        ){\n\n            const y =\n                top\n                +\n                i / 4\n                *\n                (\n                    h\n                    -\n                    top\n                    -\n                    bottom\n                );\n\n            ctx.beginPath();\n\n            ctx.moveTo(\n                left,\n                y\n            );\n\n            ctx.lineTo(\n                w-right,\n                y\n            );\n\n            ctx.stroke();\n        }\n\n\n        /*\n         * P&L line.\n         */\n        ctx.strokeStyle =\n            "#35d07f";\n\n        ctx.lineWidth = 2;\n\n        ctx.beginPath();\n\n        points.forEach(\n            (point,index) => {\n\n                const x =\n                    left\n                    +\n                    (\n                        index\n                        /\n                        Math.max(\n                            points.length-1,\n                            1\n                        )\n                    )\n                    *\n                    (\n                        w-left-right\n                    );\n\n                const y =\n                    h\n                    -\n                    bottom\n                    -\n                    (\n                        (point.value - min)\n                        /\n                        range\n                    )\n                    *\n                    (\n                        h-top-bottom\n                    );\n\n                if(index === 0){\n                    ctx.moveTo(\n                        x,\n                        y\n                    );\n                }else{\n                    ctx.lineTo(\n                        x,\n                        y\n                    );\n                }\n\n            }\n        );\n\n        ctx.stroke();\n\n\n        /*\n         * Points.\n         */\n        ctx.fillStyle =\n            "#35d07f";\n\n        points.forEach(\n            (point,index) => {\n\n                const x =\n                    left\n                    +\n                    (\n                        index\n                        /\n                        Math.max(\n                            points.length-1,\n                            1\n                        )\n                    )\n                    *\n                    (\n                        w-left-right\n                    );\n\n                const y =\n                    h\n                    -\n                    bottom\n                    -\n                    (\n                        (point.value - min)\n                        /\n                        range\n                    )\n                    *\n                    (\n                        h-top-bottom\n                    );\n\n                ctx.beginPath();\n\n                ctx.arc(\n                    x,\n                    y,\n                    2.5,\n                    0,\n                    Math.PI*2\n                );\n\n                ctx.fill();\n\n            }\n        );\n\n\n        /*\n         * Current value.\n         */\n        const last =\n            points[\n                points.length-1\n            ];\n\n        ctx.fillStyle =\n            "#e8f0f8";\n\n        ctx.font =\n            "9px system-ui";\n\n        ctx.fillText(\n            "P&L " +\n            signed(\n                last.value,\n                2\n            ),\n            left,\n            10\n        );\n\n\n        /*\n         * Time labels for first/last minute.\n         */\n        ctx.fillStyle =\n            "#8ea2b8";\n\n        ctx.font =\n            "8px system-ui";\n\n        if(\n            points[0].time\n        ){\n\n            ctx.fillText(\n                points[0].time\n                    .split("T")[1]\n                    ?.split("+")[0]\n                    || "",\n                left,\n                h-4\n            );\n\n        }\n\n        if(\n            last.time\n        ){\n\n            ctx.textAlign =\n                "right";\n\n            ctx.fillText(\n                last.time\n                    .split("T")[1]\n                    ?.split("+")[0]\n                    || "",\n                w-right,\n                h-4\n            );\n\n            ctx.textAlign =\n                "left";\n        }\n    }\n\n\n    // ========================================================\n    // FETCH ALL RUNS\n    // ========================================================\n\n    async function fetchAllRuns(){\n\n        if(polling){\n            return;\n        }\n\n        polling = true;\n\n        try{\n\n            const response =\n                await fetch(\n                    "/api/runs?ts="\n                    +\n                    Date.now(),\n                    {\n                        cache:"no-store"\n                    }\n                );\n\n            if(!response.ok){\n                throw new Error(\n                    "HTTP "\n                    +\n                    response.status\n                );\n            }\n\n            const payload =\n                await response.json();\n\n            const runs =\n                payload.runs || {};\n\n            RUNS.forEach(\n                runId => {\n\n                    if(\n                        runs[runId]\n                    ){\n                        cache[runId] =\n                            runs[runId];\n                    }\n\n                }\n            );\n\n            const active =\n                cache[\n                    activeRun\n                ];\n\n            if(active){\n\n                const key =\n                    renderKey(\n                        active\n                    );\n\n                if(\n                    renderedKeys[\n                        activeRun\n                    ] !== key\n                ){\n\n                    renderedKeys[\n                        activeRun\n                    ] = key;\n\n                    renderRun(\n                        active\n                    );\n                }\n            }\n\n        }catch(error){\n\n            console.error(\n                "[PER RUN UI]",\n                error\n            );\n\n        }finally{\n\n            polling = false;\n        }\n    }\n\n\n    // ========================================================\n    // START NOW\n    // ========================================================\n\n    async function requestNow(){\n\n        const current =\n            cache[\n                "NOW"\n            ];\n\n        /*\n         * Backend state is authoritative.\n         */\n        if(\n            current\n            &&\n            !current.completed\n            &&\n            (\n                current.request_timestamp\n                ||\n                current.started\n                ||\n                current.armed\n            )\n        ){\n            activateTab(\n                "NOW"\n            );\n\n            renderRun(\n                current\n            );\n\n            return;\n        }\n\n        try{\n\n            activateTab(\n                "NOW"\n            );\n\n            const response =\n                await fetch(\n                    "/api/runs/NOW/start?ts="\n                    +\n                    Date.now(),\n                    {\n                        cache:"no-store"\n                    }\n                );\n\n            if(!response.ok){\n                throw new Error(\n                    "HTTP "\n                    +\n                    response.status\n                );\n            }\n\n            const state =\n                await response.json();\n\n            cache[\n                "NOW"\n            ] =\n                state.state\n                ||\n                state;\n\n            renderedKeys[\n                "NOW"\n            ] =\n                renderKey(\n                    cache[\n                        "NOW"\n                    ]\n                );\n\n            renderRun(\n                cache[\n                    "NOW"\n                ]\n            );\n\n        }catch(error){\n\n            console.error(\n                "[NOW START]",\n                error\n            );\n\n        }\n\n    }\n\n\n    // ========================================================\n    // INSTALL TAB EVENTS\n    // ========================================================\n\n    function installTabs(){\n\n        const root =\n            el(\n                "proSimRoot"\n            );\n\n        if(!root){\n            return;\n        }\n\n        root\n            .querySelectorAll(\n                ".pro-sim-tab"\n            )\n            .forEach(\n                button => {\n\n                    if(\n                        button.dataset\n                            .autoRunBound\n                    ){\n                        return;\n                    }\n\n                    button.dataset\n                        .autoRunBound =\n                        "1";\n\n                    button.addEventListener(\n                        "click",\n                        event => {\n\n                            const runId =\n                                button.dataset.run;\n\n                            /*\n                             * NOW is a RESULT TAB only.\n                             * It never starts a simulation.\n                             */\n                            activateTab(\n                                runId\n                            );\n\n                            if(\n                                cache[runId]\n                            ){\n\n                                const state =\n                                    cache[runId];\n\n                                renderedKeys[\n                                    runId\n                                ] =\n                                    renderKey(\n                                        state\n                                    );\n\n                                renderRun(\n                                    state\n                                );\n\n                            }\n\n                        },\n                        true\n                    );\n\n                }\n            );\n\n    }\n\n\n\n    function installStartNowButton(){\n\n        const button =\n            document.getElementById(\n                "proStartNowButton"\n            );\n\n        if(\n            !button\n            ||\n            button.dataset.autoRunBound\n        ){\n            return;\n        }\n\n        button.dataset.autoRunBound =\n            "1";\n\n        button.addEventListener(\n            "click",\n            async event => {\n\n                event.preventDefault();\n                event.stopPropagation();\n\n                if(\n                    button.disabled\n                ){\n                    return;\n                }\n\n                await requestNow();\n\n            }\n        );\n    }\n\n\n    // ========================================================\n    // MAIN LOOP\n    // ========================================================\n\n    function boot(){\n\n        ensureChart();\n        installTabs();\n        installStartNowButton();\n\n        fetchAllRuns();\n\n        setInterval(\n            () => {\n\n                installTabs();\n                installStartNowButton();\n                ensureChart();\n                fetchAllRuns();\n\n            },\n            1000\n        );\n\n        window.addEventListener(\n            "resize",\n            () => {\n\n                const state =\n                    cache[\n                        activeRun\n                    ];\n\n                if(state){\n\n                    drawPnlHistory(\n                        Array.isArray(\n                            state.history\n                        )\n                            ? state.history\n                            : [],\n                        state\n                    );\n\n                }\n\n            }\n        );\n\n    }\n\n\n    if(\n        document.readyState\n        ===\n        "loading"\n    ){\n\n        document.addEventListener(\n            "DOMContentLoaded",\n            boot,\n            {once:true}\n        );\n\n    }else{\n\n        boot();\n\n    }\n\n})();\n</script>\n\n\n<script id="removeMinuteHedgeSection">\n(function(){\n\n    function remove(){\n\n        const root =\n            document.getElementById(\n                "proSimRoot"\n            );\n\n        if(!root){\n            return;\n        }\n\n        const sections =\n            root.querySelectorAll(\n                ".pro-table-wrap"\n            );\n\n        sections.forEach(\n            section => {\n\n                const head =\n                    section.querySelector(\n                        ".pro-section-head"\n                    );\n\n                if(!head){\n                    return;\n                }\n\n                const title =\n                    head.textContent\n                        .trim()\n                        .toLowerCase();\n\n                if(\n                    title === "hedge events"\n                    ||\n                    title ===\n                        "hedge events history"\n                ){\n                    section.remove();\n                }\n            }\n        );\n    }\n\n    if(\n        document.readyState === "loading"\n    ){\n        document.addEventListener(\n            "DOMContentLoaded",\n            remove,\n            {once:true}\n        );\n    }else{\n        remove();\n    }\n\n})();\n</script>\n\n\n<script id="nowChartBlankBeforeStart">\n(function(){\n\n    function syncNowChart(){\n\n        const section =\n            document.getElementById(\n                "autoPnlChartSection"\n            );\n\n        if(!section){\n            return;\n        }\n\n        /*\n         * Read the authoritative NOW state.\n         * We do not modify backend state here.\n         */\n        fetch(\n            "/api/runs/NOW?ts="\n            +\n            Date.now(),\n            {\n                cache:"no-store"\n            }\n        )\n        .then(\n            response =>\n                response.ok\n                    ? response.json()\n                    : null\n        )\n        .then(\n            state => {\n\n                if(!state){\n                    return;\n                }\n\n                if(\n                    state.started\n                    &&\n                    state.request_timestamp\n                ){\n\n                    section.classList.add(\n                        "show-pnl-chart"\n                    );\n\n                    section.classList.remove(\n                        "hide-pnl-chart"\n                    );\n\n                }else{\n\n                    section.classList.remove(\n                        "show-pnl-chart"\n                    );\n\n                    section.classList.add(\n                        "hide-pnl-chart"\n                    );\n                }\n            }\n        )\n        .catch(\n            () => {}\n        );\n    }\n\n    setInterval(\n        syncNowChart,\n        1000\n    );\n\n    if(\n        document.readyState === "loading"\n    ){\n\n        document.addEventListener(\n            "DOMContentLoaded",\n            syncNowChart,\n            {once:true}\n        );\n\n    }else{\n\n        syncNowChart();\n\n    }\n\n})();\n</script>\n\n\n<script id="liveSummaryChartRuntime">\n(function(){\n\n    const RUNS = [\n        "0916",\n        "0917",\n        "0918",\n        "0919",\n        "NOW"\n    ];\n\n    let activeRun = "0916";\n\n    const cache = {};\n\n    let chartMinuteKey = "";\n\n    let installed = false;\n\n\n    // ========================================================\n    // UTILITIES\n    // ========================================================\n\n    function el(id){\n        return document.getElementById(id);\n    }\n\n    function finite(v){\n        const n = Number(v);\n\n        return Number.isFinite(n)\n            ? n\n            : null;\n    }\n\n    function fmt(v,d=2){\n\n        const n = finite(v);\n\n        if(n === null){\n            return "--";\n        }\n\n        return n.toLocaleString(\n            undefined,\n            {\n                minimumFractionDigits:d,\n                maximumFractionDigits:d\n            }\n        );\n    }\n\n    function signed(v,d=2){\n\n        const n = finite(v);\n\n        if(n === null){\n            return "--";\n        }\n\n        return (\n            n >= 0\n                ? "+"\n                : ""\n        )\n        + fmt(n,d);\n    }\n\n    function setText(id,value){\n\n        const node = el(id);\n\n        if(node){\n            node.textContent =\n                value === null\n                ||\n                value === undefined\n                ||\n                value === ""\n                    ? "--"\n                    : value;\n        }\n    }\n\n    function pnlClass(v){\n\n        const n = finite(v);\n\n        if(n === null){\n            return "pro-neutral";\n        }\n\n        if(n > 0){\n            return "pro-positive";\n        }\n\n        if(n < 0){\n            return "pro-negative";\n        }\n\n        return "pro-neutral";\n    }\n\n    function setPnl(id,v){\n\n        const node = el(id);\n\n        if(!node){\n            return;\n        }\n\n        node.textContent =\n            signed(v,2);\n\n        node.className =\n            "pro-pnl-value "\n            + pnlClass(v);\n    }\n\n\n    // ========================================================\n    // CREATE ONE REAL CHART\n    // ========================================================\n\n    function ensureChart(){\n\n        if(\n            el("minutePnlChartSection")\n        ){\n            return true;\n        }\n\n        const root =\n            el("proSimRoot");\n\n        if(!root){\n            return false;\n        }\n\n        const tableSections =\n            Array.from(\n                root.querySelectorAll(\n                    ".pro-table-wrap"\n                )\n            );\n\n        const minuteHistory =\n            tableSections.find(\n                section => {\n\n                    const head =\n                        section.querySelector(\n                            ".pro-section-head"\n                        );\n\n                    return (\n                        head\n                        &&\n                        head.textContent\n                            .trim()\n                            .toLowerCase()\n                            .includes(\n                                "minute history"\n                            )\n                    );\n                }\n            );\n\n        if(!minuteHistory){\n            return false;\n        }\n\n        const wrapper =\n            document.createElement(\n                "div"\n            );\n\n        wrapper.id =\n            "minutePnlChartSection";\n\n        wrapper.innerHTML = `\n            <div id="minutePnlChartHeader">\n\n                <div id="minutePnlChartTitle">\n                    P&L HISTORY · 1-MINUTE\n                </div>\n\n                <div id="minutePnlChartMeta">\n                    --\n                </div>\n\n            </div>\n\n            <div id="minutePnlChartWrap">\n\n                <canvas\n                    id="minutePnlChart"\n                ></canvas>\n\n            </div>\n        `;\n\n        /*\n         * Chart ALWAYS sits immediately above\n         * the minute-history table.\n         */\n        minuteHistory.parentNode.insertBefore(\n            wrapper,\n            minuteHistory\n        );\n\n        return true;\n    }\n\n\n    // ========================================================\n    // REAL-TIME SUMMARY\n    //\n    // This updates every 250 ms.\n    // It does NOT rebuild the dashboard.\n    // ========================================================\n\n    function renderLiveSummary(state){\n\n        if(!state){\n            return;\n        }\n\n        const market =\n            state.market || {};\n\n        const entry =\n            state.entry || {};\n\n        const position =\n            state.position || {};\n\n        const greeks =\n            state.greeks || {};\n\n        const hedge =\n            state.hedge || {};\n\n        const pnl =\n            state.pnl || {};\n\n        const exit =\n            state.exit || {};\n\n        // ----------------------------------------------------\n        // MARKET\n        // ----------------------------------------------------\n\n        setText(\n            "proSyntheticSpot",\n            fmt(\n                market.synthetic_future\n                ??\n                market.spot,\n                2\n            )\n        );\n\n        setText(\n            "proActualFuture",\n            fmt(\n                market.actual_future\n                ??\n                market.future,\n                2\n            )\n        );\n\n        setText(\n            "proATM",\n            fmt(\n                market.atm,\n                0\n            )\n        );\n\n        setText(\n            "proCurrentStraddle",\n            fmt(\n                position.current_straddle,\n                2\n            )\n        );\n\n        // ----------------------------------------------------\n        // TRADE\n        // ----------------------------------------------------\n\n        setText(\n            "proEntryCE",\n            fmt(\n                entry.ce_price,\n                2\n            )\n        );\n\n        setText(\n            "proEntryPE",\n            fmt(\n                entry.pe_price,\n                2\n            )\n        );\n\n        setText(\n            "proEntryStraddle2",\n            fmt(\n                entry.straddle,\n                2\n            )\n        );\n\n        setText(\n            "proCurrentCE",\n            fmt(\n                position.current_ce,\n                2\n            )\n        );\n\n        setText(\n            "proCurrentPE",\n            fmt(\n                position.current_pe,\n                2\n            )\n        );\n\n        setText(\n            "proQuoteSource",\n            entry.quote_source\n        );\n\n        // ----------------------------------------------------\n        // P&L\n        // ----------------------------------------------------\n\n        setPnl(\n            "proOptionPnl",\n            pnl.option\n        );\n\n        setPnl(\n            "proFuturePnl",\n            pnl.future\n        );\n\n        setPnl(\n            "proTotalPnl",\n            pnl.total\n        );\n\n        // ----------------------------------------------------\n        // GREEKS\n        // ----------------------------------------------------\n\n        setText(\n            "proDelta",\n            fmt(\n                greeks.delta,\n                6\n            )\n        );\n\n        setText(\n            "proGamma",\n            fmt(\n                greeks.gamma,\n                7\n            )\n        );\n\n        setText(\n            "proTheta",\n            fmt(\n                greeks.theta,\n                4\n            )\n        );\n\n        setText(\n            "proVega",\n            fmt(\n                greeks.vega,\n                4\n            )\n        );\n\n        // ----------------------------------------------------\n        // RISK\n        // ----------------------------------------------------\n\n        setText(\n            "proHedge",\n            fmt(\n                hedge.current,\n               