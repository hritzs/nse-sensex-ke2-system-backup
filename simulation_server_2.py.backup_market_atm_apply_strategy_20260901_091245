class Persistence:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock = threading.RLock()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.init_db()

    def connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(self.path, timeout=10.0)
        conn.row_factory = sqlite3.Row
        return conn

    def init_db(self) -> None:
        with self.lock:
            conn = self.connect()
            try:
                conn.execute("PRAGMA journal_mode=WAL")
                conn.execute("PRAGMA synchronous=NORMAL")
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS minute_runs (
                        trade_date TEXT NOT NULL,
                        run_id TEXT NOT NULL,
                        status TEXT NOT NULL,
                        expiry TEXT,
                        updated_at TEXT NOT NULL,
                        payload TEXT NOT NULL,
                        PRIMARY KEY (trade_date, run_id)
                    )
                    """
                )
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS minute_config (
                        key TEXT PRIMARY KEY,
                        value TEXT,
                        updated_at TEXT NOT NULL
                    )
                    """
                )
                conn.commit()
            finally:
                conn.close()

    def save_run(self, run: "MinuteSimulation") -> None:
        payload = json.dumps(json_clean(run.snapshot()), ensure_ascii=False, allow_nan=False)
        status = run.status
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    """
                    INSERT INTO minute_runs
                        (trade_date, run_id, status, expiry, updated_at, payload)
                    VALUES (?, ?, ?, ?, ?, ?)
                    ON CONFLICT(trade_date, run_id)
                    DO UPDATE SET
                        status=excluded.status,
                        expiry=excluded.expiry,
                        updated_at=excluded.updated_at,
                        payload=excluded.payload
                    """,
                    (
                        run.trade_date,
                        run.run_id,
                        status,
                        run.entry_expiry,
                        iso_now(),
                        payload,
                    ),
                )
                conn.commit()
            finally:
                conn.close()

    def load_today(self, trade_date: str) -> dict[str, dict[str, Any]]:
        with self.lock:
            conn = self.connect()
            try:
                rows = conn.execute(
                    "SELECT run_id, payload FROM minute_runs WHERE trade_date=?",
                    (trade_date,),
                ).fetchall()
                return {
                    str(row["run_id"]): json.loads(row["payload"])
                    for row in rows
                }
            finally:
                conn.close()

    def clear_run(self, trade_date: str, run_id: str) -> None:
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    "DELETE FROM minute_runs WHERE trade_date=? AND run_id=?",
                    (trade_date, run_id),
                )
                conn.commit()
            finally:
                conn.close()

    def save_config(self, key: str, value: Optional[str]) -> None:
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    """
                    INSERT INTO minute_config(key, value, updated_at)
                    VALUES (?, ?, ?)
                    ON CONFLICT(key)
                    DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at
                    """,
                    (key, value, iso_now()),
                )
                conn.commit()
            finally:
                conn.close()

    def load_config(self, key: str) -> Optional[str]:
        with self.lock:
            conn = self.connect()
            try:
                row = conn.execute(
                    "SELECT value FROM minute_config WHERE key=?",
                    (key,),
                ).fetchone()
                return str(row["value"]) if row and row["value"] is not None else None
            finally:
                conn.close()


