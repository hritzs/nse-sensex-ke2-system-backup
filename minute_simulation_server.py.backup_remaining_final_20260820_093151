                                            activeRun
                                        );

                                    }
                                );

                            ensureChart();

                            fetchActiveRun();

                        },
                        true
                    );
                }
            );
    }


    // ========================================================
    // MAIN
    // ========================================================

    function boot(){

        ensureChart();

        installTabs();

        /*
         * Fast active-run refresh.
         * Does NOT rebuild the DOM.
         */
        fetchActiveRun();

        setInterval(
            fetchActiveRun,
            250
        );

        /*
         * Reinstall tabs if the existing UI script
         * recreates them.
         */
        setInterval(
            () => {
                installTabs();
            },
            1000
        );
    }


    if(
        document.readyState === "loading"
    ){

        document.addEventListener(
            "DOMContentLoaded",
            boot,
            {once:true}
        );

    }else{

        boot();

    }

})();
