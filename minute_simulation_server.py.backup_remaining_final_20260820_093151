<body>
<header>
    <h1>NIFTY Independent Minute Simulations</h1>
    <div class="tabs">
        <button data-run="0916">09:16</button>
        <button data-run="0917">09:17</button>
        <button data-run="0918">09:18</button>
        <button data-run="0919">09:19</button>
        <button id="nowButton" class="now">START NOW</button>
    </div>
</header>

<main>
    <div id="status" class="status">CONNECTING...</div>

    <div class="cards">
        <div class="card">
            <div class="label">Spot</div>
            <div id="spot" class="value">—</div>
        </div>
        <div class="card">
