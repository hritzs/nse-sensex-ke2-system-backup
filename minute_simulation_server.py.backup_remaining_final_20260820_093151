        </div>
        <div class="card">
            <div class="label">Total P&L</div>
            <div id="totalPnl" class="value">0.0000</div>
        </div>
    </div>

    <div class="panel">
        <h3>Trade</h3>
        <div class="cards">
            <div>
                <div class="label">Entry CE</div>
                <div id="entryCe" class="value">—</div>
            </div>
            <div>
                <div class="label">Entry PE</div>
                <div id="entryPe" class="value">—</div>
            </div>
            <div>
                <div class="label">Entry Straddle</div>
                <div id="entryStraddle" class="value">—</div>
            </div>
            <div>
                <div class="label">Trade Status</div>
                <div id="tradeStatus" class="value">WAITING</div>
            </div>
        </div>
        <div id="entryReason" class="reason"></div>
    </div>

    <div class="panel">
        <h3>Greeks</h3>
        <div class="grid4">
            <div>
                <div class="label">Delta</div>
                <div id="delta" class="value">—</div>
            </div>
            <div>
                <div class="label">Gamma</div>
                <div id="gamma" class="value">—</div>
            </div>
            <div>
                <div class="label">Theta</div>
                <div id="theta" class="value">—</div>
            </div>
            <div>
                <div class="label">Vega</div>
                <div id="vega" class="value">—</div>
            </div>
        </div>
    </div>

    <div class="panel">
        <h3>P&L History</h3>
        <canvas id="pnlChart" width="1400" height="280"></canvas>
    </div>

    <div class="panel">
        <h3>1-MINUTE HISTORY</h3>
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Spot</th>
                    <th>Future</th>
                    <th>ATM</th>
                    <th>Straddle</th>
                    <th>Delta</th>
                    <th>Gamma</th>
                    <th>Hedge</th>
                    <th>Total P&L</th>
                </tr>
            </thead>
            <tbody id="history"></tbody>
        </table>
    </div>
</main>

<script>
let activeRun = "0916";

function fmt(v, digits=2) {
    const n = Number(v);
    return Number.isFinite(n) ? n.toFixed(digits) : "—";
}

function setActive(runId) {
    activeRun = runId;
    document.querySelectorAll("[data-run]").forEach(btn => {
        btn.classList.toggle(
            "active",
            btn.dataset.run === runId
        );
    });
}

function render(state) {
    if (!state) return;

    setActive(state.run_id);

    const m = state.market || {};
    const e = state.entry || {};
    const p = state.position || {};
    const g = state.greeks || {};
    const h = state.history || [];

    document.getElementById("spot").textContent =
        fmt(m.spot);

    document.getElementById("future").textContent =
        fmt(m.future);

    document.getElementById("atm").textContent =
        fmt(m.atm);

    document.getElementById("totalPnl").textContent =
        fmt(
            (state.pnl || {}).total,
            4
        );

    document.getElementById("entryCe").textContent =
        e.ce ? `${e.ce} @ ${fmt(e.ce_price, 2)}` : "—";

    document.getElementById("entryPe").textContent =
        e.pe ? `${e.pe} @ ${fmt(e.pe_price, 2)}` : "—";

    document.getElementById("entryStraddle").textContent =
        fmt(e.straddle, 2);

    document.getElementById("tradeStatus").textContent =
        p.active
            ? "ACTIVE"
            : state.completed
                ? `EXITED: ${state.exit?.reason || "—"}`
                : state.armed
                    ? "ARMED"
                    : "WAITING";

    document.getElementById("entryReason").textContent =
        state.entry_block_reason
            ? `Entry block: ${state.entry_block_reason}`
            : (
                e.quote_source
                    ? `Entry quote source: ${e.quote_source}`
                    : ""
            );

    document.getElementById("delta").textContent =
        fmt(g.delta, 6);

    document.getElementById("gamma").textContent =
        fmt(g.gamma, 6);

    document.getElementById("theta").textContent =
        fmt(g.theta, 6);

    document.getElementById("vega").textContent =
        fmt(g.vega, 6);

    document.getElementById("status").textContent =
        state.completed
            ? `COMPLETED — ${state.exit?.reason || "EXIT"}`
            : state.started
                ? `LIVE — ${state.run_id}`
                : state.armed
                    ? `ARMED — ${state.run_id}`
                    : `WAITING — ${state.run_id}`;

    drawChart(h);
    renderHistory(h);
}

function drawChart(history) {
    const c = document.getElementById("pnlChart");
    const ctx = c.getContext("2d");

    ctx.clearRect(0, 0, c.width, c.height);

    if (history.length < 2) return;

    const values = history.map(
        x => Number(x.total_pnl || 0)
    );

    const min = Math.min(...values);
    const max = Math.max(...values);
    const range = Math.max(max - min, 1);

    ctx.beginPath();

    values.forEach((v, i) => {
        const x =
            20 +
            i / (values.length - 1) *
            (c.width - 40);

        const y =
            c.height - 20 -
            (v - min) / range *
            (c.height - 40);

        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    });

    ctx.stroke();
}

function renderHistory(history) {
    const body = document.getElementById("history");

    body.innerHTML = history
        .slice()
        .reverse()
        .map(x => `
            <tr>
                <td>${x.timestamp || "—"}</td>
                <td>${fmt(x.spot)}</td>
                <td>${fmt(x.future)}</td>
                <td>${fmt(x.atm)}</td>
                <td>${fmt(x.straddle)}</td>
                <td>${fmt(x.delta, 6)}</td>
                <td>${fmt(x.gamma, 6)}</td>
                <td>${fmt(x.hedge, 4)}</td>
                <td>${fmt(x.total_pnl, 4)}</td>
            </tr>
        `)
        .join("");
}

async function refresh() {
    try {
        const r = await fetch(
            `/api/runs/${activeRun}`,
            {cache: "no-store"}
        );

        render(await r.json());

    } catch (err) {
        console.error(err);
        document.getElementById("status").textContent =
            "SERVER ERROR";
    }
}

document.querySelectorAll("[data-run]").forEach(btn => {
    btn.addEventListener("click", () => {
        setActive(btn.dataset.run);
        refresh();
    });
});

document.getElementById("nowButton").addEventListener(
    "click",
    async () => {
        const btn = document.getElementById("nowButton");
        btn.disabled = true;
        btn.textContent = "STARTING NOW...";

        try {
            const r = await fetch(
                "/api/runs/NOW/start",
                {cache: "no-store"}
            );

            const state = await r.json();
            render(state);

        } catch (err) {
            console.error(err);
        } finally {
            btn.disabled = false;
            btn.textContent = "START NOW";
        }
    }
);

setInterval(refresh, 1000);
refresh();
</script>

