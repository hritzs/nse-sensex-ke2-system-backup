<script id="liveSummaryChartRuntime">
(function(){

    const RUNS = [
        "0916",
        "0917",
        "0918",
        "0919",
        "NOW"
    ];

    let activeRun = "0916";

    const cache = {};

    let chartMinuteKey = "";

    let installed = false;


    // ========================================================
    // UTILITIES
    // ========================================================

    function el(id){
        return document.getElementById(id);
    }

    function finite(v){
        const n = Number(v);

        return Number.isFinite(n)
            ? n
            : null;
    }

    function fmt(v,d=2){

        const n = finite(v);

        if(n === null){
            return "--";
        }

        return n.toLocaleString(
            undefined,
            {
                minimumFractionDigits:d,
                maximumFractionDigits:d
            }
        );
    }

    function signed(v,d=2){

        const n = finite(v);

        if(n === null){
            return "--";
        }

        return (
            n >= 0
                ? "+"
                : ""
        )
        + fmt(n,d);
    }

    function setText(id,value){

        const node = el(id);

        if(node){
            node.textContent =
                value === null
                ||
                value === undefined
                ||
                value === ""
                    ? "--"
                    : value;
        }
    }

    function pnlClass(v){

        const n = finite(v);

        if(n === null){
            return "pro-neutral";
        }

        if(n > 0){
            return "pro-positive";
        }

        if(n < 0){
            return "pro-negative";
        }

        return "pro-neutral";
    }

    function setPnl(id,v){

        const node = el(id);

        if(!node){
            return;
        }

        node.textContent =
            signed(v,2);

        node.className =
            "pro-pnl-value "
            + pnlClass(v);
    }


    // ========================================================
    // CREATE ONE REAL CHART
    // ========================================================

    function ensureChart(){

        if(
            el("minutePnlChartSection")
        ){
            return true;
        }

        const root =
            el("proSimRoot");

        if(!root){
            return false;
        }

        const tableSections =
            Array.from(
                root.querySelectorAll(
                    ".pro-table-wrap"
                )
            );

        const minuteHistory =
            tableSections.find(
                section => {

                    const head =
                        section.querySelector(
                            ".pro-section-head"
                        );

                    return (
                        head
                        &&
                        head.textContent
                            .trim()
                            .toLowerCase()
                            .includes(
                                "minute history"
                            )
                    );
                }
            );

        if(!minuteHistory){
            return false;
        }

        const wrapper =
            document.createElement(
                "div"
            );

        wrapper.id =
            "minutePnlChartSection";

        wrapper.innerHTML = `
            <div id="minutePnlChartHeader">

                <div id="minutePnlChartTitle">
                    P&L HISTORY · 1-MINUTE
                </div>

                <div id="minutePnlChartMeta">
                    --
                </div>

            </div>

            <div id="minutePnlChartWrap">

                <canvas
                    id="minutePnlChart"
