         */
    }


    // ========================================================
    // ONLY UPDATE MINUTE HISTORY WHEN MINUTE CHANGES
    // ========================================================

    function renderMinuteHistory(
        state
    ){

        const tbody =
            el(
                "proHistoryTable"
            );

        if(!tbody){
            return;
        }

        const history =
            Array.isArray(
                state.history
            )
                ? state.history
                : [];

        /*
         * First completed minute for NOW:
         * the history point should be at the END of the
         * scheduled start minute, not the build timestamp.
         *
         * Example:
         * START 14:27:00
         * first minute point = 14:28:00
         */
        const filtered =
            history.filter(
                row => {

                    if(
                        state.run_id !== "NOW"
                    ){
                        return true;
                    }

                    if(
                        !state.scheduled_start
                    ){
                        return true;
                    }

                    if(
                        !row.timestamp
                    ){
                        return true;
                    }

                    return (
                        row.timestamp
                        >=
                        state.scheduled_start
                    );
                }
            );

        if(!filtered.length){

            tbody.innerHTML =
                `
                <tr>
                    <td
                        colspan="9"
                        class="pro-empty"
                    >
                        No completed minute snapshot yet
                    </td>
                </tr>
                `;

            return;
        }

        tbody.innerHTML =
            filtered
                .slice()
                .reverse()
                .map(
                    row => `
                    <tr>

                        <td>
                            ${
                                row.timestamp
                                ?.split("T")[1]
                                ?.split("+")[0]
                                ||
                                "--"
                            }
                        </td>

                        <td>
                            ${fmt(
                                row.synthetic_future
                                ??
                                row.spot,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.actual_future
                                ??
                                row.future,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.atm,
                                0
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.current_ce
                                ??
                                row.ce,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.current_pe
                                ??
                                row.pe,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.straddle
                                ??
                                row.current_straddle,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.delta,
                                5
                            )}
                        </td>

                        <td class="${
                            pnlClass(
                                row.total_pnl
                                ??
                                row.total
                            )
                        }">
                            ${
                                signed(
                                    row.total_pnl
                                    ??
                                    row.total,
                                    2
                                )
                            }
                        </td>

                    </tr>
                    `
                )
                .join("");
    }


    // ========================================================
    // P&L CHART
    // ========================================================

    function renderPnlChart(
        state
    ){

        if(!ensureChart()){
            return;
        }

        const section =
            el(
                "minutePnlChartSection"
            );

        const canvas =
            el(
                "minutePnlChart"
            );

        const meta =
            el(
                "minutePnlChartMeta"
            );

        if(
            !section
            ||
            !canvas
        ){
            return;
        }

        const history =
            Array.isArray(
                state.history
            )
                ? state.history
                : [];

        /*
         * NOW chart begins only after START NOW has
         * actually started.
         */
        const shouldShow =
            !!state.started
            &&
            (
                state.run_id !== "NOW"
                ||
                !!state.request_timestamp
            );

        if(!shouldShow){

            section.classList.remove(
                "visible"
            );

            return;
        }

        section.classList.add(
            "visible"
        );

        const chartHistory =
            history.filter(
                row => {

                    if(
                        state.run_id !== "NOW"
                        ||
                        !state.scheduled_start
                        ||
                        !row.timestamp
                    ){
                        return true;
                    }

                    return (
                        row.timestamp
                        >=
                        state.scheduled_start
                    );
                }
            );

        if(meta){

            meta.textContent =
                state.run_id
                +
                " · "
                +
                chartHistory.length
                +
                " minute points";
        }

        const values =
            chartHistory
                .map(
                    row =>
                        finite(
                            row.total_pnl
                            ??
                            row.total
                        )
                )
                .filter(
                    v => v !== null
                );

        const rect =
            canvas.getBoundingClientRect();

        const dpr =
            window.devicePixelRatio || 1;

        const w =
            rect.width;

        const h =
            rect.height;

        canvas.width =
            Math.max(
                1,
                Math.floor(
                    w * dpr
                )
            );

        canvas.height =
            Math.max(
                1,
                Math.floor(
                    h * dpr
                )
            );

        const ctx =
            canvas.getContext(
                "2d"
            );

        ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
        );

        ctx.clearRect(
            0,
            0,
            w,
            h
        );

        if(values.length < 2){

            ctx.fillStyle =
                "#8ea2b8";

            ctx.font =
                "10px system-ui";

            ctx.fillText(
                values.length === 1
                    ? "Waiting for next minute..."
                    : "Waiting for minute snapshots...",
                10,
                20
            );

            return;
        }

        const min =
            Math.min(
                ...values,
                0
            );

        const max =
            Math.max(
                ...values,
                0
            );

        const range =
            Math.max(
                max - min,
                0.000001
            );

        const left = 40;
        const right = 12;
        const top = 12;
        const bottom = 22;

        // Grid / zero
        ctx.strokeStyle =
            "#1b2b3b";

        ctx.lineWidth = 1;

        const zeroY =
            h
            -
            bottom
            -
            (
                (0-min)
                /
                range
            )
            *
            (
                h-top-bottom
            );

        ctx.beginPath();
        ctx.moveTo(left,zeroY);
        ctx.lineTo(w-right,zeroY);
        ctx.stroke();

        // P&L line
        ctx.strokeStyle =
            "#35d07f";

        ctx.lineWidth = 2;

        ctx.beginPath();

        values.forEach(
            (value,index) => {

                const x =
                    left
                    +
                    (
                        index
                        /
                        Math.max(
                            values.length-1,
                            1
                        )
                    )
                    *
                    (
                        w-left-right
                    );

                const y =
                    h
                    -
                    bottom
                    -
                    (
                        (value-min)
                        /
                        range
                    )
                    *
                    (
                        h-top-bottom
                    );

                if(index === 0){
                    ctx.moveTo(
                        x,
                        y
                    );
                }else{
                    ctx.lineTo(
                        x,
                        y
                    );
                }

            }
        );

        ctx.stroke();

        // Points
        ctx.fillStyle =
            "#55aaff";

        values.forEach(
            (value,index) => {

                const x =
                    left
                    +
                    (
                        index
                        /
                        Math.max(
                            values.length-1,
                            1
                        )
                    )
                    *
                    (
                        w-left-right
                    );

                const y =
                    h
                    -
                    bottom
                    -
                    (
                        (value-min)
                        /
                        range
                    )
                    *
                    (
                        h-top-bottom
                    );

                ctx.beginPath();

                ctx.arc(
                    x,
                    y,
                    2.5,
                    0,
                    Math.PI*2
                );

                ctx.fill();
            }
        );

        ctx.fillStyle =
            "#8ea2b8";

        ctx.font =
            "9px system-ui";

        ctx.fillText(
            "Max "
            +
            max.toFixed(2),
            left,
            10
        );

        ctx.fillText(
            "Min "
            +
            min.toFixed(2),
            left,
            h-3
        );

        ctx.textAlign =
            "right";

        ctx.fillText(
            "Current "
            +
            values[
                values.length-1
            ].toFixed(2),
            w-right,
            10
        );

        ctx.textAlign =
            "left";
    }


    // ========================================================
    // FETCH SELECTED RUN FREQUENTLY
    //
    // This is the important real-time fix.
    // ========================================================

    async function fetchActiveRun(){

        try{

            const response =
                await fetch(
                    "/api/runs/"
                    +
                    activeRun
                    +
                    "?ts="
                    +
                    Date.now(),
                    {
                        cache:"no-store"
                    }
                );

            if(!response.ok){
                return;
            }

            const state =
                await response.json();

            cache[
                activeRun
            ] = state;

            /*
             * LIVE summary every 250 ms.
             */
            renderLiveSummary(
                state
            );

            /*
             * The minute/history/chart only update when
             * their latest minute changes.
             */
            const history =
                Array.isArray(
                    state.history
                )
                    ? state.history
                    : [];

            const latest =
                history.length
                    ? history[
                        history.length-1
                    ]
                    : null;

            const minuteKey =
                [
                    state.run_id,
                    latest?.timestamp || "",
                    state.started
                        ? "1"
                        : "0",
                    state.completed
                        ? "1"
                        : "0",
                ].join("|");

            if(
                minuteKey !== chartMinuteKey
            ){

                chartMinuteKey =
                    minuteKey;

                renderMinuteHistory(
                    state
                );

                renderPnlChart(
                    state
                );
            }

        }catch(error){

            console.error(
                "[LIVE ACTIVE RUN]",
                error
            );
        }
    }


    // ========================================================
