<script id="professionalSimulationJS">
(function(){

  const RUNS = [
    "0916",
    "0917",
    "0918",
    "0919",
    "NOW"
  ];

  let activeRun = "0916";
  let timer = null;

  const $ = id =>
    document.getElementById(id);

  function fmt(v, digits=2){
    if(v === null || v === undefined || !Number.isFinite(Number(v))){
      return "--";
    }

    return Number(v).toLocaleString(
      undefined,
      {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      }
    );
  }

  function signed(v, digits=2){
    if(v === null || v === undefined || !Number.isFinite(Number(v))){
      return "--";
    }

    const n = Number(v);
    return (n >= 0 ? "+" : "") + fmt(n, digits);
  }

  function esc(v){
    return String(v ?? "")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
  }

  function pnlClass(v){
    const n = Number(v);

    if(!Number.isFinite(n)){
      return "pro-neutral";
    }

    if(n > 0){
      return "pro-positive";
    }

    if(n < 0){
      return "pro-negative";
    }

    return "pro-neutral";
  }

  function setPnl(id, value){
    const node = $(id);

    if(!node){
      return;
    }

    node.textContent = signed(value,2);
    node.className =
      "pro-pnl-value "
      +
      pnlClass(value);
  }

  function setText(id, value){
    const node = $(id);

    if(node){
      node.textContent =
        value === null ||
        value === undefined ||
        value === ""
          ? "--"
          : value;
    }
  }

  function resizeCanvas(){
    const canvas = $("proChart");

    if(!canvas){
      return;
    }

    const rect =
      canvas.getBoundingClientRect();

    const dpr =
      window.devicePixelRatio || 1;

    canvas.width =
      Math.max(
        1,
        Math.floor(rect.width * dpr)
      );

    canvas.height =
      Math.max(
        1,
        Math.floor(rect.height * dpr)
      );
  }

  function drawChart(state){

    const canvas = $("proChart");

    if(!canvas){
      return;
    }

    resizeCanvas();

    const ctx =
      canvas.getContext("2d");

    const dpr =
      window.devicePixelRatio || 1;

    const width =
      canvas.width / dpr;

    const height =
      canvas.height / dpr;

    ctx.setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );

    ctx.clearRect(
      0,
      0,
      width,
      height
    );

    const history =
      Array.isArray(state.history)
        ? state.history
        : [];

    if(history.length < 2){

      ctx.fillStyle = "#8ea2b8";
      ctx.font = "12px system-ui";

      ctx.fillText(
        "Waiting for minute history...",
        20,
        30
      );

      return;
    }

    const series = history.map(
      row => ({
        synthetic:
          Number(
            row.synthetic_future ??
            row.spot ??
            NaN
          ),

        pnl:
          Number(
            row.total_pnl ??
            row.total ??
            NaN
          )
      })
    );

    const validSynthetic =
      series
        .map(x => x.synthetic)
        .filter(Number.isFinite);

    const validPnl =
      series
        .map(x => x.pnl)
        .filter(Number.isFinite);

    if(
      validSynthetic.length < 2
      ||
      validPnl.length < 2
    ){
      return;
    }

    function drawSeries(
      values,
      top,
      bottom,
      stroke
    ){

      const min =
        Math.min(...values);

      const max =
        Math.max(...values);

      const range =
        Math.max(
          max - min,
          0.000001
        );

      ctx.strokeStyle =
        stroke;

      ctx.lineWidth = 2;

      ctx.beginPath();

      values.forEach(
        (v,i) => {

          const x =
            12
            +
            (
              i /
              Math.max(
                values.length - 1,
                1
              )
            )
            *
            (
              width - 24
            );

          const y =
            bottom
            -
            (
              (v - min)
              / range
            )
            *
            (
              bottom - top
            );

          if(i === 0){
            ctx.moveTo(x,y);
          }else{
            ctx.lineTo(x,y);
          }

        }
      );

      ctx.stroke();

      ctx.fillStyle = "#8ea2b8";
      ctx.font = "10px system-ui";

      ctx.fillText(
        fmt(min,2),
        14,
        bottom - 3
      );

      ctx.fillText(
        fmt(max,2),
        14,
        top + 10
      );
    }

    const middle =
      Math.floor(
        height * .52
      );

    drawSeries(
      validSynthetic,
      12,
      middle - 8,
      "#55aaff"
    );

    drawSeries(
      validPnl,
      middle + 8,
      height - 12,
      "#35d07f"
    );

    ctx.strokeStyle = "#20344a";
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(12,middle);
    ctx.lineTo(width - 12,middle);
    ctx.stroke();

    ctx.fillStyle = "#55aaff";
    ctx.fillText(
      "Synthetic Future",
      width - 120,
      20
    );

    ctx.fillStyle = "#35d07f";
    ctx.fillText(
      "Total P&L",
      width - 75,
      middle + 24
    );
  }

  function renderHedgeEvents(state){

    const tbody =
      $("proHedgeTable");

    if(!tbody){
      return;
    }

    const events =
      Array.isArray(state.hedge?.events)
        ? state.hedge.events
        : [];

    if(!events.length){

      tbody.innerHTML =
        '<tr><td colspan="9" class="pro-empty">No hedge events</td></tr>';

      return;
    }

    tbody.innerHTML =
      events
        .slice()
        .reverse()
        .slice(0,50)
        .map(
          e => `
            <tr>
              <td>${esc(e.timestamp)}</td>
              <td>${esc(e.kind ?? e.type ?? "")}</td>
              <td>${fmt(e.hedge_total ?? e.current,4)}</td>
              <td>${signed(e.hedge_change ?? e.change,4)}</td>
              <td>${fmt(e.delta,5)}</td>
              <td>${fmt(e.points_out,3)}</td>
              <td>${fmt(e.points_allowed,3)}</td>
              <td>${fmt(e.synthetic_future ?? e.spot,2)}</td>
              <td>${fmt(e.actual_future ?? e.future,2)}</td>
            </tr>
          `
        )
        .join("");
  }

  function renderHistory(state){

    const tbody =
      $("proHistoryTable");

    if(!tbody){
      return;
    }

    const rows =
      Array.isArray(state.history)
        ? state.history
        : [];

    if(!rows.length){

      tbody.innerHTML =
        '<tr><td colspan="9" class="pro-empty">Waiting for minute history</td></tr>';

      return;
    }

    tbody.innerHTML =
      rows
        .slice()
        .reverse()
        .slice(0,60)
        .map(
          r => `
            <tr>
              <td>${esc(r.timestamp)}</td>
              <td>${fmt(r.synthetic_future ?? r.spot,2)}</td>
              <td>${fmt(r.actual_future ?? r.future,2)}</td>
              <td>${fmt(r.atm,0)}</td>
              <td>${fmt(r.current_ce ?? r.ce,2)}</td>
              <td>${fmt(r.current_pe ?? r.pe,2)}</td>
              <td>${fmt(r.straddle ?? r.current_straddle,2)}</td>
              <td>${fmt(r.delta,5)}</td>
              <td class="${pnlClass(r.total_pnl ?? r.total)}">
                ${signed(r.total_pnl ?? r.total,2)}
              </td>
            </tr>
          `
        )
        .join("");
  }

  function render(state){

    if(!state){
      return;
    }

    const market =
      state.market || {};

    const entry =
      state.entry || {};

    const position =
      state.position || {};

    const greeks =
      state.greeks || {};

    const hedge =
      state.hedge || {};

    const pnl =
      state.pnl || {};

    const exit =
      state.exit || {};

    setText(
      "proRunId",
      state.run_id
    );

    setText(
      "proSyntheticSpot",
      fmt(
        market.synthetic_future ??
        market.spot
      )
    );

    setText(
      "proActualFuture",
      fmt(
        market.actual_future ??
        market.future
      )
    );

    setText(
      "proATM",
      fmt(market.atm,0)
    );

    setText(
      "proExpiry",
      "Expiry " +
      (entry.expiry ?? "--")
    );

    setText(
      "proCurrentStraddle",
      fmt(
        position.current_straddle
      )
    );

    setText(
      "proEntryStraddle",
      "Entry " +
      fmt(entry.straddle)
    );

    setText(
      "proEntryCE",
      fmt(entry.ce_price)
    );

    setText(
      "proEntryPE",
      fmt(entry.pe_price)
    );

    setText(
      "proEntryStraddle2",
      fmt(entry.straddle)
    );

    setText(
      "proCurrentCE",
      fmt(position.current_ce)
    );

    setText(
      "proCurrentPE",
      fmt(position.current_pe)
    );

    setText(
      "proQuoteSource",
      entry.quote_source
    );

    setPnl(
      "proOptionPnl",
      pnl.option
    );

    setPnl(
      "proFuturePnl",
      pnl.future
    );

    setPnl(
      "proTotalPnl",
      pnl.total
    );

    setText(
      "proDelta",
      fmt(greeks.delta,6)
    );

    setText(
      "proGamma",
      fmt(greeks.gamma,7)
    );

    setText(
      "proTheta",
      fmt(greeks.theta,4)
    );

    setText(
      "proVega",
      fmt(greeks.vega,4)
    );

    setText(
      "proHedge",
      fmt(hedge.current,4)
    );

    setText(
      "proPointsOut",
      fmt(hedge.points_out,3)
    );

    setText(
      "proPointsAllowed",
      fmt(hedge.points_allowed,3)
    );

    setText(
      "proExitReason",
      exit.reason ??
      (
        state.completed
          ? "COMPLETED"
          : state.started
            ? "RUNNING"
            : "WAITING"
      )
    );

    setText(
      "proEntryTime",
      entry.timestamp
    );

    const runState =
      $("proRunState");

    if(runState){

      runState.textContent =
        state.completed
          ? "COMPLETED"
          : state.started
            ? "RUNNING"
            : state.armed
              ? "ARMED"
              : "WAITING";
    }

    setText(
      "proEntryStatus",
      entry.timestamp
        ? "ENTRY " + entry.timestamp
        : "NO ENTRY"
    );

    setText(
      "proRunClock",
      state.start_timestamp
        ? "START " + state.start_timestamp
        : "--"
    );

    drawChart(state);
    renderHedgeEvents(state);
    renderHistory(state);
  }

  async function fetchState(){

    try{

      const response =
        await fetch(
          "/api/runs/"
          +
          activeRun
          +
          "?ts="
          +
          Date.now(),
          {
            cache:"no-store"
          }
        );

      if(!response.ok){
        throw new Error(
          "HTTP " + response.status
        );
      }

      const state =
        await response.json();

      render(state);

      const live =
        $("proLiveStatus");

      if(live){
        live.textContent =
          state.completed
            ? "COMPLETED"
            : "LIVE";
      }

    }catch(error){

      const live =
        $("proLiveStatus");

      if(live){
        live.textContent = "RECONNECTING";
      }

      console.error(
        "[PRO SIM UI]",
        error
      );
    }
  }

  async function startNow(){

    try{

      const response =
        await fetch(
          "/api/runs/NOW/start?ts="
          +
          Date.now(),
          {
            cache:"no-store"
          }
        );

      const data =
        await response.json();

      if(!response.ok){
        throw new Error(
          data.error ||
          "Unable to arm NOW"
        );
      }

      activeRun = "NOW";
      updateTabState();

      await fetchState();

    }catch(error){

      console.error(
        "[START NOW]",
        error
      );

      alert(
        "Unable to start NOW simulation: "
        +
        error.message
      );
    }
  }

  function updateTabState(){

    document
      .querySelectorAll(
        ".pro-sim-tab"
      )
      .forEach(
        button => {

          button.classList.toggle(
            "active",
            button.dataset.run === activeRun
          );
        }
      );
  }

  function install(){

    document
      .querySelectorAll(
        ".pro-sim-tab"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              const run =
                button.dataset.run;

              if(run === "NOW"){

                startNow();
                return;
              }

              activeRun = run;

              updateTabState();
              fetchState();
            }
          );
        }
      );

    window.addEventListener(
      "resize",
      () => drawChart(
        window.__PRO_LAST_STATE ||
        {}
      )
    );

    // Keep a copy for resize redraws.
    const originalRender = render;

    window.__PRO_RENDER = function(state){

      window.__PRO_LAST_STATE = state;
      originalRender(state);

    };

    fetchState();

    if(timer){
      clearInterval(timer);
    }

    timer =
      setInterval(
        fetchState,
        1000
      );
  }

  /*
   * Replace render with state-caching wrapper.
   */
  window.__PRO_LAST_STATE = null;

  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      install,
      {
        once:true
      }
    );
  }else{
    install();
  }

})();
</script>


<script id="compactFinalLayout">
(function(){

  function arrange(){

    const root =
      document.getElementById("proSimRoot");

    if(!root){
      return;
    }

    const shell =
      root.querySelector(".pro-sim-shell");

    const sections =
      [...root.querySelectorAll(".pro-table-wrap")];

    let hedge = null;
    let history = null;

    sections.forEach(section => {

      const head =
        section.querySelector(".pro-section-head");

      const text =
        head
          ? head.textContent.trim().toLowerCase()
          : "";

      if(text === "hedge events"){
        hedge = section;
      }

      if(text === "minute history"){
        history = section;
      }

    });

    const firstTwo =
      root.querySelector(".pro-two");

    if(
      hedge &&
      firstTwo &&
      shell
    ){
      shell.insertBefore(
        hedge,
        firstTwo
      );

      hedge.id =
        "proHedgeEventsSection";
    }

    const chart =
      root.querySelector(".pro-chart-wrap");

    if(chart){
      chart.remove();
    }

    /*
     * Remove the old independent-run visual controls.
     * The compact pro panel owns the tabs.
     */
    document
      .querySelectorAll(
        "#fiveSimulationRunTabs,#fiveRunLabel"
      )
      .forEach(node => {

        const parent =
          node.closest(
            ".card,.panel,section"
          ) ||
          node.parentElement;

        if(parent){
          parent.style.display =
            "none";
        }

      });
  }

  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      arrange,
      {once:true}
    );
  }else{
    arrange();
  }

})();
</script>

<script id="finalPnlChartJS">
(function(){

    function installPnlChart(){

        const root =
            document.getElementById("proSimRoot");

        if(!root){
            return;
        }

        if(
            document.getElementById(
                "proPnlHistoryChartSection"
            )
        ){
            return;
        }

        /*
         * Find the existing 1-MINUTE HISTORY section.
         * The P&L chart goes directly before it.
         */
        const tableSections =
            Array.from(
                root.querySelectorAll(
                    ".pro-table-wrap"
                )
            );

        const minuteHistory =
            tableSections.find(
                section => {

                    const head =
                        section.querySelector(
                            ".pro-section-head"
                        );

                    return (
                        head &&
                        head.textContent
                            .trim()
                            .toLowerCase()
                            === "minute history"
                    );
                }
            );

        if(!minuteHistory){
            return;
        }

        const chart =
            document.createElement("div");

        chart.id =
            "proPnlHistoryChartSection";

        chart.innerHTML = `
            <div class="pro-chart-title">
                P&L HISTORY · 1-MINUTE SNAPSHOTS
            </div>

            <div id="proPnlHistoryCanvasWrap">
                <canvas
                    id="proPnlHistoryCanvas"
                ></canvas>
            </div>
        `;

        minuteHistory.parentNode.insertBefore(
            chart,
            minuteHistory
        );

        console.log(
            "[PRO UI] P&L chart installed"
        );
    }


    function drawPnlChart(history){

        const canvas =
            document.getElementById(
                "proPnlHistoryCanvas"
            );

        if(!canvas){
            return;
        }

        const rect =
            canvas.getBoundingClientRect();

        const dpr =
            window.devicePixelRatio || 1;

        const width =
            Math.max(
                1,
                Math.floor(
                    rect.width * dpr
                )
            );

        const height =
            Math.max(
                1,
                Math.floor(
                    rect.height * dpr
                )
            );

        canvas.width = width;
        canvas.height = height;

        const ctx =
            canvas.getContext("2d");

        ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
        );

        const w =
            rect.width;

        const h =
            rect.height;

        ctx.clearRect(
            0,
            0,
            w,
            h
        );

        if(
            !Array.isArray(history)
            ||
            history.length < 2
        ){

            ctx.fillStyle =
                "#8ea2b8";

            ctx.font =
                "10px system-ui";

            ctx.fillText(
                "Waiting for P&L history...",
                10,
                20
            );

            return;
        }

        const values =
            history
                .map(
                    row =>
                        Number(
                            row.total_pnl ??
                            row.total ??
                            0
                        )
                )
                .filter(
                    Number.isFinite
                );

        if(values.length < 2){
            return;
        }

        const min =
            Math.min(...values);

        const max =
            Math.max(...values);

        /*
         * Keep a visible zero line whenever the range
         * crosses zero.
         */
        const low =
            Math.min(
                min,
                0
            );

        const high =
            Math.max(
                max,
                0
            );

        const range =
            Math.max(
                high - low,
                0.000001
            );

        const padX = 10;
        const padY = 12;

        /*
         * Grid / zero line.
         */
        const zeroY =
            h -
            padY -
            (
                (0 - low)
                / range
            )
            *
            (
                h - 2 * padY
            );

        ctx.strokeStyle =
            "#20344a";

        ctx.lineWidth = 1;

        ctx.beginPath();

        ctx.moveTo(
            padX,
            zeroY
        );

        ctx.lineTo(
            w - padX,
            zeroY
        );

        ctx.stroke();

        /*
         * P&L line.
         */
        ctx.strokeStyle =
            "#35d07f";

        ctx.lineWidth = 2;

        ctx.beginPath();

        values.forEach(
            (value, index) => {

                const x =
                    padX
                    +
                    (
                        index
                        /
                        Math.max(
                            values.length - 1,
                            1
                        )
                    )
                    *
                    (
                        w - 2 * padX
                    );

                const y =
                    h -
                    padY
                    -
                    (
                        (value - low)
                        /
                        range
                    )
                    *
                    (
                        h - 2 * padY
                    );

                if(index === 0){
                    ctx.moveTo(
                        x,
                        y
                    );
                }else{
                    ctx.lineTo(
                        x,
                        y
                    );
                }

            }
        );

        ctx.stroke();

        /*
         * Last-value marker.
         */
        const last =
            values[values.length - 1];

        const lastX =
            w - padX;

        const lastY =
            h -
            padY
            -
            (
                (last - low)
                /
                range
            )
            *
            (
                h - 2 * padY
            );

        ctx.fillStyle =
            "#35d07f";

        ctx.beginPath();

        ctx.arc(
            lastX,
            lastY,
            3,
            0,
            Math.PI * 2
        );

        ctx.fill();

        /*
         * Labels.
         */
        ctx.fillStyle =
            "#8ea2b8";

        ctx.font =
            "9px system-ui";

        ctx.fillText(
            "Max " + max.toFixed(2),
            10,
            10
        );

        ctx.fillText(
            "Min " + min.toFixed(2),
            10,
            h - 2
        );

        ctx.textAlign = "right";

        ctx.fillText(
            "Current " + last.toFixed(2),
            w - 10,
            10
        );

        ctx.textAlign = "left";
    }


    window.__PRO_DRAW_PNL_CHART =
        drawPnlChart;


    /*
     * We hook into the existing pro UI render.
     * The existing render function already receives the
     * complete Simulation state.
     */
    function hookRender(){

        if(
            typeof window.__PRO_RENDER
            !== "function"
        ){
            return;
        }

        if(
            window.__PRO_PNL_HOOKED
        ){
            return;
        }

        const original =
            window.__PRO_RENDER;

        window.__PRO_RENDER =
            function(state){

                original(state);

                if(state){

                    drawPnlChart(
                        Array.isArray(
                            state.history
                        )
                            ? state.history
                            : []
                    );
                }

            };

        window.__PRO_PNL_HOOKED =
            true;
    }


    function boot(){

        installPnlChart();

        /*
         * Existing professional UI may already have
         * created its render wrapper. Try repeatedly for
         * a short period rather than changing the engine.
         */
        hookRender();

        let attempts = 0;

        const timer =
            setInterval(
                () => {

                    installPnlChart();
                    hookRender();

                    attempts++;

                    if(
                        attempts > 30
                    ){
                        clearInterval(timer);
                    }

                },
                200
            );
    }


    if(
        document.readyState
        === "loading"
    ){
        document.addEventListener(
            "DOMContentLoaded",
            boot,
            {once:true}
        );
    }else{
        boot();
    }


    window.addEventListener(
        "resize",
        () => {

            const last =
                window.__PRO_LAST_STATE;

            if(last){
                drawPnlChart(
                    Array.isArray(
                        last.history
                    )
                        ? last.history
                        : []
                );
            }

        }
    );

})();
</script>


<script id="perRunAutomaticDashboardJS">
(function(){

    const RUNS = [
        "0916",
        "0917",
        "0918",
        "0919",
        "NOW"
    ];

    let activeRun = "0916";

    const cache = {};

    let polling = false;

    /*
     * UI rendering is MINUTE SNAPSHOT based.
     *
     * The browser may poll every second, but it does NOT
     * rebuild the dashboard every second.
     */
    const renderedKeys = {};

    function renderKey(state){

        if(!state){
            return "";
        }

        const history =
            Array.isArray(
                state.history
            )
                ? state.history
                : [];

        const chartSection =
            el(
                "autoPnlChartSection"
            );

        /*
         * Chart policy:
         *
         * 09:16/09:17/09:18/09:19:
         *     show only after that run actually starts.
         *
         * NOW:
         *     do not show before START NOW.
         *     after the scheduled start, show the chart
         *     and build it only from NOW's own minute history.
         */
        if(chartSection){

            const shouldShowChart =
                !!state.started
                &&
                (
                    state.run_id !== "NOW"
                    ||
                    !!state.request_timestamp
                );

            if(shouldShowChart){

                chartSection.classList.add(
                    "show-pnl-chart"
                );

                chartSection.classList.remove(
                    "hide-pnl-chart"
                );

            }else{

                chartSection.classList.remove(
                    "show-pnl-chart"
                );

                chartSection.classList.add(
                    "hide-pnl-chart"
                );
            }
        }

        const latest =
            history.length
                ? history[
                    history.length - 1
                ]
                : null;

        const latestMinute =
            latest
            &&
            latest.timestamp
                ? latest.timestamp
                : "";

        return [
            state.run_id || "",
            state.request_timestamp || "",
            state.started ? "1" : "0",
            state.completed ? "1" : "0",
            state.exit_reason || "",
            latestMinute,
        ].join("|");
    }

    function el(id){
        return document.getElementById(id);
    }

    function num(value){
        const n = Number(value);

        return Number.isFinite(n)
            ? n
            : null;
    }

    function fmt(
        value,
        digits=2
    ){
        const n = num(value);

        if(n === null){
            return "--";
        }

        return n.toLocaleString(
            undefined,
            {
                minimumFractionDigits:digits,
                maximumFractionDigits:digits
            }
        );
    }

    function signed(
        value,
        digits=2
    ){
        const n = num(value);

        if(n === null){
            return "--";
        }

        return (
            n >= 0
                ? "+"
                : ""
        )
        +
        fmt(
            n,
            digits
        );
    }

    function text(
        id,
        value
    ){
        const node = el(id);

        if(node){
            node.textContent =
                value === null
                ||
                value === undefined
                ||
                value === ""
                    ? "--"
                    : value;
        }
    }

    function pnlClass(value){

        const n = num(value);

        if(n === null){
            return "pro-neutral";
        }

        if(n > 0){
            return "pro-positive";
        }

        if(n < 0){
            return "pro-negative";
        }

        return "pro-neutral";
    }

    function setPnl(
        id,
        value
    ){

        const node = el(id);

        if(!node){
            return;
        }

        node.textContent =
            signed(
                value,
                2
            );

        node.className =
            "pro-pnl-value "
            +
            pnlClass(
                value
            );
    }


    // ========================================================
    // ENSURE P&L CHART EXISTS IN THE CORRECT POSITION
    // ========================================================

    function ensureChart(){

        if(
            el(
                "autoPnlChartSection"
            )
        ){
            return;
        }

        const root =
            el("proSimRoot");

        if(!root){
            return;
        }

        const historySections =
            Array.from(
                root.querySelectorAll(
                    ".pro-table-wrap"
                )
            );

        const minuteHistory =
            historySections.find(
                section => {

                    const head =
                        section.querySelector(
                            ".pro-section-head"
                        );

                    return (
                        head
                        &&
                        head.textContent
                            .trim()
                            .toLowerCase()
                            ===
                            "minute history"
                    );
                }
            );

        if(!minuteHistory){
            return;
        }

        const section =
            document.createElement(
                "div"
            );

        section.id =
            "autoPnlChartSection";

        section.innerHTML = `
            <div id="autoPnlChartHeader">
                <div id="autoPnlChartTitle">
                    P&L HISTORY · 1-MINUTE SNAPSHOTS
                </div>

                <div id="autoPnlChartStatus">
                    --
                </div>
            </div>

            <div id="autoPnlChartWrap">
                <canvas
                    id="autoPnlChart"
                ></canvas>
            </div>
        `;

        /* P&L chart MUST sit directly above minute history. */
        minuteHistory.parentNode.insertBefore(
            section,
            minuteHistory
        );
    }


    // ========================================================
    // ACTIVE TAB
    // ========================================================

    function activateTab(
        runId
    ){

        activeRun =
            RUNS.includes(runId)
                ? runId
                : "0916";

        document
            .querySelectorAll(
                "#proSimRoot .pro-sim-tab"
            )
            .forEach(
                button => {

                    button.classList.toggle(
                        "active",
                        button.dataset.run
                        ===
                        activeRun
                    );

                }
            );
    }


    // ========================================================
    // NOW BUTTON
    // ========================================================

    function updateNowButton(
        state
    ){

        const button =
            document.getElementById(
                "proStartNowButton"
            );

        if(!button){
            return;
        }

        const requested =
            !!state?.request_timestamp;

        const scheduled =
            !!state?.scheduled_start;

        const running =
            !!state?.started
            &&
            !state?.completed;

        const completed =
            !!state?.completed;

        if(
            requested
            &&
            !running
            &&
            !completed
        ){

            button.disabled =
                true;

            button.dataset.nowState =
                "scheduled";

            button.textContent =
                state.scheduled_start
                    ? (
                        "NOW · START "
                        +
                        new Date(
                            state.scheduled_start
                        ).toLocaleTimeString(
                            [],
                            {
                                hour:"2-digit",
                                minute:"2-digit",
                                second:"2-digit",
                                hour12:false
                            }
                        )
                    )
                    : "NOW · SCHEDULED";

            return;
        }


        if(running){

            button.disabled =
                true;

            button.dataset.nowState =
                "running";

            button.textContent =
                "NOW · LIVE";

            return;
        }


        if(completed){

            button.disabled =
                false;

            button.dataset.nowState =
                "completed";

            button.textContent =
                "START NOW";

            return;
        }


        button.disabled =
            false;

        button.dataset.nowState =
            "";

        button.textContent =
            "START NOW";
    }


    // ========================================================
    // RENDER ACTIVE RUN
    // ========================================================

    function renderRun(
        state
    ){

        if(!state){
            return;
