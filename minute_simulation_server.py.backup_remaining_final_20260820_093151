    // ========================================================
    // MINUTE HISTORY TABLE

    // ========================================================

    function renderHistory(
        state
    ){

        const tbody =
            el(
                "proHistoryTable"
            );

        if(!tbody){
            return;
        }

        const rows =
            Array.isArray(
                state.history
            )
                ? state.history
                : [];

        if(!rows.length){

            tbody.innerHTML =
                `
                <tr>
                    <td
                        colspan="9"
                        class="pro-empty"
                    >
                        No minute snapshot yet
                    </td>
                </tr>
                `;

            return;
        }

        tbody.innerHTML =
            rows
                .slice()
                .reverse()
                .map(
                    row => `
                    <tr>

                        <td>
                            ${(row.timestamp || "")
                                .split("T")[1]
                                ?.split("+")[0]
                                || "--"}
                        </td>

                        <td>
                            ${fmt(
                                row.synthetic_future ??
                                row.spot,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.actual_future ??
                                row.future,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.atm,
                                0
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.current_ce ??
                                row.ce,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.current_pe ??
                                row.pe,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.straddle ??
                                row.current_straddle,
                                2
                            )}
                        </td>

                        <td>
                            ${fmt(
                                row.delta,
                                5
                            )}
                        </td>

                        <td class="${pnlClass(
                            row.total_pnl ??
                            row.total
                        )}">
                            ${signed(
                                row.total_pnl ??
                                row.total,
                                2
                            )}
                        </td>

                    </tr>
                    `
                )
                .join("");
    }


    // ========================================================
    // P&L HISTORY · 1-MINUTE SNAPSHOTS LINE CHART
    //
    // One point per history record.
    // The existing simulator history is minute-based.
    // ========================================================

    function drawPnlHistory(
        history,
        state
    ){

        ensureChart();

        const canvas =
            el(
                "autoPnlChart"
            );

        const section =
            el(
                "autoPnlChartSection"
            );

        const status =
            el(
                "autoPnlChartStatus"
            );

        if(
            !canvas
            ||
            !section
        ){
            return;
        }

        if(status){

            status.textContent =
                state.run_id
                +
                " · "
                +
                history.length
                +
                " minute point"
                +
                (
                    history.length === 1
                        ? ""
                        : "s"
                );

        }

        const rect =
            canvas.getBoundingClientRect();

        const dpr =
            window.devicePixelRatio || 1;

        const width =
            Math.max(
                1,
                Math.floor(
                    rect.width * dpr
                )
            );

        const height =
            Math.max(
                1,
                Math.floor(
                    rect.height * dpr
                )
            );

        canvas.width =
            width;

        canvas.height =
            height;

        const ctx =
            canvas.getContext(
                "2d"
            );

        ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
        );

        const w =
            rect.width;

        const h =
            rect.height;

        ctx.clearRect(
            0,
            0,
            w,
            h
        );

        /*
         * No data => genuinely blank chart.
         */
        if(
            !Array.isArray(history)
            ||
            history.length === 0
        ){

            section.classList.add(
                "blank-history"
            );

            return;
        }

        section.classList.remove(
            "blank-history"
        );

        const points =
            history
                .map(
                    row => ({
                        value:
                            num(
                                row.total_pnl ??
                                row.total
                            ),

                        time:
                            row.timestamp
                    })
                )
                .filter(
                    point =>
                        point.value !== null
                );

        if(!points.length){
            return;
        }

        const values =
            points.map(
                point =>
                    point.value
            );

        const min =
            Math.min(
                ...values,
                0
            );

        const max =
            Math.max(
                ...values,
                0
            );

        const range =
            Math.max(
                max - min,
                0.000001
            );

        const left = 38;
        const right = 12;
        const top = 12;
        const bottom = 22;

        /*
         * Horizontal zero line.
         */
        const zeroY =
            h
            -
            bottom
            -
            (
                (0 - min)
                /
                range
            )
            *
            (
                h
                -
                top
                -
                bottom
            );

        ctx.strokeStyle =
            "#24384d";

        ctx.lineWidth = 1;

        ctx.beginPath();

        ctx.moveTo(
            left,
            zeroY
        );

        ctx.lineTo(
            w - right,
            zeroY
        );

        ctx.stroke();


        /*
         * Grid lines.
         */
        ctx.strokeStyle =
            "#122335";

        for(
            let i=1;
            i<4;
            i++
        ){

            const y =
                top
                +
                i / 4
                *
                (
                    h
                    -
                    top
                    -
                    bottom
                );

            ctx.beginPath();

            ctx.moveTo(
                left,
                y
            );

            ctx.lineTo(
                w-right,
                y
            );

            ctx.stroke();
        }


        /*
         * P&L line.
         */
        ctx.strokeStyle =
            "#35d07f";

        ctx.lineWidth = 2;

        ctx.beginPath();

        points.forEach(
            (point,index) => {

                const x =
                    left
                    +
                    (
                        index
                        /
                        Math.max(
                            points.length-1,
                            1
                        )
                    )
                    *
                    (
                        w-left-right
                    );

                const y =
                    h
                    -
                    bottom
                    -
                    (
                        (point.value - min)
                        /
                        range
                    )
                    *
                    (
                        h-top-bottom
                    );

                if(index === 0){
                    ctx.moveTo(
                        x,
                        y
                    );
                }else{
                    ctx.lineTo(
                        x,
                        y
                    );
                }

            }
        );

        ctx.stroke();


        /*
         * Points.
         */
        ctx.fillStyle =
            "#35d07f";

        points.forEach(
            (point,index) => {

                const x =
                    left
                    +
                    (
                        index
                        /
                        Math.max(
                            points.length-1,
                            1
                        )
                    )
                    *
                    (
                        w-left-right
                    );

                const y =
                    h
                    -
                    bottom
                    -
                    (
                        (point.value - min)
                        /
                        range
                    )
                    *
                    (
                        h-top-bottom
                    );

                ctx.beginPath();

                ctx.arc(
                    x,
                    y,
                    2.5,
                    0,
                    Math.PI*2
                );

                ctx.fill();

            }
        );


        /*
         * Current value.
         */
        const last =
            points[
                points.length-1
            ];

        ctx.fillStyle =
            "#e8f0f8";

        ctx.font =
            "9px system-ui";

        ctx.fillText(
            "P&L " +
            signed(
                last.value,
                2
            ),
            left,
            10
        );


        /*
         * Time labels for first/last minute.
         */
        ctx.fillStyle =
            "#8ea2b8";

        ctx.font =
            "8px system-ui";

        if(
            points[0].time
        ){

            ctx.fillText(
                points[0].time
                    .split("T")[1]
                    ?.split("+")[0]
                    || "",
                left,
                h-4
            );

        }

        if(
            last.time
        ){

            ctx.textAlign =
                "right";

            ctx.fillText(
                last.time
                    .split("T")[1]
                    ?.split("+")[0]
                    || "",
                w-right,
                h-4
            );

            ctx.textAlign =
                "left";
        }
    }


    // ========================================================
    // FETCH ALL RUNS
    // ========================================================

    async function fetchAllRuns(){

        if(polling){
            return;
        }

        polling = true;

        try{

            const response =
                await fetch(
                    "/api/runs?ts="
                    +
                    Date.now(),
                    {
                        cache:"no-store"
                    }
                );

            if(!response.ok){
                throw new Error(
                    "HTTP "
                    +
                    response.status
                );
            }

            const payload =
                await response.json();

            const runs =
                payload.runs || {};

            RUNS.forEach(
                runId => {

                    if(
                        runs[runId]
                    ){
                        cache[runId] =
                            runs[runId];
                    }

                }
            );

            const active =
                cache[
                    activeRun
                ];

            if(active){

                const key =
                    renderKey(
                        active
                    );

                if(
                    renderedKeys[
                        activeRun
                    ] !== key
                ){

                    renderedKeys[
                        activeRun
                    ] = key;

                    renderRun(
                        active
                    );
                }
            }

        }catch(error){

            console.error(
                "[PER RUN UI]",
                error
            );

        }finally{

            polling = false;
        }
    }


    // ========================================================
    // START NOW
    // ========================================================

    async function requestNow(){

        const current =
            cache[
                "NOW"
            ];

        /*
         * Backend state is authoritative.
         */
        if(
            current
            &&
            !current.completed
            &&
            (
                current.request_timestamp
                ||
                current.started
                ||
                current.armed
            )
        ){
            activateTab(
                "NOW"
            );

            renderRun(
                current
            );

            return;
        }

        try{

            activateTab(
                "NOW"
            );

            const response =
                await fetch(
                    "/api/runs/NOW/start?ts="
                    +
                    Date.now(),
                    {
                        cache:"no-store"
                    }
                );

            if(!response.ok){
                throw new Error(
                    "HTTP "
                    +
                    response.status
                );
            }

            const state =
                await response.json();

            cache[
                "NOW"
            ] =
                state.state
                ||
                state;

            renderedKeys[
                "NOW"
            ] =
                renderKey(
                    cache[
                        "NOW"
                    ]
                );

            renderRun(
                cache[
                    "NOW"
                ]
            );

        }catch(error){

            console.error(
                "[NOW START]",
                error
            );

        }

    }


    // ========================================================
    // INSTALL TAB EVENTS
    // ========================================================

    function installTabs(){

        const root =
            el(
                "proSimRoot"
            );

        if(!root){
            return;
        }

        root
            .querySelectorAll(
                ".pro-sim-tab"
            )
            .forEach(
                button => {

                    if(
                        button.dataset
                            .autoRunBound
                    ){
                        return;
                    }

                    button.dataset
                        .autoRunBound =
                        "1";

                    button.addEventListener(
                        "click",
                        event => {

                            const runId =
                                button.dataset.run;

                            /*
                             * NOW is a RESULT TAB only.
                             * It never starts a simulation.
                             */
                            activateTab(
                                runId
                            );

                            if(
                                cache[runId]
                            ){

                                const state =
                                    cache[runId];

                                renderedKeys[
                                    runId
                                ] =
                                    renderKey(
                                        state
                                    );

                                renderRun(
                                    state
                                );

                            }

                        },
                        true
                    );

                }
            );

    }



    function installStartNowButton(){

        const button =
            document.getElementById(
                "proStartNowButton"
            );

        if(
            !button
            ||
            button.dataset.autoRunBound
        ){
            return;
        }

        button.dataset.autoRunBound =
            "1";

        button.addEventListener(
            "click",
            async event => {

                event.preventDefault();
                event.stopPropagation();

                if(
                    button.disabled
                ){
                    return;
                }

                await requestNow();

            }
        );
    }


    // ========================================================
    // MAIN LOOP
    // ========================================================

    function boot(){

        ensureChart();
        installTabs();
        installStartNowButton();

        fetchAllRuns();

        setInterval(
            () => {

                installTabs();
                installStartNowButton();
                ensureChart();
                fetchAllRuns();

            },
            1000
        );

        window.addEventListener(
            "resize",
            () => {

                const state =
                    cache[
                        activeRun
                    ];

                if(state){

                    drawPnlHistory(
                        Array.isArray(
                            state.history
                        )
                            ? state.history
                            : [],
                        state
                    );

                }

            }
        );

    }


    if(
        document.readyState
        ===
        "loading"
    ){

        document.addEventListener(
            "DOMContentLoaded",
            boot,
            {once:true}
        );

    }else{

        boot();

    }

})();
</script>


