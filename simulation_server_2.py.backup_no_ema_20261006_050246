@dataclass
class OptionQuote:
    symbol: str
    expiry: str
    strike: float
    option_type: str
    ltp: Optional[float] = None
    bid: Optional[float] = None
    ask: Optional[float] = None
    iv: Optional[float] = None
    rx_monotonic: float = 0.0
    timestamp: Optional[str] = None

    def as_dict(self) -> dict[str, Any]:
        return {
            "symbol": self.symbol,
            "expiry": self.expiry,
            "strike": self.strike,
            "type": self.option_type,
            "ltp": self.ltp,
            "bid": self.bid,
            "ask": self.ask,
            "iv": self.iv,
            "rx": self.rx_monotonic,
            "timestamp": self.timestamp,
        }


class MarketBook:
    """One synchronized in-memory market book shared by all simulations."""

    def __init__(self) -> None:
        self.lock = threading.RLock()
        self.options: dict[tuple[str, int, str], OptionQuote] = {}
        self.synthetic_by_expiry: dict[str, float] = {}
        self.synthetic_rx_by_expiry: dict[str, float] = {}
        self.future_by_expiry: dict[str, float] = {}
        self.future_rx_by_expiry: dict[str, float] = {}
        self.latest_rx_monotonic = 0.0
        self.latest_timestamp: Optional[str] = None
        self.selected_expiry: Optional[str] = None
        self.expiry_mode = "auto"

        # Session-wide MARKET ATM straddle data. These start at 09:15 and
        # are independent of whether any simulation trade has entered.
        self.session_extrema_by_expiry: dict[str, dict[str, Any]] = {}
        self.session_history_by_expiry: dict[str, list[dict[str, Any]]] = {}
        self.last_session_minute_by_expiry: dict[str, str] = {}

    @staticmethod
    def _extract_expiry_strike_type(symbol: str, expiry: Any, strike: Any) -> tuple[Optional[str], Optional[float], Optional[str]]:
        text = str(symbol or "").strip().upper()
        exp = str(expiry or "").strip().upper() or None
        st = finite_float(strike)

        # Pipe format: NIFTY|01-SEP-26|24050|CE
        parts = text.split("|")
        if len(parts) >= 4:
            exp = exp or parts[1].strip().upper()
            if st is None:
                st = finite_float(parts[2])
            typ = parts[3].strip().upper()
            if typ in ("CE", "PE"):
                return exp, st, typ
            if typ == "FUT":
                return exp, st or 0.0, "FUT"

        # Compact NSE format: NIFTY26SEP2624050CE
        m = re.search(
            r"NIFTY(\d{2}[A-Z]{3}\d{2})([0-9]+(?:\.[0-9]+)?)(CE|PE)$",
            text,
        )
        if m:
            raw = m.group(1)
            exp = exp or f"{raw[:2]}-{raw[2:5]}-{raw[5:]}"
            st = st if st is not None else finite_float(m.group(2))
            return exp, st, m.group(3)

        typ = "CE" if text.endswith("CE") else "PE" if text.endswith("PE") else None
        return exp, st, typ

    @staticmethod
    def _tick_timestamp(tick: dict[str, Any]) -> Optional[str]:
        value = tick.get("timestamp", tick.get("published_at", tick.get("ts")))
        if value is None:
            return None
        return str(value)

    @staticmethod
    def _quote_value(tick: dict[str, Any], *names: str) -> Optional[float]:
        for name in names:
            if name in tick:
                value = finite_float(tick.get(name))
                if value is not None:
                    return value
        return None

    def ingest(self, tick: dict[str, Any]) -> None:
        if not isinstance(tick, dict):
            return

        msg_type = str(tick.get("type", "")).strip().lower()
        symbol = str(tick.get("symbol", tick.get("sym", ""))).strip()
        if not symbol:
            return

        upper = symbol.upper()
        underlying = str(tick.get("underlying", "")).strip().upper()
        if underlying and underlying != "NIFTY":
            return
        if not underlying and not upper.startswith("NIFTY|") and not upper.startswith("NIFTY2"):
            return
        if upper.startswith("NIFTYNXT50") or upper.startswith("BANKNIFTY"):
            return

        now_mono = monotonic_time.monotonic()
        self.latest_rx_monotonic = now_mono
        self.latest_timestamp = self._tick_timestamp(tick) or iso_now()

        with self.lock:
            # Futures are published separately by the C++ server.
            if msg_type == "future_quote" or upper.startswith("NIFTY|") and upper.endswith("|0|FUT"):
                expiry = str(tick.get("expiry", "")).strip().upper()
                ltp = self._quote_value(tick, "ltp", "last", "price")
                if expiry and ltp is not None and ltp > 0:
                    self.future_by_expiry[expiry] = ltp
                    self.future_rx_by_expiry[expiry] = now_mono
                return

            expiry, strike, option_type = self._extract_expiry_strike_type(
                symbol,
                tick.get("expiry"),
                tick.get("strike"),
            )
            if not expiry or strike is None or option_type not in ("CE", "PE"):
                return

            ltp = self._quote_value(tick, "ltp", "last", "price")
            bid = self._quote_value(tick, "bid1", "bid", "Bid")
            ask = self._quote_value(tick, "ask1", "ask", "Ask")
            iv = iv_decimal(tick.get("iv"))

            key = (expiry, int(round(strike)), option_type)
            q = OptionQuote(
                symbol=symbol,
                expiry=expiry,
                strike=float(strike),
                option_type=option_type,
                ltp=ltp,
                bid=bid,
                ask=ask,
                iv=iv,
                rx_monotonic=now_mono,
                timestamp=self.latest_timestamp,
            )
            self.options[key] = q

            syn = self._quote_value(tick, "syn_fut", "synthetic_future", "synthetic", "spot")
            if syn is not None and syn > 0:
                self.synthetic_by_expiry[expiry] = syn
                self.synthetic_rx_by_expiry[expiry] = now_mono

    def _expiry_candidates_locked(self) -> list[str]:
        """Return all known non-expired expiries ordered by expiry date."""
        now = now_ist().replace(tzinfo=None)
        candidates: list[tuple[datetime, str]] = []
        seen: set[str] = set()

        expiry_candidates = set(self.synthetic_by_expiry)
        expiry_candidates.update(key[0] for key in self.options)
        expiry_candidates.update(self.future_by_expiry)

        for expiry in expiry_candidates:
            if expiry in seen:
                continue
            dt = expiry_sort_key(expiry)
            if dt is None or dt < now:
                continue
            candidates.append((dt, expiry))
            seen.add(expiry)

        candidates.sort(key=lambda x: x[0])
        return [expiry for _, expiry in candidates]

    def expiry_for_role(self, role: str) -> Optional[str]:
        """Return CURRENT or the immediately following NEXT expiry."""
        normalized = str(role or DEFAULT_EXPIRY_VIEW).strip().upper()
        if normalized not in EXPIRY_VIEWS:
            normalized = DEFAULT_EXPIRY_VIEW

        with self.lock:
            candidates = self._expiry_candidates_locked()

            if self.expiry_mode == "manual" and self.selected_expiry:
                current = self.selected_expiry
                if normalized == "CURRENT":
                    return current
                current_dt = expiry_sort_key(current)
                if current_dt is None:
                    return None
                later = [
                    x for x in candidates
                    if x != current
                    and expiry_sort_key(x) is not None
                    and expiry_sort_key(x) > current_dt
                ]
                return later[0] if later else None

            if not candidates:
                return None
            if normalized == "CURRENT":
                return candidates[0]

            # NEXT is the immediate weekly, not simply candidates[1].
            # If the expected weekly is not present in the feed yet, return
            # None instead of incorrectly labelling a later monthly expiry as NEXT.
            expected = expected_next_nifty_weekly_expiry(candidates[0])
            return expected if expected in candidates else None

    def update_session_snapshot(self, expiry: str, snapshot: Optional[dict[str, Any]]) -> Optional[dict[str, Any]]:
        """Update 09:15+ extrema and one persistable minute snapshot."""
        if not snapshot:
            return None

        # Use the actual Trading Terminal timestamp.
        raw_market_timestamp = (
            snapshot.get("receive_time")
            or snapshot.get("timestamp")
        )

        try:
            now = (
                parse_timestamp(raw_market_timestamp)
                if raw_market_timestamp
                else None
            )
        except Exception:
            now = None

        if now is None:
            now = now_ist()
        if now.time() < MARKET_OPEN or now.time() > MARKET_CLOSE:
            return None

        straddle = finite_float(snapshot.get("straddle"))
        if straddle is None or straddle <= 0:
            return None

        with self.lock:
            ext = self.session_extrema_by_expiry.setdefault(
                expiry,
                {
                    "min_straddle": straddle,
                    "max_straddle": straddle,
                    "first_timestamp": now.isoformat(timespec="seconds"),
                    "last_timestamp": now.isoformat(timespec="seconds"),
                    "observations": 0,
                },
            )

            ext["min_straddle"] = min(float(ext.get("min_straddle", straddle)), straddle)
            ext["max_straddle"] = max(float(ext.get("max_straddle", straddle)), straddle)
            ext["last_timestamp"] = now.isoformat(timespec="seconds")
            ext["observations"] = int(ext.get("observations", 0)) + 1

            # User-requested minute persistence begins at 09:16; extrema begin
            # at 09:15 and therefore include the 09:15 market snapshot.
            if now.time() < time(9, 16):
                return None

            minute_key = now.strftime("%Y-%m-%d %H:%M")
            if self.last_session_minute_by_expiry.get(expiry) == minute_key:
                return None

            self.last_session_minute_by_expiry[expiry] = minute_key
            row = {
                "timestamp": now.isoformat(timespec="seconds"),
                "expiry": expiry,
                "spot": finite_float(snapshot.get("spot")),
                "synthetic_future": finite_float(snapshot.get("synthetic_future")),
                "atm": finite_float(snapshot.get("atm")),
                "ce": finite_float(snapshot.get("ce_ltp")),
                "pe": finite_float(snapshot.get("pe_ltp")),
                "straddle": straddle,
                "min_straddle": ext["min_straddle"],
                "max_straddle": ext["max_straddle"],
            }
            history = self.session_history_by_expiry.setdefault(expiry, [])
            history.append(row)
            del history[:-MARKET_HISTORY_LIMIT]
            return row

    def restore_session_history(self, expiry: str, rows: list[dict[str, Any]]) -> None:
        with self.lock:
            cleaned = [row for row in rows if isinstance(row, dict)][-MARKET_HISTORY_LIMIT:]
            self.session_history_by_expiry[expiry] = cleaned

            values = [finite_float(row.get("straddle")) for row in cleaned]
            values = [x for x in values if x is not None and x > 0]
            cumulative_mins = [finite_float(row.get("min_straddle")) for row in cleaned]
            cumulative_maxs = [finite_float(row.get("max_straddle")) for row in cleaned]
            cumulative_mins = [x for x in cumulative_mins if x is not None and x > 0]
            cumulative_maxs = [x for x in cumulative_maxs if x is not None and x > 0]
            if values or cumulative_mins or cumulative_maxs:
                self.session_extrema_by_expiry[expiry] = {
                    "min_straddle": min(cumulative_mins or values),
                    "max_straddle": max(cumulative_maxs or values),
                    "first_timestamp": cleaned[0].get("timestamp"),
                    "last_timestamp": cleaned[-1].get("timestamp"),
                    "observations": len(values),
                }
                last_ts = parse_timestamp(cleaned[-1].get("timestamp"))
                if last_ts is not None:
                    self.last_session_minute_by_expiry[expiry] = last_ts.strftime("%Y-%m-%d %H:%M")

    def session_extrema(self, expiry: Optional[str]) -> dict[str, Any]:
        if not expiry:
            return {}
        with self.lock:
            return dict(self.session_extrema_by_expiry.get(expiry) or {})

    def session_history(self, expiry: Optional[str]) -> list[dict[str, Any]]:
        if not expiry:
            return []
        with self.lock:
            return list(self.session_history_by_expiry.get(expiry) or [])

    def _available_expiries_locked(self) -> list[str]:
        now = now_ist().replace(tzinfo=None)
        result: list[tuple[datetime, str]] = []
        seen: set[str] = set()

        expiry_candidates = set(self.synthetic_by_expiry)
        expiry_candidates.update(key[0] for key in self.options)
        expiry_candidates.update(self.future_by_expiry)

        for expiry in expiry_candidates:
            if expiry in seen:
                continue
            dt = expiry_sort_key(expiry)
            if dt is None or dt < now:
                continue

            has_pair = False
            strike = self._atm_strike_locked(expiry)
            if strike is not None:
                ce = self.options.get((expiry, strike, "CE"))
                pe = self.options.get((expiry, strike, "PE"))
                has_pair = bool(
                    ce and pe
                    and ce.ltp is not None and ce.ltp > 0
                    and pe.ltp is not None and pe.ltp > 0
                )
            if has_pair:
                result.append((dt, expiry))
                seen.add(expiry)

        result.sort(key=lambda x: x[0])
        return [expiry for _, expiry in result]

    def available_expiries(self) -> list[str]:
        with self.lock:
            return self._available_expiries_locked()

    def _atm_strike_locked(self, expiry: str, synthetic: Optional[float] = None) -> Optional[int]:
        syn = synthetic if synthetic is not None else self.synthetic_by_expiry.get(expiry)
        if syn is None or syn <= 0:
            return None
        return int(round(syn / 50.0) * 50)

    def _nearest_expiry_candidate_locked(self) -> Optional[str]:
        """Return the nearest non-expired expiry known to the feed."""
        candidates = self._expiry_candidates_locked()
        return candidates[0] if candidates else None

    def choose_expiry(self) -> Optional[str]:
        with self.lock:
            if self.expiry_mode == "manual" and self.selected_expiry:
                return self.selected_expiry

            return self._nearest_expiry_candidate_locked()

    def set_expiry(self, expiry: Optional[str]) -> tuple[bool, Optional[str], list[str]]:
        requested = str(expiry or "").strip().upper()
        with self.lock:
            available = self._available_expiries_locked()
            if not requested or requested == "AUTO":
                self.expiry_mode = "auto"
                self.selected_expiry = None
                target = available[0] if available else None
                return True, target, available
            if requested not in available:
                return False, None, available
            self.expiry_mode = "manual"
            self.selected_expiry = requested
            return True, requested, available

    def _fresh(self, rx: Optional[float], max_age: float = 2.0) -> bool:
        return rx is not None and rx > 0 and monotonic_time.monotonic() - rx <= max_age

    def _snapshot_for_expiry_locked(self, expiry: str) -> Optional[dict[str, Any]]:
        syn = self.synthetic_by_expiry.get(expiry)
        syn_rx = self.synthetic_rx_by_expiry.get(expiry)
        if syn is None or syn <= 0 or not self._fresh(syn_rx):
            return None

        atm = self._atm_strike_locked(expiry, syn)
        if atm is None:
            return None
        ce = self.options.get((expiry, atm, "CE"))
        pe = self.options.get((expiry, atm, "PE"))
        if ce is None or pe is None:
            return None
        if not self._fresh(ce.rx_monotonic) or not self._fresh(pe.rx_monotonic):
            return None
        if ce.ltp is None or pe.ltp is None or ce.ltp <= 0 or pe.ltp <= 0:
            return None

        return {
            "expiry": expiry,
            "spot": float(syn),
            "synthetic_future": float(syn),
            "atm": float(atm),
            "ce": ce,
            "pe": pe,
            "ce_ltp": float(ce.ltp),
            "pe_ltp": float(pe.ltp),
            "straddle": float(ce.ltp + pe.ltp),
            "receive_time": ce.timestamp or pe.timestamp or self.latest_timestamp,
        }

    def current_snapshot(self, expiry: Optional[str] = None) -> Optional[dict[str, Any]]:
        with self.lock:
            selected = expiry or self.choose_expiry()
            if not selected:
                return None
            return self._snapshot_for_expiry_locked(selected)

    def position_quotes(self, expiry: str, ce_symbol: str, pe_symbol: str) -> tuple[Optional[OptionQuote], Optional[OptionQuote]]:
        with self.lock:
            ce: Optional[OptionQuote] = None
            pe: Optional[OptionQuote] = None
            for q in self.options.values():
                if q.expiry != expiry:
                    continue
                if q.symbol == ce_symbol:
                    ce = q
                elif q.symbol == pe_symbol:
                    pe = q
                if ce is not None and pe is not None:
                    break
            return ce, pe


