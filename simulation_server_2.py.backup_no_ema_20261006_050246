class SimulationController:
    def __init__(self, persistence: Persistence) -> None:
        self.lock = threading.RLock()
        self.book = MarketBook()
        self.persistence = persistence
        self.trade_date = now_ist().date().isoformat()

        self.runs_by_view: dict[str, dict[str, MinuteSimulation]] = {
            view: {
                run_id: MinuteSimulation(
                    run_id=run_id,
                    book=self.book,
                    persistence=persistence,
                    trade_date=self.trade_date,
                    expiry_view=view,
                )
                for run_id in RUN_IDS
            }
            for view in EXPIRY_VIEWS
        }

        # Backward-compatible CURRENT alias.
        self.runs = self.runs_by_view[DEFAULT_EXPIRY_VIEW]
        self.now_consumed = {view: False for view in EXPIRY_VIEWS}
        self.selected_view = DEFAULT_EXPIRY_VIEW
        self.auto_run_next_expiry = AUTO_NEXT_EXPIRY_DEFAULT
        self._restore_today()

    def _normalize_view(self, view: Optional[str]) -> str:
        value = str(view or DEFAULT_EXPIRY_VIEW).strip().upper()
        return value if value in EXPIRY_VIEWS else DEFAULT_EXPIRY_VIEW

    def _runs_for_view(self, view: Optional[str] = None) -> dict[str, MinuteSimulation]:
        return self.runs_by_view[self._normalize_view(view)]

    def _restore_today(self) -> None:
        market_history = self.persistence.load_market_history(self.trade_date)
        for expiry, rows in market_history.items():
            self.book.restore_session_history(expiry, rows)

        for view in EXPIRY_VIEWS:
            stored = self.persistence.load_today(self.trade_date, view)
            for run_id, payload in stored.items():
                sim = self.runs_by_view[view].get(run_id)
                if sim is None:
                    continue
                try:
                    sim.restore(payload)
                    sim.expiry_view = view
                    if run_id == "NOW" and (sim.armed or sim.started or sim.completed):
                        self.now_consumed[view] = True
                    print(
                        f"[DB] restored view={view} run={run_id} "
                        f"status={sim.status} expiry={sim.entry_expiry}"
                    )
                except Exception as exc:
                    print(
                        f"[DB] restore failed view={view} run={run_id}: {exc!r}"
                    )

        saved_view = self.persistence.load_config("selected_expiry_view")
        self.selected_view = self._normalize_view(saved_view)

        saved_auto = self.persistence.load_config("auto_run_next_expiry")
        if saved_auto is not None:
            self.auto_run_next_expiry = str(saved_auto).strip().lower() in {
                "1", "true", "yes", "on"
            }

        saved_expiry = self.persistence.load_config("selected_expiry")
        if saved_expiry:
            parsed = parse_expiry_date(saved_expiry)
            today = now_ist().date()
            if parsed is not None and parsed.date() >= today:
                self.book.selected_expiry = saved_expiry
                self.book.expiry_mode = "manual"
            else:
                self.book.selected_expiry = None
                self.book.expiry_mode = "auto"
                self.persistence.save_config("selected_expiry", None)

    def select_view(self, view: Optional[str]) -> tuple[bool, str, Optional[str], Optional[str]]:
        normalized = self._normalize_view(view)
        with self.lock:
            current_expiry = self.book.expiry_for_role("CURRENT")
            next_expiry = self.book.expiry_for_role("NEXT")
            if normalized == "NEXT" and next_expiry is None:
                return False, self.selected_view, current_expiry, next_expiry
            self.selected_view = normalized
            self.persistence.save_config("selected_expiry_view", normalized)
            return True, normalized, current_expiry, next_expiry

    def set_auto_next_expiry(self, enabled: Any) -> bool:
        with self.lock:
            self.auto_run_next_expiry = bool(enabled)
            self.persistence.save_config(
                "auto_run_next_expiry",
                "1" if self.auto_run_next_expiry else "0",
            )
            return self.auto_run_next_expiry

    def select_expiry(self, expiry: Optional[str]) -> tuple[bool, Optional[str], list[str]]:
        with self.lock:
            ok, target, available = self.book.set_expiry(expiry)
            if ok:
                self.persistence.save_config(
                    "selected_expiry",
                    self.book.selected_expiry,
                )
            return ok, target, available

    def start_now(self) -> MinuteSimulation:
        with self.lock:
            view = self.selected_view
            sim = self.runs_by_view[view]["NOW"]
            if self.now_consumed[view] or sim.started or sim.completed:
                raise RuntimeError(f"NOW simulation already consumed for {view} today")

            expiry = self.book.expiry_for_role(view)
            if not expiry:
                raise RuntimeError("NO_READY_EXPIRY")

            sim.arm(iso_now())
            sim.start_timestamp = iso_now()
            self.now_consumed[view] = True

            snapshot = self.book.current_snapshot(expiry)
            sim.process_snapshot(snapshot)
            return sim

    def start_fixed_if_due(self, run_id: str, view: str) -> None:
        if run_id not in RUN_STARTS:
            return
        if view == "NEXT" and not self.auto_run_next_expiry:
            return

        now = now_ist()
        start_hour, start_minute = RUN_STARTS[run_id]
        sim = self.runs_by_view[view][run_id]

        if sim.started or sim.completed or sim.armed:
            return
        if now.hour != start_hour or now.minute != start_minute:
            return

        timestamp = now.isoformat(timespec="seconds")
        sim.arm(timestamp)
        sim.start_timestamp = timestamp

    def _record_backend_market_state(self, expiry: str, snapshot: Optional[dict[str, Any]]) -> None:
        if not snapshot:
            return
        row = self.book.update_session_snapshot(expiry, snapshot)
        if row is not None:
            self.persistence.save_market_minute(self.trade_date, expiry, row)

    def on_market_tick(self) -> None:
        with self.lock:
            # --------------------------------------------------------
            # MARKET DATA / EXTREMA COLLECTION
            # --------------------------------------------------------
            #
            # Always collect BOTH expiry books from 09:15 onward. This is
            # independent of whether NEXT simulation lanes are enabled and
            # independent of which view is currently visible in the UI.
            # Therefore CURRENT and NEXT each get their own full-session
            # min/max and minute history.
            # --------------------------------------------------------
            market_views = list(EXPIRY_VIEWS)
            for view in market_views:
                expiry = self.book.expiry_for_role(view)
                if not expiry:
                    continue
                snapshot = self.book.current_snapshot(expiry)
                self._record_backend_market_state(expiry, snapshot)

            # --------------------------------------------------------
            # SIMULATION LANES
            # --------------------------------------------------------
            # NEXT lanes are optional; backend market/extrema collection
            # above is NOT optional.
            run_views = ["CURRENT"]
            if self.auto_run_next_expiry:
                run_views.append("NEXT")

            # Arm all fixed lanes at their exact scheduled minutes.
            for view in run_views:
                for run_id in RUN_STARTS:
                    self.start_fixed_if_due(run_id, view)

            # Process each lane against its own expiry dataset.
            for view in run_views:
                for sim in self.runs_by_view[view].values():
                    if not sim.armed and not sim.started:
                        continue

                    expiry = sim.entry_expiry or self.book.expiry_for_role(view)
                    if not expiry:
                        continue

                    snapshot = self.book.current_snapshot(expiry)
                    sim.process_snapshot(snapshot)

    def clear_run(self, run_id: str, view: Optional[str] = None) -> None:
        normalized = self._normalize_view(view or self.selected_view)
        sim = self.runs_by_view[normalized].get(run_id)
        if sim is None:
            raise KeyError(run_id)
        sim.clear()
        if run_id == "NOW":
            self.now_consumed[normalized] = False

    def state(self, run_id: Optional[str] = None, view: Optional[str] = None) -> Any:
        normalized = self._normalize_view(view or self.selected_view)
        with self.lock:
            if run_id is None:
                return {
                    rid: sim.snapshot()
                    for rid, sim in self.runs_by_view[normalized].items()
                }
            sim = self.runs_by_view[normalized].get(run_id)
            if sim is None:
                raise KeyError(run_id)
            return sim.snapshot()

    def view_state(self) -> dict[str, Any]:
        with self.lock:
            current_expiry = self.book.expiry_for_role("CURRENT")
            next_expiry = self.book.expiry_for_role("NEXT")
            selected_expiry = current_expiry if self.selected_view == "CURRENT" else next_expiry
            return {
                "selected_view": self.selected_view,
                "selected_expiry": selected_expiry,
                "current_expiry": current_expiry,
                "next_expiry": next_expiry,
                "auto_run_next_expiry": self.auto_run_next_expiry,
            }

    def market_state(self, view: Optional[str] = None) -> dict[str, Any]:
        normalized = self._normalize_view(view or self.selected_view)
        expiry = self.book.expiry_for_role(normalized)
        return {
            "view": normalized,
            "expiry": expiry,
            "extrema": self.book.session_extrema(expiry),
            "history": self.book.session_history(expiry),
        }


