            self.history.clear()
            self.hedge_events.clear()
            self.trade_history.clear()
            self.last_minute_key = None
            self.last_hedge_minute_key = None
        self.persistence.clear_run(
            self.trade_date,
            self.run_id,
            self.expiry_view,
        )

    def restore(self, payload: dict[str, Any]) -> None:
        """
        Restore a simulation from the exact structure produced by snapshot().

        snapshot() stores runtime state in nested sections:
            entry / market / position / greeks / reference /
            hedge / pnl / exit

        Older restore logic expected many of these values at the payload
        top level, so a restart could restore the status flags while
        leaving the actual trading state missing.
        """
        if not isinstance(payload, dict):
            raise TypeError("restore payload must be a dict")

        with self.lock:
            # --------------------------------------------------------
            # TOP-LEVEL STATE
            # --------------------------------------------------------
            for name in (
                "armed",
                "started",
                "completed",
                "request_timestamp",
                "start_timestamp",
                "expiry_view",
                "entry_block_reason",
                "last_minute_key",
                "last_hedge_minute_key",
            ):
                if name in payload:
                    setattr(self, name, payload[name])

            # --------------------------------------------------------
            # ENTRY
            # --------------------------------------------------------
            entry = payload.get("entry") or {}

            entry_map = {
                "timestamp": "entry_timestamp",
                "expiry": "entry_expiry",
                "atm": "entry_atm",
                "ce": "entry_ce_symbol",
                "pe": "entry_pe_symbol",
                "ce_price": "entry_ce",
                "pe_price": "entry_pe",
                "straddle": "entry_straddle",
                "spot": "entry_spot",
                "iv": "entry_iv",
                "dte": "entry_dte",
                "quote_source": "entry_quote_source",
            }

            for source_name, attr_name in entry_map.items():
                if source_name in entry:
                    setattr(self, attr_name, entry[source_name])

            # --------------------------------------------------------
            # POSITION
            # --------------------------------------------------------
            position = payload.get("position") or {}

            for source_name, attr_name in (
                ("current_ce", "current_ce"),
                ("current_pe", "current_pe"),
                ("current_straddle", "current_straddle"),
            ):
                if source_name in position:
                    setattr(self, attr_name, position[source_name])

            # --------------------------------------------------------
            # MARKET
            # --------------------------------------------------------
            market = payload.get("market") or {}

            market_map = {
                "spot": "market_spot",
                "atm": "market_atm",
                "ce": "market_ce",
                "pe": "market_pe",
                "straddle": "market_straddle",
                "min_straddle": "min_straddle",
                "max_straddle": "max_straddle",
            }

            for source_name, attr_name in market_map.items():
                if source_name in market:
                    setattr(self, attr_name, market[source_name])

            # --------------------------------------------------------
            # GREEKS
            # --------------------------------------------------------
            greeks = payload.get("greeks") or {}

            greeks_map = {
                "delta": "net_delta",
                "option_delta": "option_delta",
                "display_delta": "smoothed_delta",
                "gamma": "gamma",
                "theta": "theta",
                "vega": "vega",
            }

            for source_name, attr_name in greeks_map.items():
                if source_name in greeks:
                    setattr(self, attr_name, greeks[source_name])

            # --------------------------------------------------------
            # CURRENT ATM REFERENCE
            # --------------------------------------------------------
            reference = payload.get("reference") or {}

            reference_map = {
                "atm": "reference_atm",
                "ce": "reference_ce",
                "pe": "reference_pe",
                "otm_iv": "reference_otm_iv",
            }

            for source_name, attr_name in reference_map.items():
                if source_name in reference:
                    setattr(self, attr_name, reference[source_name])

            # --------------------------------------------------------
            # HEDGE / RISK / TP / SL
            # --------------------------------------------------------
            hedge = payload.get("hedge") or {}

            hedge_map = {
                "current": "hedge",
                "target": "hedge_target",
                "cash": "hedge_cash",
                "initial": "initial_hedge",
                "points_out": "points_out",
                "points_allowed": "points_allowed",
                "tp_bps": "tp_bps",
                "tp_points": "tp_points",
                "sl_points": "sl_points",
                "rtv_value": "rtv_value",
                "rtv_threshold": "rtv_threshold",
                "iv_drop_threshold": "iv_drop_threshold",
                "iv_drop_active": "iv_drop_active",
                "otm_iv": "otm_iv",
                "zero_dte_active": "zero_dte_active",
            }

            for source_name, attr_name in hedge_map.items():
                if source_name in hedge:
                    setattr(self, attr_name, hedge[source_name])

            self.hedge_events = list(
                hedge.get("events")
                or payload.get("hedge_events")
                or []
            )[:MAX_HEDGE_EVENTS]

            # --------------------------------------------------------
            # P&L
            # --------------------------------------------------------
            pnl = payload.get("pnl") or {}

            if "option" in pnl:
                self.option_pnl = pnl["option"]

            if "future" in pnl:
                self.future_pnl = pnl["future"]
            elif "synthetic_hedge" in pnl:
                self.future_pnl = pnl["synthetic_hedge"]

            if "total" in pnl:
                self.total_pnl = pnl["total"]

            # --------------------------------------------------------
            # EXIT
            # --------------------------------------------------------
            exit_state = payload.get("exit") or {}

            if "reason" in exit_state:
                self.exit_reason = exit_state["reason"]

            if "timestamp" in exit_state:
                self.exit_timestamp = exit_state["timestamp"]

            # --------------------------------------------------------
            # HISTORY
            # --------------------------------------------------------
            self.history = list(
                payload.get("history") or []
            )[-MAX_HISTORY:]

            self.trade_history = list(
                payload.get("trade_history") or []
            )[:MAX_TRADE_HISTORY]

            # --------------------------------------------------------
            # BACKWARD COMPATIBILITY WITH FLAT PAYLOADS
            # --------------------------------------------------------
            flat_fields = (
                "entry_timestamp",
                "entry_expiry",
                "entry_atm",
                "entry_ce_symbol",
                "entry_pe_symbol",
                "entry_ce",
                "entry_pe",
                "entry_straddle",
                "entry_spot",
                "entry_iv",
                "entry_dte",
                "entry_quote_source",
                "current_ce",
                "current_pe",
                "current_straddle",
                "min_straddle",
                "max_straddle",
                "market_atm",
                "market_ce",
                "market_pe",
                "market_straddle",
                "market_spot",
                "reference_atm",
                "reference_ce",
                "reference_pe",
                "reference_otm_iv",
                "option_delta",
                "net_delta",
                "delta",
                "smoothed_delta",
                "gamma",
                "theta",
                "vega",
                "hedge",
                "hedge_target",
                "hedge_cash",
                "initial_hedge",
                "points_out",
                "points_allowed",
                "tp_bps",
                "tp_points",
                "sl_points",
                "rtv_value",
                "rtv_threshold",
                "otm_iv",
                "zero_dte_active",
                "iv_drop_threshold",
                "iv_drop_active",
                "option_pnl",
                "future_pnl",
                "total_pnl",
                "exit_reason",
                "entry_block_reason",
                "last_minute_key",
                "last_hedge_minute_key",
            )

            for name in flat_fields:
                if name not in payload:
                    continue

                flat_value = payload[name]
                current_value = getattr(self, name)

                if current_value is None:
                    setattr(self, name, flat_value)

            # --------------------------------------------------------
            # REBUILD TP/SL FOR A RESTORED LIVE POSITION
            # --------------------------------------------------------
            #
            # The database may contain TP values calculated under an
            # older DTE mapping.  For an active restored position,
            # ENTRY IV + ENTRY DTE are the authoritative inputs.
            #
            # Do not recalculate entry, hedge, P&L, or position prices.
            # Only rebuild the TP/SL thresholds.
            # --------------------------------------------------------
            if (
                self.started
                and not self.completed
                and self.entry_iv is not None
                and self.entry_spot is not None
            ):
                restore_dte = self.entry_dte

                if restore_dte is None and self.entry_expiry:
                    restore_dte = trading_dte(
                        self.entry_expiry
                    )

                if restore_dte is not None:
                    self._set_tp_sl(
                        float(restore_dte)
                    )

            # --------------------------------------------------------
            # DERIVE LAST MINUTE KEY IF NECESSARY
            # --------------------------------------------------------
            if not self.last_minute_key and self.history:
                last_row = self.history[-1]

                if isinstance(last_row, dict):
                    last_ts = last_row.get("timestamp")

                    if last_ts:
                        dt = parse_timestamp(last_ts)

                        if dt is not None:
                            self.last_minute_key = dt.strftime(
                                "%Y-%m-%d %H:%M"
                            )

            # --------------------------------------------------------
            # DERIVE LAST HEDGE MINUTE KEY IF NECESSARY
            # --------------------------------------------------------
            if not self.last_hedge_minute_key and self.hedge_events:
                event = self.hedge_events[0]

                if isinstance(event, dict):
                    event_ts = event.get("timestamp")

                    if event_ts:
                        dt = parse_timestamp(event_ts)

                        if dt is not None:
                            self.last_hedge_minute_key = dt.strftime(
                                "%Y-%m-%d %H:%M"
                            )

            # --------------------------------------------------------
            # RESTORE SESSION-WIDE MIN / MAX FROM SHARED MARKET BOOK
            # --------------------------------------------------------
            #
            # IMPORTANT: these are NOT per-lane extrema. Every lane
            # (09:16 / 09:17 / 09:18 / 09:19 / NOW) for the same expiry
            # must use the same intraday min/max, measured from 09:15
            # market open onward. The shared MarketBook stores the
            # extrema independently for CURRENT and NEXT expiry.
            #
            # The previous restore logic rebuilt min/max from each lane's
            # own history. That made a 09:17 lane start its extrema at 09:17,
            # a 09:18 lane start at 09:18, etc. Do not do that.
            # --------------------------------------------------------
            session_expiry = self.entry_expiry
            if session_expiry:
