class Persistence:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock = threading.RLock()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.init_db()

    def connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(self.path, timeout=10.0)
        conn.row_factory = sqlite3.Row
        return conn

    def init_db(self) -> None:
        with self.lock:
            conn = self.connect()
            try:
                conn.execute("PRAGMA journal_mode=WAL")
                conn.execute("PRAGMA synchronous=NORMAL")
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS minute_runs (
                        trade_date TEXT NOT NULL,
                        run_id TEXT NOT NULL,
                        status TEXT NOT NULL,
                        expiry TEXT,
                        updated_at TEXT NOT NULL,
                        payload TEXT NOT NULL,
                        PRIMARY KEY (trade_date, run_id)
                    )
                    """
                )
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS minute_config (
                        key TEXT PRIMARY KEY,
                        value TEXT,
                        updated_at TEXT NOT NULL
                    )
                    """
                )
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS minute_lane_runs (
                        trade_date TEXT NOT NULL,
                        expiry_view TEXT NOT NULL,
                        run_id TEXT NOT NULL,
                        status TEXT NOT NULL,
                        expiry TEXT,
                        updated_at TEXT NOT NULL,
                        payload TEXT NOT NULL,
                        PRIMARY KEY (trade_date, expiry_view, run_id)
                    )
                    """
                )
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS market_minute_history (
                        trade_date TEXT NOT NULL,
                        expiry TEXT NOT NULL,
                        minute_key TEXT NOT NULL,
                        timestamp TEXT NOT NULL,
                        payload TEXT NOT NULL,
                        PRIMARY KEY (trade_date, expiry, minute_key)
                    )
                    """
                )
                conn.commit()
            finally:
                conn.close()

    def save_run(self, run: "MinuteSimulation") -> None:
        payload = json.dumps(json_clean(run.snapshot()), ensure_ascii=False, allow_nan=False)
        status = run.status
        view_mode = str(getattr(run, "expiry_view", DEFAULT_EXPIRY_VIEW)).upper()
        if view_mode not in EXPIRY_VIEWS:
            view_mode = DEFAULT_EXPIRY_VIEW

        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    """
                    INSERT INTO minute_lane_runs
                        (trade_date, expiry_view, run_id, status, expiry, updated_at, payload)
                    VALUES (?, ?, ?, ?, ?, ?, ?)
                    ON CONFLICT(trade_date, expiry_view, run_id)
                    DO UPDATE SET
                        status=excluded.status,
                        expiry=excluded.expiry,
                        updated_at=excluded.updated_at,
                        payload=excluded.payload
                    """,
                    (
                        run.trade_date,
                        view_mode,
                        run.run_id,
                        status,
                        run.entry_expiry,
                        iso_now(),
                        payload,
                    ),
                )

                # Preserve the legacy current-expiry table for compatibility.
                if view_mode == DEFAULT_EXPIRY_VIEW:
                    conn.execute(
                        """
                        INSERT INTO minute_runs
                            (trade_date, run_id, status, expiry, updated_at, payload)
                        VALUES (?, ?, ?, ?, ?, ?)
                        ON CONFLICT(trade_date, run_id)
                        DO UPDATE SET
                            status=excluded.status,
                            expiry=excluded.expiry,
                            updated_at=excluded.updated_at,
                            payload=excluded.payload
                        """,
                        (
                            run.trade_date,
                            run.run_id,
                            status,
                            run.entry_expiry,
                            iso_now(),
                            payload,
                        ),
                    )

                conn.commit()
            finally:
                conn.close()

    def load_today(self, trade_date: str, view_mode: str = DEFAULT_EXPIRY_VIEW) -> dict[str, dict[str, Any]]:
        view_mode = str(view_mode or DEFAULT_EXPIRY_VIEW).upper()
        if view_mode not in EXPIRY_VIEWS:
            view_mode = DEFAULT_EXPIRY_VIEW

        with self.lock:
            conn = self.connect()
            try:
                rows = conn.execute(
                    """
                    SELECT run_id, payload
                    FROM minute_lane_runs
                    WHERE trade_date=? AND expiry_view=?
                    """,
                    (trade_date, view_mode),
                ).fetchall()

                if rows:
                    return {
                        str(row["run_id"]): json.loads(row["payload"])
                        for row in rows
                    }

                # Seamless read of legacy current-expiry rows.
                if view_mode == DEFAULT_EXPIRY_VIEW:
                    rows = conn.execute(
                        "SELECT run_id, payload FROM minute_runs WHERE trade_date=?",
                        (trade_date,),
                    ).fetchall()
                    return {
                        str(row["run_id"]): json.loads(row["payload"])
                        for row in rows
                    }
                return {}
            finally:
                conn.close()

    def save_market_minute(self, trade_date: str, expiry: str, row: dict[str, Any]) -> None:
        parsed = parse_timestamp(row.get("timestamp"))
        minute_key = parsed.strftime("%Y-%m-%d %H:%M") if parsed else str(row.get("timestamp"))
        payload = json.dumps(json_clean(row), ensure_ascii=False, allow_nan=False)
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    """
                    INSERT INTO market_minute_history
                        (trade_date, expiry, minute_key, timestamp, payload)
                    VALUES (?, ?, ?, ?, ?)
                    ON CONFLICT(trade_date, expiry, minute_key)
                    DO UPDATE SET
                        timestamp=excluded.timestamp,
                        payload=excluded.payload
                    """,
                    (
                        trade_date,
                        expiry,
                        minute_key,
                        str(row.get("timestamp") or iso_now()),
                        payload,
                    ),
                )
                conn.commit()
            finally:
                conn.close()

    def load_market_history(self, trade_date: str) -> dict[str, list[dict[str, Any]]]:
        with self.lock:
            conn = self.connect()
            try:
                rows = conn.execute(
                    """
                    SELECT expiry, payload
                    FROM market_minute_history
                    WHERE trade_date=?
                    ORDER BY expiry, minute_key
                    """,
                    (trade_date,),
                ).fetchall()
                out: dict[str, list[dict[str, Any]]] = {}
                for row in rows:
                    out.setdefault(str(row["expiry"]), []).append(json.loads(row["payload"]))
                return out
            finally:
                conn.close()

    def clear_run(self, trade_date: str, run_id: str, view_mode: str = DEFAULT_EXPIRY_VIEW) -> None:
        view_mode = str(view_mode or DEFAULT_EXPIRY_VIEW).upper()
        if view_mode not in EXPIRY_VIEWS:
            view_mode = DEFAULT_EXPIRY_VIEW
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    "DELETE FROM minute_lane_runs WHERE trade_date=? AND expiry_view=? AND run_id=?",
                    (trade_date, view_mode, run_id),
                )
                if view_mode == DEFAULT_EXPIRY_VIEW:
                    conn.execute(
                        "DELETE FROM minute_runs WHERE trade_date=? AND run_id=?",
                        (trade_date, run_id),
                    )
                conn.commit()
            finally:
                conn.close()

    def save_config(self, key: str, value: Optional[str]) -> None:
        with self.lock:
            conn = self.connect()
            try:
                conn.execute(
                    """
                    INSERT INTO minute_config(key, value, updated_at)
                    VALUES (?, ?, ?)
                    ON CONFLICT(key)
                    DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at
                    """,
                    (key, value, iso_now()),
                )
                conn.commit()
            finally:
                conn.close()

    def load_config(self, key: str) -> Optional[str]:
        with self.lock:
            conn = self.connect()
            try:
                row = conn.execute(
                    "SELECT value FROM minute_config WHERE key=?",
                    (key,),
                ).fetchone()
                return str(row["value"]) if row and row["value"] is not None else None
            finally:
                conn.close()


