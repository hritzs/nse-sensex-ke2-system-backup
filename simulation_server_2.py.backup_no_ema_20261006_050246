        with self.lock:
            self.armed = False
            self.started = False
            self.completed = False
            self.request_timestamp = None
            self.start_timestamp = None
            self.entry_timestamp = None
            self.exit_timestamp = None
            self.entry_expiry = None
            self.entry_atm = None
            self.entry_ce_symbol = None
            self.entry_pe_symbol = None
            self.entry_ce = None
            self.entry_pe = None
            self.entry_straddle = None
            self.entry_spot = None
            self.entry_iv = None
            self.entry_dte = None
            self.entry_quote_source = None
            self.current_ce = None
            self.current_pe = None
            self.current_straddle = None
            self.min_straddle = None
            self.max_straddle = None
            self.market_atm = None
            self.market_ce = None
            self.market_pe = None
            self.market_straddle = None
            self.market_spot = None

            self.reference_atm = None
            self.reference_ce = None
            self.reference_pe = None
            self.reference_otm_iv = None

            self.option_delta = None
            self.net_delta = 0.0
            self.delta = None
            self.smoothed_delta = None
            self.gamma = None
            self.theta = None
            self.vega = None
            self.hedge = 0.0
            self.hedge_target = 0.0
            self.hedge_cash = 0.0
            self.initial_hedge = 0.0
            self.points_out = None
            self.points_allowed = None
            self.tp_bps = None
            self.tp_points = None
            self.sl_points = None
            self.rtv_value = None
            self.rtv_threshold = None
            self.otm_iv = None
            self.zero_dte_active = False
            self.iv_drop_active = False
            self.option_pnl = 0.0
