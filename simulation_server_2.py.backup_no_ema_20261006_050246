        if path in ("/app.js", "/styles.css"):
            file_path = FRONTEND_DIR / path.lstrip("/")
            if not file_path.exists():
                self._send({"error": "asset not found"}, 404)
                return
            content_type = "application/javascript; charset=utf-8" if path.endswith(".js") else "text/css; charset=utf-8"
            self._send(file_path.read_bytes(), 200, content_type)
            return

        if path == "/api/health":
            with CONTROLLER.lock:
                self._send(
                    {
                        "status": "OK",
                        "websocket": WEBSOCKET_URI,
                        "db": str(DB_PATH),
                        "trade_date": CONTROLLER.trade_date,
                        "selected_expiry": CONTROLLER.book.selected_expiry,
                        "expiry_mode": CONTROLLER.book.expiry_mode,
                        "option_quotes": len(CONTROLLER.book.options),
                        **CONTROLLER.view_state(),
                    }
                )
            return

        if path in ("/api/expiry-view", "/api/expiry_view"):
            self._send({
                "status": "SUCCESS",
                **CONTROLLER.view_state(),
            })
            return

        if path == "/api/expiries":
            with CONTROLLER.lock:
                self._send(
                    {
                        "status": "SUCCESS",
                        "mode": CONTROLLER.book.expiry_mode,
                        "target_expiry": CONTROLLER.book.choose_expiry(),
                        "selected_expiry": CONTROLLER.book.selected_expiry,
                        "available": CONTROLLER.book.available_expiries(),
                        **CONTROLLER.view_state(),
                    }
                )
            return

        if path == "/api/runs":
            with CONTROLLER.lock:
                selected = CONTROLLER.selected_view
                self._send(
                    {
                        "status": "SUCCESS",
                        "run_ids": list(RUN_IDS),
                        "view": selected,
                        "expiry": CONTROLLER.book.expiry_for_role(selected),
                        "runs": CONTROLLER.state(view=selected),
                    }
                )
            return

        if path == "/api/market-history":
            self._send({
                "status": "SUCCESS",
                **CONTROLLER.market_state(),
            })
            return

        if path.startswith("/api/runs/"):
            run_id = path.rsplit("/", 1)[-1]
            if run_id not in RUN_IDS:
                self._send({"status": "ERROR", "error": "Unknown run", "run_id": run_id}, 404)
                return
            self._send(CONTROLLER.state(run_id))
            return

        self._send({"status": "ERROR", "error": "Not found"}, 404)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        path = parsed.path

        try:
            if path in ("/api/select_expiry_view", "/api/select_view"):
                data = self._read_json()
                ok, selected, current_expiry, next_expiry = CONTROLLER.select_view(
                    data.get("view", data.get("expiry_view"))
                )
                if not ok:
                    self._send(
                        {
                            "status": "ERROR",
                            "error": "NEXT expiry is not currently available",
                            **CONTROLLER.view_state(),
                        },
                        400,
                    )
                    return
                self._send(
                    {
                        "status": "SUCCESS",
                        "selected_view": selected,
                        "current_expiry": current_expiry,
                        "next_expiry": next_expiry,
                        "auto_run_next_expiry": CONTROLLER.auto_run_next_expiry,
                    }
                )
                return

            if path in ("/api/auto-next-expiry", "/api/auto_next_expiry"):
                data = self._read_json()
                value = data.get("enabled", data.get("auto_run_next_expiry"))
                enabled = bool(value)
                if isinstance(value, str):
                    enabled = value.strip().lower() in {"1", "true", "yes", "on"}
                self._send(
                    {
                        "status": "SUCCESS",
                        "auto_run_next_expiry": CONTROLLER.set_auto_next_expiry(enabled),
                        **CONTROLLER.view_state(),
                    }
                )
                return

            if path == "/api/select_expiry":
                data = self._read_json()
                ok, target, available = CONTROLLER.select_expiry(data.get("expiry"))
                if not ok:
                    self._send(
                        {
                            "status": "ERROR",
                            "error": "Expiry is not currently available",
                            "available": available,
                        },
                        400,
                    )
                    return
                self._send(
                    {
                        "status": "SUCCESS",
                        "target_expiry": target,
                        "selected_expiry": CONTROLLER.book.selected_expiry,
                        "available": available,
                        **CONTROLLER.view_state(),
                    }
                )
                return

            if path == "/api/runs/NOW/start":
                sim = CONTROLLER.start_now()
                self._send(
                    {
                        "status": "SUCCESS",
                        "run_id": "NOW",
                        "state": sim.snapshot(),
                    }
                )
                return

            if path.startswith("/api/runs/") and path.endswith("/clear"):
                run_id = path.split("/")[-2]
                if run_id not in RUN_IDS:
                    self._send({"status": "ERROR", "error": "Unknown run"}, 404)
                    return
                CONTROLLER.clear_run(run_id, CONTROLLER.selected_view)
                self._send({
                    "status": "SUCCESS",
                    "run_id": run_id,
                    "view": CONTROLLER.selected_view,
                })
                return

            self._send({"status": "ERROR", "error": "Not found"}, 404)
        except Exception as exc:
            print(f"[HTTP ERROR] {path}: {exc!r}")
            self._send({"status": "ERROR", "error": str(exc)}, 409)

    def log_message(self, fmt: str, *args: Any) -> None:
        return


