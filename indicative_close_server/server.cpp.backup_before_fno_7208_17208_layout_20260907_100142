    static std::string make_json()
    {
        std::lock_guard<std::mutex> lock(
            g_state_mtx
        );

        // --------------------------------------------------------
        // Group futures by symbol.
        // --------------------------------------------------------

        std::map<
            std::string,
            std::vector<const FutureQuote*>
        > grouped;

        for (const auto& kv : g_futures)
        {
            const FutureQuote& q =
                kv.second;

            grouped[q.symbol]
                .push_back(&q);
        }

        for (auto& kv : grouped)
        {
            auto& futures =
                kv.second;

            std::sort(
                futures.begin(),
                futures.end(),
                [](const FutureQuote* a,
                   const FutureQuote* b)
                {
                    return expiry_sort_key(
                        a->expiry
                    ) <
                    expiry_sort_key(
                        b->expiry
                    );
                }
            );
        }

        std::ostringstream out;

        out
            << "{"
            << "\"ok\":true,"
            << "\"timestamp\":\""
            << json_escape(
                now_ist()
            )
            << "\","
            << "\"futures\":[";

        bool first_symbol = true;

        for (
            const auto& kv :
            grouped
        )
        {
            if (!first_symbol)
                out << ",";

            first_symbol = false;

            const std::string& symbol =
                kv.first;

            const auto& futures =
                kv.second;

            out
                << "{"
                << "\"symbol\":\""
                << json_escape(
                    symbol
                )
                << "\","
                << "\"rows\":[";

            bool first_future = true;

            for (
                const auto* q :
                futures
            )
            {
                if (!first_future)
                    out << ",";

                first_future = false;

                out
                    << "{"
                    << "\"expiry\":\""
                    << json_escape(
                        q->expiry
                    )
                    << "\",";

                out
                    << "\"ltp\":";

                if (q->has_ltp)
                    out << std::fixed
                        << std::setprecision(2)
                        << q->ltp;
                else
                    out << "null";

                out
                    << ",\"bid\":";

                if (q->has_bid)
                    out << std::fixed
                        << std::setprecision(2)
                        << q->bid;
                else
                    out << "null";

                out
                    << ",\"ask\":";

                if (q->has_ask)
                    out << std::fixed
                        << std::setprecision(2)
                        << q->ask;
                else
                    out << "null";

                out
                    << ",\"updates\":"
                    << q->updates
                    << "}";
            }

            out
                << "]"
                << "}";
        }

        out
            << "],"
            << "\"indices\":[";

        bool first_index = true;

        for (
            const auto& kv :
            g_indices
        )
        {
            const IndexQuote& q =
                kv.second;

            if (!first_index)
                out << ",";

            first_index = false;

            out
                << "{"
                << "\"name\":\""
                << json_escape(
                    q.name
                )
                << "\",";

            out
                << "\"live\":";

            if (q.has_live)
                out << std::fixed
                    << std::setprecision(2)
                    << q.live_value;
            else
                out << "null";

            out
                << ",\"indicative\":";

            if (q.has_indicative)
                out << std::fixed
                    << std::setprecision(2)
                    << q.indicative_value;
            else
                out << "null";

            out
                << "}";
        }

        out
            << "],"
            << "\"diag\":{"
            << "\"udp_packets\":"
            << g_udp_packets
            << ","
            << "\"decomp_ok\":"
            << g_decomp_ok
            << ","
            << "\"decomp_fail\":"
            << g_decomp_fail
            << ","
            << "\"tx_7207\":"
            << g_tx_7207
            << ","
            << "\"tx_7208\":"
            << g_tx_7208
            << ","
            << "\"tx_8207\":"
            << g_tx_8207
            << ","
            << "\"tx_17208\":"
            << g_tx_17208
            << ","
            << "\"future_updates\":"
            << g_future_updates
            << ","
            << "\"unknown_future_tokens\":"
            << g_unknown_future_tokens
            << "}"
            << "}";

        return out.str();
    }

