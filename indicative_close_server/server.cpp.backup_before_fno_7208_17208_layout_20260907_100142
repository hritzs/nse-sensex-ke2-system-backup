    // ============================================================
    // PROCESS F&O 7208 / 17208
    // ============================================================

    static void parse_fno(
        const uint8_t* b,
        size_t len,
        uint16_t tx)
    {
        if (len < FNO_START)
            return;

        uint16_t records =
            be16(
                b + FNO_HEADER_SIZE
            );

        if (
            records == 0 ||
            records > 100
        )
        {
            return;
        }

        size_t available =
            len - FNO_START;

        size_t max_records =
            available /
            FNO_RECORD_SIZE;

        records =
            static_cast<uint16_t>(
                std::min<size_t>(
                    records,
                    max_records
                )
            );

        for (
            uint16_t r = 0;
            r < records;
            ++r
        )
        {
            const uint8_t* rec =
                b +
                FNO_START +
                static_cast<size_t>(r) *
                FNO_RECORD_SIZE;

            const uint32_t token =
                be32(rec + 0);

            auto it =
                g_futures.find(token);

            if (it == g_futures.end())
            {
                ++g_unknown_future_tokens;
                continue;
            }

            FutureQuote& q =
                it->second;

            /*
             * F&O 214-byte record:
             *
             * Token       +0
             * BookType    +4
             * LTP         +12 / +16 depending
             * MBP         +56
             *
             * Existing production F&O parser uses:
             *   FUT LTP  +16
             *   Bid     MBP +4
             *   Ask     MBP +64
             */

            const uint16_t book =
                be16(rec + 4);

            if (
                book != 1 &&
                book != 2
            )
            {
                continue;
            }

            double ltp = 0.0;

            /*
             * Futures use +16 in the existing
             * production parser path.
             */
            ltp =
                static_cast<double>(
                    be32(rec + 16)
                ) / 100.0;

            const uint8_t* mbp =
                rec + 56;

            const double bid =
                static_cast<double>(
                    be32(mbp + 4)
                ) / 100.0;

            const double ask =
                static_cast<double>(
                    be32(mbp + 64)
                ) / 100.0;

            std::lock_guard<std::mutex> lock(
                g_state_mtx
            );

            q.ltp = ltp;
            q.bid = bid;
            q.ask = ask;

            q.has_ltp = true;
            q.has_bid = true;
            q.has_ask = true;

            ++q.updates;

            q.last_rx_ms =
                now_ms();

            ++g_future_updates;
        }
    }

    // ============================================================
    // PROCESS ONE DECOMPRESSED MESSAGE
    // ============================================================

    static void process_message(
        const uint8_t* p,
        size_t len)
    {
        if (len < 4)
            return;

        const uint16_t mlen =
            be16(p);

        const uint16_t tx =
            be16(p + 2);

        if (
            mlen < 4 ||
            mlen > len
        )
        {
            return;
        }

        const uint8_t* body =
            p + 4;

        const size_t body_len =
            mlen - 4;

        switch (tx)
        {
            case TX_7201:
                ++g_tx_7201;
                break;

            case TX_7207:
                // 7207 BCAST_INDICES belongs to the NSE Cash
                // broadcast circuit, not the F&O 233.1.2.5:34330
                // stream used by this standalone F&O server.
                //
                // Do NOT parse apparent 7207 hits from this F&O
                // stream as live index data. They can be false
                // transaction-code matches inside the F&O payload.
                ++g_tx_7207;
                break;

            case TX_7208:
                ++g_tx_7208;
                parse_fno(
                    body,
                    body_len,
                    tx
                );
                break;

            case TX_8207:
                ++g_tx_8207;
                parse_index_8207(
                    body,
                    body_len
                );
                break;

            case TX_17201:
                ++g_tx_17201;
                break;

            case TX_17202:
                ++g_tx_17202;
                break;

            case TX_17208:
                ++g_tx_17208;
                parse_fno(
                    body,
                    body_len,
                    tx
                );
                break;

            case TX_17211:
                ++g_tx_17211;
                break;

            default:
                break;
        }
    }

    // ============================================================
    // PROCESS UDP PACKET
    // ============================================================

    static void process_udp(
        const uint8_t* udp,
        size_t n)
    {
        if (n < 16)
            return;

        ++g_udp_packets;

        const uint8_t compression =
            udp[2];

        const uint16_t data_size =
            be16(
                udp + 4
            );

        if (
            data_size == 0 ||
            data_size > n - 16
        )
        {
            return;
        }

        int offsets[8]{};
        int offset_count = 0;

        offsets[offset_count++] =
            16;

        for (
            int p = 24;
            p <= static_cast<int>(n) - 8 &&
            offset_count < 8;
        )
        {
            bool found = false;

            for (
                int i = p;
                i <= static_cast<int>(n) - 8;
                ++i
            )
            {
                if (
                    std::memcmp(
                        udp + i,
                        LZO_MAGIC,
                        8
                    ) == 0
                )
                {
                    offsets[offset_count++] =
                        i + 8;

                    p = i + 9;
                    found = true;

                    break;
                }
            }

            if (!found)
                break;
        }

        static uint8_t seed[49152];

        for (
            int oi = 0;
            oi < offset_count;
            ++oi
        )
        {
            const size_t start =
                static_cast<size_t>(
                    offsets[oi]
                );

            size_t end =
                oi == 0
                    ? start + data_size
                    : n;

            if (
                start >= n ||
                end > n ||
                start >= end
            )
            {
                continue;
            }

            const uint8_t* raw =
                udp + start;

            size_t raw_len =
                end - start;

            while (
                raw_len > 0 &&
                raw[raw_len - 1] == 0
            )
            {
                --raw_len;
            }

            if (raw_len == 0)
                continue;

            std::vector<uint8_t> decoded;

            const uint8_t* data =
                nullptr;

            size_t data_len = 0;

            if (compression == 0)
            {
                if (
                    raw_len < 2 ||
                    raw[0] <= 17
                )
                {
                    continue;
                }

                const size_t lit_len =
                    raw[0] - 17;

                if (
                    raw_len < 1 + lit_len ||
                    lit_len == 0
                )
                {
                    continue;
                }

                const uint8_t* lit =
                    raw + 1;

                for (
                    size_t i = 0;
                    i < sizeof(seed);
                    ++i
                )
                {
                    seed[i] =
                        lit[i % lit_len];
                }

                auto result =
                    lzo1z_decompress_seeded(
                        raw,
                        raw_len,
                        seed,
                        sizeof(seed)
                    );

                if (
                    !result.ok ||
                    result.data.empty()
                )
                {
                    ++g_decomp_fail;
                    continue;
                }

                decoded =
                    std::move(
                        result.data
                    );

                data =
                    decoded.data();

                data_len =
                    decoded.size();

                ++g_decomp_ok;
            }
            else
            {
                decoded.resize(
                    MAX_DECOMPRESSED
                );

                lzo_uint out_len =
                    static_cast<lzo_uint>(
                        decoded.size()
                    );

                if (
                    lzo_init() != LZO_E_OK
                )
                {
                    return;
                }

                const int rc =
                    lzo1z_decompress(
                        raw,
                        static_cast<lzo_uint>(
                            raw_len
                        ),
                        decoded.data(),
                        &out_len,
                        nullptr
                    );

                if (rc != LZO_E_OK)
                {
                    ++g_decomp_fail;
                    continue;
                }

                decoded.resize(
                    static_cast<size_t>(
                        out_len
                    )
                );

                data =
                    decoded.data();

                data_len =
                    decoded.size();

                ++g_decomp_ok;
            }

            if (!data || data_len < 4)
                continue;

            size_t pos = 0;

            while (
                pos + 4 <= data_len
            )
            {
                const uint16_t mlen =
                    be16(
                        data + pos
                    );

                if (
                    mlen < 4 ||
                    pos + mlen > data_len
                )
                {
                    ++pos;
                    continue;
                }

                process_message(
                    data + pos,
                    mlen
                );

                pos += mlen;
            }

            g_last_rx_ms =
                now_ms();
        }
    }

