    static void http_loop()
    {
        const int server =
            socket(
                AF_INET,
                SOCK_STREAM,
                0
            );

        if (server < 0)
        {
            std::cerr
                << "[HTTP] socket failed: "
                << std::strerror(errno)
                << "\n";

            return;
        }

        int reuse = 1;

        setsockopt(
            server,
            SOL_SOCKET,
            SO_REUSEADDR,
            &reuse,
            sizeof(reuse)
        );

        sockaddr_in addr{};

        addr.sin_family =
            AF_INET;

        addr.sin_port =
            htons(
                HTTP_PORT
            );

        addr.sin_addr.s_addr =
            htonl(
                INADDR_ANY
            );

        if (
            bind(
                server,
                reinterpret_cast<sockaddr*>(&addr),
                sizeof(addr)
            ) < 0
        )
        {
            std::cerr
                << "[HTTP] bind failed: "
                << std::strerror(errno)
                << "\n";

            close(server);

            return;
        }

        if (
            listen(
                server,
                32
            ) < 0
        )
        {
            std::cerr
                << "[HTTP] listen failed: "
                << std::strerror(errno)
                << "\n";

            close(server);

            return;
        }

        std::cout
            << "[HTTP] listening on 0.0.0.0:"
            << HTTP_PORT
            << "\n";

        while (g_running)
        {
            sockaddr_in client_addr{};

            socklen_t len =
                sizeof(client_addr);

            int client =
                accept(
                    server,
                    reinterpret_cast<sockaddr*>(
                        &client_addr
                    ),
                    &len
                );

            if (client < 0)
                continue;

            char request[4096]{};

            const ssize_t n =
                recv(
                    client,
                    request,
                    sizeof(request) - 1,
                    0
                );

            if (n <= 0)
            {
                close(client);
                continue;
            }

            request[n] = '\0';

            const std::string req(
                request,
                static_cast<size_t>(n)
            );

            if (
                req.rfind(
                    "GET /api/data ",
                    0
                ) == 0
            )
            {
                send_response(
                    client,
                    200,
                    "application/json",
                    make_json()
                );
            }
            else if (
                req.rfind(
                    "GET /health ",
                    0
                ) == 0
            )
            {
                send_response(
                    client,
                    200,
                    "application/json",
                    "{\"ok\":true}"
                );
            }
            else if (
                req.rfind(
                    "GET / ",
                    0
                ) == 0
            )
            {
                send_response(
                    client,
                    200,
                    "text/html; charset=utf-8",
                    HTML
                );
            }
            else
            {
                send_response(
                    client,
                    404,
                    "application/json",
                    "{\"error\":\"not found\"}"
                );
            }

            close(client);
        }

        close(server);
    }

