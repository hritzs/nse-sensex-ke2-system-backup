    static bool load_future_universe()
    {
        std::ifstream f(CONTRACT_FILE);

        if (!f.is_open())
        {
            std::cerr
                << "[FNO] ERROR: cannot open "
                << CONTRACT_FILE
                << "\n";

            return false;
        }

        std::string line;

        std::getline(
            f,
            line
        );

        size_t count = 0;

        while (
            std::getline(
                f,
                line
            )
        )
        {
            auto cols =
                parse_csv_line(line);

            if (cols.size() < 8)
                continue;

            const std::string exchange =
                normalize_name(cols[1]);

            const std::string symbol =
                trim(cols[3]);

            const std::string expiry =
                trim(cols[4]);

            const std::string op_type =
                normalize_name(cols[6]);

            if (exchange != "NSE")
                continue;

            if (
                op_type != "FUT" &&
                op_type != "XX"
            )
            {
                continue;
            }

            if (
                symbol.empty() ||
                expiry.empty() ||
                cols[7].empty()
            )
            {
                continue;
            }

            uint32_t token = 0;

            try
            {
                token =
                    static_cast<uint32_t>(
                        std::stoul(
                            cols[7]
                        )
                    );
            }
            catch (...)
            {
                continue;
            }

            if (token == 0)
                continue;

            FutureQuote q;

            q.token = token;
            q.symbol = symbol;
            q.expiry = expiry;

            g_futures[token] = q;

            ++count;
        }

        std::cout
            << "[FNO] Loaded futures: "
            << count
            << "\n";

        return !g_futures.empty();
    }

    // ============================================================
    // SEEDED LZO1Z DECOMPRESSOR
    // ============================================================

    struct DecompResult
    {
        std::vector<uint8_t> data;
        bool ok = false;
    };

    static DecompResult
    lzo1z_decompress_seeded(
        const uint8_t* src,
        size_t n,
        const uint8_t* seed,
        size_t seed_len)
    {
        DecompResult r;

        r.data.reserve(
            seed_len + n * 4
        );

        r.data.insert(
            r.data.end(),
            seed,
            seed + seed_len
        );

        size_t ip = 0;

        auto rb =
            [&]() -> uint8_t
            {
                if (ip >= n)
                    throw std::out_of_range(
                        "read"
                    );

                return src[ip++];
            };

        auto copy_lit =
            [&](size_t c)
            {
                if (ip + c > n)
                    throw std::out_of_range(
                        "literal"
                    );

                r.data.insert(
                    r.data.end(),
                    src + ip,
                    src + ip + c
                );

                ip += c;
            };

        auto copy_match =
            [&](size_t back, size_t len)
            {
                if (
                    !back ||
                    r.data.size() < back
                )
                {
                    throw std::runtime_error(
                        "match"
                    );
                }

                size_t mp =
                    r.data.size() - back;

                for (
                    size_t i = 0;
                    i < len;
                    ++i
                )
                {
                    r.data.push_back(
                        r.data[mp++]
                    );
                }
            };

        try
        {
            uint8_t t = rb();

            if (t > 17)
            {
                copy_lit(
                    t - 17
                );

                t = rb();
            }

            for (;;)
            {
                if (t < 16)
                {
                    size_t c = t;

                    if (!c)
                    {
                        while (
                            ip < n &&
                            src[ip] == 0
                        )
                        {
                            c += 255;
                            ++ip;
                        }

                        c +=
                            15 +
                            src[ip++];
                    }

                    copy_lit(
                        c + 3
                    );

                    t = rb();

                    continue;
                }

                for (;;)
                {
                    if (t >= 64)
                    {
                        copy_match(
                            ((t >> 2) & 7) |
                            (rb() << 3),
                            ((t >> 5) & 3) + 2
                        );
                    }
                    else if (t >= 32)
                    {
                        size_t len =
                            t & 0x1f;

                        if (!len)
                        {
                            while (
                                ip < n &&
                                src[ip] == 0
                            )
                            {
                                len += 255;
                                ++ip;
                            }

                            len +=
                                31 +
                                src[ip++];
                        }

                        len += 2;

                        uint8_t b1 = rb();
                        uint8_t b2 = rb();

                        copy_match(
                            (b1 >> 2) |
                            (b2 << 6),
                            len
                        );
                    }
                    else if (t >= 16)
                    {
                        size_t len =
                            t & 7;

                        if (!len)
                        {
                            while (
                                ip < n &&
                                src[ip] == 0
                            )
                            {
                                len += 255;
                                ++ip;
                            }

                            len +=
                                7 +
                                src[ip++];
                        }

                        len += 2;

                        uint8_t b1 = rb();
                        uint8_t b2 = rb();

                        size_t back =
                            (b1 >> 2) |
                            (b2 << 6);

                        back +=
                            (1 << 14) |
                            (((t >> 3) & 1) << 13);

                        copy_match(
                            back,
                            len
                        );
                    }
                    else
                    {
                        break;
                    }

                    if (ip >= n)
                    {
                        r.ok = true;
                        goto done;
                    }

                    t = rb();

                    if (t == 17)
                    {
                        r.ok = true;
                        goto done;
                    }

                    uint8_t lit =
                        t & 3;

                    if (lit)
                        copy_lit(lit);

                    t = rb();
                }

                if (t == 17)
                {
                    r.ok = true;
                    goto done;
                }

                uint8_t lit =
                    t & 3;

                if (!lit)
                    break;

                copy_lit(lit);

                t = rb();
            }

            r.ok = true;
        }
        catch (...)
        {
        }

    done:

        if (r.data.size() > seed_len)
        {
            r.data.erase(
                r.data.begin(),
                r.data.begin() +
                static_cast<ptrdiff_t>(
                    seed_len
                )
            );
        }
        else
        {
            r.data.clear();
        }

        return r;
    }

    // ============================================================
    // PROCESS INDEX 7207
    // ============================================================

    static void parse_index_7207(
        const uint8_t* b,
        size_t len)
    {
        if (len < INDEX_START)
            return;

        uint16_t records =
            be16(
                b + INDEX_HEADER_SIZE
            );

        size_t available =
            len - INDEX_START;

        size_t max_records =
            available /
            INDEX_RECORD_SIZE;

        records =
            static_cast<uint16_t>(
                std::min<size_t>(
                    records,
                    max_records
                )
            );

        for (
            uint16_t r = 0;
            r < records;
            ++r
        )
        {
            const uint8_t* rec =
                b +
                INDEX_START +
                static_cast<size_t>(r) *
                INDEX_RECORD_SIZE;

            char buf[22]{};

            std::memcpy(
                buf,
                rec,
                21
            );

            std::string name(buf);

            name = trim(name);

            if (name.empty())
                continue;

            const double value =
                static_cast<double>(
                    be32(rec + 21)
                ) / 100.0;

            const std::string key =
                normalize_name(name);

            std::lock_guard<std::mutex> lock(
                g_state_mtx
            );

            IndexQuote& q =
                g_indices[key];

            q.name = name;
            q.live_value = value;
            q.has_live = true;
            ++q.live_updates;
            q.live_time = now_ist();
        }
    }

