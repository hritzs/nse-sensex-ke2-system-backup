    static void multicast_loop()
    {
        const int sock =
            socket(
                AF_INET,
                SOCK_DGRAM,
                0
            );

        if (sock < 0)
        {
            std::cerr
                << "[FNO] socket() failed: "
                << std::strerror(errno)
                << "\n";

            return;
        }

        int reuse = 1;

        setsockopt(
            sock,
            SOL_SOCKET,
            SO_REUSEADDR,
            &reuse,
            sizeof(reuse)
        );

        sockaddr_in local{};

        local.sin_family =
            AF_INET;

        local.sin_port =
            htons(
                MULTICAST_PORT
            );

        local.sin_addr.s_addr =
            htonl(
                INADDR_ANY
            );

        if (
            bind(
                sock,
                reinterpret_cast<sockaddr*>(&local),
                sizeof(local)
            ) < 0
        )
        {
            std::cerr
                << "[FNO] bind failed: "
                << std::strerror(errno)
                << "\n";

            close(sock);

            return;
        }

        ip_mreq mreq{};

        mreq.imr_multiaddr.s_addr =
            inet_addr(
                MULTICAST_IP
            );

        mreq.imr_interface.s_addr =
            htonl(
                INADDR_ANY
            );

        if (
            setsockopt(
                sock,
                IPPROTO_IP,
                IP_ADD_MEMBERSHIP,
                &mreq,
                sizeof(mreq)
            ) < 0
        )
        {
            std::cerr
                << "[FNO] multicast join failed: "
                << std::strerror(errno)
                << "\n";

            close(sock);

            return;
        }

        std::cout
            << "[FNO] JOIN SUCCESS "
            << MULTICAST_IP
            << ":"
            << MULTICAST_PORT
            << "\n";

        std::vector<uint8_t> buf(
            MAX_PACKET
        );

        while (g_running)
        {
            const ssize_t n =
                recv(
                    sock,
                    buf.data(),
                    buf.size(),
                    0
                );

            if (n <= 0)
                continue;

            process_udp(
                buf.data(),
                static_cast<size_t>(n)
            );
        }

        close(sock);
    }

