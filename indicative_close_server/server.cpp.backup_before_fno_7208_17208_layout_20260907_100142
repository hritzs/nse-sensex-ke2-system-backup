    static int month_number(
        const std::string& m)
    {
        if (m == "JAN") return 1;
        if (m == "FEB") return 2;
        if (m == "MAR") return 3;
        if (m == "APR") return 4;
        if (m == "MAY") return 5;
        if (m == "JUN") return 6;
        if (m == "JUL") return 7;
        if (m == "AUG") return 8;
        if (m == "SEP") return 9;
        if (m == "OCT") return 10;
        if (m == "NOV") return 11;
        if (m == "DEC") return 12;

        return 0;
    }

    static long expiry_sort_key(
        const std::string& expiry)
    {
        std::stringstream ss(expiry);

        std::string d;
        std::string m;
        std::string y;

        std::getline(ss, d, '-');
        std::getline(ss, m, '-');
        std::getline(ss, y, '-');

        if (
            d.empty() ||
            m.empty() ||
            y.empty()
        )
        {
            return 0;
        }

        try
        {
            int day = std::stoi(d);
            int year = std::stoi(y);

            if (year < 100)
                year += 2000;

            int mon = month_number(
                normalize_name(m)
            );

            return
                static_cast<long>(year) * 10000L +
                static_cast<long>(mon) * 100L +
                static_cast<long>(day);
        }
        catch (...)
        {
            return 0;
        }
    }

