    static inline uint16_t be16(const uint8_t* p)
    {
        return static_cast<uint16_t>(
            (static_cast<uint16_t>(p[0]) << 8) |
            static_cast<uint16_t>(p[1])
        );
    }

    static inline uint32_t be32(const uint8_t* p)
    {
        return
            (static_cast<uint32_t>(p[0]) << 24) |
            (static_cast<uint32_t>(p[1]) << 16) |
            (static_cast<uint32_t>(p[2]) << 8)  |
            static_cast<uint32_t>(p[3]);
    }

    static inline uint64_t be64_u(const uint8_t* p)
    {
        uint64_t v = 0;

        for (int i = 0; i < 8; ++i)
        {
            v =
                (v << 8) |
                static_cast<uint64_t>(p[i]);
        }

        return v;
    }

    static uint64_t now_ms()
    {
        using namespace std::chrono;

        return static_cast<uint64_t>(
            duration_cast<milliseconds>(
                system_clock::now().time_since_epoch()
            ).count()
        );
    }

    static std::string now_ist()
    {
        using namespace std::chrono;

        const auto now = system_clock::now();
        const std::time_t tt =
            system_clock::to_time_t(now);

        std::tm tm{};

        localtime_r(&tt, &tm);

        const auto ms =
            duration_cast<milliseconds>(
                now.time_since_epoch()
            ) % 1000;

        std::ostringstream ss;

        ss << std::put_time(
                 &tm,
                 "%Y-%m-%dT%H:%M:%S"
             )
           << '.'
           << std::setw(3)
           << std::setfill('0')
           << ms.count()
           << "+05:30";

        return ss.str();
    }

    static std::string trim(std::string s)
    {
        while (
            !s.empty() &&
            std::isspace(
                static_cast<unsigned char>(s.front())
            )
        )
        {
            s.erase(s.begin());
        }

        while (
            !s.empty() &&
            std::isspace(
                static_cast<unsigned char>(s.back())
            )
        )
        {
            s.pop_back();
        }

        return s;
    }

    static std::vector<std::string>
    parse_csv_line(const std::string& line)
    {
        std::vector<std::string> out;

        std::string cell;
        bool in_quotes = false;

        for (char c : line)
        {
            if (c == '"')
            {
                in_quotes = !in_quotes;
                continue;
            }

            if (c == ',' && !in_quotes)
            {
                out.push_back(trim(cell));
                cell.clear();
            }
            else
            {
                cell.push_back(c);
            }
        }

        out.push_back(trim(cell));

        return out;
    }

    static std::string normalize_name(
        const std::string& src)
    {
        std::string s;

        for (char c : src)
        {
            if (
                std::isalnum(
                    static_cast<unsigned char>(c)
                )
            )
            {
                s.push_back(
                    static_cast<char>(
                        std::toupper(
                            static_cast<unsigned char>(c)
                        )
                    )
                );
            }
        }

        return s;
    }

    static std::string json_escape(
        const std::string& s)
    {
        std::string out;

        out.reserve(s.size() + 8);

        for (char c : s)
        {
            switch (c)
            {
                case '"':
                    out += "\\\"";
                    break;

                case '\\':
                    out += "\\\\";
                    break;

                case '\n':
                    out += "\\n";
                    break;

                case '\r':
                    out += "\\r";
                    break;

                case '\t':
                    out += "\\t";
                    break;

                default:
                    out += c;
                    break;
            }
        }

        return out;
    }

