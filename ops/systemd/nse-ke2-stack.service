[Unit]
Description=NSE BSE KE2 and all-expiry Gamma supervised stack
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/administrator/projects/nse-fo-low-latency-decoder
ExecStart=/home/administrator/projects/nse-fo-low-latency-decoder/venv/bin/python -u /home/administrator/projects/nse-fo-low-latency-decoder/scripts/managed_stack.py
Restart=on-failure
RestartSec=10
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=25
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
