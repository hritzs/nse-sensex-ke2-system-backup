# ==========================================
# Stage 1: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app
COPY solid-terminal/package*.json ./solid-terminal/
RUN cd solid-terminal && npm install

COPY solid-terminal/ ./solid-terminal/
RUN cd solid-terminal && npm run build

# ==========================================
# Stage 2: Nginx Web Server
# ==========================================
FROM nginx:alpine
COPY --from=builder /app/solid-terminal/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]