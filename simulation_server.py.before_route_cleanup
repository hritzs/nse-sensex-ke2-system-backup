    def _load_reference_data(self):

        try:

            # ----------------------------------------------------
            # Read authoritative GammaShortDailydata.csv.
            #
            # The file is on a Windows SMB share. Since this
            # application runs under WSL, read it through
            # powershell.exe so the logged-in Windows user's
            # network permissions are reused.
            # ----------------------------------------------------

            ps_command = (
                "$p = '" +
                GAMMA_DAILY_SOURCE.replace("'", "''") +
                "'; "
                "if (-not (Test-Path -LiteralPath $p)) "
                "{ throw ('File not found: ' + $p) }; "
                "Get-Content -LiteralPath $p -Raw"
            )

            result = subprocess.run(
                [
                    "powershell.exe",
                    "-NoProfile",
                    "-NonInteractive",
                    "-Command",
                    ps_command,
                ],
                capture_output=True,
                text=True,
                timeout=30,
            )

            if result.returncode != 0:

                error_text = (
                    result.stderr.strip()
                    or result.stdout.strip()
                    or "PowerShell failed to read GammaShortDailydata.csv"
                )

                raise RuntimeError(
                    error_text
                )

            csv_text = result.stdout

            if not csv_text.strip():

                raise RuntimeError(
                    "GammaShortDailydata.csv is empty"
                )

            gamma = pd.read_csv(
                io.StringIO(csv_text)
            )


            # ----------------------------------------------------
            # Normalize date columns.
            # ----------------------------------------------------

            required_columns = [
                "Date",
                "PrevDate",
                "Prev2Date",
                "Straddle",
                "Future",
                "IV",
                "Prev2_Adj_IV",
                "IV_Chg",
                "Adj_IV_Chg",
                "IDV_Pure",
                "IDV_With_Prev",
            ]

            missing = [
                col
                for col in required_columns
                if col not in gamma.columns
            ]

            if missing:

                raise RuntimeError(
                    "Gamma reference missing columns: "
                    +
                    ", ".join(missing)
                )


            gamma["Date"] = pd.to_datetime(
                gamma["Date"],
                dayfirst=True,
                errors="coerce"
            )

            gamma["PrevDate"] = pd.to_datetime(
                gamma["PrevDate"],
                dayfirst=True,
                errors="coerce"
            )

            gamma["Prev2Date"] = pd.to_datetime(
                gamma["Prev2Date"],
                dayfirst=True,
                errors="coerce"
            )

            gamma = gamma.dropna(
                subset=["Date"]
            )


            gamma["Date"] = (
                gamma["Date"]
                .dt.normalize()
            )

            gamma["PrevDate"] = (
                gamma["PrevDate"]
                .dt.normalize()
            )

            gamma["Prev2Date"] = (
                gamma["Prev2Date"]
                .dt.normalize()
            )


            # ----------------------------------------------------
            # Preserve the existing IDV lookup interface.
            # get_previous_idvs() already expects:
            #
            #   IDV_Pure
            #   IDV_With_Prev
            # ----------------------------------------------------

            self.idv_history = (
                gamma[
                    [
                        "Date",
                        "IDV_Pure",
                        "IDV_With_Prev",
                    ]
                ]
                .sort_values("Date")
                .reset_index(drop=True)
            )


            # ----------------------------------------------------
            # Preserve the existing previous-reference interface.
            #
            # This reproduces the old normalization logic:
            #
            # gap > 1 day:
            #     Target_Chg = Adj_IV_Chg
            #     Target_Base = Prev2_Adj_IV
            #
            # otherwise:
            #     Target_Chg = IV_Chg
            #     Target_Base = IV
            # ----------------------------------------------------

            prev = gamma.copy()

            prev["Days_Diff"] = (
                prev["PrevDate"]
                -
                prev["Prev2Date"]
            ).dt.days

            gap = (
                prev["Days_Diff"] > 1
            )


            prev["Target_Chg"] = np.where(
                gap,
                prev["Adj_IV_Chg"],
                prev["IV_Chg"]
            )


            prev["Target_Base"] = np.where(
                gap,
                prev["Prev2_Adj_IV"],
                prev["IV"]
            )


            prev["Target_Base"] = (
                pd.to_numeric(
                    prev["Target_Base"],
                    errors="coerce"
                )
                .replace(0, np.nan)
            )


            prev["Target_Chg"] = (
                pd.to_numeric(
                    prev["Target_Chg"],
                    errors="coerce"
                )
            )


            prev["Normalized_Adj_Chg"] = (
                prev["Target_Chg"] * 0.1
            ) / prev["Target_Base"]


            # ----------------------------------------------------
            # Build exactly the lookup format consumed by
            # update_reference_state().
            # ----------------------------------------------------

            self.prev_lookup = {}

            for _, row in prev.iterrows():

                try:

                    key = row["Date"].strftime(
                        "%Y-%m-%d"
                    )

                    self.prev_lookup[key] = {
                        "Straddle": float(
                            row["Straddle"]
                        ),

                        "Normalized_Adj_Chg": float(
                            row["Normalized_Adj_Chg"]
                        ),

                        "Target_Base": float(
                            row["Target_Base"]
                        ),

                        "Future": float(
                            row["Future"]
                        ),
                    }

                except Exception:

                    continue


            self.reference_status = "READY"


            print(
                f"[REF] GammaShortDailydata loaded: "
                f"{len(gamma)} rows"
            )

            print(
                f"[REF] Reference days available: "
                f"{len(self.prev_lookup)}"
            )

            print(
                f"[REF] Source: "
                f"{GAMMA_DAILY_SOURCE}"
            )


        except Exception as e:

            self.idv_history = None
            self.prev_lookup = {}
            self.reference_status = (
                f"ERROR: {e}"
            )

            print(
                f"[REF] Gamma daily load failed: {e}"
            )


    # --------------------------------------------------------
    # Previous IDV ? exactly like optimizer
    # --------------------------------------------------------

    def get_previous_idvs(self, current_date):
        if self.idv_history is None:
            raise RuntimeError("IDV history unavailable")

        check = pd.Timestamp(current_date).normalize() - timedelta(days=1)

        for _ in range(30):
            m = self.idv_history[
                self.idv_history["Date"] == check
            ]

            if not m.empty:
                return (
                    float(m.iloc[-1]["IDV_Pure"]),
                    float(m.iloc[-1]["IDV_With_Prev"]),
                )

            check -= timedelta(days=1)

        raise ValueError("No previous IDV found")

