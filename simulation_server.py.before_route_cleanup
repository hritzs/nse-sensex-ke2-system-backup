def start_now_minute_simulation():

    """
    START NOW = start the strategy from the CURRENT market minute.

    Do not wait for 09:16/09:17/09:18/09:19.
    Do not wait for another websocket cycle.

    The current complete NIFTY chain is copied from the live
    feed state, then the complete build/entry calculation is
    executed immediately.
    """

    sim = MinuteStraddleEngine("NOW")

    # --------------------------------------------------------
    # Copy the CURRENT live chain from the canonical live
    # feed engine.
    # --------------------------------------------------------

    with ENGINE.lock:

        sim.chain = {
            key: (
                value.copy()
                if isinstance(value, dict)
                else value
            )
            for key, value in ENGINE.chain.items()
        }

        sim.latest_ticks = {
            key: (
                value.copy()
                if isinstance(value, dict)
                else value
            )
            for key, value in ENGINE.latest_ticks.items()
        }

        sim.future_by_expiry = dict(
            ENGINE.future_by_expiry
        )

        sim.syn_fut_by_expiry = dict(
            ENGINE.syn_fut_by_expiry
        )

        sim.underlying = ENGINE.underlying
        sim.future = ENGINE.future
        sim.atm = ENGINE.atm

        sim.expiry_mode = ENGINE.expiry_mode
        sim.selected_expiry = ENGINE.selected_expiry

    # --------------------------------------------------------
    # The simulation begins RIGHT NOW.
    # --------------------------------------------------------

    sim.minute_started = True
    sim.minute_start_timestamp = (
        now_ist().isoformat(
            timespec="seconds"
        )
    )

    sim.minute_completed = False

    # --------------------------------------------------------
    # Put NOW into the global independent simulation map.
    # --------------------------------------------------------

    MINUTE_SIMULATIONS["NOW"] = sim

    print(
        "[MINUTE NOW] COMPLETE BUILD START",
        sim.minute_start_timestamp,
        "chain=",
        len(sim.chain),
        "spot=",
        sim.underlying,
        "future=",
        sim.future
    )

    # --------------------------------------------------------
    # IMPORTANT:
    #
    # Run the COMPLETE build immediately.
    #
    # This must:
    #   1. find current expiry
    #   2. find current ATM
    #   3. find current CE + PE
    #   4. calculate DTE
    #   5. calculate build IV
    #   6. create the short straddle
    #   7. calculate option Greeks
    #   8. create initial futures hedge
    #   9. calculate points allowed
    #  10. calculate exit thresholds
    # --------------------------------------------------------

    try:

        sim.recalculate()

    except Exception as exc:

        print(
            "[MINUTE NOW] COMPLETE BUILD ERROR:",
            repr(exc)
        )

    return sim


def process_all_minute_simulations(
    data
):

    now_dt = now_ist()

    for run_id, sim in list(
        MINUTE_SIMULATIONS.items()
    ):

        try:

            if sim.minute_completed:
                continue

            # NOW is armed explicitly by the button.
            if run_id == "NOW":

                if (
                    sim.minute_start_timestamp
                    is None
                ):
                    continue

            else:

                # Fixed runs begin only when their
                # actual clock time arrives.
                if (
                    now_dt
                    <
                    MINUTE_START_TIMES[
                        run_id
                    ]
                ):
                    continue

            sim.process_tick(
                data
            )

        except Exception as exc:

            print(
                "[MINUTE SIM ERROR]",
                run_id,
                repr(exc)
            )


