    def process_message(self, message):

        if isinstance(message, list):
            for item in message:
                self.process_tick(item)
            return

        if not isinstance(message, dict):
            return

        self.process_tick(message)

    def process_tick(self, tick):

        if not isinstance(tick, dict):
            return

        msg_type = str(tick.get("type", "")).lower()

        # Accept surface/analytics/option messages.
        if msg_type not in (
            "",
            "surface",
            "analytics",
            "option",
            "quote",
            "tick",
            "future",
            "future_quote",
        ):
            return

        symbol = str(tick.get("symbol", ""))

        if not symbol:
            return

        # ----------------------------------------------------
        # ACTUAL FUTURE QUOTE
        #
        # C++ publishes these separately because
        # Analytics::process_tick() returns "" for futures.
        #
        # Store the actual futures LTP by expiry.
        # Do NOT use this as the synthetic spot.
        # ----------------------------------------------------
        if msg_type == "future_quote":

            # ------------------------------------------------
            # STRICT NIFTY FUTURE FILTER
            #
            # Only:
            #   NIFTY|25-AUG-26|0|FUT
            #
            # Reject:
            #   BANKNIFTY
            #   FINNIFTY
            #   MIDCPNIFTY
            #   NIFTYNXT50
            #   stock futures
            # ------------------------------------------------
            fut_symbol = symbol.strip().upper()

            if not (
                fut_symbol.startswith("NIFTY|")
                and fut_symbol.endswith("|0|FUT")
            ):
                return

            fut_expiry = str(
                tick.get("expiry", "")
            ).strip()

            fut_ltp = self._num(
                tick.get("ltp")
            )

            if (
                fut_expiry
                and np.isfinite(fut_ltp)
                and fut_ltp > 0
            ):
                self.future_by_expiry[
                    fut_expiry
                ] = fut_ltp

                print(
                    "[PY FUTURE_QUOTE]",
                    "expiry=", fut_expiry,
                    "ltp=", fut_ltp,
                    "future_by_expiry=",
                    dict(self.future_by_expiry)
                )

                # Use the nearest actual future expiry
                # on or after the current date.
                now = now_ist_naive()

                candidates = []

                for exp, px in self.future_by_expiry.items():

                    if not np.isfinite(px) or px <= 0:
                        continue

                    try:
                        dt = datetime.strptime(
                            exp,
                            "%d-%b-%y"
                        ).replace(
                            hour=15,
                            minute=40,
                            second=0,
                            microsecond=0
                        )
                    except Exception:
                        continue

                    if dt >= now:
                        candidates.append(
                            (dt, exp, px)
                        )

                if candidates:
                    candidates.sort(
                        key=lambda x: x[0]
                    )

                    self.future = candidates[0][2]
                    self.future_expiry = candidates[0][1]
                    self.future_timestamp = now_ist()

            # A future quote does not modify the option chain.
            # Recalculate only if the option state is already ready.
            self.recalculate()

            return

        # This simulator is strictly for NIFTY.
        # Do NOT accept BANKNIFTY / FINNIFTY / MIDCPNIFTY / NIFTYNXT50.
        message_underlying = str(
            tick.get("underlying", "")
        ).strip().upper()

        if message_underlying:
            if message_underlying != "NIFTY":
                return
        else:
            # Fallback for messages without an explicit underlying.
            # Extract the alphabetic prefix from the contract symbol.
            import re
            m_underlying = re.match(
                r"^([A-Z]+?)(?=\d{2}[A-Z]{3}\d{2})",
                symbol.upper()
            )

            if not m_underlying:
                return

            if m_underlying.group(1) != "NIFTY":
                return

        # ----------------------------------------------------
        # Surface message
        # ----------------------------------------------------

        strike = tick.get("strike")
        
        # EXTRACT FROM NSE STRINGS: NIFTY26MAY2625600CE
        import re
        m = re.match(r"^([A-Za-z]+)(\d{2}[A-Za-z]{3}\d{2})([\d\.]*)(CE|PE|FUT)?$", symbol.upper())
        if m:
            exp_raw = m.group(2)
            parsed_expiry = f"{exp_raw[:2]}-{exp_raw[2:5]}-{exp_raw[5:]}"
            tick["expiry"] = parsed_expiry
            if m.group(3) and not strike:
                strike = m.group(3)
        
        try:
            strike = float(strike)
        except Exception:
            strike = np.nan

        ltp = self._num(tick.get("ltp"))
        iv = self._num(tick.get("iv"))

        bid = self._num(
            tick.get(
                "bid1",
                tick.get(
                    "bid",
                    tick.get("Bid")
                )
            )
        )

        ask = self._num(
            tick.get(
                "ask1",
                tick.get(
                    "ask",
                    tick.get("Ask")
                )
            )
        )

        future = self._num(tick.get("future"))

        expiry = str(tick.get("expiry", ""))

        option_type = None

        if symbol.upper().endswith("CE"):
            option_type = "CE"
        elif symbol.upper().endswith("PE"):
            option_type = "PE"

        if (
            option_type is not None
            and np.isfinite(strike)
        ):
            key = (
                expiry,
                int(round(strike)),
                option_type,
            )

            self.chain[key] = {
                "symbol": symbol,
                "expiry": expiry,
                "strike": strike,
                "type": option_type,
                "ltp": ltp,
                "iv": iv,
                "bid": bid,
                "ask": ask,
                "future": future,
                "delta": self._num(tick.get("delta")),
                "gamma": self._num(tick.get("gamma")),
                "timestamp": tick.get(
                    "timestamp",
                    tick.get("published_at")
                ),
            }

        # ----------------------------------------------------
        # SIMULATION MARKET STATE
        #
        # The simulation "spot" is the synthetic future for
        # the SELECTED option expiry.
        #
        # Every analytics tick updates the syn_fut map for
        # its own expiry. The selected expiry is then read
        # from that map.
        # ----------------------------------------------------

        tick_expiry = str(
            tick.get("expiry", "")
        ).strip()

        tick_syn_fut = self._num(
            tick.get("syn_fut")
        )

        # Continuously maintain synthetic futures by expiry.
        if (
            tick_expiry
            and np.isfinite(tick_syn_fut)
            and tick_syn_fut > 0
        ):
            self.syn_fut_by_expiry[
                tick_expiry
            ] = tick_syn_fut

        # The UI-selected expiry is the simulation anchor.
        selected_expiry = self.simulation_expiry()

        if selected_expiry:
            selected_syn = self.syn_fut_by_expiry.get(
                selected_expiry,
                np.nan
            )

            if (
                np.isfinite(selected_syn)
                and selected_syn > 0
            ):
                # THIS is the simulation spot.
                self.underlying = selected_syn

                self.simulation_expiry_name = selected_expiry

        # Actual NIFTY future remains independent and is owned
        # exclusively by the future_quote handler.
        #
        # Never overwrite self.future from option analytics.

        self.recalculate()

    @staticmethod
    def _iv_decimal(v):
        try:
            x = float(v)

            if not np.isfinite(x) or x <= 0:
                return np.nan

            # C++ feed publishes IV in percentage form:
            # 9.89 = 9.89%.
            #
            # Strategy calculations use decimal:
            # 0.0989 = 9.89%.
            if x > 2.0:
                x /= 100.0

            return x if np.isfinite(x) else np.nan

        except Exception:
            return np.nan

    @staticmethod
    def _num(v):
        try:
            x = float(v)
            return x if np.isfinite(x) else np.nan
        except Exception:
            return np.nan

    # --------------------------------------------------------
    # Find current expiry
    # --------------------------------------------------------

    def _nifty_expiries(self):

        expiries = set()

        for val in self.chain.values():
            row = val if isinstance(val, dict) else {}

            exp = row.get("expiry")

            if exp:
                expiries.add(exp)

        return sorted(expiries)

    def weekly_expiries(self):
        now = now_ist_naive()
        result = []

        for exp in self._nifty_expiries():
            try:
                dt = datetime.strptime(
                    exp,
                    "%d-%b-%y"
                ).replace(
                    hour=15,
                    minute=40,
                    second=0,
                    microsecond=0
                )
            except Exception:
                continue

            if dt < now:
                continue

            has_ce = False
            has_pe = False

            for row in self.chain.values():
                if not isinstance(row, dict):
                    continue

                if row.get("expiry") != exp:
                    continue

                typ = row.get("type")

                if typ == "CE":
                    has_ce = True
                elif typ == "PE":
                    has_pe = True

                if has_ce and has_pe:
                    break

            if has_ce and has_pe:
                result.append((dt, exp))

        result.sort(key=lambda x: x[0])

        return [x[1] for x in result[:8]]

    def set_expiry(self, expiry):
        expiry = str(expiry or "").strip()

        if not expiry or expiry.upper() == "AUTO":
            self.expiry_mode = "auto"
            self.selected_expiry = None
            return True, "AUTO"

        available = self.weekly_expiries()

        if expiry not in available:
            return False, "Expiry is not currently available"

        self.expiry_mode = "manual"
        self.selected_expiry = expiry

        return True, expiry

    def simulation_expiry(self):
        if (
            self.expiry_mode == "manual"
            and self.selected_expiry
            and self.selected_expiry in self.weekly_expiries()
        ):
            return self.selected_expiry

        available = self.weekly_expiries()

        if not available:
            return None

        return available[0]

    def _select_expiry(self):

        now = now_ist_naive()

        candidates = []

        # Only consider expiries for which we have a usable
        # synthetic future. This prevents an expiry with syn_fut=0
        # from becoming the simulation anchor.
        for exp, syn in self.syn_fut_by_expiry.items():

            if not np.isfinite(syn) or syn <= 0:
                continue

            try:
                dt = datetime.strptime(
                    exp,
                    "%d-%b-%y"
                ).replace(
                    hour=15,
                    minute=40,
                    second=0,
                    microsecond=0
                )
            except Exception:
                continue

            if dt < now:
                continue

            candidates.append((dt, exp))

        if not candidates:
            return None

        candidates.sort(key=lambda x: x[0])

        return candidates[0][1]

    # --------------------------------------------------------
    # Current ATM option pair
    # --------------------------------------------------------

    def _atm_pair(self):

        if not np.isfinite(self.underlying):
            return None, None, None, None

        expiry = self.simulation_expiry()

        if expiry is None:
            return None, None, None, None

        target_atm = int(
            round(self.underlying / 50.0) * 50
        )

        # --------------------------------------------------------
        # EXACT ATM ONLY
        #
        # The strategy must trade the ATM generated from the
        # selected-expiry synthetic future.
        #
        # NEVER silently substitute a nearby strike.
        # --------------------------------------------------------

        selected_atm = target_atm

        ce = self.chain.get(
            (expiry, selected_atm, "CE")
        )

        pe = self.chain.get(
            (expiry, selected_atm, "PE")
        )

        # Exact ATM pair not yet available.
        # Do not manufacture a trade from a nearby strike.
        if not ce or not pe:
            return expiry, None, None, None

        if not ce or not pe:
            return expiry, None, None, None

        return expiry, ce, pe, float(selected_atm)

    # --------------------------------------------------------
    # DTE
    # --------------------------------------------------------

    def _calculate_dte(self, expiry):
        return self._live_dte_calculation(expiry)

    # --------------------------------------------------------
    # Exact live DTE calculation
    #
    # Expiry is evaluated through 15:40 IST.
    #
    # Raw DTE = exact calendar-time difference in days.
    # Weekend adjustment is applied later by recalculate()
    # exactly like the reference strategy.
    # --------------------------------------------------------

    def _live_dte_calculation(self, expiry):
        """
        RAW / normalized DTE used by the quantitative engine.

        For a future expiry:

            calendar days until expiry
            +
            remaining fraction of TODAY'S 09:15-15:40 session.

        One complete session = 385 minutes.

        This value is used as self.raw_dte.

        The existing recalculate() method then applies the
        optimizer's separate weekend adjustment to derive
        self.trading_dte for LUT / strategy classification.
        """

        try:

            now = now_ist_naive()

            exp_date = datetime.strptime(
                expiry,
                "%d-%b-%y"
            ).date()

            today = now.date()

            days_diff = (
                exp_date - today
            ).days

            # Already expired.
            if days_diff < 0:
                return 0.0001

            OPEN_MIN = (
                9 * 60 + 15
            )

            CLOSE_MIN = (
                15 * 60 + 40
            )

            SESSION_MINUTES = 385

            current_minutes = (
                now.hour * 60
                +
                now.minute
                +
                now.second / 60.0
            )

            # ====================================================
            # Expiry today
            # ====================================================

            if days_diff == 0:

                if current_minutes >= CLOSE_MIN:
                    return 0.0001

                if current_minutes < OPEN_MIN:
                    return 1.0

                remaining_minutes = (
                    CLOSE_MIN
                    -
                    current_minutes
                )

                return max(
                    remaining_minutes
                    /
                    SESSION_MINUTES,
                    0.0001
                )

            # ====================================================
            # Future expiry
            #
            # Only today's remaining time is fractional.
            # Future calendar days remain whole days.
            # ====================================================

            if current_minutes >= CLOSE_MIN:

                today_fraction = 0.0

            elif current_minutes < OPEN_MIN:

                today_fraction = 1.0

            else:

                minutes_elapsed = (
                    current_minutes
                    -
                    OPEN_MIN
                )

                today_fraction = max(
                    0.0,
                    1.0
                    -
                    (
                        minutes_elapsed
                        /
                        SESSION_MINUTES
                    )
                )

            return max(
                days_diff
                +
                today_fraction,
                0.0001
            )

        except Exception:
            return np.nan

    # --------------------------------------------------------
    # Reference state
    # --------------------------------------------------------

    def update_reference_state(self):

        today = now_ist_naive().date()

        try:
            # Prefer today's reference row when available.
            # Otherwise use the latest historical reference row
            # available on or before today.
            available = []

            for key, value in self.prev_lookup.items():
                try:
                    d = datetime.strptime(
                        key,
                        "%Y-%m-%d"
                    ).date()

                    if d <= today:
                        available.append((d, key, value))
                except Exception:
                    continue

            if not available:
                self.reference_status = (
                    "REFERENCE ERROR: no historical reference row available"
                )
                return False

            available.sort(key=lambda x: x[0])

            reference_day, key, row = available[-1]

            pure, with_prev = self.get_previous_idvs(
                pd.Timestamp(today)
            )

            self.prev_pure_idv = pure
            self.prev_with_prev_idv = with_prev

            self.prev_straddle = float(
                row["Straddle"]
            )

            self.adj_iv_chg = float(
                row["Normalized_Adj_Chg"]
            )

            self.target_base = float(
                row["Target_Base"]
            )

            self.prev_future = float(
                row["Future"]
            )

            self.weighted_idv = (
                WEIGHTS[0] * pure
                + WEIGHTS[1] * with_prev
                + WEIGHTS[2] * self.target_base
            )

            if not np.isfinite(self.weighted_idv):
                self.reference_status = (
                    "REFERENCE ERROR: weighted IDV is not finite"
                )
                return False

            if self.weighted_idv <= 0:
                self.reference_status = (
                    "REFERENCE ERROR: weighted IDV <= 0"
                )
                return False

            self.reference_date = key

            self.reference_status = (
                "READY"
                if reference_day == today
                else f"READY | using latest available reference: {key}"
            )

            return True

        except Exception as e:

            self.reference_status = (
                f"REFERENCE ERROR: {e}"
            )

            return False

    # --------------------------------------------------------
    # Feature calculation
    # --------------------------------------------------------

    def recalculate(self):

        if not np.isfinite(self.underlying):
            return

        expiry, ce, pe, selected_atm = self._atm_pair()

        if ce is None or pe is None:
            return

        self.atm = float(selected_atm)

        # Historical state is mandatory.
        if not self.update_reference_state():
            return

        raw_dte = self._calculate_dte(expiry)

        if not np.isfinite(raw_dte):
            return

        self.raw_dte = raw_dte

        # The optimizer adjusts weekend DTE exactly this way.
        today = pd.Timestamp(now_ist_naive()).normalize()

        exp_day = (
            today
            + pd.Timedelta(days=int(math.ceil(raw_dte)))
        )

        bus_days = np.busday_count(
            np.datetime64(today.date()),
            np.datetime64(exp_day.date())
        )

        weekend_days = (
            int(math.ceil(raw_dte))
            - int(bus_days)
        )

        if weekend_days > 0:

            trading_dte = max(
                0.0,
                raw_dte - WKND_ADJ
            )

        else:
            trading_dte = raw_dte

        self.trading_dte = trading_dte

        dte_idx = int(
            np.clip(
                math.ceil(trading_dte) - 1,
                0,
                6
            )
        )

        self.dte_bucket = str(dte_idx + 1)

        adj_factor = 1.0

        if (
            raw_dte > 0
            and trading_dte > 0
            and raw_dte != trading_dte
        ):
            adj_factor = math.sqrt(
                raw_dte / trading_dte
            )

        # ----------------------------------------------------
        # Build IV
        #
        # OTMIVRef in the original code is the IV at the
        # current ATM reference strike.
        # ----------------------------------------------------

        atm_iv = self._iv_decimal(
            ce.get("iv")
        )

        pe_iv = self._iv_decimal(
            pe.get("iv")
        )

        valid_ivs = [
            x for x in [atm_iv, pe_iv]
            if np.isfinite(x) and x > 0
        ]

        if not valid_ivs:
            return

        # Prefer the actual option-chain IV already produced
        # by the C++ analytics engine.
        build_iv = float(
            np.mean(valid_ivs)
        )

        # Preserve the unadjusted/raw IV.
        # Reference PtsAllowed uses this value.
        self.raw_build_iv = build_iv

        adjusted_build_iv = (
            build_iv * adj_factor
        )

        self.build_iv = adjusted_build_iv

        self.iv_ratio = (
            adjusted_build_iv
            / self.weighted_idv
        )

        # ----------------------------------------------------
        # Reference straddle
        # ----------------------------------------------------

        S = float(self.underlying)
        K = float(self.atm)
        T = max(
            self.raw_dte / 365.0,
            1e-5
        )

        ref_iv = build_iv

        ce_ref = bs_price(
            True,
            S,
            K,
            T,
            0.0,
            ref_iv
        )

        pe_ref = bs_price(
            False,
            S,
            K,
            T,
            0.0,
            ref_iv
        )

        self.current_straddle = (
            ce_ref + pe_ref
        )

        if self.current_straddle <= 0:
            return

        self.straddle_ratio = (
            self.prev_straddle
            / self.current_straddle
        )

        # ----------------------------------------------------
        # Overnight gap
        # ----------------------------------------------------

        if self.prev_future > 0:

            og_pct = (
                (self.underlying - self.prev_future)
                / self.prev_future
            ) * 100.0

            self.norm_og_gap = (
                og_pct
                * (0.19 / self.target_base)
            )

        # ----------------------------------------------------
        # Stage / LUT
        # ----------------------------------------------------

        stage = self.stage_for_time(
            now_ist_naive().time()
        )

        self.stage = stage

        key = (
            bucket_dte(self.trading_dte),
            bucket_iv(self.iv_ratio),
            bucket_straddle(self.straddle_ratio),
            bucket_build_iv(self.build_iv),
            bucket_og(self.norm_og_gap),
            bucket_adj(self.adj_iv_chg),
        )

        decision = self.luts.get(
            stage,
            {}
        ).get(key, "NO")

        # ----------------------------------------------------
        # ONE TRADE ONLY
        #
        # Once the first valid trade has been entered,
        # every subsequent stage evaluation is NO.
        #
        # This prevents:
        #   - another YES
        #   - another entry
        #   - another hedge initialization
        #   - another trade later in the same session/day
        # ----------------------------------------------------

        if self.trade_triggered:
            decision = "NO"

        # ----------------------------------------------------
        # FIRST YES LOCK
        # ----------------------------------------------------

        if (
            decision == "YES"
            and not self.trade_triggered
        ):

            # ==================================================
            # HARD ENTRY INTEGRITY CHECK
            #
            # A trade may ONLY be opened when the selected
            # weekly expiry and current simulation ATM match
            # the CE/PE contracts being entered.
            # ==================================================

            entry_allowed = True
            entry_block_reason = None

            try:
                current_atm = int(
                    round(
                        float(self.underlying) / 50.0
                    ) * 50
                )

                ce_expiry = str(
                    ce.get("expiry", "")
                ).strip()

                pe_expiry = str(
                    pe.get("expiry", "")
                ).strip()

                ce_strike = int(
                    round(
                        float(
                            ce.get("strike")
                        )
                    )
                )

                pe_strike = int(
                    round(
                        float(
                            pe.get("strike")
                        )
                    )
                )

                if ce_expiry != expiry:
                    entry_allowed = False
                    entry_block_reason = (
                        "CE_EXPIRY_MISMATCH"
                    )

                elif pe_expiry != expiry:
                    entry_allowed = False
                    entry_block_reason = (
                        "PE_EXPIRY_MISMATCH"
                    )

                elif ce_strike != current_atm:
                    entry_allowed = False
                    entry_block_reason = (
                        f"CE_STRIKE_NOT_ATM:"
                        f"{ce_strike}!={current_atm}"
                    )

                elif pe_strike != current_atm:
                    entry_allowed = False
                    entry_block_reason = (
                        f"PE_STRIKE_NOT_ATM:"
                        f"{pe_strike}!={current_atm}"
                    )

                # Require valid executable quotes.
                for label, row in (
                    ("CE", ce),
                    ("PE", pe),
                ):
                    bid = self._num(
                        row.get("bid")
                    )

                    ask = self._num(
                        row.get("ask")
                    )

                    if (
                        not np.isfinite(bid)
                        or bid <= 0
                        or not np.isfinite(ask)
                        or ask <= 0
                    ):
                        entry_allowed = False
                        entry_block_reason = (
                            f"{label}_INVALID_QUOTE"
                        )
                        break

            except Exception as e:
                entry_allowed = False
                entry_block_reason = (
                    f"ENTRY_VALIDATION_ERROR:{e}"
                )

            if entry_allowed:
                self.enter_trade(
                    expiry,
                    ce,
                    pe
                )
            else:
                self.entry_stage = None

                self.signal_history.append({
                    "timestamp":
                        now_ist_naive().isoformat(),
                    "stage": stage,
                    "decision": "BLOCKED",
                    "reason": entry_block_reason,
                    "expiry": expiry,
                    "atm": (
                        int(
                            round(
                                float(
                                    self.underlying
                                ) / 50.0
                            ) * 50
                        )
                        if np.isfinite(
                            self.underlying
                        )
                        else None
                    ),
                    "ce": (
                        ce.get("symbol")
                        if isinstance(ce, dict)
                        else None
                    ),
                    "pe": (
                        pe.get("symbol")
                        if isinstance(pe, dict)
                        else None
                    ),
                })

                # YES means the LUT matched.
                # BLOCKED means market/contract integrity
                # prevented an actual trade.
                self.signal = "BLOCKED"

        # After the first accepted trade, the current signal
        # is always NO. The first trade remains preserved in
        # trade history/audit.
        if self.trade_triggered:
            self.signal = "NO"
        else:
            self.signal = decision

        self.signal_history.append({
            "timestamp": now_ist_naive().isoformat(),
            "stage": stage,
            "decision": (
                "NO"
                if self.trade_triggered
                else decision
            ),
            "key": key,
        })

        if len(self.signal_history) > 500:
            self.signal_history = (
                self.signal_history[-500:]
            )

        if self.trade_active:
            self.update_position(
                expiry,
                ce,
                pe
            )

    # --------------------------------------------------------
    # Entry
    # --------------------------------------------------------

    def enter_trade(
        self,
        expiry,
        ce,
        pe
    ):

        # Do NOT enter if the feed does not expose executable
        # bid/ask. Never substitute 150/150 or synthetic prices.
        if not (
            np.isfinite(ce.get("bid", np.nan))
            and np.isfinite(pe.get("bid", np.nan))
        ):
            self.signal = "YES"
            self.reference_status = (
                "WAITING_FOR_REAL_CE_PE_BID_ASK"
            )
            return

        self.trade_triggered = True
        self.trade_active = True

        self.entry_stage = self.stage
        self.entry_time = now_ist_naive().strftime(
            "%H:%M:%S"
        )

        self.entry_underlying = (
            self.underlying
        )

        # Actual NIFTY future used for hedge P&L.
        # This is deliberately NOT self.underlying,
        # because self.underlying is the selected-expiry
        # synthetic future / simulation spot.
        self.entry_future = (
            self.future
        )

        self.entry_atm = self.atm

        self.entry_ce = ce.get("symbol")
        self.entry_pe = pe.get("symbol")

        self.entry_ce_bid = (
            float(ce["bid"])
        )

        self.entry_pe_bid = (
            float(pe["bid"])
        )

        self.current_ce_ask = (
            float(ce.get("ask", ce["ltp"]))
        )

        self.current_pe_ask = (
            float(pe.get("ask", pe["ltp"]))
        )

        # ----------------------------------------------------
        # BUILD SNAPSHOT
        #
        # The 30-second reference execution window is NOT used
        # as the delta timestamp.
        #
        # Initial delta is calculated from the SAME live state
        # that triggered the trade.
        # ----------------------------------------------------

        self.build_timestamp = (
            now_ist().isoformat(
                timespec="seconds"
            )
        )

        self.build_spot = float(
            self.underlying
        )

        self.build_future = (
            float(self.future)
            if np.isfinite(self.future)
            else np.nan
        )

        self.build_atm = float(
            self.atm
        )

        self.build_iv = float(
            self.build_iv
        )

        self.build_dte = float(
            self.raw_dte
        )

        self.build_ce_delta = np.nan
        self.build_pe_delta = np.nan
        self.build_opt_delta = np.nan

        # Initial short option credit.
        self.opt_pnl = 0.0

        # ----------------------------------------------------
        # INITIAL DELTA HEDGE
        #
        # Exactly at build/entry state.
        #
        # Short CE + Short PE:
        #     OptDelta = -CallDelta - PutDelta
        #
        # Initial futures hedge:
        #     FutHedge = -OptDelta
        #
        # No 30-second delay.
        # No hedge-point test for the initial hedge.
        # ----------------------------------------------------

        iv = max(
            self.build_iv,
            1e-6
        )

        T = max(
            self.raw_dte / 365.0,
            1e-5
        )

        d_call = bs_delta(
            True,
            self.build_spot,
            self.build_atm,
            T,
            0.0,
            iv
        )

        d_put = bs_delta(
            False,
            self.build_spot,
            self.build_atm,
            T,
            0.0,
            iv
        )

        self.build_ce_delta = (
            float(d_call)
            if np.isfinite(d_call)
            else np.nan
        )

        self.build_pe_delta = (
            float(d_put)
            if np.isfinite(d_put)
            else np.nan
        )

        opt_delta = (
            -d_call - d_put
        )

        self.build_opt_delta = (
            float(opt_delta)
            if np.isfinite(opt_delta)
            else np.nan
        )

        self.opt_delta = self.build_opt_delta

        self.opt_gamma = (
            -2.0 * bs_gamma(
                self.build_spot,
                self.build_atm,
                T,
                0.0,
                iv
            )
        )

        self.fut_total = (
            -self.build_opt_delta
            if np.isfinite(
                self.build_opt_delta
            )
            else 0.0
        )

        self.initial_hedge = (
            self.fut_total
        )

        self.initial_hedge_timestamp = (
            self.build_timestamp
        )

        self._hedge_event_kind = (
            "INITIAL_HEDGE"
        )

        self._hedge_event_reason = (
            "ENTRY_DELTA_NEUTRAL"
        )

        self._hedge_breached = False

        self.fut_cash = 0.0
        self.fut_pnl = (
    self.fut_total
    *
    (
        self.underlying
        -
        self.entry_future
    )
)

        self.total_pnl = 0.0

        self.exit_reason = None
        self.exit_time = None

        # Immutable trade snapshot created at entry.
        self.last_trade = {
            "entry_timestamp": (
                now_ist_naive().isoformat(
                    timespec="seconds"
                )
            ),
            "entry_stage": self.entry_stage,
            "expiry": expiry,
            "spot": float(self.entry_underlying),
            "future": (
                float(self.entry_future)
                if np.isfinite(self.entry_future)
                else None
            ),
            "atm": float(self.entry_atm),
            "ce": self.entry_ce,
            "pe": self.entry_pe,
            "entry_ce_bid": float(self.entry_ce_bid),
            "entry_pe_bid": float(self.entry_pe_bid),
            "entry_straddle": (
                float(
                    self.entry_ce_bid
                    + self.entry_pe_bid
                )
            ),
            "future_hedge_entry": float(
                self.initial_hedge
            ),
            "build_timestamp":
                self.build_timestamp,
            "build_spot":
                float(self.build_spot),
            "build_future":
                (
                    float(self.build_future)
                    if np.isfinite(
                        self.build_future
                    )
                    else None
                ),
            "build_atm":
                float(self.build_atm),
            "build_iv":
                float(self.build_iv),
            "build_dte":
                float(self.build_dte),
            "ce_delta_at_build":
                float(self.build_ce_delta),
            "pe_delta_at_build":
                float(self.build_pe_delta),
            "opt_delta_at_build":
                float(self.build_opt_delta),
            "initial_hedge_timestamp":
                self.initial_hedge_timestamp,
            "leg_ratio":
                "1:1",
        }

        print(
            f"[SIM ENTRY] {self.entry_time} "
            f"stage={self.entry_stage} "
            f"ATM={self.entry_atm} "
            f"CE={self.entry_ce_bid:.2f} "
            f"PE={self.entry_pe_bid:.2f}"
        )

    # --------------------------------------------------------
    # Position / P&L
    # --------------------------------------------------------


    def _refresh_live_risk_greeks(
        self,
        ce=None,
        pe=None
    ):
        """
        Authoritative live Greeks and hedge-risk calculation.

        RAW DTE is used for IV/Greeks.
        Live CE/PE IV is preferred.
        """

        try:

            # ------------------------------------------------
            # LIVE IV
            # ------------------------------------------------

            iv_values = []

            if isinstance(ce, dict):

                ce_iv = self._num(
                    ce.get("iv")
                )

                if (
                    np.isfinite(ce_iv)
                    and
                    ce_iv > 0
                ):
                    iv_values.append(
                        float(ce_iv)
                    )

            if isinstance(pe, dict):

                pe_iv = self._num(
                    pe.get("iv")
                )

                if (
                    np.isfinite(pe_iv)
                    and
                    pe_iv > 0
                ):
                    iv_values.append(
                        float(pe_iv)
                    )

            if iv_values:

                iv_live = float(
                    np.mean(
                        iv_values
                    )
                )

            else:

                iv_live = self._num(
                    getattr(
                        self,
                        "raw_build_iv",
                        np.nan
                    )
                )

                if (
                    not np.isfinite(iv_live)
                    or
                    iv_live <= 0
                ):

                    iv_live = self._num(
                        getattr(
                            self,
                            "build_iv",
                            np.nan
                        )
                    )

            if (
                not np.isfinite(iv_live)
                or
                iv_live <= 0
            ):
                raise ValueError(
                    "No valid IV available"
                )

            # ------------------------------------------------
            # RAW DTE
            # ------------------------------------------------

            raw_dte = self._num(
                getattr(
                    self,
                    "raw_dte",
                    np.nan
                )
            )

            if (
                not np.isfinite(raw_dte)
                or
                raw_dte <= 0
            ):
                raise ValueError(
                    "Invalid raw DTE"
                )

            T = max(
                float(raw_dte) / 365.0,
                1e-5
            )

            # ------------------------------------------------
            # UNDERLYING / ATM
            # ------------------------------------------------

            S = self._num(
                getattr(
                    self,
                    "underlying",
                    np.nan
                )
            )

            K = self._num(
                getattr(
                    self,
                    "atm",
                    np.nan
                )
            )

            if (
                not np.isfinite(S)
                or
                S <= 0
                or
                not np.isfinite(K)
                or
                K <= 0
            ):
                raise ValueError(
                    "Invalid underlying or ATM"
                )

            sqrtT = math.sqrt(T)

            # ------------------------------------------------
            # BLACK-SCHOLES
            # ------------------------------------------------

            d1 = (
                math.log(S / K)
                +
                0.5
                *
                iv_live
                *
                iv_live
                *
                T
            ) / (
                iv_live
                *
                sqrtT
            )

            pdf_d1 = (
                math.exp(
                    -0.5 * d1 * d1
                )
                /
                math.sqrt(
                    2.0 * math.pi
                )
            )

            # ------------------------------------------------
            # DELTA
            # ------------------------------------------------

            call_delta = bs_delta(
                True,
                S,
                K,
                T,
                0.0,
                iv_live
            )

            put_delta = bs_delta(
                False,
                S,
                K,
                T,
                0.0,
                iv_live
            )

            opt_delta = (
                -call_delta
                -
                put_delta
            )

            # ------------------------------------------------
            # GAMMA
            # ------------------------------------------------

            gamma_each = (
                pdf_d1
                /
                (
                    S
                    *
                    iv_live
                    *
                    sqrtT
                )
            )

            opt_gamma = (
                -2.0
                *
                gamma_each
            )

            # ------------------------------------------------
            # THETA
            # Per calendar day
            # ------------------------------------------------

            theta_each_year = (
                -(
                    S
                    *
                    pdf_d1
                    *
                    iv_live
                )
                /
                (
                    2.0
                    *
                    sqrtT
                )
            )

            opt_theta = (
                -2.0
                *
                theta_each_year
                /
                365.0
            )

            # ------------------------------------------------
            # VEGA
            # Per 1 volatility-point move
            # ------------------------------------------------

            vega_each = (
                S
                *
                pdf_d1
                *
                sqrtT
                /
                100.0
            )

            opt_vega = (
                -2.0
                *
                vega_each
            )

            # ------------------------------------------------
            # AUTHORITATIVE VALUES
            # ------------------------------------------------

            self.opt_delta = float(
                opt_delta
            )

            self.opt_gamma = float(
                opt_gamma
            )

            self.opt_theta = float(
                opt_theta
            )

            self.opt_vega = float(
                opt_vega
            )

            # ------------------------------------------------
            # POINTS OUT
            # ------------------------------------------------

            fut_total = self._num(
                getattr(
                    self,
                    "fut_total",
                    0.0
                )
            )

            if not np.isfinite(
                fut_total
            ):
                fut_total = 0.0

            net_delta = (
                opt_delta
                +
                fut_total
            )

            if abs(
                opt_gamma
            ) > 1e-12:

                self.pts_out = abs(
                    net_delta
                    /
                    opt_gamma
                )

            else:

                self.pts_out = np.nan

            # ------------------------------------------------
            # POINTS ALLOWED
            # ------------------------------------------------

            raw_build_iv = self._num(
                getattr(
                    self,
                    "raw_build_iv",
                    np.nan
                )
            )

            current_straddle = self._num(
                getattr(
                    self,
                    "current_straddle",
                    np.nan
                )
            )

            if (
                np.isfinite(raw_build_iv)
                and
                raw_build_iv > 0
                and
                np.isfinite(current_straddle)
                and
                current_straddle > 0
            ):

                raw_pts = min(
                    (
                        raw_build_iv
                        /
                        57.0
                    )
                    *
                    S,
                    current_straddle
                    /
                    4.0
                )

                self.pts_allowed = max(
                    raw_pts,
                    0.0008 * S
                )

            else:

                self.pts_allowed = np.nan

            return

        except Exception as exc:

            print(
                "[RISK] authoritative live Greek refresh failed:",
                exc
            )

            self.opt_delta = np.nan
            self.opt_gamma = np.nan
            self.opt_theta = np.nan
            self.opt_vega = np.nan
            self.pts_out = np.nan
            self.pts_allowed = np.nan

            return None

    def update_position(
        self,
        expiry,
        ce,
        pe
    ):

        if not self.trade_active:
            return

        # ----------------------------------------------------
        # LIVE OPTION MARKS
        #
        # LTP is the authoritative live simulation mark.
        # ----------------------------------------------------

        ce_ltp = self._num(
            ce.get("ltp")
        )

        pe_ltp = self._num(
            pe.get("ltp")
        )

        if not (
            np.isfinite(ce_ltp)
            and np.isfinite(pe_ltp)
        ):
            return

        # Keep legacy fields compatible.
        self.current_ce_ask = ce_ltp
        self.current_pe_ask = pe_ltp

        # Explicit LTP state.
        self.current_ce_ltp = ce_ltp
        self.current_pe_ltp = pe_ltp



        # ----------------------------------------------------
        # ----------------------------------------------------
        # LIVE OPTION GREEKS
        #
        # RAW DTE is used for IV / Greeks.
        # Trading DTE is NOT used here.
        # ----------------------------------------------------

        try:

            iv_live = self._num(
                ce.get("iv")
            )

            if (
                not np.isfinite(iv_live)
                or iv_live <= 0
            ):

                # Fall back to RAW / unadjusted build IV.
                iv_live = self._num(
                    getattr(
                        self,
                        "raw_build_iv",
                        np.nan
                    )
                )

            if (
                not np.isfinite(iv_live)
                or iv_live <= 0
            ):

                iv_live = self.build_iv

            iv_live = max(
                iv_live,
                1e-6
            )

            T_live = max(
                self.raw_dte / 365.0,
                1e-5
            )

            S_live = float(
                self.underlying
            )

            K_live = float(
                self.atm
            )

            sqrt_t = math.sqrt(
                T_live
            )

            d1 = (
                math.log(
                    S_live / K_live
                )
                +
                0.5
                * iv_live
                * iv_live
                * T_live
            ) / (
                iv_live
                * sqrt_t
            )

            pdf_d1 = (
                math.exp(
                    -0.5 * d1 * d1
                )
                /
                math.sqrt(
                    2.0 * math.pi
                )
            )

            # ------------------------------------------------
            # DELTA
            # ------------------------------------------------

            d_call_live = bs_delta(
                True,
                S_live,
                K_live,
                T_live,
                0.0,
                iv_live
            )

            d_put_live = bs_delta(
                False,
                S_live,
                K_live,
                T_live,
                0.0,
                iv_live
            )

            # Short CE + short PE.
            self.opt_delta = (
                -d_call_live
                - d_put_live
            )

            # ------------------------------------------------
            # GAMMA
            # ------------------------------------------------

            self.opt_gamma = (
                -2.0
                * bs_gamma(
                    S_live,
                    K_live,
                    T_live,
                    0.0,
                    iv_live
                )
            )

            # ------------------------------------------------
            # THETA
            # ------------------------------------------------

            theta_one_leg = (
                -(
                    S_live
                    * pdf_d1
                    * iv_live
                )
                /
                (
                    2.0
                    * sqrt_t
                    * 365.0
                )
            )

            # Short straddle -> positive theta.
            self.opt_theta = (
                -2.0
                * theta_one_leg
            )

            # ------------------------------------------------
            # VEGA
            #
            # Per 1% IV.
            # Short straddle -> negative vega.
            # ------------------------------------------------

            vega_one_leg = (
                S_live
                * pdf_d1
                * sqrt_t
                /
                100.0
            )

            self.opt_vega = (
                -2.0
                * vega_one_leg
            )

        except Exception as exc:

            print(
                "[LIVE GREEKS] update failed:",
                exc
            )

            self.opt_delta = np.nan
            self.opt_gamma = np.nan
            self.opt_theta = np.nan
            self.opt_vega = np.nan

        # HEDGE RISK
        #
        # Reference:
        #   NetDelta = OptDelta + FutTot
        #   PtsOut   = abs(NetDelta / OptGamma)
        #
        # PtsAllowed:
        #   min(
        #       (BuildIV / 57) * Spot,
        #       CurrentStraddle / 4
        #   )
        #   floored at 0.08% of spot.
        # ----------------------------------------------------

        try:
            if (
                np.isfinite(self.opt_delta)
                and np.isfinite(self.opt_gamma)
                and abs(self.opt_gamma) > 1e-12
            ):
                net_delta = (
                    self.opt_delta
                    + self.fut_total
                )

                self.pts_out = abs(
                    net_delta
                    / self.opt_gamma
                )
            else:
                self.pts_out = np.nan

            raw_build_iv = self._num(
                getattr(
                    self,
                    "raw_build_iv",
                    np.nan
                )
            )

            if (
                not np.isfinite(raw_build_iv)
                or raw_build_iv <= 0
            ):

                raw_build_iv = self.build_iv

            self.pts_allowed = max(
                min(
                    (
                        raw_build_iv
                        / 57.0
                    )
                    * self.underlying,

                    (
                        ce_ltp
                        + pe_ltp
                    )
                    / 4.0
                ),
                0.0008
                * self.underlying
            )

            # ------------------------------------------------
            # THRESHOLD-ONLY FUTURES REBALANCE
            #
            # PARAM_HEDGE_FRAC = 1.0 in the reference.
            # Therefore a breach fully neutralizes the
            # current net option/futures delta.
            #
            # Re-arming happens only after the metric returns
            # inside the allowed band.
            # ------------------------------------------------

            if (
                np.isfinite(self.pts_out)
                and np.isfinite(self.pts_allowed)
                and self.pts_out > self.pts_allowed
            ):

                if not self._hedge_breached:

                    hedge_adjustment = (
                        -net_delta
                    )

                    if np.isfinite(
                        hedge_adjustment
                    ):
                        self.fut_total += (
                            hedge_adjustment
                        )

                        self._hedge_event_kind = (
                            "REBALANCE"
                        )

                        self._hedge_event_reason = (
                            "POINTS_OUT_BREACH"
                        )

                        self._hedge_breached = True

            elif (
                np.isfinite(self.pts_out)
                and np.isfinite(self.pts_allowed)
                and self.pts_out <= self.pts_allowed
            ):

                self._hedge_breached = False

        except Exception:
            pass

        # Option P&L for current ATM chunk.
        entry_credit = (
            self.entry_ce_bid
            + self.entry_pe_bid
        )

        current_exit_cost = (
            ce_ltp
            + pe_ltp
        )

        self.opt_pnl = (
            entry_credit
            - current_exit_cost
        )

        # ----------------------------------------------------
        # Futures mark-to-market
        #
        # Current hedge is represented as futures position.
        # Use underlying as liquidation mark.
        # ----------------------------------------------------

        # ----------------------------------------------------
        # SYNTHETIC FUTURES-HEDGE P&L
        #
        # Entry:
        #     synthetic future captured at build
        #
        # Current:
        #     current synthetic spot / underlying
        #
        # IMPORTANT:
        # actual current futures quote is NOT used.
        # ----------------------------------------------------

        if (
            np.isfinite(
                self.underlying
            )
            and
            np.isfinite(
                self.entry_future
            )
        ):

            synthetic_move = (
                self.underlying
                -
                self.entry_future
            )

            self.fut_pnl = (
                (
    self.fut_total
    *
    (
        self.underlying
        -
        self.entry_future
    )
)
            )

        else:

            self.fut_pnl = (
    self.fut_total
    *
    (
        self.underlying
        -
        self.entry_future
    )
)

        self.total_pnl = (
            self.opt_pnl
            + self.fut_pnl
        )

        # ----------------------------------------------------
        # OTM values
        # ----------------------------------------------------

        if self.underlying > self.atm:
            otm_trade = pe.get("ltp", np.nan)
            otm_ref = bs_price(
                False,
                self.underlying,
                self.atm,
                max(self.raw_dte / 365.0, 1e-5),
                0.0,
                max(self.build_iv, 1e-6)
            )
        else:
            otm_trade = ce.get("ltp", np.nan)
            otm_ref = bs_price(
                True,
                self.underlying,
                self.atm,
                max(self.raw_dte / 365.0, 1e-5),
                0.0,
                max(self.build_iv, 1e-6)
            )

        otm_iv = self.build_iv

        now_minutes = (
            now_ist_naive().hour * 60
            + now_ist_naive().minute
        )

        # ----------------------------------------------------
        # Dynamic TP exactly from optimizer formula
        # ----------------------------------------------------

        dte_idx = int(
            np.clip(
                math.ceil(self.trading_dte) - 1,
                0,
                6
            )
        )

        rounded_bld = round(
            self.build_iv,
            2
        )

        fraction = (
            rounded_bld - 0.08
        ) / 0.12

        base_tp_bps = (
            TP_LOW[dte_idx]
            + fraction
            * (
                TP_HIGH[dte_idx]
                - TP_LOW[dte_idx]
            )
        )

        tp_bps = max(
            1.0,
            round(base_tp_bps)
        )

        max_loss_pts = -(
            self.entry_underlying
            * SL_BPS
            / 10000.0
        )

        max_profit_pts = (
            self.entry_underlying
            * tp_bps
            / 10000.0
        )

        # ----------------------------------------------------
        # EXACT EXIT CONDITIONS
        # ----------------------------------------------------

        sl_cond = (
            self.total_pnl
            <= max_loss_pts
        )

        tp_cond = (
            self.total_pnl
            >= max_profit_pts
        )

        tv_cond = (
            np.isfinite(otm_trade)
            and (
                2.0 * otm_trade
                < TV_THRESH
                * self.underlying
            )
        )

        tv4_cond = (
            np.isfinite(otm_ref)
            and (
                2.0 * otm_ref
                < TV4_THRESH
                * self.underlying
            )
        )

        iv_cond = (
            now_minutes >= 897
            and np.isfinite(otm_iv)
            and otm_iv < IV_DROP_THRESH
            and self.trading_dte <= 1.0
        )

        reason = None

        if sl_cond:
            reason = "STOP_LOSS"
        elif tp_cond:
            reason = "TAKE_PROFIT"
        elif tv_cond:
            reason = "OTM_TRADE_VALUE"
        elif tv4_cond:
            reason = "OTM_REFERENCE_VALUE"
        elif iv_cond:
            reason = "IV_DROP"

        # EOD
        if (
            now_ist_naive().time()
            >= MARKET_CLOSE_IST
        ):
            reason = "EOD"

        if reason:
            self.exit_trade(
                reason
            )

        # ====================================================
        # AUTHORITATIVE LIVE GREEK / RISK REFRESH
        # ====================================================

        self._refresh_live_risk_greeks(
            locals().get("ce"),
            locals().get("pe")
        )

    # --------------------------------------------------------
    # Exit
    # --------------------------------------------------------

    def exit_trade(self, reason):

        if not self.trade_active:
            return

        self.trade_active = False

        self.exit_reason = reason
        self.exit_time = now_ist_naive().strftime(
            "%H:%M:%S"
        )

        # --------------------------------------------------------
        # Finalize immutable trade audit record.
        # --------------------------------------------------------

        if self.last_trade is not None:

            self.last_trade.update({
                "exit_timestamp": (
                    now_ist_naive().isoformat(
                        timespec="seconds"
                    )
                ),
                "exit_reason": reason,
                "exit_spot": (
                    float(self.underlying)
                    if np.isfinite(self.underlying)
                    else None
                ),
                "exit_future": (
                    float(self.future)
                    if np.isfinite(self.future)
                    else None
                ),
                "exit_ce_ask": (
                    float(self.current_ce_ask)
                    if np.isfinite(self.current_ce_ask)
                    else None
                ),
                "exit_pe_ask": (
                    float(self.current_pe_ask)
                    if np.isfinite(self.current_pe_ask)
                    else None
                ),
                "exit_straddle": (
                    float(
                        self.current_ce_ask
                        + self.current_pe_ask
                    )
                    if (
                        np.isfinite(self.current_ce_ask)
                        and np.isfinite(self.current_pe_ask)
                    )
                    else None
                ),
                "option_pnl": float(self.opt_pnl),
                "future_pnl": float(self.fut_pnl),
                "total_pnl": float(self.total_pnl),
                "final_hedge": float(self.fut_total),
            })

            self.trade_history.append(
                dict(self.last_trade)
            )

            if len(self.trade_history) > 50:
                self.trade_history = (
                    self.trade_history[-50:]
                )

        print(
            f"[SIM EXIT] {self.exit_time} "
            f"reason={reason} "
            f"OptPnL={self.opt_pnl:.4f} "
            f"FutPnL={self.fut_pnl:.4f} "
            f"TotPnL={self.total_pnl:.4f}"
        )

    # --------------------------------------------------------
    # JSON state
    # --------------------------------------------------------

    def state(self):

        with self.lock:

            return {
                "status": "SUCCESS",

                "market": {
                    "spot": self._json_num(
                        self.underlying
                    ),
                    "future": self._json_num(
                        self.future
                    ),
                    "atm": self._json_num(
                        self.atm
                    ),
                },

                "stage": {
                    "name": self.stage,
                    "signal": self.signal,
