# ============================================================
# LIVE MONITOR / TRADE AUDIT LAYER
# ============================================================

LIVE_MONITOR_STATE_INSTALLED = True

def _safe_float(v):
    try:
        x = float(v)
        return x if np.isfinite(x) else None
    except Exception:
        return None

def _safe_str(v):
    return None if v is None else str(v)

def _trade_monitor_state(self):

    now = now_ist()

    if not hasattr(self, "_monitor_trade"):
        self._monitor_trade = None

    if not hasattr(self, "_trade_history"):
        self._trade_history = []

    if not hasattr(self, "_hedge_events"):
        self._hedge_events = []

    # --------------------------------------------------------
    # Current hedge
    # --------------------------------------------------------

    fut_total = _safe_float(
        getattr(self, "fut_total", np.nan)
    )

    last_hedge = getattr(
        self,
        "_monitor_last_hedge",
        None
    )

    if (
        fut_total is not None
        and (
            last_hedge is None
            or abs(fut_total - last_hedge) > 1e-8
        )
    ):
        opt_delta = _safe_float(
            getattr(
                self,
                "opt_delta",
                getattr(
                    self,
                    "net_delta",
                    np.nan
                )
            )
        )

        opt_gamma = _safe_float(
            getattr(
                self,
                "opt_gamma",
                getattr(
                    self,
                    "gamma",
                    np.nan
                )
            )
        )

        if (
            opt_delta is not None
            and opt_gamma is not None
            and abs(opt_gamma) > 1e-12
        ):
            pts_out = abs(
                (opt_delta + fut_total)
                / opt_gamma
            )
        else:
            pts_out = _safe_float(
                getattr(
                    self,
                    "pts_out",
                    np.nan
                )
            )

        underlying = _safe_float(
            getattr(
                self,
                "underlying",
                np.nan
            )
        )

        build_iv = _safe_float(
            getattr(
                self,
                "build_iv",
                np.nan
            )
        )

        current_straddle = _safe_float(
            getattr(
                self,
                "current_straddle",
                np.nan
            )
        )

        pts_allowed = None

        if (
            underlying is not None
            and build_iv is not None
            and current_straddle is not None
        ):
            raw_pts = min(
                (build_iv / 57.0) * underlying,
                current_straddle / 4.0
            )

            pts_allowed = max(
                raw_pts,
                0.0008 * underlying
            )

        event = {
            "timestamp": now.isoformat(
                timespec="seconds"
            ),
            "kind": (
                getattr(
                    self,
                    "_hedge_event_kind",
                    None
                )
                or "REBALANCE"
            ),
            "reason": (
                getattr(
                    self,
                    "_hedge_event_reason",
                    None
                )
            ),
            "hedge_total": fut_total,
            "hedge_change": (
                fut_total - last_hedge
                if last_hedge is not None
                else fut_total
            ),
            "spot": underlying,
            "future": _safe_float(
                getattr(
                    self,
                    "future",
                    np.nan
                )
            ),
            "delta": opt_delta,
            "gamma": opt_gamma,
            "points_out": pts_out,
            "points_allowed": pts_allowed,
        }

        self._hedge_event_kind = None
        self._hedge_event_reason = None

        self._hedge_events.append(event)

        if len(self._hedge_events) > 100:
            self._hedge_events = (
                self._hedge_events[-100:]
            )

        self._monitor_last_hedge = fut_total

    # --------------------------------------------------------
    # Detect current entry
    # --------------------------------------------------------

    triggered = bool(
        getattr(
            self,
            "trade_triggered",
            False
        )
    )

    active = bool(
        getattr(
            self,
            "trade_active",
            False
        )
    )

    ce = _safe_str(
        getattr(
            self,
            "entry_ce",
            None
        )
    )

    pe = _safe_str(
        getattr(
            self,
            "entry_pe",
            None
        )
    )

    entry_ce = _safe_float(
        getattr(
            self,
            "entry_ce_bid",
            np.nan
        )
    )

    entry_pe = _safe_float(
        getattr(
            self,
            "entry_pe_bid",
            np.nan
        )
    )

    entry_straddle = None

    if (
        entry_ce is not None
        and entry_pe is not None
    ):
        entry_straddle = (
            entry_ce + entry_pe
        )

    current_ce_ask = _safe_float(
        getattr(
            self,
            "current_ce_ask",
            np.nan
        )
    )

    current_pe_ask = _safe_float(
        getattr(
            self,
            "current_pe_ask",
            np.nan
        )
    )

    current_straddle_live = None

    if (
        current_ce_ask is not None
        and current_pe_ask is not None
    ):
        current_straddle_live = (
            current_ce_ask + current_pe_ask
        )

    # --------------------------------------------------------
    # Entry integrity
    # --------------------------------------------------------

    atm = _safe_float(
        getattr(
            self,
            "atm",
            np.nan
        )
    )

    entry_integrity = True
    entry_block_reason = None

    if triggered:

        if (
            entry_ce is None
            or entry_pe is None
            or entry_ce <= 0
            or entry_pe <= 0
        ):
            entry_integrity = False
            entry_block_reason = (
                "ENTRY_QUOTES_UNAVAILABLE"
            )

        # Verify actual selected strike.
        # Existing symbols contain the strike at the end.
        if (
            atm is not None
            and ce
            and pe
        ):
            try:
                import re

                mce = re.search(
                    r"(\d+(?:\.\d+)?)CE$",
                    ce
                )

                mpe = re.search(
                    r"(\d+(?:\.\d+)?)PE$",
                    pe
                )

                if mce and mpe:
                    ce_k = float(
                        mce.group(1)
                    )
                    pe_k = float(
                        mpe.group(1)
                    )

                    if (
                        abs(ce_k - atm) > 0.01
                        or abs(pe_k - atm) > 0.01
                    ):
                        entry_integrity = False
                        entry_block_reason = (
                            "ENTRY_STRIKE_NOT_CURRENT_ATM"
                        )

            except Exception:
                pass

    # --------------------------------------------------------
    # Create / preserve entry snapshot
    # --------------------------------------------------------

    if triggered and self._monitor_trade is None:

        self._monitor_trade = {
            "entry_timestamp": now.isoformat(
                timespec="seconds"
            ),
            "expiry": getattr(
                self,
                "simulation_expiry_name",
                None
            ),
            "spot": _safe_float(
                getattr(
                    self,
                    "underlying",
                    np.nan
                )
            ),
            "future": _safe_float(
                getattr(
                    self,
                    "future",
                    np.nan
                )
            ),
            "atm": atm,
            "ce": ce,
            "pe": pe,
            "entry_ce": entry_ce,
            "entry_pe": entry_pe,
            "entry_straddle": entry_straddle,
            "entry_integrity": entry_integrity,
            "entry_block_reason": entry_block_reason,
        }

    # --------------------------------------------------------
    # P&L based ONLY on this entry
    # --------------------------------------------------------

    trade = self._monitor_trade

    derived_option_pnl = None

    if (
        trade
        and trade.get("entry_straddle") is not None
        and current_straddle_live is not None
    ):
        derived_option_pnl = (
            trade["entry_straddle"]
            - current_straddle_live
        )

    engine_option_pnl = _safe_float(
        getattr(
            self,
            "opt_pnl",
            np.nan
        )
    )

    # --------------------------------------------------------
    # AUTHORITATIVE SYNTHETIC FUTURE P&L
    #
    # Do NOT use self.fut_pnl here because that state can be
    # stale / produced by the legacy actual-futures mark.
    #
    # Current mark:
    #     self.underlying = synthetic/current spot
    #
    # Entry mark:
    #     trade["future"] = synthetic future at entry
    # --------------------------------------------------------

    engine_future_pnl = 0.0

    _pnl_entry_future = (
        trade.get("future")
        if trade
        else None
    )

    if (
        _pnl_entry_future is not None
        and np.isfinite(
            getattr(
                self,
                "underlying",
                np.nan
            )
        )
        and fut_total is not None
    ):

        _synthetic_future_move = (
            float(
                self.underlying
            )
            -
            float(
                _pnl_entry_future
            )
        )

        engine_future_pnl = (
            float(fut_total)
            *
            _synthetic_future_move
        )

    engine_total_pnl = _safe_float(
        getattr(
            self,
            "total_pnl",
            np.nan
        )
    )

    # --------------------------------------------------------
    # Greeks / points
    # --------------------------------------------------------

    delta = _safe_float(
        getattr(
            self,
            "opt_delta",
            getattr(
                self,
                "delta",
                np.nan
            )
        )
    )

    gamma = _safe_float(
        getattr(
            self,
            "opt_gamma",
            getattr(
                self,
                "gamma",
                np.nan
            )
        )
    )

    theta = _safe_float(
        getattr(
            self,
            "opt_theta",
            getattr(
                self,
                "theta",
                np.nan
            )
        )
    )

    vega = _safe_float(
        getattr(
            self,
            "opt_vega",
            getattr(
                self,
                "vega",
                np.nan
            )
        )
    )

    points_out = None

    if (
        delta is not None
        and gamma is not None
        and fut_total is not None
        and abs(gamma) > 1e-12
    ):
        points_out = abs(
            (delta + fut_total)
            / gamma
        )

    points_allowed = None

    underlying = _safe_float(
        getattr(
            self,
            "underlying",
            np.nan
        )
    )

    build_iv = _safe_float(
        getattr(
            self,
            "build_iv",
            np.nan
        )
    )

    strategy_straddle = _safe_float(
        getattr(
            self,
            "current_straddle",
            np.nan
        )
    )

    if (
        underlying is not None
        and build_iv is not None
        and strategy_straddle is not None
    ):
        raw_build_iv = _safe_float(
            getattr(
                self,
                "raw_build_iv",
                np.nan
            )
        )

        points_allowed = max(
            min(
                (raw_build_iv / 57.0) * underlying,
                strategy_straddle / 4.0
            ),
            0.0008 * underlying
        )

    # --------------------------------------------------------
    # Close trade audit record
    # --------------------------------------------------------

    exit_reason = getattr(
        self,
        "exit_reason",
        None
    )

    exit_time = getattr(
        self,
        "exit_time",
        None
    )

    if (
        trade
        and exit_reason
        and trade.get("exit_timestamp") is None
    ):
        trade["exit_timestamp"] = (
            exit_time
            or now.strftime("%H:%M:%S")
        )

        trade["exit_reason"] = exit_reason
        trade["exit_spot"] = underlying
        trade["exit_future"] = _safe_float(
            getattr(
                self,
                "future",
                np.nan
            )
        )

        trade["exit_straddle"] = (
            current_straddle_live
        )

        trade["option_pnl"] = (
            derived_option_pnl
            if derived_option_pnl is not None
            else engine_option_pnl
        )

        trade["future_pnl"] = (
            engine_future_pnl
        )

        trade["total_pnl"] = (
            (
                trade["option_pnl"] or 0.0
            )
            + (
                trade["future_pnl"] or 0.0
            )
        )

        self._trade_history.append(
            dict(trade)
        )

        if len(self._trade_history) > 50:
            self._trade_history = (
                self._trade_history[-50:]
            )

        self._monitor_trade = None


    # --------------------------------------------------------
    # EXIT / RISK TELEMETRY
    #
    # These are the exact units used by the strategy:
    #   SL / TP -> points per straddle
    #   TV / TV4 -> normalized threshold tests
    # --------------------------------------------------------

    sl_points = None
    tp_points = None
    tp_bps = None

    tv_threshold = float(
        globals().get("TV_THRESH", np.nan)
    )

    tv4_threshold = float(
        globals().get("TV4_THRESH", np.nan)
    )

    iv_drop_threshold = float(
        globals().get("IV_DROP_THRESH", np.nan)
    )

    if trade:
        entry_spot = _safe_float(
            trade.get("spot")
        )

        if entry_spot is not None:
            sl_bps = float(
                globals().get("SL_BPS", 14.0)
            )

            sl_points = -(
                entry_spot
                * sl_bps
                / 10000.0
            )

            # Dynamic TP calculation exactly as the strategy.
            if np.isfinite(
                getattr(
                    self,
                    "trading_dte",
                    np.nan
                )
            ) and np.isfinite(
                getattr(
                    self,
                    "build_iv",
                    np.nan
                )
            ):
                dte_idx = int(
                    np.clip(
                        math.ceil(
                            self.trading_dte
                        ) - 1,
                        0,
                        6
                    )
                )

                rounded_bld = round(
                    float(self.build_iv),
                    2
                )

                fraction = (
                    rounded_bld - 0.08
                ) / 0.12

                tp_low = globals().get(
                    "TP_LOW",
                    None
                )

                tp_high = globals().get(
                    "TP_HIGH",
                    None
                )

                if (
                    tp_low is not None
                    and tp_high is not None
                ):
                    base_tp_bps = (
                        tp_low[dte_idx]
                        + fraction
                        * (
                            tp_high[dte_idx]
                            - tp_low[dte_idx]
                        )
                    )

                    tp_bps = max(
                        1.0,
                        round(
                            float(base_tp_bps)
                        )
                    )

                    tp_points = (
                        entry_spot
                        * tp_bps
                        / 10000.0
                    )

    # --------------------------------------------------------
    # P&L per straddle
    #
    # The strategy P&L is points per one CE+PE straddle.
    # Do not multiply this display value by quantity.
    # --------------------------------------------------------

    entry_straddle = (
        trade.get("entry_straddle")
        if trade
        else None
    )

    current_straddle = (
        _safe_float(
            getattr(
                self,
                "current_ce_ask",
                np.nan
            )
            + getattr(
                self,
                "current_pe_ask",
                np.nan
            )
        )
        if (
            np.isfinite(
                getattr(
                    self,
                    "current_ce_ask",
                    np.nan
                )
            )
            and np.isfinite(
                getattr(
                    self,
                    "current_pe_ask",
                    np.nan
                )
            )
        )
        else None
    )

    pnl_points_per_straddle = None

    if (
        entry_straddle is not None
        and current_straddle is not None
    ):
        pnl_points_per_straddle = (
            float(entry_straddle)
            - current_straddle
        )

    # --------------------------------------------------------
    # Future P&L per hedge unit
    # --------------------------------------------------------

    future_move = None
    future_pnl = _safe_float(
        getattr(
            self,
            "fut_pnl",
            np.nan
        )
    )

    entry_future = (
        trade.get("future")
        if trade
        else None
    )

    if (
        entry_future is not None
        and np.isfinite(
            getattr(
                self,
                "future",
                np.nan
            )
        )
    ):
        future_move = (

            float(self.underlying)
            - float(entry_future)
        )

    # --------------------------------------------------------
    # Add telemetry to the existing monitor object.
    # --------------------------------------------------------

    # This object already exists from the previous monitor patch.
    # Extend the returned object after construction.

    return {
        "trade": trade,
        "trade_history": self._trade_history[-20:],
        "entry_integrity": entry_integrity,
        "entry_block_reason": entry_block_reason,
        "greeks": {
            "delta": delta,
            "gamma": gamma,
            "theta": theta,
            "vega": vega,
        },
        "risk": {
            "points_out": points_out,
            "points_allowed": points_allowed,
            "raw_build_iv":
                _safe_float(
                    getattr(
                        self,
                        "raw_build_iv",
                        np.nan
                    )
                ),
            "adjusted_build_iv":
                _safe_float(
                    getattr(
                        self,
                        "build_iv",
                        np.nan
                    )
                ),
            
            "future_hedge": fut_total,

            "sl_points": sl_points,
            "tp_points": (
                tp_points
                if "tp_points" in locals()
                else None
            ),
            "tp_bps": tp_bps,

            "tv_threshold": (
                tv_threshold
                if np.isfinite(tv_threshold)
                else None
            ),
            "tv4_threshold": (
                tv4_threshold
                if np.isfinite(tv4_threshold)
                else None
            ),
            "iv_drop_threshold": (
                iv_drop_threshold
                if np.isfinite(iv_drop_threshold)
                else None
            ),
        },
        "pnl_detail": {
