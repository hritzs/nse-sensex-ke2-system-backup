# ============================================================

class MinuteStraddleEngine(LiveFiveStageEngine):

    def __init__(self, run_id):
        super().__init__()

        self.minute_run_id = str(run_id)

        self.minute_started = False
        self.minute_completed = False

        self.minute_start_timestamp = None
        self.minute_exit_timestamp = None

        self.minute_last_key = None
        self.minute_history = []

        # Live CE/PE marks are created later by update_position().
        # Initialize them here so the API can safely expose a
        # brand-new simulation before its first trade update.
        self.current_ce_ltp = np.nan
        self.current_pe_ltp = np.nan

    # --------------------------------------------------------
    # No LUT / no historical reference / no stage decision.
    #
    # At the first valid live ATM CE + PE:
    #   -> enter one short straddle
    #
    # After entry:
    #   -> existing update_position()
    #   -> existing hedge/Greeks/P&L
    #   -> existing exit conditions
    # --------------------------------------------------------

    def recalculate(self):

        if not np.isfinite(self.underlying):
            return

        try:
            expiry, ce, pe, selected_atm = (
                self._atm_pair()
            )
        except Exception:
            return

        if (
            expiry is None
            or ce is None
            or pe is None
        ):
            return

        self.atm = float(selected_atm)

        try:
            raw_dte = self._calculate_dte(expiry)
        except Exception:
            return

        if not np.isfinite(raw_dte):
            return

        self.raw_dte = float(raw_dte)
        self.trading_dte = float(raw_dte)

        # Use live ATM IV only.
        try:
            ce_iv = self._iv_decimal(
                ce.get("iv")
            )
            pe_iv = self._iv_decimal(
                pe.get("iv")
            )
        except Exception:
            return

        ivs = [
            x
            for x in (ce_iv, pe_iv)
            if np.isfinite(x) and x > 0
        ]

        if not ivs:
            return

        self.raw_build_iv = float(
            np.mean(ivs)
        )

        self.build_iv = self.raw_build_iv

        self.build_timestamp = now_ist().isoformat(
            timespec="seconds"
        )

        self.build_spot = float(
            self.underlying
        )

        self.build_future = (
            float(self.future)
            if np.isfinite(self.future)
            else np.nan
        )

        self.build_atm = float(
            self.atm
        )

        self.build_dte = float(
            self.raw_dte
        )

        # Compatibility values for the existing entry/
        # risk calculations. They do NOT generate a signal.
        self.weighted_idv = max(
            self.raw_build_iv,
            1e-6
        )

        self.prev_straddle = np.nan
        self.adj_iv_chg = 0.0

        self.target_base = max(
            self.raw_build_iv,
            1e-6
        )

        self.prev_future = (
            self.future
            if np.isfinite(self.future)
            else self.underlying
        )

        # ----------------------------------------------------
        # ENTRY
        # ----------------------------------------------------

        if not self.minute_started:

            ce_bid = self._num(
                ce.get("bid")
            )
            ce_ask = self._num(
                ce.get("ask")
            )
            pe_bid = self._num(
                pe.get("bid")
            )
            pe_ask = self._num(
                pe.get("ask")
            )

            if not (
                np.isfinite(ce_bid)
                and ce_bid > 0
                and np.isfinite(ce_ask)
                and ce_ask > 0
                and np.isfinite(pe_bid)
                and pe_bid > 0
                and np.isfinite(pe_ask)
                and pe_ask > 0
            ):
                return

            # Explicitly mark this as a simulation entry.
            self.stage = (
                "MINUTE_"
                +
                self.minute_run_id
            )

            self.signal = "YES"

            try:
                self.enter_trade(
                    expiry,
                    ce,
                    pe
                )
            except Exception as exc:
                print(
                    "[MINUTE ENTRY ERROR]",
                    self.minute_run_id,
                    repr(exc)
                )
                return

            if self.trade_active:

                self.minute_started = True

                self.minute_start_timestamp = (
                    now_ist().isoformat(
                        timespec="seconds"
                    )
                )

                self._record_minute()

            return

        # ----------------------------------------------------
        # AFTER ENTRY
        # ----------------------------------------------------

        if not self.trade_active:
            self.minute_completed = True
            return

        try:

            self.update_position(
                expiry,
                ce,
                pe
            )

        except Exception as exc:

            print(
                "[MINUTE UPDATE ERROR]",
                self.minute_run_id,
                repr(exc)
            )

            return

        self._record_minute()

        if not self.trade_active:

            self.minute_completed = True

            self.minute_exit_timestamp = (
                now_ist().isoformat(
                    timespec="seconds"
                )
            )

    # --------------------------------------------------------
    # One snapshot per wall-clock minute.
    # --------------------------------------------------------

    def _record_minute(self):

        now_dt = now_ist()

        key = now_dt.strftime(
            "%Y-%m-%d %H:%M"
        )

        if key == self.minute_last_key:
            return

        self.minute_last_key = key

        self.minute_history.append({
            "timestamp":
                now_dt.isoformat(
                    timespec="seconds"
                ),

            "run_id":
                self.minute_run_id,

            "trade_active":
                bool(self.trade_active),

            "completed":
                bool(self.minute_completed),

            "spot":
                float(self.underlying)
                if np.isfinite(self.underlying)
                else None,

            "future":
                float(self.future)
                if np.isfinite(self.future)
                else None,

            "atm":
                float(self.atm)
                if np.isfinite(self.atm)
                else None,

            "entry_ce":
                self.entry_ce,

            "entry_pe":
                self.entry_pe,

            "ce_ltp":
                float(self.current_ce_ltp)
                if np.isfinite(self.current_ce_ltp)
                else None,

            "pe_ltp":
                float(self.current_pe_ltp)
                if np.isfinite(self.current_pe_ltp)
                else None,

            "total_pnl":
                float(self.total_pnl),

            "option_pnl":
                float(self.opt_pnl),

            "future_pnl":
                float(self.fut_pnl),

            "future_hedge":
                float(self.fut_total),

            "delta":
                float(self.opt_delta)
                if np.isfinite(self.opt_delta)
                else None,

            "gamma":
                float(self.opt_gamma)
                if np.isfinite(self.opt_gamma)
                else None,

            "theta":
                float(self.opt_theta)
                if np.isfinite(self.opt_theta)
                else None,

            "vega":
                float(self.opt_vega)
                if np.isfinite(self.opt_vega)
                else None,

            "exit_reason":
                self.exit_reason,
        })

        if len(self.minute_history) > 1000:
            self.minute_history = (
                self.minute_history[-1000:]
            )

    # --------------------------------------------------------
    # API state
    # --------------------------------------------------------

    def minute_state(self):

        return {
            "simulation_run":
                self.minute_run_id,

            "simulation_mode":
                "MINUTE_STRADDLE",

            "started":
                self.minute_started,

            "completed":
                self.minute_completed,

            "start_timestamp":
                self.minute_start_timestamp,

            "exit_timestamp":
                self.minute_exit_timestamp,

            "trade_active":
                bool(self.trade_active),

            "spot":
                float(self.underlying)
                if np.isfinite(self.underlying)
                else None,

            "future":
                float(self.future)
                if np.isfinite(self.future)
                else None,

            "atm":
                float(self.atm)
                if np.isfinite(self.atm)
                else None,

            "entry_ce":
                self.entry_ce,

            "entry_pe":
                self.entry_pe,

            "entry_atm":
                float(self.entry_atm)
                if np.isfinite(self.entry_atm)
                else None,

            "current_ce_ltp":
                float(self.current_ce_ltp)
                if np.isfinite(self.current_ce_ltp)
                else None,

            "current_pe_ltp":
                float(self.current_pe_ltp)
                if np.isfinite(self.current_pe_ltp)
                else None,

            "total_pnl":
                float(self.total_pnl),

            "option_pnl":
                float(self.opt_pnl),

            "future_pnl":
                float(self.fut_pnl),

            "future_hedge":
                float(self.fut_total),

            "delta":
                float(self.opt_delta)
                if np.isfinite(self.opt_delta)
                else None,

            "gamma":
                float(self.opt_gamma)
                if np.isfinite(self.opt_gamma)
                else None,

            "theta":
                float(self.opt_theta)
                if np.isfinite(self.opt_theta)
                else None,

            "vega":
                float(self.opt_vega)
                if np.isfinite(self.opt_vega)
                else None,

            "exit_reason":
                self.exit_reason,

            "minute_history":
                self.minute_history[-120:],

            "trade_history":
                list(
                    getattr(
                        self,
                        "trade_history",
                        []
                    )[-20:]
                ),

            "hedge_events":
                list(
                    getattr(
                        self,
                        "hedge_events",
                        []
                    )[-50:]
                ),
        }


