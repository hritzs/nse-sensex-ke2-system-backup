# FOUR INDEPENDENT SIMULATION RUNS
# ============================================================
#
# One shared market feed -> four independent strategy engines.
#
# 0916 starts at 09:16
# 0917 starts at 09:17
# 0918 starts at 09:18
# 0919 starts at 09:19
#
# Each lane owns its own:
#   trade state
#   hedge state
#   P&L
#   Greeks
#   exits
#   signal history
#
# The market feed is shared.
# The simulation state is NOT shared.
# ============================================================

SIMULATION_RUNS = {
    "0916": LiveFiveStageEngine(),
    "0917": LiveFiveStageEngine(),
    "0918": LiveFiveStageEngine(),
    "0919": LiveFiveStageEngine(),
    "NOW": LiveFiveStageEngine(),
}

NOW_SIMULATION_STARTED = False
NOW_SIMULATION_START_TS = None

SIMULATION_START_MINUTES = {
    "0916": 9 * 60 + 16,
    "0917": 9 * 60 + 17,
    "0918": 9 * 60 + 18,
    "0919": 9 * 60 + 19,
}

# Backward compatibility for existing code.
# The legacy ENGINE remains the 0916 lane.
ENGINE = SIMULATION_RUNS["0916"]


def _simulation_run_started(run_id, now_dt=None):
    """
    Determine whether an independent simulation lane has started.
    """
    global NOW_SIMULATION_STARTED

    if run_id == "NOW":
        return NOW_SIMULATION_STARTED

    if now_dt is None:
        now_dt = now_ist()

    minute_value = (
        now_dt.hour * 60
        +
        now_dt.minute
    )

    return (
        minute_value
        >= SIMULATION_START_MINUTES[run_id]
    )


def _simulation_run_state(run_id):
    """
    Return the state for one independent simulation lane.
    """
    engine = SIMULATION_RUNS[run_id]

    with engine.lock:
        payload = engine.state()

    payload = _seed_apply_to_payload(
        payload
    )

    payload["simulation_run"] = run_id
    payload["simulation_start"] = (
        f"{run_id[:2]}:{run_id[2:]}"
    )

    payload["simulation_started"] = (
        _simulation_run_started(run_id)
    )

    if run_id == "NOW":
        payload["simulation_start_timestamp"] = (
            NOW_SIMULATION_START_TS.isoformat()
            if NOW_SIMULATION_START_TS is not None
            else None
        )

    return payload


def _simulation_runs_state():
    """
    Return all four independent simulation states.
    """
    return {
        run_id:
            _simulation_run_state(run_id)
        for run_id in (
            "0916",
            "0917",
            "0918",
            "0919"
        )
    }


def _process_message_all_simulation_runs(data):
    """
    Send every live market message to each lane that has started.

    Each LiveFiveStageEngine receives the SAME market message,
    but keeps completely independent trade/hedge/P&L state.
    """
    now_dt = now_ist()

    for run_id, engine in SIMULATION_RUNS.items():

        if not _simulation_run_started(
            run_id,
            now_dt
        ):
            continue

        try:
            engine.process_message(
                data
            )
        except Exception as exc:
            print(
                "[SIM RUN ERROR]",
                run_id,
                repr(exc)
            )



