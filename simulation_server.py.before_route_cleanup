                    "entry_straddle": (
                        self._json_num(
                            self.entry_ce_bid
                            + self.entry_pe_bid
                        )
                        if (
                            np.isfinite(
                                self.entry_ce_bid
                            )
                            and np.isfinite(
                                self.entry_pe_bid
                            )
                        )
                        else None
                    ),
                    "current_ce_ask": self._json_num(
                        self.current_ce_ask
                    ),
                    "current_pe_ask": self._json_num(
                        self.current_pe_ask
                    ),
                    "futures_hedge": self._json_num(
                        self.fut_total
                    ),

                    "leg_ratio": "1:1",

                    "build_timestamp":
                        self.build_timestamp,

                    "build_spot":
                        self._json_num(
                            self.build_spot
                        ),

                    "build_future":
                        self._json_num(
                            self.build_future
                        ),

                    "build_atm":
                        self._json_num(
                            self.build_atm
                        ),

                    "build_iv":
                        self._json_num(
                            self.build_iv
                        ),

                    "build_dte":
                        self._json_num(
                            self.build_dte
                        ),

                    "ce_delta_at_build":
                        self._json_num(
                            self.build_ce_delta
                        ),

                    "pe_delta_at_build":
                        self._json_num(
                            self.build_pe_delta
                        ),

                    "opt_delta_at_build":
                        self._json_num(
                            self.build_opt_delta
                        ),

                    "initial_hedge":
                        self._json_num(
                            self.initial_hedge
                        ),

                    "initial_hedge_timestamp":
                        self.initial_hedge_timestamp,

                    "opt_delta":
                        self._json_num(
