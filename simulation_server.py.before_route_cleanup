def norm_cdf(x):
    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))


def norm_pdf(x):
    return math.exp(-0.5 * x * x) / math.sqrt(2.0 * math.pi)


def bs_price(is_call, S, K, T, r, sigma):
    if not all(np.isfinite([S, K, T, sigma])):
        return np.nan

    if S <= 0 or K <= 0:
        return np.nan

    if T <= 0 or sigma <= 0:
        return max(0.0, S - K) if is_call else max(0.0, K - S)

    sq = math.sqrt(T)

    d1 = (
        math.log(S / K)
        + (r + 0.5 * sigma * sigma) * T
    ) / (sigma * sq)

    d2 = d1 - sigma * sq

    if is_call:
        return (
            S * norm_cdf(d1)
            - K * math.exp(-r * T) * norm_cdf(d2)
        )

    return (
        K * math.exp(-r * T) * norm_cdf(-d2)
        - S * norm_cdf(-d1)
    )


def bs_delta(is_call, S, K, T, r, sigma):
    if T <= 0 or sigma <= 0 or S <= 0 or K <= 0:
        return np.nan

    d1 = (
        math.log(S / K)
        + (r + 0.5 * sigma * sigma) * T
    ) / (sigma * math.sqrt(T))

    return norm_cdf(d1) if is_call else norm_cdf(d1) - 1.0


def bs_gamma(S, K, T, r, sigma):
    if T <= 0 or sigma <= 0 or S <= 0 or K <= 0:
        return np.nan

    d1 = (
        math.log(S / K)
        + (r + 0.5 * sigma * sigma) * T
    ) / (sigma * math.sqrt(T))

    return norm_pdf(d1) / (S * sigma * math.sqrt(T))


