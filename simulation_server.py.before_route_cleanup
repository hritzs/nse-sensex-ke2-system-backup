async def ws_loop():
    """
    Consume the C++ live feed and hand each decoded message to the
    existing simulation engine.

    The engine owns:
      - symbol filtering
      - strike / expiry parsing
      - CE / PE identification
      - chain insertion
      - spot / future extraction
      - feature calculation
      - stage evaluation
      - P&L recalculation
    """

    debug_count = 0

    while True:
        try:
            print(f"[WS] Connecting to {WEBSOCKET_URI}...")

            async with websockets.connect(
                WEBSOCKET_URI,
                ping_interval=20,
                ping_timeout=20,
                max_size=64 * 1024 * 1024,
            ) as ws:

                print("[WS] Connected to C++ NSE feed :9001")

                # Keep compatibility with the current C++ server.
                try:
                    await ws.send(
                        json.dumps(
                            {
                                "action": "subscribe",
                                "channel": "ticks",
                            }
                        )
                    )
                except Exception:
                    pass

                async for raw in ws:
                    try:
                        if isinstance(raw, bytes):
                            raw = raw.decode(
                                "utf-8",
                                errors="replace"
                            )

                        payload = json.loads(raw)

                        # ------------------------------------------------
                        # RAW FUTURE DEBUG
                        # Capture exactly what Python receives from C++.
                        # ------------------------------------------------
                        debug_payloads = (
                            payload
                            if isinstance(payload, list)
                            else [payload]
                        )

                        for _fp in debug_payloads:
                            if not isinstance(_fp, dict):
                                continue

                            _fsym = str(
                                _fp.get("symbol", "")
                            ).strip().upper()

                            _ftype = str(
                                _fp.get("type", "")
                            ).strip().lower()

                            if (
                                _ftype == "future_quote"
                                and _fsym.startswith("NIFTY|")
                                and _fsym.endswith("|0|FUT")
                            ):
                                print(
                                    "[RAW PY FUT]",
                                    _fsym,
                                    "expiry=",
                                    _fp.get("expiry"),
                                    "ltp=",
                                    _fp.get("ltp"),
                                )

                        if isinstance(payload, list):
                            records = payload

                        elif isinstance(payload, dict):
                            data = payload.get("data")

                            if isinstance(data, list):
                                records = data
                            else:
                                records = [payload]

                        else:
                            continue

                        for data in records:
                            if not isinstance(data, dict):
                                continue

                            msg_type = str(
                                data.get("type", "")
                            ).lower()

                            if msg_type == "eod_ivs":
                                continue

                            symbol = str(
                                data.get(
                                    "symbol",
                                    data.get("sym", "")
                                )
                            ).strip()

                            if not symbol:
                                continue

                            # ------------------------------------------------
                            # STRICT FUTURE FILTER
                            #
                            # The simulator is ONLY for NIFTY.
                            #
                            # Accept:
                            #   NIFTY|25-AUG-26|0|FUT
                            #
                            # Reject every stock/index future other than NIFTY.
                            # ------------------------------------------------
                            if msg_type == "future_quote":
                                fut_symbol = symbol.upper()

                                if not (
                                    fut_symbol.startswith("NIFTY|")
                                    and fut_symbol.endswith("|0|FUT")
                                ):
                                    continue

                            debug_count += 1

                            if debug_count <= 20:
                                print(
                                    "[WS INGEST]",
                                    debug_count,
                                    "type=", msg_type,
                                    "symbol=", symbol,
                                    "strike=", data.get("strike"),
                                    "expiry=", data.get("expiry"),
                                    "ltp=", data.get("ltp"),
                                )

                            # ------------------------------------------------
                            # CRITICAL:
                            # Do NOT write directly into ENGINE.chain.
                            #
                            # process_message/process_tick is the canonical
                            # ingestion path for the simulation engine.
                            # ------------------------------------------------
                            _is_exact_nifty = (
                                symbol.upper().startswith("NIFTY")
                                and not symbol.upper().startswith("NIFTYNXT50")
                            )

                            if _is_exact_nifty:
                                print(
                                    "[NIFTY BEFORE ENGINE]",
                                    symbol,
                                    "| strike=", data.get("strike"),
                                    "| expiry=", data.get("expiry"),
                                    "| type=", data.get("type")
                                )

                            _process_message_all_simulation_runs(data)
                            process_all_minute_simulations(data)

                            if "NIFTY" in symbol.upper():
                                with ENGINE.lock:
                                    print(
                                        "[NIFTY AFTER ENGINE]",
                                        symbol,
                                        "| chain_size=", len(ENGINE.chain)
                                    )

                            if (
                                debug_count <= 20
                                or "NIFTY" in symbol.upper()
                            ):
                                with ENGINE.lock:
                                    chain_size = len(ENGINE.chain)
                                    underlying = ENGINE.underlying
                                    future = ENGINE.future

                                if "NIFTY" in symbol.upper():
                                    print(
                                        "[ENGINE]",
                                        "NIFTY received:",
                                        symbol,
                                        "| chain_size=",
                                        chain_size,
                                        "| underlying=",
                                        underlying,
                                        "| future=",
                                        future,
                                    )

                    except Exception as e:
                        print(
                            "[WS MESSAGE ERROR]",
                            repr(e)
                        )

        except Exception as e:
            print(
                "[WS LOOP ERROR]",
                repr(e)
            )
            await asyncio.sleep(2)


def start_ws_thread():

    asyncio.run(
        ws_loop()
    )



