                    )
                )
                else None
            ),
        },
        "hedge_events": self._hedge_events[-20:],
    }


# Install monitor state after class definition.
_original_state = LiveFiveStageEngine.state

def _monitored_state(self):

    payload = _original_state(self)

    try:
        payload["monitor"] = (
            _trade_monitor_state(self)
        )
    except Exception as e:
        payload["monitor"] = {
            "error": str(e)
        }


    # --------------------------------------------------------
    # SECOND-BY-SECOND P&L HISTORY
    #
    # This is deliberately based on P&L PER STRADDLE.
    # It is not quantity-scaled and not mixed with future
    # hedge P&L.
    #
    # The browser polls /api/simulate every second, so this
    # creates the live curve without inventing historical data.
    # --------------------------------------------------------

    if not hasattr(
        self,
        "_pnl_history"
    ):
        self._pnl_history = []

    monitor_payload = payload.get(
        "monitor",
        {}
    )

    pnl_detail = monitor_payload.get(
        "pnl_detail",
        {}
    )

    risk_payload = monitor_payload.get(
        "risk",
        {}
    )

    pnl_per_straddle = (
        pnl_detail.get(
            "pnl_points_per_straddle"
        )
    )

    total_pnl = pnl_detail.get(
        "total_pnl"
    )

    active_trade = bool(
        getattr(
            self,
            "trade_active",
            False
        )
    )

    # Record only when a real trade has an entry.
    if (
        active_trade
        and pnl_per_straddle is not None
    ):
        self._pnl_history.append({
            "timestamp": now_ist().isoformat(
                timespec="seconds"
            ),
            "pnl_per_straddle": (
                float(pnl_per_straddle)
            ),
            "total_pnl": (
                float(total_pnl)
                if total_pnl is not None
                else None
            ),
            "points_out": (
                risk_payload.get(
                    "points_out"
                )
            ),
            "points_allowed": (
                risk_payload.get(
                    "points_allowed"
                )
            ),
            "future_hedge": (
                risk_payload.get(
                    "future_hedge"
                )
            ),
        })

    # Keep enough data for the whole current session.
    if len(self._pnl_history) > 3600:
        self._pnl_history = (
            self._pnl_history[-3600:]
        )

    payload["monitor"]["pnl_history"] = (
        self._pnl_history[-1800:]
    )

    # Add the completed trades separately so the UI can show
    # historical entries without confusing them with the
    # current active position.
    payload["monitor"]["trade_history"] = (
        getattr(
            self,
            "trade_history",
            payload["monitor"].get(
                "trade_history",
                []
            )
        )
    )


    # --------------------------------------------------------
    # FIVE-STAGE LUT SNAPSHOT
    #
    # Keep the latest evaluation for every stage separately.
    # The bracket values are the actual LUT buckets generated
    # by the strategy engine; they are not recomputed by UI.
    # --------------------------------------------------------

    stage_brackets = {}

    for event in getattr(
        self,
        "signal_history",
        []
    ):

        stage_name = (
            event.get("stage")
        )

        if not stage_name:
            continue

        key = (
            event.get("key")
        )

        bucket_names = [
            "DTE",
            "IV_Ratio",
            "Straddle_Ratio",
            "Build_IV",
            "Norm_OG_Gap",
            "Adj_IV_Chg",
        ]

        buckets = {}

        if isinstance(key, (tuple, list)):

            for i, name in enumerate(
                bucket_names
            ):

                buckets[name] = (
                    key[i]
                    if i < len(key)
                    else None
                )

        stage_brackets[
            stage_name
        ] = {
            "decision":
                event.get(
                    "decision",
                    "NO"
                ),
            "buckets":
                buckets,
            "timestamp":
                event.get(
                    "timestamp"
                ),
        }

    payload["stage_brackets"] = (
        stage_brackets
    )


    # --------------------------------------------------------
    # Market clock / live feed health
    # --------------------------------------------------------

    now = now_ist()

    future_ts = getattr(
        self,
        "future_timestamp",
        None
    )

    future_age = None

    if future_ts is not None:
        try:
            if future_ts.tzinfo is None:
                future_ts = future_ts.replace(
                    tzinfo=IST
                )

            future_age = max(
                0.0,
                (
                    now - future_ts
                ).total_seconds()
            )
        except Exception:
            future_age = None

    market_open = datetime.combine(
        now.date(),
        MARKET_OPEN_IST
    )

    market_close = datetime.combine(
        now.date(),
        MARKET_CLOSE_IST
    )

    market_status = "PRE_OPEN"

    if market_open <= now.replace(
        tzinfo=None
    ) < market_close:
        market_status = "OPEN"

    elif now.replace(
        tzinfo=None
    ) >= market_close:
        market_status = "CLOSED"

    payload["clock"] = {
        "timestamp_ist": now.isoformat(
            timespec="seconds"
        ),
        "market_open": "09:15:00",
        "market_close": "15:40:00",
        "status": market_status,
        "session_elapsed_fraction": (
            min(
                1.0,
                max(
                    0.0,
                    (
                        (
                            now.replace(
                                tzinfo=None
                            ) - market_open
                        ).total_seconds()
                        /
                        (
                            market_close
                            - market_open
                        ).total_seconds()
                    )
                )
            )
            if market_open <= now.replace(
                tzinfo=None
            ) <= market_close
            else (
                0.0
                if now.replace(
                    tzinfo=None
                ) < market_open
                else 1.0
            )
        ),
        "future_age_seconds": future_age,
        "future_status": (
            "FRESH"
            if (
                future_age is not None
                and future_age <= 5.0
            )
            else (
                "STALE"
                if (
                    future_age is not None
                    and future_age <= 15.0
                )
                else "UNKNOWN"
            )
        ),
    }

    # --------------------------------------------------------
    # Normalize live Build IV display
    # --------------------------------------------------------

    feat = payload.get("features")

    if isinstance(feat, dict):

        biv = feat.get("build_iv")

        if isinstance(biv, (int, float)):
            feat["build_iv_decimal"] = biv
            feat["build_iv_percent"] = (
                biv * 100.0
            )

    # --------------------------------------------------------
    # Detailed DTE information
    # --------------------------------------------------------

    feat = payload.get("features", {})

    raw_dte = feat.get(
        "raw_dte"
    )

    trading_dte = feat.get(
        "trading_dte"
    )

    if trading_dte is None:
        trading_dte = (
            raw_dte - 1.0
            if raw_dte is not None
            else None
        )

    if raw_dte is not None:
        payload["dte_detail"] = {
            "raw_calendar_days": raw_dte,
            "trading_adjusted_days": trading_dte,
            "market_open": "09:15:00",
            "market_close": "15:40:00",
            "note": (
                "Raw DTE is exact IST time-to-expiry; "
                "weekend adjustment follows the reference strategy."
            ),
        }

    return payload


