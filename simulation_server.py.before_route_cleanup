import math
import json


MANUAL_SEED_FILE = (
    ROOT /
    "data" /
    "manual_timestamp_seed.json"
)

MANUAL_SEED = None


def _manual_save():
    """
    Manual seed persistence hook.

    MANUAL_SEED is the authoritative in-memory state for the
    running simulator. Persistence is intentionally a no-op.
    """
    return None


MANUAL_SEED_LOCK = threading.Lock()

def _seed_float(value):
    try:
        x = float(value)
        return x if math.isfinite(x) else None
    except Exception:
        return None


def _seed_timestamp(value):
    if not value:
        return None

    text = str(value).strip()

    from datetime import datetime

    formats = (
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M:%S%z",
        "%Y-%m-%d %H:%M:%S",
    )

    for fmt in formats:
        try:
            dt = datetime.strptime(
                text,
                fmt
            )

            if dt.tzinfo is None:
                return dt.replace(
                    tzinfo=IST
                )

            return dt

        except Exception:
            pass

    return None


def _seed_stage(timestamp):
    dt = _seed_timestamp(timestamp)

    if dt is None:
        return "MANUAL"

    t = dt.astimezone(IST).time()

    if t < time(9, 17):
        return "0916"

    if t < time(9, 18):
        return "0917"

    if t < time(9, 19):
        return "0918"

    if t < time(9, 20):
        return "0919"

    return "0920_onwards"


def _seed_greeks(
    spot,
    strike,
    dte,
    iv
):

    spot = _seed_float(spot)
    strike = _seed_float(strike)
    dte = _seed_float(dte)
    iv = _seed_float(iv)

    if (
        spot is None
        or strike is None
        or dte is None
        or iv is None
        or spot <= 0
        or strike <= 0
        or dte <= 0
        or iv <= 0
    ):
        raise ValueError(
            "Valid spot, ATM, DTE and IV are required"
        )

    sigma = (
        iv / 100.0
        if iv > 1.5
        else iv
    )

    t = max(
        dte / 365.0,
        1e-8
    )

    root_t = math.sqrt(t)

    d1 = (
        math.log(spot / strike)
        +
        0.5 *
        sigma *
        sigma *
        t
    ) / (
        sigma *
        root_t
    )

    nd1 = 0.5 * (
        1.0 +
        math.erf(
            d1 /
            math.sqrt(2.0)
        )
    )

    ce_delta = nd1
    pe_delta = nd1 - 1.0

    # Reference strategy:
    # sell 1 CE + sell 1 PE.
    opt_delta = (
        -ce_delta
        -
        pe_delta
    )

    # Initial hedge is performed at BUILD TIME.
    initial_hedge = -opt_delta

    return {
        "ce_delta": ce_delta,
        "pe_delta": pe_delta,
        "opt_delta": opt_delta,
        "initial_hedge": initial_hedge
    }


def _seed_save():

    if MANUAL_SEED is None:
        try:
            MANUAL_SEED_FILE.unlink()
        except FileNotFoundError:
            pass
        return

    MANUAL_SEED_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    MANUAL_SEED_FILE.write_text(
        json.dumps(
            MANUAL_SEED,
            indent=2,
            default=str
        ),
        encoding="utf-8"
    )


def _seed_load():

    global MANUAL_SEED

    try:

        if not MANUAL_SEED_FILE.exists():
            MANUAL_SEED = None
            return

        MANUAL_SEED = json.loads(
            MANUAL_SEED_FILE.read_text(
                encoding="utf-8"
            )
        )

        print(
            "[MANUAL SEED] loaded:",
            MANUAL_SEED.get(
                "timestamp"
            )
        )

    except Exception as exc:

        print(
            "[MANUAL SEED] load failed:",
            exc
        )

        MANUAL_SEED = None



def _seed_apply(data):

    global MANUAL_SEED

    timestamp = _seed_timestamp(
        data.get("timestamp")
    )

    if timestamp is None:
        raise ValueError(
            "Invalid timestamp"
        )

    expiry = str(
        data.get(
            "expiry",
            ""
        )
    ).strip().upper()

    strike = _seed_float(
        data.get(
            "strike"
        )
    )

    ce_ltp = _seed_float(
        data.get(
            "ce_ltp"
        )
    )

    pe_ltp = _seed_float(
        data.get(
            "pe_ltp"
        )
    )

    if not expiry:
        raise ValueError(
            "Expiry is required"
        )

    if strike is None or strike <= 0:
        raise ValueError(
            "Strike is required"
        )

    if ce_ltp is None or ce_ltp <= 0:
        raise ValueError(
            "CE LTP is required"
        )

    if pe_ltp is None or pe_ltp <= 0:
        raise ValueError(
            "PE LTP is required"
        )

    # --------------------------------------------------------
    # Exact manual build values
    # --------------------------------------------------------

    synthetic_future = (
        strike
        + ce_ltp
        - pe_ltp
    )

    entry_straddle = (
        ce_ltp
        + pe_ltp
    )

    # --------------------------------------------------------
    # DTE from the exact build timestamp.
    # Market expiry is 15:40 IST, consistent with simulator.
    # --------------------------------------------------------

    dte = _manual_normalized_raw_dte(
        timestamp,
        expiry
    )

    try:

        expiry_dt = None

        for fmt in (
            "%d-%b-%y",
            "%d-%b-%Y",
            "%d-%m-%Y",
            "%Y-%m-%d"
        ):

            try:

                expiry_dt = datetime.strptime(
                    expiry,
                    fmt
                )

                break

            except Exception:
                pass

        if expiry_dt is None:

            raise ValueError(
                "Unsupported expiry format"
            )

        expiry_dt = expiry_dt.replace(
            hour=15,
            minute=40,
            second=0,
            microsecond=0
        )

        seed_naive = (
            timestamp
            .astimezone(IST)
            .replace(tzinfo=None)
        )

        dte = max(
            (
                expiry_dt -
                seed_naive
            ).total_seconds()
            /
            86400.0,
            0.0
        )

    except Exception:

        dte = None


    # --------------------------------------------------------
    # Build IV from the supplied ATM straddle.
    #
    # ATM straddle ? F * sigma * sqrt(2T/pi)
    #
    # This is the build estimate only. Once live data resumes,
    # the normal live engine continues updating its analytics.
    # --------------------------------------------------------

    build_iv = None

    if (
        synthetic_future > 0
        and entry_straddle > 0
        and dte is not None
        and dte > 0
    ):

        try:

            build_iv = (
                entry_straddle
                /
                (
                    synthetic_future
                    *
                    math.sqrt(
                        2.0
                        *
                        dte
                        /
                        365.0
                        /
                        math.pi
                    )
                )
            )

            if (
                not math.isfinite(
                    build_iv
                )
                or
                build_iv <= 0
                or
                build_iv >= 3.0
            ):
                build_iv = None

        except Exception:

            build_iv = None


    # --------------------------------------------------------
    # Build-time Greeks.
    # --------------------------------------------------------

    greeks = {
        "ce_delta": None,
        "pe_delta": None,
        "opt_delta": None,
        "initial_hedge": None
    }

    if (
        build_iv is not None
        and
        dte is not None
        and
        dte > 0
    ):

        greeks = _seed_greeks(
            synthetic_future,
            strike,
            dte,
            build_iv
        )


    stage = _seed_stage(
        timestamp
    )


    MANUAL_SEED = {

        "active": True,

        "mode":
            "MANUAL_LTP_CATCHUP",

        "timestamp":
            timestamp
            .astimezone(IST)
            .isoformat(),

        "stage":
            stage,

        "expiry":
            expiry,

        "strike":
            strike,

        "ce_ltp":
            ce_ltp,

        "pe_ltp":
            pe_ltp,

        "synthetic_future":
            synthetic_future,

        "entry_straddle":
            entry_straddle,

        "dte":
            dte,

        "build_iv":
            build_iv,

        "build_timestamp":
            timestamp
            .astimezone(IST)
            .isoformat(),

        "build_spot":
            synthetic_future,

        "build_future":
            synthetic_future,

        "build_atm":
            strike,

        "build_dte":
            dte,

        "ce_delta_at_build":
            greeks["ce_delta"],

        "pe_delta_at_build":
            greeks["pe_delta"],

        "opt_delta_at_build":
            greeks["opt_delta"],

        "initial_hedge":
            greeks["initial_hedge"],

        "initial_hedge_timestamp":
            timestamp
            .astimezone(IST)
            .isoformat()
    }


    with MANUAL_SEED_LOCK:

        _manual_save()


    print(
        "[MANUAL LTP]",
        "timestamp=",
        MANUAL_SEED["timestamp"],
        "expiry=",
        expiry,
        "strike=",
        strike,
        "CE=",
        ce_ltp,
        "PE=",
        pe_ltp,
        "synthetic_future=",
        synthetic_future,
        "straddle=",
        entry_straddle,
        "dte=",
        dte,
        "iv=",
        build_iv,
        "opt_delta=",
        greeks["opt_delta"],
        "initial_hedge=",
        greeks["initial_hedge"]
    )

    return dict(
        MANUAL_SEED
    )


def _seed_clear():

    global MANUAL_SEED

    MANUAL_SEED = None
    _seed_save()


def _seed_get():

    if MANUAL_SEED is None:
        return None

    return dict(
        MANUAL_SEED
    )



def _seed_apply_to_payload(payload):

    seed = _seed_get()

    if seed is None:
        return payload

    seed_time = _seed_timestamp(
        seed.get("timestamp")
    )

    if seed_time is None:
        return payload

    if now_ist() < seed_time:
        return payload

    market = payload.setdefault(
        "market",
        {}
    )

    position = payload.setdefault(
        "position",
        {}
    )

    monitor = payload.setdefault(
        "monitor",
        {}
    )

    greeks = monitor.setdefault(
        "greeks",
        {}
    )

    risk = monitor.setdefault(
        "risk",
        {}
    )

    pnl = payload.setdefault(
        "pnl",
        {}
    )

    pnl_detail = monitor.setdefault(
        "pnl_detail",
        {}
    )


    # ========================================================
    # CURRENT LIVE MARKET
    # ========================================================

    current_future = _seed_float(
    market.get(
        "spot"
    )
)


    # ========================================================
    # LIVE OPTION LTP
    # ========================================================

    def live_ltp(
        expiry,
        strike,
        option_type
    ):

        chain = getattr(
            ENGINE,
            "chain",
            None
        )

        if not isinstance(
            chain,
            dict
        ):
            return None

        wanted_expiry = str(
            expiry
        ).strip()

        wanted_strike = _seed_float(
            strike
        )

        wanted_type = str(
            option_type
        ).upper()

        if wanted_strike is None:
            return None

        for key, quote in chain.items():

            try:

                if not isinstance(
                    key,
                    (tuple, list)
                ):
                    continue

                if len(key) < 3:
                    continue

                if str(
                    key[0]
                ).strip() != wanted_expiry:
                    continue

                ks = _seed_float(
                    key[1]
                )

                if (
                    ks is None
                    or
                    abs(
                        ks -
                        wanted_strike
                    ) > 0.01
                ):
                    continue

                if str(
                    key[2]
                ).upper() != wanted_type:
                    continue

                if not isinstance(
                    quote,
                    dict
                ):
                    continue

                for field in (
                    "ltp",
                    "LTP",
                    "price",
                    "last",
                    "last_price"
                ):

                    value = _seed_float(
                        quote.get(field)
                    )

                    if value is not None:
                        return value

            except Exception:
                continue

        return None


    current_ce_ltp = live_ltp(
        seed["expiry"],
        seed["strike"],
        "CE"
    )

    current_pe_ltp = live_ltp(
        seed["expiry"],
        seed["strike"],
        "PE"
    )


    # ========================================================
    # INSTANT CATCH-UP
    #
    # Build point = manual LTP
    # Current point = current live LTP
    #
    # NO fabricated 09:19, 09:20, 09:21 ... prices.
    # ========================================================

    entry_straddle = _seed_float(
        seed.get(
            "entry_straddle"
        )
    )

    current_straddle = None

    if (
        current_ce_ltp is not None
        and
        current_pe_ltp is not None
    ):

        current_straddle = (
            current_ce_ltp
            +
            current_pe_ltp
        )


    option_pnl = None

    if (
        entry_straddle is not None
        and
        current_straddle is not None
    ):

        option_pnl = (
            entry_straddle
            -
            current_straddle
        )


    entry_future = _seed_float(
        seed.get(
            "synthetic_future"
        )
    )

    future_move = None
    future_pnl = 0.0

    if (
        entry_future is not None
        and
        current_future is not None
    ):

        future_move = (

            current_future
            -
            entry_future
        )

        initial_hedge = _seed_float(
            seed.get(
                "initial_hedge"
            )
        )

        if initial_hedge is not None:

            future_pnl = (
                initial_hedge
                *
                future_move
            )


    total_pnl = (
        (option_pnl or 0.0)
        +
        future_pnl
    )


    # ========================================================
    # POSITION
    # ========================================================

    expiry_text = str(
        seed["expiry"]
    ).replace(
        "-",
        ""
    )

    strike_text = str(
        int(seed["strike"])
    )

    position.update({

        "active":
            True,

        "triggered":
            True,

        "side":
            "SHORT_STRADDLE",

        "ce":
            "NIFTY"
            +
            expiry_text
            +
            strike_text
            +
            "CE",

        "pe":
            "NIFTY"
            +
            expiry_text
            +
            strike_text
            +
            "PE",

        "entry_ce":
            seed["ce_ltp"],

        "entry_pe":
            seed["pe_ltp"],

        "entry_straddle":
            entry_straddle,

        "current_ce_ask":
            current_ce_ltp,

        "current_pe_ask":
            current_pe_ltp,

        "futures_hedge":
            seed.get(
                "initial_hedge"
            )
            or 0.0,

        "leg_ratio":
            "1:1",

        "build_timestamp":
            seed.get(
                "build_timestamp"
            ),

        "build_spot":
            seed.get(
                "build_spot"
            ),

        "build_future":
            seed.get(
                "build_future"
            ),

        "build_atm":
            seed.get(
                "build_atm"
            ),

        "build_iv":
            seed.get(
                "build_iv"
            ),

        "build_dte":
            seed.get(
                "build_dte"
            ),

        "ce_delta_at_build":
            seed.get(
                "ce_delta_at_build"
            ),

        "pe_delta_at_build":
            seed.get(
                "pe_delta_at_build"
            ),

        "opt_delta_at_build":
            seed.get(
                "opt_delta_at_build"
            ),

        "initial_hedge":
            seed.get(
                "initial_hedge"
            ),

        "initial_hedge_timestamp":
            seed.get(
                "initial_hedge_timestamp"
            ),

        "entry_future":
            entry_future,

        "current_future":
            current_future,

        "future_move":
            future_move
    })


    # ========================================================
    # BUILD-TIME GREEKS / HEDGE
    # ========================================================

    greeks["delta"] = (
        seed.get(
            "opt_delta_at_build"
        )
    )

    risk["future_hedge"] = (
        seed.get(
            "initial_hedge"
        )
        or 0.0
    )


    # ========================================================
    # P&L
    # ========================================================


    # ========================================================
    # MANUAL LIVE GREEKS EXACT
    #
    # Build-time seed Greeks are historical values.
    # Current Trade Greeks must be recalculated from:
    #
    #   current synthetic spot
    #   current RAW DTE
    #   current/live IV when available
    #   current futures hedge
    #
    # Position:
    #   SHORT CE + SHORT PE
    # ========================================================

    
    try:

        # ----------------------------------------------------
        # CURRENT RAW DTE
        # ----------------------------------------------------

        _features_live = payload.get(
            "features",
            {}
        )

        _raw_dte_live = _seed_float(
            _features_live.get(
                "raw_dte"
            )
        )

        if (
            _raw_dte_live is None
            or
            _raw_dte_live <= 0
        ):

            _raw_dte_live = _seed_float(
                _features_live.get(
                    "dte"
                )
            )

        if (
            _raw_dte_live is None
            or
            _raw_dte_live <= 0
        ):

            raise ValueError(
                "Invalid RAW DTE"
            )

        _T_live = max(
            float(
                _raw_dte_live
            ) / 365.0,
            1e-5
        )

        # ----------------------------------------------------
        # CURRENT SYNTHETIC SPOT
        #
        # Position strike remains the original manual strike.
        # ----------------------------------------------------

        _S_live = _seed_float(
            market.get(
                "spot"
            )
        )

        _K_live = _seed_float(
            seed.get(
                "strike"
            )
        )

        if (
            _S_live is None
            or
            _K_live is None
            or
            _S_live <= 0
            or
            _K_live <= 0
        ):

            raise ValueError(
                "Invalid live spot/position strike"
            )

        # ----------------------------------------------------
        # EXACT LIVE CE/PE IV
        # ----------------------------------------------------

        _chain_live = getattr(
            ENGINE,
            "chain",
            None
        )

        _expiry_live = str(
            seed.get(
                "expiry"
            )
        ).strip()

        def _get_exact_live_iv(
            _option_type
        ):

            if not isinstance(
                _chain_live,
                dict
            ):
                return None

            for (
                _key_live,
                _quote_live
            ) in _chain_live.items():

                try:

                    if not isinstance(
                        _key_live,
                        (tuple, list)
                    ):
                        continue

                    if len(
                        _key_live
                    ) < 3:
                        continue

                    if str(
                        _key_live[0]
                    ).strip() != _expiry_live:
                        continue

                    _strike_live = _seed_float(
                        _key_live[1]
                    )

                    if (
                        _strike_live is None
                        or
                        abs(
                            _strike_live
                            -
                            _K_live
                        ) > 0.01
                    ):
                        continue

                    if str(
                        _key_live[2]
                    ).upper() != str(
                        _option_type
                    ).upper():
                        continue

                    if not isinstance(
                        _quote_live,
                        dict
                    ):
                        continue

                    for _iv_field in (
                        "iv",
                        "IV",
                        "implied_volatility",
                        "impliedVolatility"
                    ):

                        _iv_value = _seed_float(
                            _quote_live.get(
                                _iv_field
                            )
                        )

                        if (
                            _iv_value is not None
                            and
                            _iv_value > 0
                        ):

                            return float(
                                _iv_value
                            )

                except Exception:
                    continue

            return None

        _build_iv_fallback = _seed_float(
            seed.get(
                "build_iv"
            )
        )

        if (
            _build_iv_fallback is None
            or
            _build_iv_fallback <= 0
        ):

            raise ValueError(
                "Invalid fallback build IV"
            )

        _ce_iv_live = _get_exact_live_iv(
            "CE"
        )

        _pe_iv_live = _get_exact_live_iv(
            "PE"
        )

        if (
            _ce_iv_live is None
            or
            _ce_iv_live <= 0
        ):

            _ce_iv_live = (
                _build_iv_fallback
            )

        if (
            _pe_iv_live is None
            or
            _pe_iv_live <= 0
        ):

            _pe_iv_live = (
                _build_iv_fallback
            )

        _ce_iv_live = max(
            float(
                _ce_iv_live
            ),
            1e-6
        )

        _pe_iv_live = max(
            float(
                _pe_iv_live
            ),
            1e-6
        )

        # ----------------------------------------------------
        # IV UNIT NORMALIZATION
        #
        # Live option-chain IV is supplied as PERCENT:
        #
        #   8.347  = 8.347%
        #
        # Black-Scholes functions expect DECIMAL:
        #
        #   0.08347
        #
        # Build IV is already stored as decimal.
        # ----------------------------------------------------

        if _ce_iv_live > 1.0:
            _ce_iv_live /= 100.0

        if _pe_iv_live > 1.0:
            _pe_iv_live /= 100.0

        # ----------------------------------------------------
        # LIVE DELTAS
        # ----------------------------------------------------

        _ce_delta_live = bs_delta(
            True,
            _S_live,
            _K_live,
            _T_live,
            0.0,
            _ce_iv_live
        )

        _pe_delta_live = bs_delta(
            False,
            _S_live,
            _K_live,
            _T_live,
            0.0,
            _pe_iv_live
        )

        # Short CE + short PE.
        _opt_delta_live = (
            -_ce_delta_live
            -
            _pe_delta_live
        )

        # ----------------------------------------------------
        # LIVE GAMMA
        #
        # Use production bs_gamma() separately for both legs.
        # ----------------------------------------------------

        _ce_gamma_live = bs_gamma(
            _S_live,
            _K_live,
            _T_live,
            0.0,
            _ce_iv_live
        )

        _pe_gamma_live = bs_gamma(
            _S_live,
            _K_live,
            _T_live,
            0.0,
            _pe_iv_live
        )

        _opt_gamma_live = (
            -_ce_gamma_live
            -
            _pe_gamma_live
        )

        # ----------------------------------------------------
        # LIVE THETA
        #
        # Short-option theta per calendar day.
        # r = 0, q = 0.
        # ----------------------------------------------------

        _math = __import__(
            "math"
        )

        _sqrt_T_live = (
            _T_live ** 0.5
        )

        def _short_theta_day(
            _iv
        ):

            _d1 = (
                _math.log(
                    _S_live /
                    _K_live
                )
                +
                0.5
                *
                _iv
                *
                _iv
                *
                _T_live
            ) / (
                _iv
                *
                _sqrt_T_live
            )

            _pdf = (
                _math.exp(
                    -0.5
                    *
                    _d1
                    *
                    _d1
                )
                /
                (
                    2.0
                    *
                    _math.pi
                )
                ** 0.5
            )

            _long_theta_year = (
                -(
                    _S_live
                    *
                    _pdf
                    *
                    _iv
                )
                /
                (
                    2.0
                    *
                    _sqrt_T_live
                )
            )

            # Short option = positive theta.
            return (
                -_long_theta_year
                /
                365.0
            )

        _ce_theta_live = (
            _short_theta_day(
                _ce_iv_live
            )
        )

        _pe_theta_live = (
            _short_theta_day(
                _pe_iv_live
            )
        )

        _opt_theta_live = (
            _ce_theta_live
            +
            _pe_theta_live
        )

        # ----------------------------------------------------
        # LIVE VEGA
        #
        # Per 1 volatility percentage point.
        # ----------------------------------------------------

        def _short_vega(
            _iv
        ):

            _d1 = (
                _math.log(
                    _S_live /
                    _K_live
                )
                +
                0.5
                *
                _iv
                *
                _iv
                *
                _T_live
            ) / (
                _iv
                *
                _sqrt_T_live
            )

            _pdf = (
                _math.exp(
                    -0.5
                    *
                    _d1
                    *
                    _d1
                )
                /
                (
                    2.0
                    *
                    _math.pi
                )
                ** 0.5
            )

            _long_vega = (
                _S_live
                *
                _pdf
                *
                _sqrt_T_live
                /
                100.0
            )

            # Short option = negative vega.
            return -_long_vega

        _ce_vega_live = (
            _short_vega(
                _ce_iv_live
            )
        )

        _pe_vega_live = (
            _short_vega(
                _pe_iv_live
            )
        )

        _opt_vega_live = (
            _ce_vega_live
            +
            _pe_vega_live
        )

        # ----------------------------------------------------
        # CURRENT FUTURES HEDGE
        # ----------------------------------------------------

        _futures_hedge_live = _seed_float(
            seed.get(
                "initial_hedge"
            )
        )

        if (
            _futures_hedge_live is None
        ):

            _futures_hedge_live = 0.0

        # ----------------------------------------------------
        # NET DELTA / POINTS OUT
        # ----------------------------------------------------

        _net_delta_live = (
            _opt_delta_live
            +
            _futures_hedge_live
        )

        if abs(
            _opt_gamma_live
        ) > 1e-12:

            _points_out_live = abs(
                _net_delta_live
                /
                _opt_gamma_live
            )

        else:

            _points_out_live = None

        # ----------------------------------------------------
        # POINTS ALLOWED
        # ----------------------------------------------------

        _raw_build_iv_live = _seed_float(
            getattr(
                ENGINE,
                "raw_build_iv",
                None
            )
        )

        if (
            _raw_build_iv_live is None
            or
            _raw_build_iv_live <= 0
        ):

            _raw_build_iv_live = (
                _build_iv_fallback
            )

        if (
            current_straddle is not None
            and
            current_straddle > 0
        ):

            _points_allowed_live = max(
                min(
                    (
                        _raw_build_iv_live
                        /
                        57.0
                    )
                    *
                    _S_live,

                    current_straddle
                    /
                    4.0
                ),

                0.0008
                *
                _S_live
            )

        else:

            _points_allowed_live = None

        # ----------------------------------------------------
        # AUTHORITATIVE CURRENT GREEKS
        # ----------------------------------------------------

        greeks.update({

            "delta":
                _opt_delta_live,

            "gamma":
                _opt_gamma_live,

            "theta":
                _opt_theta_live,

            "vega":
                _opt_vega_live,

            "ce_delta":
                _ce_delta_live,

            "pe_delta":
                _pe_delta_live,

            "ce_iv":
                _ce_iv_live,

            "pe_iv":
                _pe_iv_live,

        })

        risk.update({

            "points_out":
                _points_out_live,

            "points_allowed":
                _points_allowed_live,

            "net_delta":
                _net_delta_live,

            "raw_build_iv":
                _raw_build_iv_live,

        })

        position.update({

            "opt_delta":
                _opt_delta_live,

            "opt_gamma":
                _opt_gamma_live,

            "opt_theta":
                _opt_theta_live,

            "opt_vega":
                _opt_vega_live,

            "futures_hedge":
                _futures_hedge_live,

            "points_out":
                _points_out_live,

            "points_allowed":
                _points_allowed_live,

            "current_future":
                current_future,

            "future_move":
                (
                    current_future
                    -
                    entry_future
                    if
                    current_future is not None
                    and
                    entry_future is not None
                    else None
                ),

        })

    except Exception as _manual_live_greek_exc:

        print(
            "[MANUAL LIVE GREEKS] calculation failed:",
            _manual_live_greek_exc
        )


    # ========================================================
    # END MANUAL LIVE GREEKS EXACT
    # ========================================================

    pnl_detail.update({

        "entry_straddle":
            entry_straddle,

        "current_straddle":
            current_straddle,

        "option_pnl_entry_based":
            option_pnl,

        "pnl_points_per_straddle":
            option_pnl,

        "future_entry":
            entry_future,

        "future_current":
            current_future,

        "future_move":
            future_move,

        "future_pnl":
            future_pnl,

        "total_pnl":
            total_pnl
    })


    pnl.update({

        "option":
            option_pnl or 0.0,

        "future":
            future_pnl,

        "points":
            total_pnl,

        "status":
            "MANUAL_CATCHUP_LIVE"
    })


    # ========================================================
    # NO SECOND TRADE
    # ========================================================

    stage = payload.setdefault(
        "stage",
        {}
    )

    stage["entry_stage"] = (
        seed.get(
            "stage"
        )
    )

    stage["signal"] = "NO"


    # ========================================================
    # CATCH-UP INFORMATION
    # ========================================================

    payload["manual_seed"] = {

        "active":
            True,

        "mode":
            "MANUAL_LTP_CATCHUP",

        "timestamp":
            seed.get(
                "timestamp"
            ),

        "stage":
            seed.get(
                "stage"
            ),

        "expiry":
            seed.get(
                "expiry"
            ),

        "strike":
            seed.get(
                "strike"
            ),

        "ce_ltp":
            seed.get(
                "ce_ltp"
            ),

        "pe_ltp":
            seed.get(
                "pe_ltp"
            ),

        "synthetic_future":
            entry_future,

        "entry_straddle":
            entry_straddle,

        "current_ce_ltp":
            current_ce_ltp,

        "current_pe_ltp":
            current_pe_ltp,

        "current_straddle":
            current_straddle,

        "option_pnl":
            option_pnl,

        "initial_hedge":
            seed.get(
                "initial_hedge"
            ),

        "future_entry":
            entry_future,

        "future_current":
            current_future,

        "future_move":
            future_move,

        "future_pnl":
            future_pnl,

        "total_pnl":
            total_pnl
    }

    payload["data_mode"] = (
        "MANUAL_LTP_CATCHUP_LIVE"
    )

    return payload


