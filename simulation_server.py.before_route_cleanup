                        self.future
                    ),

                    "future_move": (
                        self._json_num(
                            self.future
                            - self.entry_future
                        )
                        if (
                            np.isfinite(self.future)
                            and np.isfinite(self.entry_future)
                        )
                        else None
                    ),
                },

                "pnl": {
                    "option": self._json_num(
                        self.opt_pnl
                    ),
                    "future": self._json_num(
                        self.fut_pnl
                    ),
                    "points": self._json_num(
                        self.total_pnl
                    ),
                    "status": (
                        "RUNNING"
                        if self.trade_active
                        else (
                            "EXITED"
                            if self.exit_reason
                            else "WAITING"
                        )
                    ),
                },

                "exit": {
                    "reason": self.exit_reason,
                    "time": self.exit_time,
                },

                "reference": {
                    "status": self.reference_status,
                    "date": self.reference_date,
                },

                "ws": {
                    "chain_size": len(self.chain),
                },
            }

    @staticmethod
    def _json_num(v):

        try:
            x = float(v)

            if not np.isfinite(x):
                return None

            return x

        except Exception:
            return None



