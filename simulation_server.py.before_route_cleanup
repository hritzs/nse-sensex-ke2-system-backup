def _manual_normalized_raw_dte(
    build_timestamp,
    expiry_date
):
    """
    Manual-seed normalized RAW DTE.

    Same model as live engine:

        calendar days
        +
        remaining fraction of today's
        09:15 -> 15:40 session.

    One session = 385 minutes.

    Uses the MANUAL BUILD TIMESTAMP,
    never the current live timestamp.
    """

    try:

        ts = build_timestamp

        if ts is None:
            return np.nan

        if isinstance(ts, str):

            text = ts.strip()

            # ISO timestamp with optional timezone.
            try:
                ts = datetime.fromisoformat(
                    text
                )
            except Exception:

                # UI format:
                # 14-08-2026 09:18:00
                ts = datetime.strptime(
                    text,
                    "%d-%m-%Y %H:%M:%S"
                )

        if ts.tzinfo is not None:

            ts = ts.astimezone(
                IST
            ).replace(
                tzinfo=None
            )

        if isinstance(
            expiry_date,
            datetime
        ):

            exp_date = (
                expiry_date.date()
            )

        elif hasattr(
            expiry_date,
            "date"
        ):

            exp_date = expiry_date.date()

        else:

            exp_text = str(
                expiry_date
            ).strip()

            exp_date = datetime.strptime(
                exp_text,
                "%d-%b-%y"
            ).date()

        days_diff = (
            exp_date -
            ts.date()
        ).days

        if days_diff < 0:
            return 0.0001

        OPEN_MIN = 9 * 60 + 15
        CLOSE_MIN = 15 * 60 + 40
        SESSION_MINUTES = 385

        current_minutes = (
            ts.hour * 60
            +
            ts.minute
            +
            ts.second / 60.0
        )

        # Expiry today.
        if days_diff == 0:

            if current_minutes >= CLOSE_MIN:
                return 0.0001

            if current_minutes < OPEN_MIN:
                return 1.0

            return max(
                (
                    CLOSE_MIN
                    -
                    current_minutes
                )
                /
                SESSION_MINUTES,
                0.0001
            )

        # Future expiry.
        if current_minutes >= CLOSE_MIN:

            today_fraction = 0.0

        elif current_minutes < OPEN_MIN:

            today_fraction = 1.0

        else:

            today_fraction = max(
                0.0,
                1.0
                -
                (
                    (
                        current_minutes
                        -
                        OPEN_MIN
                    )
                    /
                    SESSION_MINUTES
                )
            )

        return max(
            days_diff
            +
            today_fraction,
            0.0001
        )

    except Exception as exc:

        print(
            "[MANUAL DTE ERROR]",
            exc
        )

        return np.nan


