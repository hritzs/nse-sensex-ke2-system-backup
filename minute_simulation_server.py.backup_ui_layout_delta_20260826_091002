        if path == "/api/runs":
            self.send_json({
                "status": "SUCCESS",
                "run_ids": list(RUN_IDS),
                "runs": CONTROLLER.state(),
            })
            return

        if path == "/api/runs/NOW/start":
            self.send_json(
                CONTROLLER.start_now()
            )
            return

        if path == "/api/expiries":
            self.send_json({
                "target_expiry": CONTROLLER.book.target_expiry,
                "available": CONTROLLER.book.available_expiries(),
            })
            return

        if path.startswith("/api/select_expiry"):

            from urllib.parse import parse_qs, urlsplit

            query = parse_qs(urlsplit(self.path).query)
            expiry = (query.get("expiry") or [""])[0].strip()

            if not expiry:
                self.send_json(
                    {
                        "status": "ERROR",
                        "error": "Missing expiry parameter",
                    },
                    400,
                )
                return

            ok, available = CONTROLLER.book.set_target_expiry(expiry)

            if not ok:
                self.send_json(
                    {
                        "status": "ERROR",
                        "error": "Expiry not currently available from feed",
                        "requested": expiry,
                        "available": available,
                    },
                    400,
                )
                return

            self.send_json({
                "status": "SUCCESS",
                "target_expiry": expiry,
                "available": available,
            })
            return

        if path.startswith("/api/runs/") and path.endswith("/clear"):

            run_id = path[
                len("/api/runs/"):-len("/clear")
            ]

            self.send_json(
                CONTROLLER.clear_run(run_id)
            )
            return

        if path.startswith("/api/runs/"):
            run_id = path.rsplit("/", 1)[-1]
            state = CONTROLLER.state(run_id)
            if state is None:
                self.send_json(
                    {
                        "status": "ERROR",
                        "error": "Unknown simulation run",
                        "run_id": run_id,
                    },
                    404,
                )
                return
            self.send_json(state)
            return

        self.send_json(
            {
                "status": "ERROR",
                "error": "Not found",
            },
            404,
        )


async def server_websocket_loop() -> None:
    await ws_loop()


def main() -> None:
    print("=" * 72)
    print("NIFTY CLEAN MINUTE SIMULATION SERVER")
    print("=" * 72)
    print(f"Feed : {WS_URI}")
    print(f"HTTP : http://0.0.0.0:{HTTP_PORT}")
    print("Runs : 09:16 / 09:17 / 09:18 / 09:19 / NOW")
    print(
        f"Quote policy : "
        f"{'LTP fallback enabled' if USE_LTP_FALLBACK else 'strict bid/ask'}"
    )
    print(
        f"Target expiry : "
        f"{CONTROLLER.book.target_expiry or 'NOT SELECTED - use /api/select_expiry'}"
    )
    print("=" * 72)

    thread = threading.Thread(
        target=lambda: asyncio.run(
            server_websocket_loop()
        ),
        daemon=True,
        name="market-websocket",
    )
    thread.start()

    server = ThreadingHTTPServer(
        (HTTP_HOST, HTTP_PORT),
        HTTPHandler,
    )

    print(
        f"[HTTP] Listening on {HTTP_HOST}:{HTTP_PORT}"
    )

    try:
        server.serve_forever()
    finally:
        server.server_close()


