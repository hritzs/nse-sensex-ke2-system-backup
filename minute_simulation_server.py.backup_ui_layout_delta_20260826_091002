<script id="expirySelectorJS">
(function(){

  function setGate(selected){

    const disabled = !selected;

    document.querySelectorAll(".pro-sim-tab").forEach(btn => {
      btn.disabled = disabled;
      btn.style.opacity = disabled ? "0.5" : "1";
      btn.style.cursor = disabled ? "not-allowed" : "pointer";
    });

    const startBtn = document.getElementById("proStartNowButton");
    if(startBtn){
      startBtn.disabled = disabled;
    }
  }

  async function refresh(){

    try{
      const res = await fetch("/api/expiries?ts=" + Date.now(), {cache:"no-store"});
      const data = await res.json();

      const sel = document.getElementById("proExpirySelect");
      const status = document.getElementById("proExpiryStatus");

      if(sel){

        const current = sel.value;
        const available = data.available || [];

        sel.innerHTML =
          '<option value="">Select expiry...</option>' +
          available.map(e =>
            '<option value="' + e + '"' + (e === current ? " selected" : "") + '>' + e + '</option>'
          ).join("");

        if(data.target_expiry){
          sel.value = data.target_expiry;
        }
      }

      if(status){
        status.textContent =
          data.target_expiry
            ? "ACTIVE EXPIRY: " + data.target_expiry
            : "NO EXPIRY SELECTED";
      }

      setGate(!!data.target_expiry);

    }catch(error){
      console.error("[EXPIRY UI]", error);
    }
  }

  async function confirmExpiry(){

    const sel = document.getElementById("proExpirySelect");

    if(!sel || !sel.value){
      alert("Choose an expiry first - only expiries the feed is currently sending complete data for are listed.");
      return;
    }

    try{

      const res = await fetch(
        "/api/select_expiry?expiry=" + encodeURIComponent(sel.value) + "&ts=" + Date.now(),
        {cache:"no-store"}
      );

      const data = await res.json();

      if(!res.ok){
        alert(data.error || "Unable to select expiry");
        return;
      }

      await refresh();

    }catch(error){
      alert("Unable to select expiry: " + error.message);
    }
  }

  function install(){

    const btn = document.getElementById("proExpiryConfirm");

    if(btn){
      btn.addEventListener("click", confirmExpiry);
    }

    refresh();
    setInterval(refresh, 3000);
  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", install, {once:true});
  }else{
    install();
  }

})();
</script>

