def _sim_clean(value):

    if value is None:
        return None

    if isinstance(
        value,
        (str, int, bool),
    ):
        return value

    if isinstance(value, float):

        if (
            value != value
            or value in (
                float("inf"),
                float("-inf"),
            )
        ):
            return None

        return value

    if isinstance(value, dict):
        return {
            str(k): _sim_clean(v)
            for k, v in value.items()
        }

    if isinstance(value, (list, tuple)):
        return [
            _sim_clean(v)
            for v in value
        ]

    try:
        return float(value)
    except Exception:
        return str(value)


