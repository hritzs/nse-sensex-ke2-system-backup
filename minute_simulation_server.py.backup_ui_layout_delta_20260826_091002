def _sim_persist_v2(sim, expiry):

    if not expiry:
        return

    try:
        payload = _sim_snapshot(sim)

        status = (
            "COMPLETED" if sim.completed
            else ("RUNNING" if sim.started
            else ("ARMED" if sim.armed else "WAITING"))
        )

        conn = _sim_db_connect()
        try:
            conn.execute(
                """
                INSERT INTO simulation_state_v2 (
                    expiry, run_id, trade_date, status, payload, updated_at
                )
                VALUES (?, ?, ?, ?, ?, ?)
                ON CONFLICT(trade_date, expiry, run_id)
                DO UPDATE SET
                    status=excluded.status,
                    payload=excluded.payload,
                    updated_at=excluded.updated_at
                """,
                (
                    expiry,
                    sim.run_id,
                    now_ist().date().isoformat(),
                    status,
                    json.dumps(payload, ensure_ascii=False, allow_nan=False),
                    now_ist().isoformat(timespec="seconds"),
                ),
            )
            conn.commit()
        finally:
            conn.close()

    except Exception as exc:
        print("[SIM DB] persist_v2 failed:", repr(exc))


def _sim_restore_v2(expiry, run_id):

    try:
