<script id="finalPnlChartJS">
(function(){

    function installPnlChart(){

        const root =
            document.getElementById("proSimRoot");

        if(!root){
            return;
        }

        if(
            document.getElementById(
                "proPnlHistoryChartSection"
            )
        ){
            return;
        }

        /*
         * Find the existing 1-MINUTE HISTORY section.
         * The P&L chart goes directly before it.
         */
        const tableSections =
            Array.from(
                root.querySelectorAll(
                    ".pro-table-wrap"
                )
            );

        const minuteHistory =
            tableSections.find(
                section => {

                    const head =
                        section.querySelector(
                            ".pro-section-head"
                        );

                    return (
                        head &&
                        head.textContent
                            .trim()
                            .toLowerCase()
                            .includes("minute history")
                    );
                }
            );

        if(!minuteHistory){
            return;
        }

        const chart =
            document.createElement("div");

        chart.id =
            "proPnlHistoryChartSection";

        chart.innerHTML = `
            <div class="pro-chart-title">
                P&L HISTORY · 1-MINUTE SNAPSHOTS
            </div>

            <div id="proPnlHistoryCanvasWrap">
                <canvas
                    id="proPnlHistoryCanvas"
                ></canvas>
            </div>
        `;

        minuteHistory.parentNode.insertBefore(
            chart,
            minuteHistory
        );

        console.log(
            "[PRO UI] P&L chart installed"
        );
    }


    function drawPnlChart(history){

        const canvas =
            document.getElementById(
                "proPnlHistoryCanvas"
            );

        if(!canvas){
            return;
        }

        const rect =
            canvas.getBoundingClientRect();

        const dpr =
            window.devicePixelRatio || 1;

        const width =
            Math.max(
                1,
                Math.floor(
                    rect.width * dpr
                )
            );

        const height =
            Math.max(
                1,
                Math.floor(
                    rect.height * dpr
                )
            );

        canvas.width = width;
        canvas.height = height;

        const ctx =
            canvas.getContext("2d");

        ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
        );

        const w =
            rect.width;

        const h =
            rect.height;

        ctx.clearRect(
            0,
            0,
            w,
            h
        );

        if(
            !Array.isArray(history)
            ||
            history.length < 2
        ){

            ctx.fillStyle =
                "#8ea2b8";

            ctx.font =
                "10px system-ui";

            ctx.fillText(
                "Waiting for P&L history...",
                10,
                20
            );

            return;
        }

        const values =
            history
                .map(
                    row =>
                        Number(
                            row.total_pnl ??
                            row.total ??
                            0
                        )
                )
                .filter(
                    Number.isFinite
                );

        if(values.length < 2){
            return;
        }

        const min =
            Math.min(...values);

        const max =
            Math.max(...values);

        /*
         * Keep a visible zero line whenever the range
         * crosses zero.
         */
        const low =
            Math.min(
                min,
                0
            );

        const high =
            Math.max(
                max,
                0
            );

        const range =
            Math.max(
                high - low,
                0.000001
            );

        const padX = 10;
        const padY = 12;

        /*
         * Grid / zero line.
         */
        const zeroY =
            h -
            padY -
            (
                (0 - low)
                / range
            )
            *
            (
                h - 2 * padY
            );

        ctx.strokeStyle =
            "#20344a";

        ctx.lineWidth = 1;

        ctx.beginPath();

        ctx.moveTo(
            padX,
            zeroY
        );

        ctx.lineTo(
            w - padX,
            zeroY
        );

        ctx.stroke();

        /*
         * P&L line.
         */
        ctx.strokeStyle =
            "#35d07f";

        ctx.lineWidth = 2;

        ctx.beginPath();

        values.forEach(
            (value, index) => {

                const x =
                    padX
                    +
                    (
                        index
                        /
                        Math.max(
                            values.length - 1,
                            1
                        )
                    )
                    *
                    (
                        w - 2 * padX
                    );

                const y =
                    h -
                    padY
                    -
                    (
                        (value - low)
                        /
                        range
                    )
                    *
                    (
                        h - 2 * padY
                    );

                if(index === 0){
                    ctx.moveTo(
                        x,
                        y
                    );
                }else{
                    ctx.lineTo(
                        x,
                        y
                    );
                }

            }
        );

        ctx.stroke();

        /*
         * Last-value marker.
         */
        const last =
            values[values.length - 1];

        const lastX =
            w - padX;

        const lastY =
            h -
            padY
            -
            (
                (last - low)
                /
                range
            )
            *
            (
                h - 2 * padY
            );

        ctx.fillStyle =
            "#35d07f";

        ctx.beginPath();

        ctx.arc(
            lastX,
            lastY,
            3,
            0,
            Math.PI * 2
        );

        ctx.fill();

        /*
         * Labels.
         */
        ctx.fillStyle =
            "#8ea2b8";

        ctx.font =
            "9px system-ui";

        ctx.fillText(
            "Max " + max.toFixed(2),
            10,
            10
        );

        ctx.fillText(
            "Min " + min.toFixed(2),
            10,
            h - 2
        );

        ctx.textAlign = "right";

        ctx.fillText(
            "Current " + last.toFixed(2),
            w - 10,
            10
        );

        ctx.textAlign = "left";
    }


    window.__PRO_DRAW_PNL_CHART =
        drawPnlChart;


    /*
     * We hook into the existing pro UI render.
     * The existing render function already receives the
     * complete Simulation state.
     */
    function hookRender(){

        if(
            typeof window.__PRO_RENDER
            !== "function"
        ){
            return;
        }

        if(
            window.__PRO_PNL_HOOKED
        ){
            return;
        }

        const original =
            window.__PRO_RENDER;

        window.__PRO_RENDER =
            function(state){

                original(state);

                if(state){

                    drawPnlChart(
                        Array.isArray(
                            state.history
                        )
                            ? state.history
                            : []
                    );
                }

            };

        window.__PRO_PNL_HOOKED =
            true;
    }


    function boot(){

        installPnlChart();

        /*
         * Existing professional UI may already have
         * created its render wrapper. Try repeatedly for
         * a short period rather than changing the engine.
         */
        hookRender();

        let attempts = 0;

        const timer =
            setInterval(
                () => {

                    installPnlChart();
                    hookRender();

                    attempts++;

                    if(
                        attempts > 30
                    ){
                        clearInterval(timer);
                    }

                },
                200
            );
    }


    if(
        document.readyState
        === "loading"
    ){
        document.addEventListener(
            "DOMContentLoaded",
            boot,
            {once:true}
        );
    }else{
        boot();
    }


    window.addEventListener(
        "resize",
        () => {

            const last =
                window.__PRO_LAST_STATE;

            if(last){
                drawPnlChart(
                    Array.isArray(
                        last.history
                    )
                        ? last.history
                        : []
                );
            }

        }
    );

})();
</script>









<script id="nowChartBlankBeforeStart">
(function(){

    function syncNowChart(){

        const section =
            document.getElementById(
                "autoPnlChartSection"
            );

        if(!section){
            return;
        }

        /*
         * Read the authoritative NOW state.
         * We do not modify backend state here.
         */
        fetch(
            "/api/runs/NOW?ts="
            +
            Date.now(),
            {
                cache:"no-store"
            }
        )
        .then(
            response =>
                response.ok
                    ? response.json()
                    : null
        )
        .then(
            state => {

                if(!state){
                    return;
                }

                if(
                    state.started
                    &&
                    state.request_timestamp
                ){

                    section.classList.add(
                        "show-pnl-chart"
                    );

                    section.classList.remove(
                        "hide-pnl-chart"
                    );

                }else{

                    section.classList.remove(
                        "show-pnl-chart"
                    );

                    section.classList.add(
                        "hide-pnl-chart"
                    );
                }
            }
        )
        .catch(
            () => {}
        );
    }

    setInterval(
        syncNowChart,
        1000
    );

    if(
        document.readyState === "loading"
    ){

        document.addEventListener(
            "DOMContentLoaded",
            syncNowChart,
            {once:true}
        );

