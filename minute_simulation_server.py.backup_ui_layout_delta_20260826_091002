  async function fetchState(){

    try{

      const response =
        await fetch(
          "/api/runs/"
          +
          activeRun
          +
          "?ts="
          +
          Date.now(),
          {
            cache:"no-store"
          }
        );

      if(!response.ok){
        throw new Error(
          "HTTP " + response.status
        );
      }

      const state =
        await response.json();

      render(state);

      if (window.__PRO_DRAW_PNL_CHART) {
        window.__PRO_DRAW_PNL_CHART(
          Array.isArray(state.history)
            ? state.history
            : []
        );
      }

      const live =
        $("proLiveStatus");

      if(live){
        live.textContent =
          state.completed
            ? "COMPLETED"
            : "LIVE";
      }

    }catch(error){

      const live =
        $("proLiveStatus");

      if(live){
        live.textContent = "RECONNECTING";
      }

      console.error(
        "[PRO SIM UI]",
        error
      );
    }
  }

  async function startNow(){

    try{

      const response =
        await fetch(
          "/api/runs/NOW/start?ts="
          +
          Date.now(),
          {
            cache:"no-store"
          }
        );

      const data =
        await response.json();

      if(!response.ok){
        throw new Error(
          data.error ||
          "Unable to arm NOW"
        );
      }

      persistActiveRun("NOW");
      updateTabState();

      await fetchState();

    }catch(error){

      console.error(
        "[START NOW]",
        error
      );

      alert(
        "Unable to start NOW simulation: "
        +
        error.message
      );
    }
  }

  function updateTabState(){

    document
      .querySelectorAll(
        ".pro-sim-tab"
      )
      .forEach(
        button => {

          button.classList.toggle(
            "active",
            button.dataset.run === activeRun
          );
        }
      );
  }

  function install(){

    document
      .querySelectorAll(
        ".pro-sim-tab"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              const run =
                button.dataset.run;

              if(run === "NOW"){

                startNow();
                return;
              }

              persistActiveRun(run);

              updateTabState();
              fetchState();
            }
          );
        }
      );

    window.addEventListener(
      "resize",
      () => drawChart(
        window.__PRO_LAST_STATE ||
        {}
      )
    );

    // Keep a copy for resize redraws.
    const originalRender = render;

    window.__PRO_RENDER = function(state){

      window.__PRO_LAST_STATE = state;
      originalRender(state);

    };

    fetchState();

    if(timer){
      clearInterval(timer);
    }

    timer =
      setInterval(
        fetchState,
        1000
      );
  }

  /*
   * Replace render with state-caching wrapper.
   */
  window.__PRO_LAST_STATE = null;

  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      install,
      {
        once:true
      }
    );
  }else{
    install();
  }

})();
</script>


