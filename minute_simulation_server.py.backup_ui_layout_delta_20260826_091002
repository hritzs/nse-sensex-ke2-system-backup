<script id="professionalSimulationJS">
(function(){

  const RUNS = [
    "0916",
    "0917",
    "0918",
    "0919",
    "NOW"
  ];

  const ACTIVE_RUN_KEY =
    "nifty_minute_active_run";


  let activeRun = "0916";


  try {

    const saved =

      localStorage.getItem(

        ACTIVE_RUN_KEY

      );


    if (

      saved &&

      RUNS.includes(saved)

    ) {

      activeRun = saved;

    }

  } catch (error) {

    console.warn(

      "[RUN UI] restore failed",

      error

    );

  }


  function persistActiveRun(runId) {

    if (!RUNS.includes(runId)) {

      return;

    }


    activeRun = runId;


    try {

      localStorage.setItem(

        ACTIVE_RUN_KEY,

        runId

      );

    } catch (error) {

      console.warn(

        "[RUN UI] persist failed",

        error

      );

    }

  }

      localStorage.getItem(
        "nifty_minute_active_run"
      ) || "0916";

  try {
    const saved =
      localStorage.getItem(
        ACTIVE_RUN_KEY
      );

    if (
      saved &&
      RUNS.includes(saved)
    ) {
      activeRun = saved;
    }
  } catch (error) {
    console.warn(
      "[RUN UI] restore failed",
      error
    );
  }

  function persistActiveRun(runId) {

    if (!RUNS.includes(runId)) {
      return;
    }

    // Switching runs (tabs) must not carry over sticky field
    // values from the previous run's display cache. Without
    // this, a field that briefly returns null for the newly
    // selected run keeps showing the OLD run's value instead
    // (e.g. NOW's entry price bleeding into 0916's WAITING tab).
    for (const key in __lastFieldValues) {
      delete __lastFieldValues[key];
    }
    for (const key in __lastFieldUpdatedAt) {
      delete __lastFieldUpdatedAt[key];
    }

    activeRun = runId;

    try {
      localStorage.setItem(
        ACTIVE_RUN_KEY,
        activeRun
      );
    } catch (error) {
      console.warn(
        "[RUN UI] persist failed",
        error
      );
    }
  }

  let timer = null;

  const $ = id =>
    document.getElementById(id);

  // Sticky display cache: once a field has shown a real value,
  // a transient null/empty poll result will not blank it back
  // to "--". Only used for setText() fields (market/position
  // reference fields), not for setPnl() P&L fields, which
  // already always carry a real number (default 0.0).
  const __lastFieldValues = {};
  const __lastFieldUpdatedAt = {};

  function fmt(v, digits=2){
    if(v === null || v === undefined || !Number.isFinite(Number(v))){
      return "--";
    }

    return Number(v).toLocaleString(
      undefined,
      {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits
      }
    );
  }

  function signed(v, digits=2){
    if(v === null || v === undefined || !Number.isFinite(Number(v))){
      return "--";
    }

    const n = Number(v);
    return (n >= 0 ? "+" : "") + fmt(n, digits);
  }

  function esc(v){
    return String(v ?? "")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
  }

  function fmtTime(v){
    if(v === null || v === undefined || v === ""){
      return "--";
    }
    const s = String(v);
    const tIdx = s.indexOf("T");
    if(tIdx === -1){
      return s;
    }
    const timePart = s.slice(tIdx + 1);
    const plusIdx = timePart.indexOf("+");
    const cut = plusIdx === -1 ? timePart : timePart.slice(0, plusIdx);
    return cut.slice(0, 8);
  }

  function pnlClass(v){
    const n = Number(v);

    if(!Number.isFinite(n)){
      return "pro-neutral";
    }

    if(n > 0){
      return "pro-positive";
    }

    if(n < 0){
      return "pro-negative";
    }

    return "pro-neutral";
  }

  function setPnl(id, value){
    const node = $(id);

    if(!node){
      return;
    }

    node.textContent = signed(value,2);
    node.className =
      "pro-pnl-value "
      +
      pnlClass(value);
  }

  function setText(id, value){
    const node = $(id);

    if(!node){
      return;
    }

    const isEmpty =
      value === null ||
      value === undefined ||
      value === "";

    if(isEmpty){

      if(
        Object.prototype.hasOwnProperty.call(
          __lastFieldValues,
          id
        )
      ){
        // Hold the last real value instead of
        // flashing "--" on a single stale/missed poll.
        node.textContent = __lastFieldValues[id];

        const ageMs =
          Date.now() -
          (__lastFieldUpdatedAt[id] || 0);

        // Dim the value once it's been stale for more
        // than ~3 polls (polling runs at 1s intervals).
        node.style.opacity =
          ageMs > 3000 ? "0.45" : "1";

        return;
      }

      node.textContent = "--";
      return;
    }

    __lastFieldValues[id] = value;
    __lastFieldUpdatedAt[id] = Date.now();
    node.style.opacity = "1";
    node.textContent = value;
  }

  function resizeCanvas(){
    const canvas = $("proChart");

    if(!canvas){
      return;
    }

    const rect =
      canvas.getBoundingClientRect();

    const dpr =
      window.devicePixelRatio || 1;

    canvas.width =
      Math.max(
        1,
        Math.floor(rect.width * dpr)
      );

    canvas.height =
      Math.max(
        1,
        Math.floor(rect.height * dpr)
      );
  }

  function drawChart(state){

    const canvas = $("proChart");

    if(!canvas){
      return;
    }

    resizeCanvas();

    const ctx =
      canvas.getContext("2d");

    const dpr =
      window.devicePixelRatio || 1;

    const width =
      canvas.width / dpr;

    const height =
      canvas.height / dpr;

    ctx.setTransform(
      dpr,
      0,
      0,
      dpr,
      0,
      0
    );

    ctx.clearRect(
      0,
      0,
      width,
      height
    );

    const history =
      Array.isArray(state.history)
        ? state.history
        : [];

    if(history.length < 2){

      ctx.fillStyle = "#8ea2b8";
      ctx.font = "12px system-ui";

      ctx.fillText(
        "Waiting for minute history...",
        20,
        30
      );

      return;
    }

    const series = history.map(
      row => ({
        synthetic:
          Number(
            row.synthetic_future ??
            row.spot ??
            NaN
          ),

        pnl:
          Number(
            row.total_pnl ??
            row.total ??
            NaN
          )
      })
    );

    const validSynthetic =
      series
        .map(x => x.synthetic)
        .filter(Number.isFinite);

    const validPnl =
      series
        .map(x => x.pnl)
        .filter(Number.isFinite);

    if(
      validSynthetic.length < 2
      ||
      validPnl.length < 2
    ){
      return;
    }

    function drawSeries(
      values,
      top,
      bottom,
      stroke
    ){

      const min =
        Math.min(...values);

      const max =
        Math.max(...values);

      const range =
        Math.max(
          max - min,
          0.000001
        );

      ctx.strokeStyle =
        stroke;

      ctx.lineWidth = 2;

      ctx.beginPath();

      values.forEach(
        (v,i) => {

          const x =
            12
            +
            (
              i /
              Math.max(
                values.length - 1,
                1
              )
            )
            *
            (
              width - 24
            );

          const y =
            bottom
            -
            (
              (v - min)
              / range
            )
            *
            (
              bottom - top
            );

          if(i === 0){
            ctx.moveTo(x,y);
          }else{
            ctx.lineTo(x,y);
          }

        }
      );

      ctx.stroke();

      ctx.fillStyle = "#8ea2b8";
      ctx.font = "10px system-ui";

      ctx.fillText(
        fmt(min,2),
        14,
        bottom - 3
      );

      ctx.fillText(
        fmt(max,2),
        14,
        top + 10
      );
    }

    const middle =
      Math.floor(
        height * .52
      );

    drawSeries(
      validSynthetic,
      12,
      middle - 8,
      "#55aaff"
    );

    drawSeries(
      validPnl,
      middle + 8,
      height - 12,
      "#35d07f"
    );

    ctx.strokeStyle = "#20344a";
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(12,middle);
    ctx.lineTo(width - 12,middle);
    ctx.stroke();

    ctx.fillStyle = "#55aaff";
    ctx.fillText(
      "Synthetic Future",
      width - 120,
      20
    );

    ctx.fillStyle = "#35d07f";
    ctx.fillText(
      "Total P&L",
      width - 75,
      middle + 24
    );
  }

  function renderHedgeEvents(state){

    const tbody =
      $("proHedgeTable");

    if(!tbody){
      return;
    }

    const events =
      Array.isArray(state.hedge?.events)
        ? state.hedge.events
        : [];

    if(!events.length){

      tbody.innerHTML =
        '<tr><td colspan="8" class="pro-empty">No hedge events</td></tr>';

      return;
    }

    tbody.innerHTML =
      events
        .slice()
        .reverse()
        .slice(0,50)
        .map(
          e => `
            <tr>
              <td>${esc(fmtTime(e.timestamp))}</td>
              <td>${esc(e.reason ?? "")}</td>
              <td>${fmt(e.new_hedge ?? e.hedge_total ?? e.current,4)}</td>
              <td>${signed(e.change ?? e.hedge_change,4)}</td>
              <td>${fmt(e.delta,5)}</td>
              <td>${fmt(e.points_out,3)}</td>
              <td>${fmt(e.points_allowed,3)}</td>
              <td>${fmt(e.spot ?? e.synthetic_future,2)}</td>
            </tr>
          `
        )
        .join("");
  }

  function renderHistory(state){

    const tbody =
      $("proHistoryTable");

    if(!tbody){
      return;
    }

    const rows =
      Array.isArray(state.history)
        ? state.history
        : [];

    if(!rows.length){

      tbody.innerHTML =
        '<tr><td colspan="8" class="pro-empty">Waiting for minute history</td></tr>';

      return;
    }

    tbody.innerHTML =
      rows
        .slice()
        .reverse()
        .slice(0,60)
        .map(
          r => `
            <tr>
              <td>${esc(fmtTime(r.timestamp))}</td>
              <td>${fmt(r.synthetic_future ?? r.spot,2)}</td>
              <td>${fmt(r.atm,0)}</td>
              <td>${fmt(r.current_ce ?? r.ce,2)}</td>
              <td>${fmt(r.current_pe ?? r.pe,2)}</td>
              <td>${fmt(r.straddle ?? r.current_straddle,2)}</td>
              <td>${fmt(r.delta,5)}</td>
              <td class="${pnlClass(r.total_pnl ?? r.total)}">
                ${signed(r.total_pnl ?? r.total,2)}
              </td>
            </tr>
          `
        )
        .join("");
  }

  function render(state){

    if(!state){
      return;
    }

    const market =
      state.market || {};

    const entry =
      state.entry || {};

    const position =
      state.position || {};

    const greeks =
      state.greeks || {};

    const hedge =
      state.hedge || {};

    const pnl =
      state.pnl || {};

    const exit =
      state.exit || {};

    setText(
      "proRunId",
      state.run_id
    );

    setText(
      "proSyntheticSpot",
      fmt(
        market.synthetic_future ??
        market.spot
      )
    );

    setText(
      "proATM",
      fmt(market.atm,0)
    );

    setText(
      "proExpiry",
      "Expiry " +
      (entry.expiry ?? "--")
    );

    setText(
      "proCurrentStraddle",
      fmt(
        position.current_straddle
      )
    );
    const liveMarketAtm =
      market.atm ??
      position.market_atm ??
      null;

    const liveMarketStraddle =
      market.straddle ??
      position.market_straddle ??
      (
        market.ce != null &&
