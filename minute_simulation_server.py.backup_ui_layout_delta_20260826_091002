class SimulationController:

    def __init__(self):
        self.lock = threading.RLock()
        self.book = MarketBook()

        self.runs: dict[str, Simulation] = {
            run_id: Simulation(
                run_id=run_id,
                book=self.book,
            )
            for run_id in RUN_IDS
        }

        self.session_date = now_ist().date()

        # NOW lifecycle
        self.now_started = False
        self.now_request_timestamp = None
        self.now_scheduled_start = None

        self._restore_persistent_now()

    def _restore_persistent_now(self):

        payload = _sim_restore(
            "NOW"
        )

        if not payload:
            return

        try:

            sim = self.runs["NOW"]

            _sim_apply_restore(
                sim,
                payload,
            )

            if (
                sim.started
                or sim.armed
                or sim.entry_ce_symbol
            ):

                self.now_started = True

                self.now_request_timestamp = (
                    getattr(
                        sim,
                        "request_timestamp",
                        None,
                    )
                )

                self.now_scheduled_start = (
                    getattr(
                        sim,
                        "scheduled_start",
                        None,
                    )
                )

                print(
                    "[SIM DB] RESTORED NOW",
                    "| CE=",
                    sim.entry_ce_symbol,
                    "| PE=",
                    sim.entry_pe_symbol,
                    "| ATM=",
                    sim.entry_atm,
                )

        except Exception as exc:

            print(
                "[SIM DB] NOW restore failed:",
                repr(exc),
            )



    def _fixed_run_should_start(self, run_id: str) -> bool:
        """
        Fixed simulations arm ONLY during their exact scheduled
        minute - not "at or after" it.

        Example:
            09:16 run -> arms only during 09:16:00-09:16:59
            09:17 run -> arms only during 09:17:00-09:17:59
            09:18 run -> arms only during 09:18:00-09:18:59
            09:19 run -> arms only during 09:19:00-09:19:59

        If the server was down, the expiry wasn't yet selected,
        or the process simply wasn't ticking during that exact
        minute, the run permanently misses it for the day and
        does NOT backfill later - matching the documented intent
        that was previously not actually enforced by this method
        (it only checked now >= start, with no upper bound, so a
        run could incorrectly arm hours late).

        Each Simulation.armed flag guarantees the run is started
        only once for the trading day, for the runs that do
        catch their window.
        """

        start = FIXED_STARTS[run_id]
        now = now_ist().time()

        start_seconds = (
            start.hour * 3600
            + start.minute * 60
        )

        now_seconds = (
            now.hour * 3600
            + now.minute * 60
            + now.second
        )

        return (
            start_seconds
            <= now_seconds
            < start_seconds + 60
        )


    def process_tick(self, tick: dict) -> None:

        with self.lock:

            now = now_ist()
            today = now.date()

            # ----------------------------------------------------
            # NEW TRADING DAY
            #
            # Reset all five simulation lanes so tomorrow's
            # 09:16/09:17/09:18/09:19 runs start cleanly.
            # ----------------------------------------------------
            if today != self.session_date:

                self.session_date = today

                self.runs = {
                    run_id: Simulation(
                        run_id=run_id,
                        book=self.book,
                    )
                    for run_id in RUN_IDS
                }

                self.now_started = False
                self.now_request_timestamp = None
                self.now_scheduled_start = None

            # ----------------------------------------------------
            # Always ingest the market first.
            # ----------------------------------------------------
            self.book.update(tick)

            current = now_ist()

            for run_id, sim in self.runs.items():

                # A completed simulation stays completed for the
                # remainder of this trading day.
                if sim.completed:
                    continue

                # No simulation may arm/build until an expiry has
                # been explicitly selected via /api/select_expiry.
                if self.book.target_expiry is None:
                    continue

                # ------------------------------------------------
                # FIXED 09:16 / 09:17 / 09:18 / 09:19
                #
                # Only start during the exact minute.
                # Missed minute => no backfill.
                # ------------------------------------------------
                if run_id != "NOW":

                    if not sim.started:

                        if not self._fixed_run_should_start(
                            run_id
                        ):
                            continue

                        if not sim.armed:

                            sim.armed = True

                            sim.start_timestamp = (
                                current.isoformat(
                                    timespec="seconds"
                                )
                            )

                    market_snapshot = None

                    if sim.started:
                        market_snapshot = (
                            self.book.current_simulation_snapshot(
                                sim.entry_expiry
                            )
                        )

                        if market_snapshot is None:
                            continue

                    sim.process(
                        market_snapshot
                    )

                    continue

                # ------------------------------------------------
                # NOW
                #
                # The button only ARMS the simulation.
                #
                # It does NOT build immediately.
                #
                # Build occurs on the first live tick at or after
                # the next full minute.
                # ------------------------------------------------
                if not self.now_started:
                    continue

                scheduled = (
                    self.now_scheduled_start
                )

                if scheduled is None:
                    continue

                if current < scheduled:
                    continue

                # Scheduled minute has arrived.
                if not sim.armed:

                    sim.armed = True

                    # This is the actual simulation start time,
                    # while request_timestamp preserves the time
                    # at which the user clicked START NOW.
                    sim.start_timestamp = (
                        current.isoformat(
                            timespec="seconds"
                        )
                    )

                market_snapshot = None

                if sim.started:
                    market_snapshot = (
                        self.book.current_simulation_snapshot(
                            sim.entry_expiry
                        )
                    )

                    if market_snapshot is None:
                        continue

                sim.process(
                    market_snapshot
                )


    def start_now(self) -> dict:

        with self.lock:

            if self.book.target_expiry is None:
                return {
                    "run_id": "NOW",
                    "error": "NO_EXPIRY_SELECTED",
                }

            current = now_ist()

            existing = self.runs.get(
                "NOW"
            )

            # ----------------------------------------------------
            # NOW IS ONE-SHOT PER SERVER SESSION.
            #
            # Once START NOW has been pressed, this remains
            # consumed even after the trade completes.
            #
            # A server restart creates a fresh controller and
            # resets now_started=False.
            # ----------------------------------------------------
            if self.now_started:

                if existing is not None:
                    return existing.state()

                return {
                    "run_id": "NOW",
                    "error": "NOW simulation already consumed",
                }

            # ----------------------------------------------------
            # Fresh NOW lane.
            # ----------------------------------------------------
            sim = Simulation(
                run_id="NOW",
                book=self.book,
            )

            self.runs["NOW"] = sim

            self.now_started = True

            # Exact user click timestamp.
            request_timestamp = (
                current.isoformat(
                    timespec="seconds"
                )
            )

            # Next full minute.
            scheduled = (
                current.replace(
                    second=0,
                    microsecond=0,
                )
                + timedelta(minutes=1)
            )

            self.now_request_timestamp = (
                request_timestamp
            )

            self.now_scheduled_start = (
                scheduled
            )

            sim.request_timestamp = (
                request_timestamp
            )

            sim.scheduled_start = (
                scheduled
            )

            # DO NOT ARM.
            # DO NOT BUILD.
            #
            # process_tick() will do that exactly when the
            # scheduled minute begins.
            sim.armed = False

            return sim.state()


    def clear_run(self, run_id: str) -> dict:
        with self.lock:

            if run_id not in self.runs:
                return {
                    "status": "ERROR",
                    "error": "Unknown simulation run",
                    "run_id": run_id,
                }

            try:
                conn = _sim_db_connect()
                try:
                    conn.execute(
                        "DELETE FROM simulation_state "
                        "WHERE run_id=? AND trade_date=?",
                        (
                            run_id,
                            now_ist().date().isoformat(),
                        ),
                    )
                    conn.commit()
                finally:
                    conn.close()
            except Exception as exc:
                print(
                    "[SIM DB] clear_run failed:",
                    repr(exc),
                )

            self.runs[run_id] = Simulation(
                run_id=run_id,
                book=self.book,
            )

            if run_id == "NOW":
                self.now_started = False
                self.now_request_timestamp = None
                self.now_scheduled_start = None

            return {
                "status": "SUCCESS",
                "run_id": run_id,
                "cleared": True,
            }


    def state(self, run_id: str | None = None) -> Any:
        with self.lock:
            if run_id:
                sim = self.runs.get(run_id)
                return sim.state() if sim else None
            return {
                run_id:
                    sim.state()
                for run_id, sim in self.runs.items()
            }


CONTROLLER = SimulationController()


async def ws_loop():
    while True:
        try:
            print(f"[WS] Connecting to {WS_URI} ...")
            async with websockets.connect(
                WS_URI,
                ping_interval=None,
                ping_timeout=None,
                max_size=64 * 1024 * 1024,
            ) as ws:
                print("[WS] Connected to C++ feed :9001")

                try:
                    await ws.send(
                        json.dumps({
                            "action": "subscribe",
                            "channel": "ticks",
                        })
                    )
                except Exception:
                    pass

                async for raw in ws:
                    try:
                        if isinstance(raw, bytes):
                            raw = raw.decode(
                                "utf-8",
                                errors="replace",
                            )

                        payload = json.loads(raw)

                        if isinstance(payload, list):
                            records = payload
                        elif isinstance(payload, dict):
                            data = payload.get("data")
                            records = (
                                data
                                if isinstance(data, list)
                                else [payload]
                            )
                        else:
                            continue

                        for record in records:
                            if isinstance(record, dict):
                                CONTROLLER.process_tick(record)

                    except Exception as exc:
                        print(
                            "[WS RECORD ERROR]",
                            repr(exc),
                        )

        except Exception as exc:
            print("[WS ERROR]", repr(exc))
            await asyncio.sleep(2)


def fmt_num(value: Any, digits: int = 2) -> str:
    x = finite(value)
    return "—" if x is None else f"{x:.{digits}f}"


