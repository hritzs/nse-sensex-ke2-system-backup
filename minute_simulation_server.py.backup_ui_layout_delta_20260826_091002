def now_ist() -> datetime:
    return datetime.now(IST)


def finite(value: Any) -> float | None:
    try:
        x = float(value)
        return x if math.isfinite(x) else None
    except (TypeError, ValueError):
        return None


def norm_iv(value: Any) -> float | None:
    """Accept IV as either decimal or percentage."""
    x = finite(value)
    if x is None or x <= 0:
        return None
    if x > 2.0:
        return x / 100.0
    return x


def norm_symbol(symbol: Any) -> str:
    return str(symbol or "").strip()


def parse_symbol(symbol: str) -> tuple[str | None, str | None, float | None, str | None]:
    """
    Expected current C++ pipe format:
        NIFTY|25-AUG-26|24150|CE
        NIFTY|25-AUG-26|0|FUT
    """
    parts = symbol.split("|")
    if len(parts) >= 4:
        underlying = parts[0].strip().upper()
        expiry = parts[1].strip()
        try:
            strike = float(parts[2])
        except (TypeError, ValueError):
            strike = None
        opt_type = parts[3].strip().upper()
        return underlying, expiry, strike, opt_type

    # Fallback legacy compact symbols.
    upper = symbol.upper()
    for opt_type in ("CE", "PE", "FUT"):
        if upper.endswith(opt_type):
            body = upper[:-len(opt_type)]
            # Best-effort only; pipe-format is authoritative.
            return "NIFTY", None, None, opt_type

    return None, None, None, None


def expiry_datetime(expiry: str) -> datetime | None:
    """
    Parse 25-AUG-26 / 25-AUG-2026 and treat expiry settlement as 15:30 IST.
    Weekend adjustment is handled by stepping backwards to a weekday.
    """
    expiry = str(expiry or "").strip()
    for fmt in ("%d-%b-%y", "%d-%b-%Y"):
        try:
            d = datetime.strptime(expiry.upper(), fmt).date()
            dt = datetime.combine(d, time(15, 30), tzinfo=IST)
            while dt.weekday() >= 5:
                dt -= timedelta(days=1)
            return dt
        except ValueError:
            continue
    return None


def exact_dte(expiry: str, now: datetime | None = None) -> float | None:
    end = expiry_datetime(expiry)
    if end is None:
        return None
    current = now or now_ist()
    seconds = (end - current).total_seconds()
    return max(seconds / 86400.0, 0.0)


def norm_cdf(x: float) -> float:
    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))


def norm_pdf(x: float) -> float:
    return math.exp(-0.5 * x * x) / math.sqrt(2.0 * math.pi)


def bs_price(is_call: bool, spot: float, strike: float, t: float, rate: float, vol: float) -> float:
    if spot <= 0 or strike <= 0 or t <= 0 or vol <= 0:
        intrinsic = max(spot - strike, 0.0) if is_call else max(strike - spot, 0.0)
        return intrinsic

    sqrt_t = math.sqrt(t)
    d1 = (math.log(spot / strike) + (rate + 0.5 * vol * vol) * t) / (vol * sqrt_t)
    d2 = d1 - vol * sqrt_t

    if is_call:
        return spot * norm_cdf(d1) - strike * math.exp(-rate * t) * norm_cdf(d2)
    return strike * math.exp(-rate * t) * norm_cdf(-d2) - spot * norm_cdf(-d1)


def bs_greeks(is_call: bool, spot: float, strike: float, t: float, rate: float, vol: float) -> dict[str, float]:
    if spot <= 0 or strike <= 0 or t <= 0 or vol <= 0:
        delta = 1.0 if is_call else -1.0
        return {"delta": delta, "gamma": 0.0, "theta": 0.0, "vega": 0.0}

    sqrt_t = math.sqrt(t)
    d1 = (math.log(spot / strike) + (rate + 0.5 * vol * vol) * t) / (vol * sqrt_t)
    d2 = d1 - vol * sqrt_t

    disc = math.exp(-rate * t)
    pdf = norm_pdf(d1)

    if is_call:
        delta = norm_cdf(d1)
        theta = (
            -(spot * pdf * vol) / (2.0 * sqrt_t)
            - rate * strike * disc * norm_cdf(d2)
        ) / 365.0
    else:
        delta = norm_cdf(d1) - 1.0
        theta = (
            -(spot * pdf * vol) / (2.0 * sqrt_t)
            + rate * strike * disc * norm_cdf(-d2)
        ) / 365.0

    gamma = pdf / (spot * vol * sqrt_t)
    vega = spot * pdf * sqrt_t / 100.0

    return {
        "delta": delta,
        "gamma": gamma,
        "theta": theta,
        "vega": vega,
    }


def implied_vol_from_price(
    is_call: bool,
    spot: float,
    strike: float,
    t: float,
    price: float,
    rate: float = RISK_FREE_RATE,
) -> float | None:
    """
    Robust bisection fallback if the C++ message does not carry IV.
    """
    if not all(math.isfinite(x) for x in (spot, strike, t, price)):
        return None
    if spot <= 0 or strike <= 0 or t <= 0 or price <= 0:
        return None

    intrinsic = max(spot - strike, 0.0) if is_call else max(strike - spot, 0.0)
    if price <= intrinsic:
        return None

    lo, hi = 1e-6, 5.0
    p_hi = bs_price(is_call, spot, strike, t, rate, hi)
    if price > p_hi:
        return None

    for _ in range(80):
        mid = 0.5 * (lo + hi)
        p = bs_price(is_call, spot, strike, t, rate, mid)
        if p > price:
            hi = mid
        else:
            lo = mid

    return 0.5 * (lo + hi)


@dataclass
class Quote:
    symbol: str
    expiry: str
    strike: float
    option_type: str
    ltp: float | None = None
    bid: float | None = None
    ask: float | None = None
    iv: float | None = None
    timestamp: Any = None
    delta: float | None = None
    gamma: float | None = None
    quote_source: str = "NONE"

    def mark(self) -> float | None:
        return self.ltp

    def executable_entry(self) -> float | None:
        if (
            self.bid is not None
            and self.ask is not None
            and self.bid > 0
            and self.ask > 0
            and self.ask >= self.bid
            and self.ask < max(1000.0, 10.0 * max(self.ltp or 0.0, 1.0))
        ):
            return self.bid

        if self.ltp is not None and self.ltp > 0:
            return self.ltp

        return None

    def executable_exit(self) -> float | None:
        if (
            self.bid is not None
            and self.ask is not None
            and self.bid > 0
            and self.ask > 0
            and self.ask >= self.bid
            and self.ask < max(1000.0, 10.0 * max(self.ltp or 0.0, 1.0))
        ):
            return self.ask

        if self.ltp is not None and self.ltp > 0:
            return self.ltp

        return None


class MarketBook:

    def __init__(self):
        self.lock = threading.RLock()

        self.options = {}

        # --------------------------------------------------------
        # ACTUAL NIFTY FUTURE
        # future_quote -> LTP
        # --------------------------------------------------------
        self.futures = {}
        self.future_timestamps = {}
        self.future_bids = {}
        self.future_asks = {}

        # --------------------------------------------------------
        # AUTHORITATIVE SYNTHETIC FUTURE
        #
        # analytics -> syn_fut, maintained separately by expiry.
        #
        # The original production engine uses:
        #
        #     syn_fut_by_expiry[selected_expiry]
        #
        # as the simulation underlying / synthetic spot.
        # --------------------------------------------------------
        self.syn_fut_by_expiry = {}
        self.syn_fut_timestamps = {}

        # Raw NIFTY index spot. DISPLAY / REFERENCE ONLY.
        self.index_spot = None

        self.latest_timestamp = None
        self.last_messages = 0

        # ========================================================
        # ATOMIC C++ ATM STATE
        #
        # The simulation MUST NOT combine independently arriving
        # CE / PE / syn_fut packets.
        #
        # One state per expiry contains:
        #   syn_fut
        #   atm_strike
        #   ATM CE
        #   ATM PE
        #   CE sequence
        #   PE sequence
        #   completion sequence
        #   receive timestamp
        # ========================================================

        self.cpp_atm_state = {}

        # Must be explicitly set via /api/select_expiry before
        # any simulation run is allowed to arm/build.
        self.target_expiry = None

        self.cpp_sequence = 0
        self.cpp_complete_state_sequence = 0

        # Last packet sequence per option.
        self.quote_sequence = {}

        # Last analytics sequence observed.
        self.analytics_sequence = 0


    def update(self, raw):
        if not isinstance(raw, dict):
            return

        msg_type = str(
            raw.get("type", "")
        ).strip().lower()

        symbol = str(
            raw.get("symbol")
            or raw.get("sym")
            or ""
        ).strip()

        if not symbol:
            return

        upper = symbol.upper()

        underlying = str(
            raw.get("underlying", "")
        ).strip().upper()

        expiry = str(
            raw.get("expiry", "")
        ).strip()

        strike = finite(
            raw.get("strike")
        )

        # ========================================================
        # STRICT NIFTY FILTER
        # ========================================================

        if not (
            underlying == "NIFTY"
            or upper.startswith("NIFTY|")
            or (
                upper.startswith("NIFTY")
                and not upper.startswith("NIFTYNXT50")
            )
        ):
            return

        now = now_ist()

        timestamp = (
            raw.get("timestamp")
            or raw.get("published_at")
        )

        # ========================================================

        if msg_type == "future_quote":

            ltp = finite(
                raw.get("ltp")
            )

            bid = finite(
                raw.get(
                    "bid1",
                    raw.get(
                        "bid",
                        raw.get("Bid")
                    )
                )
            )

            ask = finite(
                raw.get(
                    "ask1",
                    raw.get(
                        "ask",
                        raw.get("Ask")
                    )
                )
            )

            if (
                expiry
                and ltp is not None
                and ltp > 0
            ):
                with self.lock:

                    self.futures[
                        expiry
                    ] = ltp

                    self.future_bids[
                        expiry
                    ] = bid

                    self.future_asks[
                        expiry
                    ] = ask

                    self.future_timestamps[
                        expiry
                    ] = now

                    self.latest_timestamp = timestamp

                    self.last_messages += 1

            return

        # ========================================================
        # ANALYTICS
        #
        # C++ analytics contains:
        #
        #   spot
        #   syn_fut
        #   atm_strike
        #   option quote
        #
        # IMPORTANT:
        #
        # syn_fut is stored as authoritative C++ state,
        # BUT it is NOT immediately consumed by the simulation.
        #
        # The simulation consumes it only after ATM CE + ATM PE
        # have been captured into the same atomic state.
        # ========================================================

        if msg_type != "analytics":
            return

        raw_spot = finite(
            raw.get("spot")
        )

        syn_fut = finite(
            raw.get("syn_fut")
        )

        cpp_atm = finite(
            raw.get("atm_strike")
        )

        # C++ does not appear to expose a guaranteed global
        # packet sequence in the examples. Therefore maintain
        # our own monotonically increasing receive sequence.
        with self.lock:

            self.cpp_sequence += 1
            packet_sequence = self.cpp_sequence

            self.analytics_sequence = packet_sequence

            if (
                raw_spot is not None
                and raw_spot > 0
            ):
                self.index_spot = raw_spot

            if (
                expiry
                and syn_fut is not None
                and syn_fut > 0
            ):
                self.syn_fut_by_expiry[
                    expiry
                ] = syn_fut

                self.syn_fut_timestamps[
                    expiry
                ] = now

            self.latest_timestamp = timestamp

            self.last_messages += 1

        # ========================================================
        # OPTION TYPE
        # ========================================================

        option_type = None

        if upper.endswith("CE"):
            option_type = "CE"

        elif upper.endswith("PE"):
            option_type = "PE"

        else:
            parts = symbol.split("|")

            if len(parts) >= 4:
                option_type = (
                    str(parts[3])
                    .strip()
                    .upper()
                )

        if option_type not in (
            "CE",
            "PE",
        ):
            return

        if not expiry or strike is None:
            return

        ltp = finite(
            raw.get("ltp")
        )

        bid = finite(
            raw.get(
                "bid1",
                raw.get(
                    "bid",
                    raw.get("Bid")
                )
            )
        )

        ask = finite(
            raw.get(
                "ask1",
                raw.get(
                    "ask",
                    raw.get("Ask")
                )
            )
        )

        iv = norm_iv(
            raw.get("iv")
        )

        q = Quote(
            symbol=symbol,
            expiry=expiry,
            strike=float(strike),
            option_type=option_type,
            ltp=ltp,
            bid=bid,
            ask=ask,
            iv=iv,
            timestamp=timestamp,
            delta=finite(
                raw.get("delta")
            ),
            gamma=finite(
                raw.get("gamma")
            ),
        )

        # ========================================================
        # QUOTE SOURCE
        # ========================================================

        if (
            q.ask is not None
            and (
                q.ask <= 0
                or (
                    q.ltp is not None
                    and q.ask >
                    10.0 * max(
                        q.ltp,
                        1.0
                    )
                )
            )
        ):
            q.quote_source = "LTP_FALLBACK"

        elif (
            q.bid is not None
            and q.ask is not None
            and q.bid > 0
            and q.ask >= q.bid
        ):
            q.quote_source = "BID_ASK"

        elif (
            q.ltp is not None
            and q.ltp > 0
        ):
            q.quote_source = "LTP_FALLBACK"

        # ========================================================
        # STORE NORMAL OPTION QUOTE
        # ========================================================

        key = (
            expiry,
            int(round(strike)),
            option_type,
        )

        with self.lock:

            self.options[key] = q

            self.quote_sequence[key] = packet_sequence

            # ====================================================
            # ATOMIC ATM CAPTURE
            #
            # ONLY capture the quote if this packet belongs to
            # the ATM strike supplied by C++.
            #
            # We do NOT calculate ATM ourselves.
            # ====================================================

            if (
                cpp_atm is None
                or cpp_atm <= 0
                or syn_fut is None
                or syn_fut <= 0
            ):
                return

            atm_int = int(
                round(cpp_atm)
            )

            strike_int = int(
                round(strike)
            )

            if strike_int != atm_int:
                return

            state = self.cpp_atm_state.get(
                expiry
            )

            if state is None:
                state = {
                    "expiry": expiry,
                    "atm": atm_int,
                    "syn_fut": float(syn_fut),
                    "ce": None,
                    "pe": None,
                    "ce_sequence": None,
                    "pe_sequence": None,
                    "syn_sequence": packet_sequence,
                    "atm_sequence": packet_sequence,
                    "updated_at": now,
                    "complete_sequence": None,
                }

                self.cpp_atm_state[
                    expiry
                ] = state

            # ----------------------------------------------------
            # IMPORTANT:
            #
            # syn_fut + ATM strike are updated from the SAME
            # analytics packet that produced this ATM quote.
            # ----------------------------------------------------

            state["atm"] = atm_int

            state["syn_fut"] = float(
                syn_fut
            )

            state["syn_sequence"] = (
                packet_sequence
            )

            state["atm_sequence"] = (
                packet_sequence
            )

            state["updated_at"] = now

            if option_type == "CE":

                state["ce"] = q

                state["ce_sequence"] = (
                    packet_sequence
                )

            elif option_type == "PE":

                state["pe"] = q

                state["pe_sequence"] = (
                    packet_sequence
                )

            # ----------------------------------------------------
            # COMPLETE STATE
            #
            # We require both ATM legs to exist.
            #
            # They may have arrived in separate packets, but both
            # MUST still be fresh. The state is rebuilt using the
            # latest C++ syn_fut/ATM and latest ATM CE/PE.
            #
            # The sequence numbers are retained so diagnostics can
            # show exactly how far apart the legs were received.
            # ----------------------------------------------------

            ce = state.get("ce")
            pe = state.get("pe")

            if (
                ce is not None
                and pe is not None
                and ce.ltp is not None
                and pe.ltp is not None
                and ce.ltp > 0
                and pe.ltp > 0
                and state.get("syn_fut") is not None
                and state["syn_fut"] > 0
            ):

                self.cpp_complete_state_sequence += 1

                state["complete_sequence"] = (
                    self.cpp_complete_state_sequence
                )

                state["updated_at"] = now

                # ------------------------------------------------
                # Parity diagnostic ONLY.
                #
                # Never use this to replace syn_fut.
                # ------------------------------------------------

                parity_synthetic = (
                    float(state["atm"])
                    + float(ce.ltp)
                    - float(pe.ltp)
                )

                parity_error = (
                    parity_synthetic
                    - float(state["syn_fut"])
                )

                state["parity_synthetic"] = (
                    parity_synthetic
                )

                state["parity_error"] = (
                    parity_error
                )

                # Print only meaningful mismatches.
                if abs(parity_error) >= 2.0:

                    print(
                        "[CPP PARITY WARNING]",
                        "expiry=", expiry,
                        "atm=", state["atm"],
                        "cpp_syn=", state["syn_fut"],
                        "ce=", ce.ltp,
                        "pe=", pe.ltp,
                        "ce_pe_syn=", parity_synthetic,
                        "diff=", parity_error,
                        "ce_seq=", state["ce_sequence"],
                        "pe_seq=", state["pe_sequence"],
                        "syn_seq=", state["syn_sequence"],
                    )

    def current_simulation_snapshot(
        self,
        expiry=None,
    ):
        """
        Return ONE coherent C++ market snapshot.

        This is the ONLY market snapshot the Simulation should
        consume for its strategy calculations.
        """

        with self.lock:

            selected = (
                expiry
                or self.select_expiry()
            )

            if selected is None:
                return None

            state = self.cpp_atm_state.get(
                selected
            )

            if state is None:
                return None

            syn_fut = state.get(
                "syn_fut"
            )

            atm = state.get(
                "atm"
            )

            ce = state.get(
                "ce"
            )

            pe = state.get(
                "pe"
            )

            complete_sequence = state.get(
                "complete_sequence"
            )

            if (
                syn_fut is None
                or syn_fut <= 0
                or atm is None
                or ce is None
                or pe is None
                or complete_sequence is None
            ):
                return None

            ce_ltp = finite(
                ce.ltp
            )

            pe_ltp = finite(
                pe.ltp
            )

            if (
                ce_ltp is None
                or pe_ltp is None
                or ce_ltp <= 0
                or pe_ltp <= 0
            ):
                return None

            updated_at = state.get(
                "updated_at"
            )

            if updated_at is None:
                return None

            age = (
                now_ist() - updated_at
            ).total_seconds()

            # Do not simulate dead market state.
            if age > 2.0:
                return None

            syn_fut = float(
                syn_fut
            )

            atm = float(
                atm
            )

            ce_ltp = float(
                ce_ltp
            )

            pe_ltp = float(
                pe_ltp
            )

            parity_synthetic = (
                atm
                + ce_ltp
                - pe_ltp
            )

            parity_error = (
                parity_synthetic
                - syn_fut
            )

            return {
                "expiry": selected,

                # C++ authoritative synthetic.
                "spot": syn_fut,
                "cpp_synthetic": syn_fut,

                # C++ authoritative ATM.
                "atm": atm,

                # Exact ATM quotes.
                "ce": ce,
                "pe": pe,

                "ce_ltp": ce_ltp,
                "pe_ltp": pe_ltp,

                "straddle": (
                    ce_ltp
                    + pe_ltp
                ),

                # Diagnostics only.
                "parity_synthetic":
                    parity_synthetic,

                "parity_error":
                    parity_error,

                "ce_sequence":
                    state.get(
                        "ce_sequence"
                    ),

                "pe_sequence":
                    state.get(
                        "pe_sequence"
                    ),

                "syn_sequence":
                    state.get(
                        "syn_sequence"
                    ),

                "complete_sequence":
                    complete_sequence,

                "receive_time":
                    updated_at,
            }



    def snapshot(self):
        with self.lock:
            return {
                "index_spot":
                    self.index_spot,

                "futures":
                    dict(self.futures),

                "future_timestamps":
                    dict(self.future_timestamps),

                "cpp_atm_state":
                    {
                        expiry: {
                            k: (
                                v
                                if k not in ("ce", "pe")
                                else (
                                    v.symbol
                                    if v is not None
                                    else None
                                )
                            )
                            for k, v in state.items()
                        }
                        for expiry, state
                        in self.cpp_atm_state.items()
                    },

                "cpp_authoritative":
                    {
                        "syn_fut_by_expiry":
                            dict(
                                self.syn_fut_by_expiry
                            ),

                        "complete_state_sequence":
                            self.cpp_complete_state_sequence,

                        "feed_sequence":
                            self.cpp_sequence,
                    },

                "synthetic_futures":
                    dict(self.syn_fut_by_expiry),

                "synthetic_timestamps":
                    dict(self.syn_fut_timestamps),

                "options":
                    dict(self.options),

                "timestamp":
                    self.latest_timestamp,

                "messages":
                    self.last_messages,
            }


    def current_future_bid_ask(self, expiry=None):
        with self.lock:

            now = now_ist()
            candidates = []

            for exp, price in self.futures.items():

                ts = self.future_timestamps.get(exp)

                if ts is None:
                    continue

                if (
                    now - ts
                ).total_seconds() > 5.0:
                    continue

                if (
                    expiry is not None
                    and exp != expiry
                ):
                    continue

                dt = expiry_datetime(exp)

                if (
                    dt is not None
                    and dt >= now
                ):
                    candidates.append(
                        (
                            dt,
                            exp,
                        )
                    )

            if not candidates:
                return (
                    None,
                    None,
                    None,
                )

            candidates.sort(
                key=lambda x: x[0]
            )

            selected = candidates[0][1]

            return (
                self.futures.get(selected),
                self.future_bids.get(selected),
                self.future_asks.get(selected),
            )


    def current_synthetic_future(self, expiry=None):
        with self.lock:

            selected = (
                expiry
                or self.select_expiry()
            )

            if selected is None:
                return None

            value = (
                self.syn_fut_by_expiry.get(
                    selected
                )
            )

            ts = (
                self.syn_fut_timestamps.get(
                    selected
                )
            )

            if value is None or ts is None:
                return None

            age = (
                now_ist() - ts
            ).total_seconds()

            if age > 5.0:
                return None

            if value <= 0:
                return None

            return float(value)


    def current_spot(self, expiry=None):
        # Strategy spot = selected expiry synthetic future.
        return self.current_synthetic_future(
            expiry
        )


    def select_expiry(self):

        with self.lock:

            now = now_ist()

            # ====================================================
            # EXPLICIT TARGET EXPIRY ONLY
            #
            # No auto-selection, no scanning, no fallback to any
            # other expiry. TARGET_EXPIRY is set manually at the
            # top of this file.
            # ====================================================

            target_expiry = self.target_expiry

            if target_expiry is None:
                return None

            state = self.cpp_atm_state.get(
                target_expiry
            )

            if state is None:
                return None

            syn_fut = state.get(
                "syn_fut"
            )

            atm = state.get(
                "atm"
            )

            ce = state.get(
                "ce"
            )

            pe = state.get(
                "pe"
            )

            complete_sequence = state.get(
                "complete_sequence"
            )

            updated_at = state.get(
                "updated_at"
            )

            if (
                syn_fut is None
                or syn_fut <= 0
                or atm is None
                or ce is None
                or pe is None
                or complete_sequence is None
                or updated_at is None
            ):
                return None

            age = (
                now - updated_at
            ).total_seconds()

            if age > 2.0:
                return None

            if (
                ce.ltp is None
                or pe.ltp is None
                or ce.ltp <= 0
                or pe.ltp <= 0
            ):
                return None

            return target_expiry


    def available_expiries(self):
        with self.lock:
            return sorted(self.cpp_atm_state.keys())

    def ready_expiries(self):
        """
        Every expiry currently passing the same freshness/
        completeness checks select_expiry() applies to a single
        expiry - but returns ALL qualifying expiries, not one.
        """
        with self.lock:
            now = now_ist()
            ready = []

            for expiry, state in self.cpp_atm_state.items():

                if state is None:
                    continue

                syn_fut = state.get("syn_fut")
                atm = state.get("atm")
                ce = state.get("ce")
                pe = state.get("pe")
                complete_sequence = state.get("complete_sequence")
                updated_at = state.get("updated_at")

                if (
                    syn_fut is None or syn_fut <= 0
                    or atm is None
                    or ce is None or pe is None
                    or complete_sequence is None
                    or updated_at is None
                ):
                    continue

                age = (now - updated_at).total_seconds()
                if age > 2.0:
                    continue

                if (
                    ce.ltp is None or pe.ltp is None
                    or ce.ltp <= 0 or pe.ltp <= 0
                ):
                    continue

                dt = expiry_datetime(expiry)
                if dt is None or dt < now:
                    continue

                ready.append(expiry)

            return sorted(ready)


    def set_target_expiry(self, expiry):
        with self.lock:
            available = sorted(self.cpp_atm_state.keys())

            if expiry not in self.cpp_atm_state:
                return False, available

            self.target_expiry = expiry
            return True, available



    def select_atm_pair(self, expiry=None):

        with self.lock:

            expiry = expiry or self.select_expiry()

            if expiry is None:
                return None

            state = self.cpp_atm_state.get(
                expiry
            )

            if state is None:
                return None

            syn_fut = state.get(
                "syn_fut"
            )

            atm = state.get(
                "atm"
            )

            ce = state.get(
                "ce"
            )

            pe = state.get(
                "pe"
            )

            if (
                syn_fut is None
                or syn_fut <= 0
                or atm is None
                or ce is None
                or pe is None
            ):
                return None

            if (
                ce.ltp is None
                or pe.ltp is None
                or ce.ltp <= 0
                or pe.ltp <= 0
            ):
                return None

            return (
                expiry,
                int(round(atm)),
                ce,
                pe,
            )




@dataclass
class Simulation:
    run_id: str
    book: MarketBook
    group_expiry: str | None = None
    lock: threading.RLock = field(default_factory=threading.RLock)

    armed: bool = False
    started: bool = False
    completed: bool = False

    start_timestamp: str | None = None
    scheduled_start: object | None = None
    request_timestamp: str | None = None
    exit_timestamp: str | None = None

    entry_timestamp: str | None = None
    entry_expiry: str | None = None
    entry_atm: float | None = None
    entry_ce_symbol: str | None = None
    entry_pe_symbol: str | None = None
    entry_ce: float | None = None
    entry_pe: float | None = None
    entry_straddle: float | None = None
    entry_spot: float | None = None
    entry_future: float | None = None
    entry_iv: float | None = None
    entry_dte: float | None = None
    entry_quote_source: str | None = None

    current_ce: float | None = None
    current_pe: float | None = None
    current_straddle: float | None = None
    min_straddle: float | None = None
    max_straddle: float | None = None

    option_pnl: float = 0.0
    future_pnl: float = 0.0
    total_pnl: float = 0.0

    delta: float | None = None
    gamma: float | None = None
    theta: float | None = None
    vega: float | None = None

    hedge: float = 0.0
    hedge_target: float = 0.0
    hedge_cash: float = 0.0
    points_out: float | None = None
    points_allowed: float | None = None

    tp_bps: float | None = None
    tp_points: float | None = None
    sl_points: float | None = None
    rtv_value: float | None = None
    rtv_threshold: float | None = None
    otm_iv: float | None = None
    zero_dte_active: bool = False
    iv_drop_threshold: float | None = None
    iv_drop_active: bool = False

    exit_reason: str | None = None
    entry_block_reason: str | None = None

    last_minute_key: str | None = None
    hedge_last_minute_key: str | None = None
    history: list[dict] = field(default_factory=list)
    hedge_events: list[dict] = field(default_factory=list)

    # Live market ATM reference, separate from the open position.
    market_atm: float | None = None
    market_ce: float | None = None
    market_pe: float | None = None
    market_straddle: float | None = None
    trade_history: list[dict] = field(default_factory=list)

    def _current_pair(self):
        return self.book.select_atm_pair(self.group_expiry)

    def _get_iv(self, q: Quote, spot: float, atm: float, dte: float) -> float | None:
        if q.iv is not None and q.iv > 0:
            return q.iv
        if q.ltp is None or q.ltp <= 0:
            return None
        return implied_vol_from_price(
            q.option_type == "CE",
            spot,
            atm,
            max(dte / 365.0, 1e-6),
            q.ltp,
        )

    def _calculate_greeks(self, spot: float, atm: float, dte: float, iv: float) -> None:
        t = max(dte / 365.0, 1e-6)

        call = bs_greeks(
            True, spot, atm, t, RISK_FREE_RATE, iv
        )
        put = bs_greeks(
            False, spot, atm, t, RISK_FREE_RATE, iv
        )

        # Short CE + short PE.
        self.delta = -(call["delta"] + put["delta"])
        self.gamma = -(call["gamma"] + put["gamma"])
        self.theta = -(call["theta"] + put["theta"])
        self.vega = -(call["vega"] + put["vega"])

    def _calculate_risk(self, spot: float, iv: float) -> None:
        if self.gamma is not None and abs(self.gamma) > 1e-12:
            self.points_out = abs(
                (self.delta + self.hedge) / self.gamma
            )
        else:
            self.points_out = None

        if self.current_straddle is not None:
            raw_allowed = (iv / 57.0) * spot
            cap_allowed = self.current_straddle / 4.0
            floor_allowed = 0.0008 * spot
            self.points_allowed = max(
                floor_allowed,
                min(raw_allowed, cap_allowed)
            )

    def _record_hedge(self, reason: str, old: float, new: float, spot: float) -> None:
        if abs(new - old) < 1e-10:
            return

        self.hedge_events.append({
            "timestamp": now_ist().isoformat(timespec="seconds"),
            "reason": reason,
            "old_hedge": old,
            "new_hedge": new,
            "change": new - old,
            "spot": spot,
            "delta": self.delta,
            "gamma": self.gamma,
            "points_out": self.points_out,
            "points_allowed": self.points_allowed,
        })
        self.hedge_events = self.hedge_events[-500:]

    def _rebalance(self, spot: float) -> None:

        target = -float(
            self.delta or 0.0
        )

        self.hedge_target = target

        if (
            self.points_out is None
            or self.points_allowed is None
        ):
            return

        if self.points_out < self.points_allowed:
            return

        old = float(self.hedge)

        change = (
            target
            - old
        )

        if abs(change) < 1e-10:
            return

        fut_ltp, fut_bid, fut_ask = (
            self.book.current_future_bid_ask(
                self.entry_expiry
            )
        )

        # BUY hedge -> execute at ASK.
        # SELL hedge -> execute at BID.
        #
        # If the C++ quote is unavailable, use synthetic LTP.
        if change > 0:
            execution_price = (
                fut_ask
                if (
                    fut_ask is not None
                    and fut_ask > 0
                )
                else (
                    fut_ltp
                    if (
                        fut_ltp is not None
                        and fut_ltp > 0
                    )
                    else spot
                )
            )
        else:
            execution_price = (
                fut_bid
                if (
                    fut_bid is not None
                    and fut_bid > 0
                )
                else (
                    fut_ltp
                    if (
                        fut_ltp is not None
                        and fut_ltp > 0
                    )
                    else spot
                )
            )

        if (
            execution_price is None
            or execution_price <= 0
        ):
            return

        # BUY  -> negative cash
        # SELL -> positive cash
        self.hedge_cash -= (
            change
            * float(execution_price)
        )

        self.hedge = target

        self._record_hedge(
            "RISK_BREACH",
            old,
            target,
            spot,
        )

    def _update_pnl(self, spot):

        if self.entry_straddle is None:
            return

        # --------------------------------------------------------
        # OPTION P&L
        #
        # The entry CE/PE are already executable entry prices:
        # bid when valid, LTP fallback otherwise.
        #
        # A short option is currently valued at the ask required
        # to buy it back.
        # --------------------------------------------------------

        position_ce = None
        position_pe = None

        for quote in self.book.options.values():

            if quote.symbol == self.entry_ce_symbol:
                position_ce = quote

            elif quote.symbol == self.entry_pe_symbol:
                position_pe = quote

            if (
                position_ce is not None
                and position_pe is not None
            ):
                break

        ce_exit = (
            position_ce.executable_exit()
            if position_ce is not None
            else None
        )

        pe_exit = (
            position_pe.executable_exit()
            if position_pe is not None
            else None
        )

        if ce_exit is None:
            ce_exit = self.current_ce

        if pe_exit is None:
            pe_exit = self.current_pe

        if (
            ce_exit is not None
            and pe_exit is not None
        ):
            self.option_pnl = (
                float(self.entry_ce or 0.0)
                + float(self.entry_pe or 0.0)
                - float(ce_exit)
                - float(pe_exit)
            )

        # --------------------------------------------------------
        # SYNTHETIC HEDGE P&L
        #
        # hedge_cash contains every executed hedge adjustment.
        #
        # Remaining long hedge -> mark at BID.
        # Remaining short hedge -> mark at ASK.
        #
        # If bid/ask is unavailable, use LTP.
        # --------------------------------------------------------

        fut_ltp, fut_bid, fut_ask = (
            self.book.current_future_bid_ask(
                self.entry_expiry
            )
        )

        if fut_ltp is None:
            fut_ltp = spot

        if self.hedge > 0:
            hedge_mark_price = (
                fut_bid
                if (
                    fut_bid is not None
                    and fut_bid > 0
                )
                else fut_ltp
            )

        elif self.hedge < 0:
            hedge_mark_price = (
                fut_ask
                if (
                    fut_ask is not None
                    and fut_ask > 0
                )
                else fut_ltp
            )

        else:
            hedge_mark_price = 0.0

        if (
            hedge_mark_price is not None
            and hedge_mark_price > 0
        ):
            self.future_pnl = (
                float(self.hedge_cash)
                + (
                    float(self.hedge)
                    * float(hedge_mark_price)
                )
            )
        else:
            self.future_pnl = (
                float(self.hedge_cash)
            )

        self.total_pnl = (
            float(self.option_pnl)
            + float(self.future_pnl)
        )

    def _check_exit(
        self,
        spot: float,
        dte: float,
        otm_quote: Quote | None,
        iv: float,
    ) -> str | None:

        # ========================================================
        # REFERENCE EXIT LOGIC
        # ========================================================

        underlying = float(
            self.entry_spot
            if self.entry_spot is not None
            else spot
        )

        # --------------------------------------------------------
        # STOP LOSS
        # Reference: SL_BPS = 14
        # --------------------------------------------------------

        max_loss_pts = -(
            underlying
            * 14.0
            / 10000.0
        )

        self.sl_points = max_loss_pts

        # --------------------------------------------------------
        # DYNAMIC TAKE PROFIT
        #
        # Reference:
        # high = [30,25,25,20,15,15,15]
        # low  = [16,13,13,10, 8, 8, 8]
        #
        # build IV interpolation:
        # fraction = (round(build_iv, 2) - .08) / .12
        #
        # IMPORTANT:
        # 0-DTE uses bucket 1.
        # --------------------------------------------------------

        tp_high = (
            30.0, 25.0, 25.0, 20.0,
            15.0, 15.0, 15.0,
        )

        tp_low = (
            16.0, 13.0, 13.0, 10.0,
            8.0, 8.0, 8.0,
        )

        build_iv = float(
            self.entry_iv
            if self.entry_iv is not None
            else iv
            if iv is not None
            else 0.0
        )

        rounded_bld = round(
            build_iv,
            2,
        )

        fraction = (
            rounded_bld - 0.08
        ) / 0.12

        try:
            dte_value = float(dte)
        except (TypeError, ValueError):
            dte_value = 0.0

        # 0-DTE -> first reference bucket.
        if dte_value <= 1.0:
            bucket = 0
        elif dte_value <= 2.0:
            bucket = 1
        elif dte_value <= 3.0:
            bucket = 2
        elif dte_value <= 4.0:
            bucket = 3
        elif dte_value <= 5.0:
            bucket = 4
        elif dte_value <= 6.0:
            bucket = 5
        else:
            bucket = 6

        base_tp_bps = (
            tp_low[bucket]
            + fraction
            * (
                tp_high[bucket]
                - tp_low[bucket]
            )
        )

        self.tp_bps = float(
            max(
                1.0,
                round(base_tp_bps),
            )
        )

        max_prof_pts = (
            underlying
            * self.tp_bps
            / 10000.0
        )

        self.tp_points = max_prof_pts

        # --------------------------------------------------------
        # 0-DTE FILTERS
        #
        # RTV and OTM-IV exit are active only on expiry day.
        # exact_dte() is fractional during the session, so
        # 0 < DTE <= 1 identifies the expiry-day lane.
        # --------------------------------------------------------

        self.zero_dte_active = (
            dte_value > 0.0
            and dte_value <= 1.0
        )

        otm = (
            otm_quote
            if otm_quote is not None
            else None
        )

        # Actual OTM option IV.
        if (
            self.zero_dte_active
            and otm is not None
        ):
            try:
                self.otm_iv = self._get_iv(
                    otm,
                    float(spot),
                    float(self.entry_atm),
                    float(max(dte_value, 1e-6)),
                )
            except Exception:
                self.otm_iv = None
        else:
            self.otm_iv = None

        # RTV ONLY ON 0-DTE.
        if (
            self.zero_dte_active
            and otm is not None
            and otm.ltp is not None
            and otm.ltp > 0
        ):
            self.rtv_value = (
                2.0 * float(otm.ltp)
            )

            self.rtv_threshold = (
                0.00015 * float(spot)
            )
        else:
            self.rtv_value = None
            self.rtv_threshold = None

        # --------------------------------------------------------
        # EXIT PRIORITY
        # --------------------------------------------------------

        if self.total_pnl <= max_loss_pts:
            return "STOP_LOSS"

        if self.total_pnl >= max_prof_pts:
            return "TAKE_PROFIT"

        if (
            self.rtv_value is not None
            and self.rtv_value
            < self.rtv_threshold
        ):
            return "RTV_TRADE_VALUE"

        # --------------------------------------------------------
        # IV DROP
        #
        # Reference:
        # time >= 14:57
        # OTM IV < 0.10
        # DTE <= 1
        # --------------------------------------------------------

        current = now_ist()

        self.iv_drop_threshold = 0.1

        self.iv_drop_active = (
            self.zero_dte_active
            and current.time() >= time(14, 57)
        )

        if (
            self.iv_drop_active
            and self.otm_iv is not None
            and self.otm_iv < self.iv_drop_threshold
        ):
            return "IV_DROP"

        if current.time() >= time(15, 40):
            return "EOD"

        return None

    def _finish(self, reason: str) -> None:
        if self.completed:
            return

        self.completed = True
        self.started = bool(self.started)
        self.armed = False
        self.exit_reason = reason
        self.exit_timestamp = (
            now_ist().isoformat(
                timespec="seconds"
            )
        )

        self.trade_history.append({
            "entry_timestamp": self.entry_timestamp,
            "exit_timestamp": self.exit_timestamp,
            "reason": reason,
            "entry_straddle": self.entry_straddle,
            "final_straddle": self.current_straddle,
            "option_pnl": self.option_pnl,
            "future_pnl": self.future_pnl,
            "total_pnl": self.total_pnl,
        })

    def build_now(self, start_timestamp=None):
        with self.lock:

            current = now_ist()

            self.armed = True

            self.start_timestamp = (
                current.isoformat(
                    timespec="seconds"
                )
            )

            self.scheduled_start = current

            # START NOW = build immediately from the
            # current live synthetic future and exact
            # ATM CE + PE.
            return self._try_enter()

    def _try_enter(self, force: bool = False) -> bool:
        pair = self._current_pair()

        if pair is None:
            self.entry_block_reason = (
                "ATM_CE_PE_NOT_AVAILABLE"
            )
            return False

        expiry, atm, ce, pe = pair
        spot = self.book.current_spot()

        if spot is None:
            self.entry_block_reason = "SPOT_UNAVAILABLE"
            return False

        dte = exact_dte(expiry)
        if dte is None or dte < 0:
            self.entry_block_reason = "DTE_UNAVAILABLE"
            return False

        ce_px = ce.executable_entry()
        pe_px = pe.executable_entry()

        if ce_px is None or pe_px is None:
            self.entry_block_reason = (
                f"QUOTES_UNAVAILABLE | "
                f"CE={ce_px!r} PE={pe_px!r}"
            )
            return False

        ce_iv = self._get_iv(
            ce, spot, atm, dte
        )
        pe_iv = self._get_iv(
            pe, spot, atm, dte
        )

        if ce_iv is None or pe_iv is None:
            self.entry_block_reason = (
                "IV_UNAVAILABLE"
            )
            return False

        iv = 0.5 * (ce_iv + pe_iv)

        self.entry_timestamp = (
            now_ist().isoformat(timespec="seconds")
        )
        self.entry_expiry = expiry
        self.entry_atm = float(atm)
        self.entry_ce_symbol = ce.symbol
        self.entry_pe_symbol = pe.symbol
        self.entry_ce = float(ce_px)
        self.entry_pe = float(pe_px)
        self.entry_straddle = (
            self.entry_ce
            + self.entry_pe
        )
        self.entry_spot = float(spot)
        # ----------------------------------------------------
        # STRATEGY UNDERLYING
        #
        # `spot` is the authoritative C++ synthetic future.
        # This is the strategy underlying.
        # ----------------------------------------------------

        self.entry_future = float(
            spot
        )
        self.entry_iv = float(iv)
        self.entry_dte = float(dte)
        self.entry_quote_source = (
            "BID_ASK"
            if (
                ce.quote_source == "BID_ASK"
                and pe.quote_source == "BID_ASK"
            )
            else "LTP_FALLBACK"
        )

        self.current_ce = ce.mark()
        self.current_pe = pe.mark()
        self.current_straddle = (
            (self.current_ce or 0.0)
            + (self.current_pe or 0.0)
        )

        self._calculate_greeks(
            spot,
            float(atm),
            float(dte),
            float(iv),
        )

        self.hedge = -float(self.delta or 0.0)
        self.hedge_target = self.hedge

        # Initial hedge is an actual transaction.
        self.hedge_cash = 0.0

        (
            fut_ltp,
            fut_bid,
            fut_ask,
        ) = self.book.current_future_bid_ask(
            expiry
        )

        initial_hedge = float(
            self.hedge
        )

        if initial_hedge > 0:
            execution_price = (
                fut_ask
                if (
                    fut_ask is not None
                    and fut_ask > 0
                )
                else (
                    fut_ltp
                    if (
                        fut_ltp is not None
                        and fut_ltp > 0
                    )
                    else spot
                )
            )
        elif initial_hedge < 0:
            execution_price = (
                fut_bid
                if (
                    fut_bid is not None
                    and fut_bid > 0
                )
                else (
                    fut_ltp
                    if (
                        fut_ltp is not None
                        and fut_ltp > 0
                    )
                    else spot
                )
            )
        else:
            execution_price = 0.0

        if (
            execution_price is not None
            and execution_price > 0
        ):
            self.hedge_cash -= (
                initial_hedge
                * float(execution_price)
            )

        self._calculate_risk(
            spot,
            float(iv),
        )

        self.started = True
        self.completed = False
        self.entry_block_reason = None

        self._record_minute()

        return True

    def _persisted_process(self, market_snapshot=None) -> None:

        with self.lock:

            if self.completed:
                return

            # ====================================================
            # ENTRY
            # ====================================================

            if not self.started:

                if not self.armed:
                    return

                if not self._try_enter():
                    return

                return

            # ====================================================
            # ONE ATOMIC C++ SNAPSHOT
            #
            # NOTHING below this point re-reads CE, PE, ATM,
            # synthetic, or future from MarketBook.
            # ====================================================

            snapshot = market_snapshot

            if snapshot is None:
                return

            # ====================================================
            # LIVE NEAREST-WEEKLY-EXPIRY SNAPSHOT
            #
            # Independent from the entry-locked snapshot above.
            # Used ONLY for the market_* reference fields.
            # ====================================================

            live_market_snapshot = snapshot

            # ====================================================
            # CURRENT MARKET ATM — ALWAYS AVAILABLE
            #
            # This is independent from the open position.
            # It must be populated before entry as well.
            # ====================================================

            try:

                if live_market_snapshot is None:
                    raise ValueError(
                        "no live market snapshot"
                    )

                _live_market_atm = float(
                    live_market_snapshot["atm"]
                )

                _live_market_ce = float(
                    live_market_snapshot["ce_ltp"]
                )

                _live_market_pe = float(
                    live_market_snapshot["pe_ltp"]
                )

                self.market_atm = (
                    _live_market_atm
                )

                self.market_ce = (
                    _live_market_ce
                )

                self.market_pe = (
                    _live_market_pe
                )

                self.market_straddle = (
                    _live_market_ce
                    +
                    _live_market_pe
                )

            except Exception as exc:

                print(
                    "[MARKET ATM] snapshot extraction failed:",
                    repr(exc),
                )



            expiry = snapshot["expiry"]

            # ----------------------------------------------------
            # CURRENT MARKET ATM
            #
            # This is the live market reference. It must NOT replace
            # the already-open position's CE/PE legs.
            # ----------------------------------------------------

            market_atm = snapshot["atm"]

            # ----------------------------------------------------
            # AUTHORITATIVE C++ SYNTHETIC
            # ----------------------------------------------------

            spot = float(
                snapshot["spot"]
            )

            # Current MARKET ATM pair.
            market_ce = snapshot["ce"]
            market_pe = snapshot["pe"]

            # ----------------------------------------------------
            # OPEN POSITION LEGS
            #
            # After entry, these symbols are immutable.
            # ----------------------------------------------------

            position_ce = None
            position_pe = None

            for quote in self.book.options.values():

                if quote.symbol == self.entry_ce_symbol:
                    position_ce = quote

                elif quote.symbol == self.entry_pe_symbol:
                    position_pe = quote

                if (
                    position_ce is not None
                    and position_pe is not None
                ):
                    break

            if (
                position_ce is None
                or position_pe is None
            ):
                return

            # Freeze analytical strike at entry.
            atm = float(
                self.entry_atm
            )

            # Downstream IV/Greeks logic uses the OPEN position.
            ce = position_ce
            pe = position_pe

            dte = exact_dte(
                expiry
            )


            if dte is None:
                return

            # ====================================================
            # LIVE OPTION MARKS
            #
            # These are from the SAME snapshot.
            # ====================================================

            # ----------------------------------------------------
            # OPEN POSITION CURRENT MARK
            # ----------------------------------------------------

            self.current_ce = float(
                position_ce.mark()
            )

            self.current_pe = float(
                position_pe.mark()
            )

            self.current_straddle = (
                self.current_ce
                +
                self.current_pe
            )

            # O(1) running position-straddle extrema.
            if self.min_straddle is None:
                self.min_straddle = self.current_straddle

            if self.max_straddle is None:
                self.max_straddle = self.current_straddle

            if self.current_straddle < self.min_straddle:
                self.min_straddle = self.current_straddle

            if self.current_straddle > self.max_straddle:
                self.max_straddle = self.current_straddle

            # ----------------------------------------------------
            # CURRENT MARKET ATM REFERENCE
            # ----------------------------------------------------

            if live_market_snapshot is not None:

                self.market_atm = float(
                    live_market_snapshot["atm"]
                )

                self.market_ce = float(
                    live_market_snapshot["ce_ltp"]
                )

                self.market_pe = float(
                    live_market_snapshot["pe_ltp"]
                )

                self.market_straddle = (
                    self.market_ce
                    +
                    self.market_pe
                )


            # ====================================================
            # IV
            # ====================================================

            ce_iv = self._get_iv(
                ce,
                spot,
                atm,
                dte,
            )

            pe_iv = self._get_iv(
                pe,
                spot,
                atm,
                dte,
            )

            iv_values = [
                x
                for x in (
                    ce_iv,
                    pe_iv,
                )
                if x is not None
            ]

            if not iv_values:
                return

            iv = (
                sum(iv_values)
                / len(iv_values)
            )

            # ====================================================
            # GREEKS
            #
            # Same C++ synthetic + same C++ ATM.
            # ====================================================

            self._calculate_greeks(
                spot,
                float(atm),
                float(dte),
                float(iv),
            )

            # ====================================================
            # RISK
            #
            # Same synthetic.
            # ====================================================

            self._calculate_risk(
                spot,
                float(iv),
            )

            # ====================================================
            # HEDGE
            #
            # Same delta/gamma generated from the SAME snapshot.
            #
            # _rebalance() does not fetch market data.
            #
            # THROTTLED TO MINUTE-END:
            # Only re-evaluate/execute a hedge adjustment once per
            # wall-clock minute (on the first tick that arrives in
            # a new minute), instead of on every tick. This stops
            # hedges from firing mid-minute (e.g. at :34s) and
            # aligns hedge decisions with the same 1-minute cadence
            # as _record_minute().
            # ====================================================

            hedge_now = now_ist()

            hedge_minute_key = (
                hedge_now.strftime("%Y-%m-%d %H:%M")
            )

            # Hedge only during the final second of the minute.
            # At most one hedge adjustment per minute.
            if (
                hedge_now.second >= 59
                and hedge_minute_key
                != self.hedge_last_minute_key
            ):

                self.hedge_last_minute_key = hedge_minute_key

                self._rebalance(
                    spot
                )

            # ====================================================
            # HEDGE P&L
            #
            # The `future` argument is reference-only.
            # Strategy P&L uses `spot`, which is C++ syn_fut.
            # ====================================================

            self._update_pnl(
                  spot
              )

            # ====================================================
            # EXIT
            # ====================================================

            otm = (
                pe
                if spot > atm
                else ce
            )

            reason = self._check_exit(
                spot,
                dte,
                otm,
                iv,
            )

            # ====================================================
            # RECORD EXACT SNAPSHOT USED
            # ====================================================

            self._record_minute(
                snapshot=snapshot
            )

            if reason:
                self._finish(
                    reason
                )


    def process(self, market_snapshot=None) -> None:
        self._persisted_process(market_snapshot)

        try:
            _sim_persist_v2(self, self.group_expiry)
        except Exception as exc:
            print(
                "[SIM DB] process persist failed:",
                repr(exc),
            )


    def _record_minute(
        self,
        snapshot=None,
    ) -> None:

        if snapshot is None:
            snapshot = (
                self.book.current_simulation_snapshot(
                    self.entry_expiry
                    if self.entry_expiry
                    else None
                )
            )

        receive_time = (
            snapshot.get("receive_time")
            if snapshot
            else None
        )

        row_time = (
            receive_time
            if hasattr(
                receive_time,
                "strftime"
            )
            else now_ist()
        )

        minute_key = row_time.strftime(
            "%Y-%m-%d %H:%M"
        )

        if (
            minute_key
            == self.last_minute_key
        ):
            return

        self.last_minute_key = minute_key

        spot = (
            snapshot.get("spot")
            if snapshot
            else None
        )

        atm = (
            snapshot.get("atm")
            if snapshot
            else None
        )

        self.history.append({

            "timestamp":
                row_time.isoformat(
                    timespec="seconds"
                ),

            "cpp_receive_time":
                (
                    receive_time.isoformat()
                    if hasattr(
                        receive_time,
                        "isoformat"
                    )
                    else receive_time
                ),

            # Authoritative strategy synthetic.
            "synthetic_future":
                spot,

            "spot":
                spot,

            "atm":
                (
                    self.entry_atm
                    if self.started
                    else atm
                ),

            "current_ce":
                self.current_ce,

            "current_pe":
                self.current_pe,

            "straddle":
                self.current_straddle,

            "delta":
                self.delta,

            "gamma":
                self.gamma,

            "theta":
                self.theta,

            "vega":
                self.vega,

            "hedge":
                self.hedge,

            "hedge_target":
                self.hedge_target,

            "points_out":
                self.points_out,

            "points_allowed":
                self.points_allowed,

            "option_pnl":
                self.option_pnl,

            # Internal name retained for compatibility;
            # UI labels this Synthetic Hedge.
            "future_pnl":
                self.future_pnl,

            "total_pnl":
                self.total_pnl,

            "trade_active":
                self.started
                and not self.completed,

            "quote_source":
                self.entry_quote_source,

            "cpp_sequence":
                (
                    snapshot.get(
                        "complete_sequence"
                    )
                    if snapshot
                    else None
                ),

            "ce_sequence":
                (
                    snapshot.get(
                        "ce_sequence"
                    )
                    if snapshot
                    else None
                ),

            "pe_sequence":
                (
                    snapshot.get(
                        "pe_sequence"
                    )
                    if snapshot
                    else None
                ),

            "parity_error":
                (
                    snapshot.get(
                        "parity_error"
                    )
                    if snapshot
                    else None
                ),
        })

        self.history = (
            self.history[-500:]
        )

    def state(self) -> dict:
        with self.lock:
            spot = self.book.current_spot()

            pair = self.book.select_atm_pair()

            live_atm = (
                pair[1]
                if pair is not None
                else None
            )

            return {
                "run_id": self.run_id,
                "mode": "MINUTE_STRADDLE",
                "armed": self.armed,
                "request_timestamp":
                    getattr(
                        self,
                        "request_timestamp",
                        None,
                    ),

                "scheduled_start":
                    (
                        getattr(
                            self,
                            "scheduled_start",
                            None,
                        ).isoformat()
                        if getattr(
                            self,
                            "scheduled_start",
                            None,
                        ) is not None
                        else None
                    ),
                "started": self.started,
                "completed": self.completed,
                "start_timestamp": self.start_timestamp,
                "exit_timestamp": self.exit_timestamp,

                "market": {
                    "spot": spot,
                    "synthetic_future": spot,
                    "atm": (
                        self.entry_atm
                        if self.started
                        else live_atm
                    ),
                },

                "entry": {
                    "timestamp": self.entry_timestamp,
                    "expiry": self.entry_expiry,
                    "atm": self.entry_atm,
                    "ce": self.entry_ce_symbol,
                    "pe": self.entry_pe_symbol,
                    "ce_price": self.entry_ce,
                    "pe_price": self.entry_pe,
