// Centralized Logger: Prints to Console, writes to File, and broadcasts to UI
void SystemLog(const std::string& msg, bool is_error = false) {
    std::lock_guard<std::mutex> lock(g_logMtx);
    
    // Console Output
    if (is_error) std::cerr << msg << std::endl;
    else std::cout << msg << std::endl;
    
    // File Output
    if (g_logFile.is_open()) {
        g_logFile << "[SYS] " << msg << std::endl;
        g_logFile.flush();
    }
    
