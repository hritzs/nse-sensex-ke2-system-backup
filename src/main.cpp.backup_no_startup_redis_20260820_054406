void sync_bhavcopy_files() {
    SystemLog("Checking network for new Bhavcopy files...");
    
    // Use an absolute path instead of a relative path for safer execution
    std::string base_dir = "./";
    std::string mkdir_cmd = "mkdir -p " + base_dir + "data/BhavCopy/BSEfobhavcopy";
    std::system(mkdir_cmd.c_str());

    // PowerShell commands wrapped in C++11 raw string literals (R"(...)") to avoid escaping hell.
