    // broadcast_to_all_clients(json_log); 
}

void signal_handler(int signum) {
    // WARNING: Do not use SystemLog (which uses std::mutex and I/O) inside a signal handler.
    // Mutexes are not async-signal-safe and can cause a deadlock if interrupted mid-log.
    // We safely set the atomic flag and notify threads to exit instead.
    g_running = false;
    QUEUE_CV.notify_all(); // Wake up all waiting workers
}

void worker_thread()
{
    live_packet_worker();
}

void multicast_listener(Exchange exchange, const char* ip, int port, const char* local_ip) {
    int sock = socket(AF_INET, SOCK_DGRAM, 0);
    if (sock < 0) {
        SystemLog("Socket creation failed for " + std::string(ip) + ":" + std::to_string(port), true);
        return;
    }

    int reuse = 1;
    setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));

    struct timeval tv;
    tv.tv_sec = 1;
    tv.tv_usec = 0;
    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tv, sizeof tv);

    sockaddr_in addr{};
    addr.sin_family = AF_INET;
    addr.sin_port = htons(port);
    addr.sin_addr.s_addr = htonl(INADDR_ANY);

    if (bind(sock, (sockaddr*)&addr, sizeof(addr)) < 0) {
        int err = errno;

        SystemLog(
            "Bind failed for " +
            std::string(ip) + ":" +
            std::to_string(port) +
            " | errno=" +
            std::to_string(err) +
            " | error=" +
            std::string(std::strerror(err)),
            true
        );

        close(sock);
        return;
    }

    SystemLog(
        "UDP bind SUCCESS on 0.0.0.0:" +
        std::to_string(port)
    );

    ip_mreq mreq{};
    mreq.imr_multiaddr.s_addr = inet_addr(ip);
    mreq.imr_interface.s_addr = inet_addr(local_ip);

    if (setsockopt(sock, IPPROTO_IP, IP_ADD_MEMBERSHIP, &mreq, sizeof(mreq)) < 0) {
        int err = errno;

        SystemLog(
            "Multicast join failed for " +
            std::string(ip) + ":" +
            std::to_string(port) +
            " | local_ip=" +
            std::string(local_ip) +
            " | errno=" +
            std::to_string(err) +
            " | error=" +
            std::string(std::strerror(err)),
            true
        );

        close(sock);
        return;
    }

    SystemLog(
        "Multicast JOIN SUCCESS: group=" +
        std::string(ip) +
        " port=" +
        std::to_string(port) +
        " interface=" +
        std::string(local_ip)
    );

    SystemLog("Listening for market data on " + std::string(ip) + ":" + std::to_string(port));

    std::vector<uint8_t> buf(Config::MAX_PACKET);

    while (g_running) {
        ssize_t n = recv(sock, buf.data(), buf.size(), 0);

        if (n < 0) {
            // Error or timeout, just continue to check g_running flag
            continue;
        } else if (n > 0) {
            static bool first_packet = true;
            if (first_packet) {
                SystemLog("[MULTICAST] SUCCESS! First byte of market data received!");
                first_packet = false;
            }
            QueuedPacket pkt;

            pkt.exchange = exchange;

            pkt.data.assign(
                buf.begin(),
                buf.begin() + n
            );

            pkt.rx_ns = steady_ns();

            FEED_DIAG.packets_received.fetch_add(
                1,
                std::memory_order_relaxed
            );

            FEED_DIAG.bytes_received.fetch_add(
                static_cast<uint64_t>(n),
                std::memory_order_relaxed
            );

            {
                std::lock_guard<std::mutex> lock(QUEUE_MTX);

                /*
                 * LIVE MARKET POLICY:
                 *
                 * Never allow old packets to accumulate forever.
                 *
                 * Drop oldest first when full.
                 */
                if (
                    PACKET_QUEUE.size()
                    >= MAX_PACKET_QUEUE
                ) {

                    PACKET_QUEUE.pop_front();

                    FEED_DIAG.packets_dropped.fetch_add(
                        1,
                        std::memory_order_relaxed
                    );
                }

                PACKET_QUEUE.emplace_back(
                    std::move(pkt)
                );

                atomic_max(
                    FEED_DIAG.max_queue_depth,
                    static_cast<uint64_t>(
                        PACKET_QUEUE.size()
                    )
                );
            }

            QUEUE_CV.notify_one();
        }
    }

    close(sock);
    SystemLog("Stopped listening on " + std::string(ip) + ":" + std::to_string(port));
}

#ifndef DISABLE_KDB
void kdb_writer_thread() {
    SystemLog("[KDB] Writer thread started. Monitoring connections...");
    
    int kdb_handle = 0;
    redisContext *redis = nullptr;
    
    auto safe_stoll = [](const std::string &s) -> long long {
        try { return std::stoll(s); } catch(...) { return 0; }
    };

    auto safe_stod = [](const std::string &s) -> double {
        try { return std::stod(s); } catch(...) { return 0.0; }
    };

    auto extract_json_string = [](const std::string& json, const std::string& key) -> std::string {
        std::string search = "\"" + key + "\":\"";
        size_t start_pos = json.find(search);
        if (start_pos == std::string::npos) return "";
        start_pos += search.length();
        size_t end_pos = json.find("\"", start_pos);
        if (end_pos == std::string::npos) return "";
        return json.substr(start_pos, end_pos - start_pos);
    };

    auto extract_json_number = [](const std::string& json, const std::string& key) -> std::string {
        std::string search = "\"" + key + "\"";
        size_t start_pos = json.find(search);
        if (start_pos == std::string::npos) return "0";
        start_pos += search.length();
        
        // Find the colon delimiter
        start_pos = json.find(':', start_pos);
        if (start_pos == std::string::npos) return "0";
        start_pos++; // move past colon
        
        // Skip any whitespace characters
        while (start_pos < json.length() && std::isspace(json[start_pos])) {
            start_pos++;
        }
        
        size_t end_pos = start_pos;
        while (end_pos < json.length() && (isdigit(json[end_pos]) || json[end_pos] == '.' || json[end_pos] == '-')) {
            end_pos++;
        }
        
        if (end_pos == start_pos) return "0";
        return json.substr(start_pos, end_pos - start_pos);
    };

    while(g_running) {
        // 1. Maintain KDB+ Connection & Setup Native RPC Function
        if (kdb_handle <= 0) {
            kdb_handle = khp((S)"127.0.0.1", 5000);
            if (kdb_handle > 0) {
                const char* init_q = "if[not `greeks_chain in tables[]; greeks_chain:([] time:`timestamp$(); sym:`symbol$(); underlying:`symbol$(); expiry:`symbol$(); strike:`float$(); ltp:`float$(); bid:`float$(); ask:`float$(); spot:`float$(); future:`float$(); iv:`float$(); delta:`float$(); gamma:`float$(); theta:`float$(); vega:`float$(); chg1d:`float$(); chg5:`float$(); chg15:`float$(); chg30:`float$(); chg60:`float$(); max_iv:`float$(); min_iv:`float$(); oi:`long$(); volume:`long$(); lpp_high:`float$(); lpp_low:`float$(); prev_oi:`long$(); chg_future:`float$(); atm_iv:`float$())];"
                                     "upd_greek:{[row] `greeks_chain insert (.z.p,row)}";
                K result = k(kdb_handle, (S)init_q, (K)0);
                if (result) r0(result);
                SystemLog("[KDB] Connected natively to KDB+ process.");
            } else {
                std::this_thread::sleep_for(std::chrono::seconds(2));
                continue;
            }
        }

        // 2. Maintain Redis Pub/Sub Connection
        if (redis == nullptr || redis->err) {
            if (redis) redisFree(redis);
            redis = redisConnect("127.0.0.1", 6379);
            if (redis && !redis->err) {
                struct timeval timeout = { 1, 0 }; // 1 second loop tick
                redisSetTimeout(redis, timeout);
                redisReply *reply = (redisReply *)redisCommand(redis, "SUBSCRIBE dalal_greeks_stream");
                if (reply) freeReplyObject(reply);
                SystemLog("[KDB] Redis stream active. Forwarding ticks...");
            } else {
                std::this_thread::sleep_for(std::chrono::seconds(2));
                continue;
            }
        }

        // 3. Process Streams Natively
        redisReply *reply = nullptr;
        if (redisGetReply(redis, (void**)&reply) == REDIS_OK) {
            if (reply == nullptr) continue; // Timeout occurred, loop to check g_running

            if (reply->type == REDIS_REPLY_ARRAY && reply->elements == 3 && strcmp(reply->element[0]->str, "message") == 0) {
                std::string payload = reply->element[2]->str;
                if (extract_json_string(payload, "type") == "analytics") {
                    // Async Native RPC call via negative handle (-kdb_handle)
                    K row = knk(28, 
                        ks((S)extract_json_string(payload, "symbol").c_str()),
                        ks((S)extract_json_string(payload, "underlying").c_str()),
