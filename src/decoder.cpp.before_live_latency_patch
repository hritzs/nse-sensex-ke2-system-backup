static void parse_7130(const uint8_t* b, size_t len) {
    if (len < 40) return;
    uint16_t recs = be16(b + 12);
    size_t offset = 40;
    for (uint16_t i = 0; i < recs; i++) {
        if (offset + 8 > len) break;
        uint32_t token = be32(b + offset);
        uint32_t oi = be32(b + offset + 4);
        auto it = TOKEN_MAP.find(token);
        if (it != TOKEN_MAP.end()) Analytics::update_oi(it->second.first, oi);
        offset += 8;
    }
}

void process_packet(Exchange exchange, const uint8_t* buf, size_t len)
{
    total_packets++;

    if (exchange == Exchange::BSE) {
        // BSE Direct NFCAST does not use the same LZO chunking layer as NSE
        parse_bse_nfcast(buf, len);
        parsed_packets++;
        print_stats();
        return;
    }

    // Exchange::NSE LZO decompression layer below
    if (len < 4)
    {
        dropped_packets++;
        print_stats();
        return;
    }

    uint16_t packets = be16(buf + 2);

    if (packets == 0 || packets > 50)
    {
        dropped_packets++;
        print_stats();
        return;
    }

    size_t pos = 4;

    for (uint16_t i = 0; i < packets; i++)
    {
        if (pos + 2 > len)
        {
            dropped_packets++;
            break;
        }

        uint16_t comp = be16(buf + pos);
        pos += 2;

        if (comp == 0 || comp > 2048)
        {
            dropped_packets++;
            break;
        }

        if (pos + comp > len)
        {
            dropped_packets++;
            break;
        }

        std::vector<uint8_t> dec;

        bool ok = decompress_lzo(buf + pos, comp, dec);

        pos += comp;

        if (!ok)
        {
            dropped_packets++;
            continue;
        }

        if (dec.size() <= 18)
        {
            dropped_packets++;
            continue;
        }

        const uint8_t* b = dec.data() + 8;
        size_t blen = dec.size() - 8;

        if (blen < 12)
        {
            dropped_packets++;
            continue;
        }

        uint16_t tx = be16(b + 10);

        static int tx_diag_count = 0;
        if (tx_diag_count < 20)
        {
            ++tx_diag_count;
            std::cout << "[TX DIAG] UDP Message Type (tx) = " << tx << " | length = " << blen << std::endl;
        }

        switch (tx)
        {
            case 17208:
            case 7208:
                parse_7208(b, blen);
                parsed_packets++;
                break;
            case 17202:
                parse_17202(b, blen);
                parsed_packets++;
                break;
            case 7202:
                parse_7202(b, blen);
                parsed_packets++;
                break;
            case 17201:
                parse_17201(b, blen);
                parsed_packets++;
                break;
            case 7201:
                parse_7201(b, blen);
                parsed_packets++;
                break;
            case 7220:
                parse_7220(b, blen);
                parsed_packets++;
                break;
            case 17130:
                parse_17130(b, blen);
                parsed_packets++;
                break;
            case 7130:
                parse_7130(b, blen);
                parsed_packets++;
                break;
            default:
                break;
        }
    }

    print_stats();
}